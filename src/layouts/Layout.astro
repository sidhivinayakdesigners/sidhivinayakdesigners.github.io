<body>
  <!-- Google Tag Manager (noscript) if present -->
  {!isDev && (
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-ND5JCFH"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  )}
  
  <Header />
  
  <main>
    <slot />
  </main>
  
  <Footer showNaviMumbaiFooter={showNaviMumbaiFooter} />
  
  <!-- scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" is:inline></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js" is:inline></script>
  <script src="/assets/js/main.min.js?v=1009" is:inline></script>
  <script is:inline>
    AOS.init({
        duration: 800,
        once: true
    });

    // Global touch swipe handler for Bootstrap Carousels
    (function() {
      let touchStartX = 0;
      let touchStartY = 0;
      let touchEndX = 0;
      let touchEndY = 0;

      document.addEventListener('touchstart', function(e) {
        const carousel = e.target.closest('.carousel');
        if (!carousel) return;
        touchStartX = e.changedTouches[0].screenX;
        touchStartY = e.changedTouches[0].screenY;
      }, { passive: true });

      document.addEventListener('touchend', function(e) {
        const carousel = e.target.closest('.carousel');
        if (!carousel) return;
        touchEndX = e.changedTouches[0].screenX;
        touchEndY = e.changedTouches[0].screenY;
        handleSwipe(carousel);
      }, { passive: true });

      function handleSwipe(carousel) {
        const deltaX = touchEndX - touchStartX;
        const deltaY = touchEndY - touchStartY;
        
        // Threshold: horizontal distance > 40px, vertical displacement < 80px
        if (Math.abs(deltaX) > 40 && Math.abs(deltaY) < 80) {
          if (deltaX < 0) {
            // Swipe Left -> Show next photo
            const nextBtn = carousel.querySelector('.carousel-control-next');
            if (nextBtn) {
              nextBtn.click();
            }
          } else {
            // Swipe Right -> Show previous photo
            const prevBtn = carousel.querySelector('.carousel-control-prev');
            if (prevBtn) {
              prevBtn.click();
            }
          }
        }
      }
    })();

    // ===== UNIFIED CATALOGUE MAXIMIZE LIGHTBOX WITH BOTTOM FILMSTRIP =====
    (function() {
      let modalEl = null;
      let stageEl = null;
      let mainImgEl = null;
      let captionEl = null;
      let filmstripEl = null;
      let prevBtn = null;
      let nextBtn = null;
      let closeBtn = null;

      let currentPhotos = [];
      let currentPhotoIndex = 0;
      let currentTitle = '';

      function initCatalogModal() {
        if (modalEl) return;

        modalEl = document.createElement('div');
        modalEl.className = 'dc-catalog-modal';
        modalEl.id = 'dcCatalogModal';
        modalEl.innerHTML = `
          <button class="dc-catalog-modal-close" id="dcCatalogModalClose" aria-label="Close modal">&times;</button>
          <button class="dc-catalog-modal-nav dc-catalog-modal-prev" id="dcCatalogModalPrev" aria-label="Previous photo">&#10094;</button>
          <button class="dc-catalog-modal-nav dc-catalog-modal-next" id="dcCatalogModalNext" aria-label="Next photo">&#10095;</button>
          <div class="dc-catalog-modal-main-stage" id="dcCatalogModalStage">
            <div class="dc-catalog-modal-img-wrapper">
              <img id="dcCatalogModalMainImg" class="dc-catalog-modal-main-img" src="" alt="Catalog View" />
            </div>
            <div class="dc-catalog-modal-caption" id="dcCatalogModalCaption"></div>
          </div>
          <div class="dc-catalog-modal-filmstrip-wrapper" id="dcCatalogModalFilmstripWrapper">
            <div class="dc-catalog-modal-filmstrip" id="dcCatalogModalFilmstrip"></div>
          </div>
        `;
        document.body.appendChild(modalEl);

        const styleEl = document.createElement('style');
        styleEl.innerHTML = `
          .dc-catalog-modal {
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
            width: 100vw !important;
            height: 100vh !important;
            background: rgba(8, 8, 10, 0.97) !important;
            z-index: 2147483647 !important;
            display: none;
            flex-direction: column !important;
            justify-content: space-between !important;
            align-items: center !important;
            padding: 15px 12px 10px 12px !important;
            box-sizing: border-box !important;
            touch-action: none !important;
            user-select: none !important;
            -webkit-user-select: none !important;
          }
          body.catalog-lightbox-open,
          body.lightbox-open {
            overflow: hidden !important;
          }
          body.catalog-lightbox-open .dc-mobile-bottom-bar,
          body.catalog-lightbox-open #dcMobileBottomBar,
          body.catalog-lightbox-open .floating-widgets,
          body.catalog-lightbox-open .navbar {
            display: none !important;
          }
          .dc-catalog-modal-close {
            position: absolute !important;
            top: 15px !important;
            right: 20px !important;
            width: 44px !important;
            height: 44px !important;
            border-radius: 50% !important;
            background: rgba(255, 255, 255, 0.2) !important;
            border: none !important;
            color: #ffffff !important;
            font-size: 1.6rem !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            cursor: pointer !important;
            z-index: 2147483647 !important;
            transition: background 0.2s ease, transform 0.2s ease !important;
            line-height: 1 !important;
          }
          .dc-catalog-modal-close:hover {
            background: rgba(255, 255, 255, 0.35) !important;
            transform: scale(1.08) !important;
          }
          .dc-catalog-modal-nav {
            position: absolute !important;
            top: 45% !important;
            transform: translateY(-50%) !important;
            width: 48px !important;
            height: 48px !important;
            border-radius: 50% !important;
            background: rgba(255, 255, 255, 0.18) !important;
            border: 1px solid rgba(255, 255, 255, 0.3) !important;
            color: #ffffff !important;
            font-size: 1.4rem !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            cursor: pointer !important;
            z-index: 2147483647 !important;
            transition: all 0.2s ease !important;
            backdrop-filter: blur(4px) !important;
            -webkit-backdrop-filter: blur(4px) !important;
          }
          .dc-catalog-modal-nav:hover {
            background: #189ba6 !important;
            border-color: #189ba6 !important;
            transform: translateY(-50%) scale(1.1) !important;
          }
          .dc-catalog-modal-prev { left: 20px !important; }
          .dc-catalog-modal-next { right: 20px !important; }
          .dc-catalog-modal-main-stage {
            flex: 1 !important;
            width: 100% !important;
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
            min-height: 0 !important;
            position: relative !important;
          }
          .dc-catalog-modal-img-wrapper {
            flex: 1 !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            min-height: 0 !important;
            width: 100% !important;
          }
          .dc-catalog-modal-main-img {
            max-height: 64vh !important;
            max-width: 88vw !important;
            width: auto !important;
            height: auto !important;
            object-fit: contain !important;
            border-radius: 6px !important;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.7) !important;
            pointer-events: auto !important;
            user-select: none !important;
            -webkit-user-drag: none !important;
            transition: opacity 0.2s ease !important;
          }
          .dc-catalog-modal-caption {
            color: #ffffff !important;
            font-size: 0.95rem !important;
            font-weight: 500 !important;
            margin-top: 10px !important;
            text-align: center !important;
            max-width: 85% !important;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            letter-spacing: 0.3px !important;
          }
          .dc-catalog-modal-filmstrip-wrapper {
            width: 100% !important;
            max-width: 92vw !important;
            height: 72px !important;
            margin-top: 8px !important;
            margin-bottom: 6px !important;
            display: flex !important;
            justify-content: center !important;
            z-index: 2147483647 !important;
          }
          .dc-catalog-modal-filmstrip {
            display: flex !important;
            gap: 8px !important;
            overflow-x: auto !important;
            max-width: 100% !important;
            padding: 4px 10px !important;
            scrollbar-width: thin !important;
            scrollbar-color: rgba(255, 255, 255, 0.4) transparent !important;
            -webkit-overflow-scrolling: touch !important;
            touch-action: pan-x !important;
          }
          .dc-catalog-modal-filmstrip::-webkit-scrollbar {
            height: 5px !important;
          }
          .dc-catalog-modal-filmstrip::-webkit-scrollbar-thumb {
            background: rgba(255, 255, 255, 0.4) !important;
            border-radius: 4px !important;
          }
          .dc-catalog-modal-thumb {
            flex: 0 0 auto !important;
            width: 76px !important;
            height: 52px !important;
            border-radius: 4px !important;
            overflow: hidden !important;
            cursor: pointer !important;
            opacity: 0.5 !important;
            border: 2px solid transparent !important;
            transition: all 0.2s ease !important;
            box-sizing: border-box !important;
          }
          .dc-catalog-modal-thumb.active {
            opacity: 1 !important;
            border: 2px solid #ffffff !important;
            box-shadow: 0 0 12px rgba(255, 255, 255, 0.8) !important;
            transform: scale(1.06) !important;
          }
          .dc-catalog-modal-thumb img {
            width: 100% !important;
            height: 100% !important;
            object-fit: cover !important;
            display: block !important;
            pointer-events: none !important;
          }
          @media (max-width: 768px) {
            .dc-catalog-modal {
              padding: 10px 4px 6px 4px !important;
            }
            .dc-catalog-modal-close {
              top: 10px !important;
              right: 12px !important;
              width: 40px !important;
              height: 40px !important;
              font-size: 1.3rem !important;
              background: rgba(255, 255, 255, 0.25) !important;
            }
            .dc-catalog-modal-nav {
              width: 38px !important;
              height: 38px !important;
              font-size: 1.1rem !important;
            }
            .dc-catalog-modal-prev { left: 6px !important; }
            .dc-catalog-modal-next { right: 6px !important; }
            .dc-catalog-modal-main-img {
              max-height: 52vh !important;
              max-width: 94vw !important;
            }
            .dc-catalog-modal-caption {
              font-size: 0.82rem !important;
              margin-top: 6px !important;
              max-width: 92% !important;
            }
            .dc-catalog-modal-filmstrip-wrapper {
              height: 58px !important;
              margin-top: 4px !important;
              margin-bottom: 2px !important;
            }
            .dc-catalog-modal-thumb {
              width: 60px !important;
              height: 42px !important;
            }
          }
        `;
        document.head.appendChild(styleEl);

        stageEl = modalEl.querySelector('#dcCatalogModalStage');
        mainImgEl = modalEl.querySelector('#dcCatalogModalMainImg');
        captionEl = modalEl.querySelector('#dcCatalogModalCaption');
        filmstripEl = modalEl.querySelector('#dcCatalogModalFilmstrip');
        prevBtn = modalEl.querySelector('#dcCatalogModalPrev');
        nextBtn = modalEl.querySelector('#dcCatalogModalNext');
        closeBtn = modalEl.querySelector('#dcCatalogModalClose');

        closeBtn.addEventListener('click', closeCatalogModal);
        prevBtn.addEventListener('click', (e) => { e.stopPropagation(); navigateCatalogModal(-1); });
        nextBtn.addEventListener('click', (e) => { e.stopPropagation(); navigateCatalogModal(1); });

        modalEl.addEventListener('click', (e) => {
          if (e.target === modalEl || e.target.classList.contains('dc-catalog-modal-img-wrapper') || e.target === stageEl) {
            closeCatalogModal();
          }
        });

        // Touch Drag & Swipe Gestures
        let startX = 0;
        let startY = 0;
        let currentX = 0;
        let currentY = 0;
        let isDragging = false;
        let isSwiping = false;

        const getEventX = (e) => (e.touches ? e.touches[0].clientX : e.clientX);
        const getEventY = (e) => (e.touches ? e.touches[0].clientY : e.clientY);

        const onDragStart = (e) => {
          if (currentPhotos.length <= 1) return;
          if (e.target.closest('.dc-catalog-modal-close') || e.target.closest('.dc-catalog-modal-nav') || e.target.closest('.dc-catalog-modal-filmstrip-wrapper')) return;
          isDragging = true;
          isSwiping = false;
          startX = getEventX(e);
          startY = getEventY(e);
          currentX = startX;
          currentY = startY;
          mainImgEl.style.transition = 'none';
        };

        const onDragMove = (e) => {
          if (!isDragging) return;
          currentX = getEventX(e);
          currentY = getEventY(e);
          const deltaX = currentX - startX;
          const deltaY = currentY - startY;

          if (!isSwiping && (Math.abs(deltaX) > 6 || Math.abs(deltaY) > 6)) {
            isSwiping = true;
          }

          if (isSwiping) {
            const scale = Math.max(0.88, 1 - Math.abs(deltaX) / 1600);
            mainImgEl.style.transform = `translate3d(${deltaX}px, 0, 0) scale(${scale})`;
            mainImgEl.style.opacity = `${Math.max(0.4, 1 - Math.abs(deltaX) / 500)}`;
          }
        };

        const onDragEnd = () => {
          if (!isDragging) return;
          isDragging = false;
          const deltaX = currentX - startX;
          const threshold = window.innerWidth * 0.12;

          mainImgEl.style.transition = 'transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease';

          if (deltaX < -threshold) {
            mainImgEl.style.transform = `translate3d(-120px, 0, 0)`;
            mainImgEl.style.opacity = '0';
            setTimeout(() => {
              navigateCatalogModal(1);
              mainImgEl.style.transition = 'none';
              mainImgEl.style.transform = `translate3d(80px, 0, 0)`;
              setTimeout(() => {
                mainImgEl.style.transition = 'transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease';
                mainImgEl.style.transform = 'translate3d(0, 0, 0)';
                mainImgEl.style.opacity = '1';
              }, 20);
            }, 140);
          } else if (deltaX > threshold) {
            mainImgEl.style.transform = `translate3d(120px, 0, 0)`;
            mainImgEl.style.opacity = '0';
            setTimeout(() => {
              navigateCatalogModal(-1);
              mainImgEl.style.transition = 'none';
              mainImgEl.style.transform = `translate3d(-80px, 0, 0)`;
              setTimeout(() => {
                mainImgEl.style.transition = 'transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease';
                mainImgEl.style.transform = 'translate3d(0, 0, 0)';
                mainImgEl.style.opacity = '1';
              }, 20);
            }, 140);
          } else {
            mainImgEl.style.transform = 'translate3d(0, 0, 0) scale(1)';
            mainImgEl.style.opacity = '1';
          }
        };

        stageEl.addEventListener('touchstart', onDragStart, { passive: true });
        stageEl.addEventListener('touchmove', onDragMove, { passive: true });
        stageEl.addEventListener('touchend', onDragEnd, { passive: true });

        stageEl.addEventListener('mousedown', (e) => {
          if (e.button !== 0) return;
          onDragStart(e);
        });
        window.addEventListener('mousemove', onDragMove);
        window.addEventListener('mouseup', onDragEnd);

        // Keyboard navigation
        document.addEventListener('keydown', (e) => {
          if (modalEl && modalEl.style.display === 'flex') {
            if (e.key === 'Escape') closeCatalogModal();
            if (e.key === 'ArrowRight') navigateCatalogModal(1);
            if (e.key === 'ArrowLeft') navigateCatalogModal(-1);
          }
        });

        // Filmstrip horizontal mousewheel
        filmstripEl.addEventListener('wheel', (e) => {
          if (e.deltaY !== 0) {
            e.preventDefault();
            filmstripEl.scrollLeft += e.deltaY;
          }
        }, { passive: false });
      }

      function renderCatalogSlide(index) {
        if (!currentPhotos[index]) return;
        currentPhotoIndex = index;
        const total = currentPhotos.length;

        mainImgEl.style.opacity = '0.35';
        mainImgEl.src = currentPhotos[currentPhotoIndex];
        mainImgEl.onload = () => { mainImgEl.style.opacity = '1'; };

        captionEl.textContent = (currentTitle ? currentTitle + ' ' : '') + `(${currentPhotoIndex + 1} / ${total})`;

        // Update thumbnails in bottom filmstrip
        const thumbs = filmstripEl.querySelectorAll('.dc-catalog-modal-thumb');
        thumbs.forEach((th, idx) => {
          if (idx === currentPhotoIndex) {
            th.classList.add('active');
            th.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          } else {
            th.classList.remove('active');
          }
        });

        if (prevBtn) prevBtn.style.display = total > 1 ? 'flex' : 'none';
        if (nextBtn) nextBtn.style.display = total > 1 ? 'flex' : 'none';
      }

      function navigateCatalogModal(dir) {
        if (currentPhotos.length <= 1) return;
        const nextIdx = (currentPhotoIndex + dir + currentPhotos.length) % currentPhotos.length;
        renderCatalogSlide(nextIdx);
      }

      function closeCatalogModal() {
        if (!modalEl) return;
        modalEl.style.display = 'none';
        document.body.classList.remove('catalog-lightbox-open', 'lightbox-open');
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
      }

      window.openCatalogLightboxModal = function(photos, startIndex, title) {
        initCatalogModal();
        if (!photos || photos.length === 0) return;

        currentPhotos = photos;
        currentPhotoIndex = (startIndex >= 0 && startIndex < photos.length) ? startIndex : 0;
        currentTitle = title || '';

        // Build bottom filmstrip containing ONLY this catalogue's photos
        filmstripEl.innerHTML = '';
        currentPhotos.forEach((src, idx) => {
          const thumb = document.createElement('div');
          thumb.className = 'dc-catalog-modal-thumb' + (idx === currentPhotoIndex ? ' active' : '');
          thumb.innerHTML = `<img src="${src}" alt="Thumb ${idx + 1}" loading="lazy" />`;
          thumb.addEventListener('click', (e) => {
            e.stopPropagation();
            renderCatalogSlide(idx);
          });
          filmstripEl.appendChild(thumb);
        });

        const filmstripWrapper = modalEl.querySelector('#dcCatalogModalFilmstripWrapper');
        if (filmstripWrapper) {
          filmstripWrapper.style.display = currentPhotos.length > 1 ? 'flex' : 'none';
        }

        renderCatalogSlide(currentPhotoIndex);
        modalEl.style.display = 'flex';
        document.body.classList.add('catalog-lightbox-open', 'lightbox-open');
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
      };

      // Universal openLightbox handler for all catalogue cards
      window.openLightbox = function(imgElement, event) {
        if (event) {
          try { event.stopPropagation(); event.preventDefault(); } catch(e) {}
        }

        const container = imgElement ? imgElement.closest('.dc-exact-card-img, .dc-exact-card, .premium-card-img, .premium-card, .catalog-card, .carousel') : null;

        let photos = [];
        let title = '';
        let startIndex = 0;

        if (container) {
          title = (container.getAttribute('data-lightbox-title') || 
                   container.closest('.dc-exact-card, .premium-card, .catalog-card')?.querySelector('.dc-exact-card-title, .card-title, h3, h4')?.textContent || 
                   '').replace(/&amp;/g, '&').trim();

          // Strategy A: Carousel inner images from this exact card (100% exact visual sequence)
          const cardImgs = Array.from(container.querySelectorAll('.carousel-inner img, .carousel-item img'));
          if (cardImgs.length > 0) {
            photos = cardImgs.map(img => img.getAttribute('src') || img.src).filter(Boolean);
            if (imgElement) {
              startIndex = cardImgs.indexOf(imgElement);
              if (startIndex < 0) {
                const activeImg = container.querySelector('.carousel-item.active img');
                if (activeImg) startIndex = cardImgs.indexOf(activeImg);
              }
            }
          }

          // Strategy B: data-lightbox-photos JSON
          if (photos.length === 0) {
            const raw = container.getAttribute('data-lightbox-photos') || container.closest('[data-lightbox-photos]')?.getAttribute('data-lightbox-photos');
            if (raw) {
              try {
                photos = JSON.parse(raw.replace(/&quot;/g, '"').replace(/&amp;/g, '&'));
              } catch(e) {}
            }
          }

          // Strategy C: all img elements inside container
          if (photos.length === 0) {
            const allImgs = Array.from(container.querySelectorAll('img'));
            photos = allImgs.map(img => img.getAttribute('src') || img.src).filter(Boolean);
            if (imgElement) startIndex = allImgs.indexOf(imgElement);
          }
        }

        // Fallback for standalone image
        if (photos.length === 0 && imgElement) {
          const src = imgElement.getAttribute('src') || imgElement.src;
          if (src) photos = [src];
          title = imgElement.getAttribute('alt') || 'Interior Catalogue';
          startIndex = 0;
        }

        if (photos.length === 0) return;

        // Resolve start index by src matching if index is still negative or 0
        if (startIndex < 0 && imgElement) {
          const clickedSrc = (imgElement.getAttribute('src') || imgElement.src || '').split('?')[0].split('#')[0].toLowerCase();
          const clickedFilename = clickedSrc.split('/').pop();
          for (let i = 0; i < photos.length; i++) {
            const pSrc = (photos[i] || '').split('?')[0].split('#')[0].toLowerCase();
            if (pSrc === clickedSrc || (clickedFilename && pSrc.endsWith('/' + clickedFilename))) {
              startIndex = i;
              break;
            }
          }
        }

        if (startIndex < 0 || startIndex >= photos.length) startIndex = 0;

        window.openCatalogLightboxModal(photos, startIndex, title);
      };

      // Document-level fast delegation for catalogue card clicks
      document.addEventListener('click', (e) => {
        if (e.target.closest('#dcCatalogModal') || e.target.closest('#galleryPhotoModal')) return;
        const cardImg = e.target.closest('.dc-exact-card-img img, .carousel-inner img');
        if (cardImg && !cardImg.hasAttribute('onclick')) {
          e.preventDefault();
          window.openLightbox(cardImg, e);
        }
      });
    })();
  </script>
