  <!-- Light Theme Override matching services.html -->
  <style id="services-light-theme-override">
    html {
      scroll-behavior: smooth !important;
      text-rendering: optimizeLegibility !important;
      -webkit-font-smoothing: antialiased !important;
      -moz-osx-font-smoothing: grayscale !important;
    }
    html, body {
      background-color: #ffffff !important;
      color: #000000 !important;
      font-family: Arial, Helvetica, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    }
    
    /* Improve rendering and scrolling performance */
    img, video, iframe {
      content-visibility: auto !important;
    }
    
    /* Hardware acceleration for smooth animations */
    .glimpse-card, .premium-card, .btn, a, .hero-section {
      transform: translate3d(0,0,0);
      will-change: transform, opacity;
      transition: transform 0.3s cubic-bezier(0.25, 0.8, 0.25, 1) !important;
    }
    .hero-section, .catalog-directory-hero, .dc-top-section-bg, header.bg-dark, .bg-dark, .bg-dark-card, .bg-dark-contrast {
      background-color: #f3f6f8 !important;
      color: #000000 !important;
    }
    h1, h2, h3, h4, h5, h6, .section-title {
      color: #000000 !important;
    }
    p, span, li, label, div, small, strong, p *, li *, span *, label *, div *, small *, strong *, .text-muted, .text-white-50, .text-secondary, .text-muted * {
      color: #000000 !important;
    }
    :not(footer) .text-white, body:not(footer) .text-white, a.text-white:not(footer a), .section-title.text-white {
      color: #000000 !important;
    }
    .text-gold, .text-gold * {
