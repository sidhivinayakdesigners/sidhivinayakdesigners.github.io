---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: string;
  showNaviMumbaiFooter?: boolean;
}

const { title, description, canonical = Astro.url.href, schema, showNaviMumbaiFooter = false } = Astro.props;
const isDev = import.meta.env.DEV;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta content="width=device-width, initial-scale=1.0" name="viewport" />
  <title>{title}</title>
  <meta content={description} name="description" />
  <link href={canonical} rel="canonical" />
  
  <!-- Resource Hints & Preconnects for Performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
  <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com" />

  <!-- Injected head meta and styling -->
  {schema && <script type="application/ld+json" set:html={schema}></script>}
  
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  <!-- Favicon -->
  <link href="/assets/images/favicon.webp" rel="icon" type="image/png" />
  <link href="/favicon.webp" rel="shortcut icon" type="image/x-icon" />
  <!-- Open Graph / Facebook -->
  <meta content="website" property="og:type" />
  <meta content={canonical} property="og:url" />
  <meta content={title} property="og:title" />
  <meta content={description} property="og:description" />
  <meta content="https://siddhivinayakdesigners.in/assets/images/hero_bg.webp" property="og:image" />
  <!-- Twitter -->
  <meta content="summary_large_image" name="twitter:card" />
  <meta content={canonical} name="twitter:url" />
  <meta content={title} name="twitter:title" />
  <meta content={description} name="twitter:description" />
  <meta content="https://siddhivinayakdesigners.in/assets/images/hero_bg.webp" name="twitter:image" />
  <!-- Bootstrap 5 & Styles -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  <link href="/assets/css/aos.css" rel="stylesheet" />
  <link href="/assets/css/style.min.css?v=1011" rel="stylesheet" />
  <style>
    /* Hero Banner Slider Responsive CSS */
    .hero-banner-slider-section {
      width: 100%;
      overflow: hidden;
      padding-top: 0 !important;
      margin-top: 0 !important;
    }

    @media (max-width: 767px) {
      .hero-banner-img {
        width: 100% !important;
        height: auto !important;
        display: block !important;
      }
      .carousel-indicators {
        bottom: 8px !important;
        margin-bottom: 0 !important;
      }
      .carousel-indicators [data-bs-target] {
        width: 8px !important;
        height: 8px !important;
        border-radius: 50% !important;
        background-color: #189ba6 !important;
      }
    }

    @media (min-width: 768px) {
      .hero-banner-img {
        width: 100% !important;
        max-height: 620px !important;
        object-fit: cover !important;
      }
    }

    /* Premium 10k$ Hero Styling Overhaul */
    .hero-section {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding-top: 120px;
      padding-bottom: 100px;
      overflow: hidden;
    }

    .hero-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, rgba(21, 20, 19, 0.98) 0%, rgba(21, 20, 19, 0.92) 40%, rgba(21, 20, 19, 0.6) 100%);
      z-index: 1;
    }

    /* Glow backdrop element */
    .hero-glow-orb {
      position: absolute;
      top: 20%;
      right: 10%;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(184, 144, 71, 0.15) 0%, rgba(184, 144, 71, 0) 70%);
      filter: blur(50px);
      z-index: 2;
      pointer-events: none;
      animation: pulse-glow 8s infinite alternate;
    }

    @keyframes pulse-glow {
      0% { transform: scale(1); opacity: 0.7; }
      100% { transform: scale(1.2); opacity: 1; }
    }

    .hero-container {
      position: relative;
      z-index: 3;
    }

    .hero-subtitle-premium {
      font-size: 0.9rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 3px;
      color: var(--color-gold);
      display: inline-block;
      margin-bottom: 1.5rem;
      position: relative;
      padding-left: 45px;
    }

    .hero-subtitle-premium::before {
      content: '';
      position: absolute;
      left: 0;
      top: 50%;
      width: 30px;
      height: 1px;
      background-color: var(--color-gold);
    }

    .hero-title-premium {
      font-size: clamp(2.5rem, 5vw, 4.5rem);
      line-height: 1.15;
      font-weight: 800;
      color: #fff !important;
      letter-spacing: -1px;
    }

    .hero-title-premium .text-gradient-gold {
      background: linear-gradient(135deg, #FFF 30%, #D4AF37 70%, #B89047 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: inline-block;
    }

    .hero-text-premium {
      font-size: 1.15rem;
      line-height: 1.8;
      font-weight: 300;
      color: #D1CFC9 !important;
      max-width: 650px;
      margin-top: 1.5rem;
      margin-bottom: 2.5rem;
    }

    /* Floating Showcase Card UI */
    .hero-showcase-glass-card {
      background: rgba(30, 28, 26, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      padding: 3rem 2.5rem;
      border-radius: 1px;
      position: relative;
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
      z-index: 10;
      animation: float-slow 6s ease-in-out infinite;
    }

    .hero-showcase-glass-card::before {
      content: '';
      position: absolute;
      top: -1px;
      left: -1px;
      width: 100%;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(135deg, rgba(184, 144, 71, 0.3) 0%, rgba(184, 144, 71, 0) 50%);
      pointer-events: none;
      z-index: -1;
    }

    @keyframes float-slow {
      0% { transform: translateY(0px); }
      50% { transform: translateY(-15px); }
      100% { transform: translateY(0px); }
    }

    .stat-row {
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      padding-bottom: 1.25rem;
      margin-bottom: 1.25rem;
    }

    .stat-row:last-child {
      border-bottom: none;
      padding-bottom: 0;
      margin-bottom: 0;
    }

    .stat-number {
      font-size: 2.5rem;
      font-weight: 700;
      color: var(--color-gold);
      line-height: 1;
      font-family: var(--font-heading);
    }

    .stat-label {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: #A6A097;
      font-weight: 600;
      margin-top: 0.25rem;
    }

    /* Premium Call to Action System */
    .cta-container-premium {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .cta-primary-btn {
      background: linear-gradient(135deg, #D4AF37 0%, #B89047 100%);
      color: #151413 !important;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      font-size: 0.85rem;
      padding: 1.25rem 2.5rem;
      border: none;
      border-radius: 1px;
      transition: all 0.3s ease;
      box-shadow: 0 4px 20px rgba(184, 144, 71, 0.3);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      width: fit-content;
      text-decoration: none;
    }

    .cta-primary-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(184, 144, 71, 0.5);
      background: linear-gradient(135deg, #E5C158 0%, #D4AF37 100%);
    }

    .cta-secondary-row {
      display: flex;
      align-items: center;
      gap: 2rem;
      margin-top: 0.5rem;
    }

    .cta-link-minimal {
      color: #FFF !important;
      font-size: 0.85rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      transition: color 0.3s ease;
      border-bottom: 1px solid rgba(255, 255, 255, 0.15);
      padding-bottom: 4px;
    }

    .cta-link-minimal:hover {
      color: var(--color-gold) !important;
      border-color: var(--color-gold);
    }

    /* Glassmorphic Form Overrides for Hero */
    .hero-glass-form .form-control {
      background: rgba(255, 255, 255, 0.05) !important;
      border: 1px solid rgba(255, 255, 255, 0.15) !important;
      color: #fff !important;
      border-radius: 1px !important;
      padding: 0.9rem 1rem !important;
      font-size: 0.9rem !important;
    }

    .hero-glass-form .form-control:focus {
      background: rgba(255, 255, 255, 0.08) !important;
      border-color: var(--color-gold) !important;
      box-shadow: 0 0 15px rgba(212, 175, 55, 0.2) !important;
    }

    .hero-glass-form label {
      color: #A6A097 !important;
      font-size: 0.7rem !important;
      letter-spacing: 1.5px !important;
      text-transform: uppercase !important;
      font-weight: 700 !important;
      margin-bottom: 0.4rem !important;
    }
  </style>

