ssets/images/delivered-projects/belapur-2bhk-parallel/4.webp","caption":"Belapur 2BHK - Modern Parallel Kitchen Setup"},{"src":"/assets/images/delivered-projects/belapur-2bhk-parallel/5.webp","caption":"Belapur 2BHK - Kitchen Cabinet Overhead details"},{"src":"/assets/images/delivered-projects/belapur-2bhk-parallel/6.webp","caption":"Belapur 2BHK - Elegant Master Bedroom"},{"src":"/assets/images/delivered-projects/belapur-2bhk-parallel/7.webp","caption":"Belapur 2BHK - Master Bedroom Wardrobes"},{"src":"/assets/images/delivered-projects/belapur-2bhk-parallel/8.webp","caption":"Belapur 2BHK - Kid Room bed styling"},{"src":"/assets/images/delivered-projects/belapur-2bhk-parallel/9.webp","caption":"Belapur 2BHK - Kid Room detailed study unit"},{"src":"/assets/images/delivered-projects/belapur-2bhk-parallel/10.webp","caption":"Belapur 2BHK - Kids Bedroom storage cabinetry"},{"src":"/assets/images/delivered-projects/nerul-3bhk-u-shaped/1.webp","caption":"Nerul 3BHK - Kitchen U-shaped layout"},{"src":"/assets/images/delivered-projects/nerul-3bhk-u-shaped/2.webp","caption":"Nerul 3BHK - Living Room wall paneling overview"},{"src":"/assets/images/delivered-projects/nerul-3bhk-u-shaped/3.webp","caption":"Nerul 3BHK - Living Room detailed view"},{"src":"/assets/images/delivered-projects/nerul-3bhk-u-shaped/4.webp","caption":"Nerul 3BHK - Living Room side profile console"},{"src":"/assets/images/delivered-projects/nerul-3bhk-u-shaped/5.webp","caption":"Nerul 3BHK - Living Room space layout"},{"src":"/assets/images/delivered-projects/nerul-3bhk-u-shaped/6.webp","caption":"Nerul 3BHK - Cozy Master Bedroom"},{"src":"/assets/images/siddhivinayak-designers-vashi.webp","caption":"Custom Living Room Woodwork Handover in Vashi"}];

      let currentCaptions = [];

      function renderCatalogSlide(index) {
        if (!currentPhotos[index]) return;
        currentPhotoIndex = index;
        const total = currentPhotos.length;

        mainImgEl.style.opacity = '0.35';
        mainImgEl.src = currentPhotos[currentPhotoIndex];
        mainImgEl.onload = () => { mainImgEl.style.opacity = '1'; };

        if (captionEl) captionEl.textContent = '';

        // Update thumbnails in bottom filmstrip
        const thumbs = filmstripEl.querySelectorAll('.dc-catalog-modal-thumb');
        thumbs.forEach((th, idx) => {
          if (idx === currentPhotoIndex) {
            th.classList.add('active');
            th.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
          } else {
            th.classList.remove('active');
          }
        });

        if (prevBtn) prevBtn.style.display = total > 1 ? 'flex' : 'none';
        if (nextBtn) nextBtn.style.display = total > 1 ? 'flex' : 'none';
      }

      function navigateCatalogModal(dir) {
        if (currentPhotos.length <= 1) return;
        const nextIdx = (currentPhotoIndex + dir + currentPhotos.length) % currentPhotos.length;
        renderCatalogSlide(nextIdx);
      }

      function closeCatalogModal() {
        if (!modalEl) return;
        modalEl.style.display = 'none';
        document.body.classList.remove('catalog-lightbox-open', 'lightbox-open');
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
      }

      window.openCatalogLightboxModal = function(photos, startIndex, captionsOrTitle) {
        initCatalogModal();
        if (!photos || photos.length === 0) return;

        currentPhotos = photos;
        currentPhotoIndex = (startIndex >= 0 && startIndex < photos.length) ? startIndex : 0;
        
        if (Array.isArray(captionsOrTitle)) {
          currentCaptions = captionsOrTitle;
          currentTitle = '';
        } else {
          currentCaptions = [];
          currentTitle = captionsOrTitle || '';
        }

        // Build bottom filmstrip containing this catalogue's photos
        filmstripEl.innerHTML = '';
        currentPhotos.forEach((src, idx) => {
          const thumb = document.createElement('div');
          thumb.className = 'dc-catalog-modal-thumb' + (idx === currentPhotoIndex ? ' active' : '');
          thumb.innerHTML = `<img src="${src}" alt="Thumb ${idx + 1}" loading="lazy" />`;
          thumb.addEventListener('click', (e) => {
            e.stopPropagation();
            renderCatalogSlide(idx);
          });
          filmstripEl.appendChild(thumb);
        });

        const filmstripWrapper = modalEl.querySelector('#dcCatalogModalFilmstripWrapper');
        if (filmstripWrapper) {
          filmstripWrapper.style.display = currentPhotos.length > 1 ? 'flex' : 'none';
        }

        renderCatalogSlide(currentPhotoIndex);
        modalEl.style.display = 'flex';
        document.body.classList.add('catalog-lightbox-open', 'lightbox-open');
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
      };

      // Universal openLightbox handler for all catalogue and recent completion gallery cards
      window.openLightbox = function(imgElement, event) {
        if (event) {
          try { event.stopPropagation(); event.preventDefault(); } catch(e) {}
        }

        // Bypassed on Gallery page so the dedicated full gallery modal runs uninterrupted
        if (document.getElementById('galleryPhotoModal') || (imgElement && imgElement.closest('.gallery-item, #galleryGrid, #galleryPhotoModal'))) {
          return;
        }

        const container = imgElement ? imgElement.closest('.dc-exact-card-img, .dc-exact-card, .premium-card-img, .premium-card, .catalog-card, .carousel') : null;

        let photos = [];
        let captions = [];
        let startIndex = 0;

        if (container) {
          // Strategy A: Carousel inner images from this exact card (for multi-image catalogue cards)
          const carouselImgs = Array.from(container.querySelectorAll('.carousel-inner img, .carousel-item img'));
          if (carouselImgs.length > 0) {
            photos = carouselImgs.map(img => img.getAttribute('src') || img.src).filter(Boolean);
            const cardTitle = (container.getAttribute('data-lightbox-title') || 
                               container.closest('.dc-exact-card, .premium-card, .catalog-card')?.querySelector('.dc-exact-card-title, .card-title, h3, h4')?.textContent || 
                               '').replace(/&amp;/g, '&').trim();
            captions = photos.map(() => cardTitle);
            if (imgElement) {
              startIndex = carouselImgs.indexOf(imgElement);
              if (startIndex < 0) {
                const activeImg = container.querySelector('.carousel-item.active img');
                if (activeImg) startIndex = carouselImgs.indexOf(activeImg);
              }
            }
          }

          // Strategy B: data-lightbox-photos JSON
          if (photos.length === 0) {
            const raw = container.getAttribute('data-lightbox-photos') || container.closest('[data-lightbox-photos]')?.getAttribute('data-lightbox-photos');
            if (raw) {
              try {
                photos = JSON.parse(raw.replace(/&quot;/g, '"').replace(/&amp;/g, '&'));
                const cardTitle = (container.getAttribute('data-lightbox-title') || '').replace(/&amp;/g, '&').trim();
                captions = photos.map(() => cardTitle);
              } catch(e) {}
            }
          }

          // Strategy C: Gallery Section (e.g. Recent Completion Gallery on Home/Cities pages)
          if (photos.length === 0) {
            const section = container.closest('section, .container, .row');
            if (section) {
              const sectionCards = Array.from(section.querySelectorAll('.premium-card, .dc-exact-card'));
              if (sectionCards.length > 1) {
                if (typeof ALL_GALLERY_PHOTOS !== 'undefined' && ALL_GALLERY_PHOTOS.length > 0) {
                  photos = ALL_GALLERY_PHOTOS.map(p => p.src);
                  captions = ALL_GALLERY_PHOTOS.map(p => p.caption);
                  if (imgElement) {
                    const trig = imgElement.closest('.premium-card, .dc-exact-card')?.querySelector('.lightbox-trigger');
                    const hrefVal = trig ? trig.getAttribute('href') : '';
                    const clickedSrc = (trig && trig.getAttribute('data-src')) || 
                                       (hrefVal && !hrefVal.startsWith('javascript') && hrefVal.startsWith('/') ? hrefVal : null) || 
                                       imgElement.getAttribute('src') || imgElement.src || '';
                    const cleanClicked = clickedSrc.split('?')[0].split('#')[0].toLowerCase();
                    const clickedFilename = cleanClicked.split('/').pop();
                    startIndex = photos.findIndex(src => {
                      const clean = (src || '').split('?')[0].split('#')[0].toLowerCase();
                      return clean === cleanClicked || (clickedFilename && clean.endsWith('/' + clickedFilename));
                    });
                  }
                } else {
                  sectionCards.forEach(card => {
                    const img = card.querySelector('img');
                    const trig = card.querySelector('.lightbox-trigger');
                    const hrefVal = trig ? trig.getAttribute('href') : '';
                    const src = (trig && trig.getAttribute('data-src')) || 
                                (hrefVal && !hrefVal.startsWith('javascript') && hrefVal.startsWith('/') ? hrefVal : null) || 
                                (img && (img.getAttribute('src') || img.src));
                    const cap = (trig && trig.getAttribute('data-caption')) || (img && (img.getAttribute('alt') || '')) || '';
                    if (src) {
                      photos.push(src);
                      captions.push(cap.replace(/&amp;/g, '&').trim());
                    }
                  });
                  if (imgElement) {
                    const clickedCard = imgElement.closest('.premium-card, .dc-exact-card');
                    if (clickedCard) {
                      startIndex = sectionCards.indexOf(clickedCard);
                    }
                  }
                }
              }
            }
          }

          // Strategy D: all img elements inside container
          if (photos.length === 0) {
            const allImgs = Array.from(container.querySelectorAll('img'));
            photos = allImgs.map(img => img.getAttribute('src') || img.src).filter(Boolean);
            const cardTitle = (container.getAttribute('data-lightbox-title') || imgElement?.getAttribute('alt') || '').replace(/&amp;/g, '&').trim();
            captions = photos.map(() => cardTitle);
            if (imgElement) startIndex = allImgs.indexOf(imgElement);
          }
        }

        // Fallback for standalone image
        if (photos.length === 0 && imgElement) {
          const src = imgElement.getAttribute('src') || imgElement.src;
          if (src) photos = [src];
          captions = [(imgElement.getAttribute('alt') || 'Interior Design').replace(/&amp;/g, '&').trim()];
          startIndex = 0;
        }

        if (photos.length === 0) return;

        // Resolve start index by src matching if index is still negative or 0
        if (startIndex < 0 && imgElement) {
          const clickedSrc = (imgElement.getAttribute('src') || imgElement.src || '').split('?')[0].split('#')[0].toLowerCase();
          const clickedFilename = clickedSrc.split('/').pop();
          for (let i = 0; i < photos.length; i++) {
            const pSrc = (photos[i] || '').split('?')[0].split('#')[0].toLowerCase();
            if (pSrc === clickedSrc || (clickedFilename && pSrc.endsWith('/' + clickedFilename))) {
              startIndex = i;
              break;
            }
          }
        }

        if (startIndex < 0 || startIndex >= photos.length) startIndex = 0;

        window.openCatalogLightboxModal(photos, startIndex, captions.length > 0 ? captions : title);
      };

      // Document-level fast delegation for catalogue and recent completion cards
      document.addEventListener('click', (e) => {
        if (e.target.closest('#dcCatalogModal') || e.target.closest('#galleryPhotoModal') || e.target.closest('.gallery-item') || document.getElementById('galleryPhotoModal')) return;
        
        const trigger = e.target.closest('.lightbox-trigger, .premium-card-overlay a');
        const cardImg = e.target.closest('.dc-exact-card-img img, .carousel-inner img, .premium-card-img img, .premium-card img');
        const cardContainer = e.target.closest('.dc-exact-card-img, .premium-card-img, .premium-card');

        const targetEl = trigger || cardImg || (cardContainer ? cardContainer.querySelector('img') : null);
        if (targetEl && !targetEl.hasAttribute('onclick')) {
          e.preventDefault();
          window.openLightbox(targetEl, e);
        }
      });
    })();

    // Track referring content page across the entire site for seamless catalogue close navigation
    (function() {
      try {
        var path = window.location.pathname;
        var isImmersive = path.includes('/modern-4bhk-penthouse-kharghar') ||
                          path.includes('/contemporary-3bhk-flat-kopar-khairane') ||
                          path.includes('/contemporary-4bhk-penthouse-seawoods') ||
                          path.includes('/elegant-2bhk-flat-vashi') ||
                          path.includes('/contemporary-3bhk-house-belapur') ||
                          path.includes('/rustic-3bhk-home-nerul') ||
                          path.endsWith('-photos/') ||
                          path.endsWith('-photos');
        if (!isImmersive) {
          sessionStorage.setItem('svd_last_content_page', window.location.href);
        }
      } catch(err) {}
    })();

    // Universal Close Handler for Immersive Catalogues
    window.closeImmersiveGallery = function(e) {
      if (e && e.preventDefault) e.preventDefault();
      if (e && e.stopPropagation) e.stopPropagation();
      
      var lastPage = null;
      try {
        lastPage = sessionStorage.getItem('svd_last_content_page');
      } catch(err) {}

      var referrer = document.referrer;
      var isSameSiteReferrer = referrer && (referrer.indexOf(window.location.host) !== -1 || referrer.startsWith(window.location.origin)) && referrer !== window.location.href;

      // 1. If history back is valid and referrer was internal, use browser history back
      if (window.history.length > 1 && isSameSiteReferrer) {
        window.history.back();
        return false;
      }

      // 2. If session storage has the page we navigated from, redirect directly to it
      if (lastPage && lastPage !== window.location.href) {
        window.location.href = lastPage;
        return false;
      }

      // 3. Fallback to same-site referrer
      if (isSameSiteReferrer) {
        window.location.href = referrer;
        return false;
      }

      // 4. Try history.back
      if (window.history.length > 1) {
        window.history.back();
        return false;
      }

      // 5. Default fallback to home
      window.location.href = '/';
      return false;
    };
  </script>
