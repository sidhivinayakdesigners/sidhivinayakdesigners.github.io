      body.lightbox-open #dcMobileBottomBar,
      body.gallery-modal-open .dc-mobile-bottom-bar,
      body.gallery-modal-open #dcMobileBottomBar,
      body.lightbox-open .floating-widgets,
      body.gallery-modal-open .floating-widgets,
      body.lightbox-open .navbar,
