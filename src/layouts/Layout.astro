<body>
  <!-- Google Tag Manager (noscript) if present -->
  {!isDev && (
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-ND5JCFH"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  )}
  
  <Header />
  
  <main>
    <slot />
  </main>
  
  <Footer />
  
  <!-- scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" is:inline></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js" is:inline></script>
  <script src="/assets/js/main.min.js?v=1009" is:inline></script>
  <script is:inline>
    AOS.init({
        duration: 800,
        once: true
    });

    // Global touch swipe handler for Bootstrap Carousels
    (function() {
      let touchStartX = 0;
      let touchStartY = 0;
      let touchEndX = 0;
      let touchEndY = 0;

      document.addEventListener('touchstart', function(e) {
        const carousel = e.target.closest('.carousel');
        if (!carousel) return;
        touchStartX = e.changedTouches[0].screenX;
        touchStartY = e.changedTouches[0].screenY;
      }, { passive: true });

      document.addEventListener('touchend', function(e) {
        const carousel = e.target.closest('.carousel');
        if (!carousel) return;
        touchEndX = e.changedTouches[0].screenX;
        touchEndY = e.changedTouches[0].screenY;
        handleSwipe(carousel);
      }, { passive: true });

      function handleSwipe(carousel) {
        const deltaX = touchEndX - touchStartX;
        const deltaY = touchEndY - touchStartY;
        
        // Threshold: horizontal distance > 40px, vertical displacement < 80px
        if (Math.abs(deltaX) > 40 && Math.abs(deltaY) < 80) {
          if (deltaX < 0) {
            // Swipe Left -> Show next photo
            const nextBtn = carousel.querySelector('.carousel-control-next');
            if (nextBtn) {
              nextBtn.click();
            }
          } else {
            // Swipe Right -> Show previous photo
            const prevBtn = carousel.querySelector('.carousel-control-prev');
            if (prevBtn) {
              prevBtn.click();
            }
          }
        }
      }
    })();

    // Global Lightbox handler for catalog pages
    (function() {
      let lightbox = document.getElementById('lightboxModal');
      let currentPhotos = [];
      let currentPhotoIndex = 0;
      let currentTitle = '';

      function initLightbox() {
        if (lightbox) return;
        
        lightbox = document.createElement('div');
        lightbox.className = 'lightbox-modal';
        lightbox.id = 'lightboxModal';
        lightbox.innerHTML = `
          <div class="lightbox-content">
            <span class="lightbox-close"><i class="fas fa-times"></i></span>
            <div class="lightbox-slider-container">
              <div class="lightbox-slider-track"></div>
            </div>
            <div class="lightbox-caption" id="lightboxCaption"></div>
          </div>
        `;
        document.body.appendChild(lightbox);
        
        const styleEl = document.createElement('style');
        styleEl.innerHTML = `
          .lightbox-modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: rgba(10, 10, 10, 0.98);
            z-index: 999999;
            display: none;
            align-items: center;
            justify-content: center;
          }
          .lightbox-content {
            position: relative;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
          }
          .lightbox-close {
            position: absolute;
            top: 20px;
            right: 20px;
            font-size: 2rem;
            color: #ffffff !important;
            cursor: pointer;
            z-index: 100000;
            width: 44px;
            height: 44px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
            transition: all 0.2s ease;
          }
          .lightbox-close:hover {
            background: rgba(255, 255, 255, 0.2);
            color: #189ba6 !important;
          }
          .lightbox-close i {
            color: #ffffff !important;
          }
          .lightbox-slider-container {
            width: 85vw;
            height: 80vh;
            overflow: hidden;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: flex-start;
          }
          .lightbox-slider-track {
            display: flex;
            height: 100%;
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            will-change: transform;
          }
          .lightbox-slide {
            width: 85vw;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
          }
          .lightbox-slide img {
            max-width: 90%;
            max-height: 80vh;
            object-fit: contain;
            border-radius: 4px;
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
          }
          .lightbox-caption {
            color: #ffffff !important;
            margin-top: 20px;
            font-size: 1.1rem;
            text-align: center;
            font-weight: 500;
            max-width: 80%;
          }
          .lightbox-prev, .lightbox-next {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(255, 255, 255, 0.1);
            border: none;
            color: #ffffff !important;
            font-size: 1.5rem;
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            border-radius: 50%;
            z-index: 100000;
            transition: all 0.2s ease;
          }
          .lightbox-prev:hover, .lightbox-next:hover {
            background: rgba(255, 255, 255, 0.2);
            color: #189ba6 !important;
          }
          .lightbox-prev i, .lightbox-next i {
            color: #ffffff !important;
          }
          .lightbox-prev { left: 20px; }
          .lightbox-next { right: 20px; }
          @media (max-width: 768px) {
            .lightbox-slider-container {
              width: 95vw;
            }
            .lightbox-slide {
              width: 95vw;
            }
            .lightbox-slide img {
              max-width: 95%;
            }
            .lightbox-prev, .lightbox-next {
              width: 40px;
              height: 40px;
              font-size: 1.2rem;
            }
            .lightbox-prev { left: 5px; }
            .lightbox-next { right: 5px; }
          }
        `;
        document.head.appendChild(styleEl);

        // Bind events
        lightbox.querySelector('.lightbox-close').addEventListener('click', closeGlobalLightbox);
        lightbox.addEventListener('click', (e) => {
          if (e.target === lightbox || e.target.classList.contains('lightbox-content') || e.target.classList.contains('lightbox-slide')) {
            closeGlobalLightbox();
          }
        });

        // Touch swipes for lightbox
        let lStartX = 0;
        let lStartY = 0;
        lightbox.addEventListener('touchstart', (e) => {
          lStartX = e.changedTouches[0].screenX;
          lStartY = e.changedTouches[0].screenY;
        }, { passive: true });
        
        lightbox.addEventListener('touchend', (e) => {
          const deltaX = e.changedTouches[0].screenX - lStartX;
          const deltaY = e.changedTouches[0].screenY - lStartY;
          
          if (Math.abs(deltaX) > 40 && Math.abs(deltaY) < 80) {
            if (deltaX < 0) {
              navigateLightbox(1);
            } else {
              navigateLightbox(-1);
            }
          }
        }, { passive: true });

        // Keyboard
        document.addEventListener('keydown', (e) => {
          if (lightbox.style.display === 'flex') {
            if (e.key === 'ArrowRight') {
              navigateLightbox(1);
            } else if (e.key === 'ArrowLeft') {
              navigateLightbox(-1);
            } else if (e.key === 'Escape') {
              closeGlobalLightbox();
            }
          }
        });
      }

      function renderLightbox() {
        if (!lightbox) return;
        const track = lightbox.querySelector('.lightbox-slider-track');
        const caption = lightbox.querySelector('#lightboxCaption');
        
        caption.textContent = currentTitle;
        track.innerHTML = '';
        
        const vwWidth = window.innerWidth <= 768 ? 95 : 85;
        track.style.width = `${currentPhotos.length * vwWidth}vw`;
        
        currentPhotos.forEach((src, idx) => {
          const slide = document.createElement('div');
          slide.className = 'lightbox-slide';
          slide.style.width = `${vwWidth}vw`;
          slide.innerHTML = `<img src="${src}" alt="Catalog View ${idx + 1}" />`;
          track.appendChild(slide);
        });
        
        const offset = -currentPhotoIndex * vwWidth;
        track.style.transform = `translate3d(${offset}vw, 0, 0)`;
        
        const prevBtn = lightbox.querySelector('.lightbox-prev');
        const nextBtn = lightbox.querySelector('.lightbox-next');
        if (prevBtn) prevBtn.style.display = currentPhotos.length > 1 ? 'flex' : 'none';
        if (nextBtn) nextBtn.style.display = currentPhotos.length > 1 ? 'flex' : 'none';
      }

      function navigateLightbox(direction) {
        if (currentPhotos.length <= 1) return;
        currentPhotoIndex = (currentPhotoIndex + direction + currentPhotos.length) % currentPhotos.length;
        renderLightbox();
      }

      function closeGlobalLightbox() {
        if (!lightbox) return;
        lightbox.style.display = 'none';
        document.body.style.overflow = '';
      }

      window.openLightbox = function(imgElement, event) {
        if (event) {
          event.stopPropagation();
          event.preventDefault();
        }
        
        initLightbox();

        const cardImgContainer = imgElement.closest('.dc-exact-card-img');
        if (!cardImgContainer) return;
        
        const title = cardImgContainer.getAttribute('data-lightbox-title') || '';
        const photosJson = cardImgContainer.getAttribute('data-lightbox-photos');
        if (!photosJson) return;
        
        try {
          currentPhotos = JSON.parse(photosJson);
        } catch(e) {
          console.error(e);
          return;
        }
        
        if (currentPhotos.length === 0) return;
        
        const currentSrc = imgElement.getAttribute('src');
        currentPhotoIndex = currentPhotos.indexOf(currentSrc);
        if (currentPhotoIndex === -1) {
          currentPhotoIndex = currentPhotos.findIndex(p => p.includes(currentSrc) || currentSrc.includes(p));
          if (currentPhotoIndex === -1) currentPhotoIndex = 0;
        }
        
        currentTitle = title;
        
        lightbox.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        
        // Add dynamic arrows if missing
        let prevBtn = lightbox.querySelector('.lightbox-prev');
        if (!prevBtn) {
          prevBtn = document.createElement('button');
          prevBtn.className = 'lightbox-prev';
          prevBtn.innerHTML = '<i class="fas fa-chevron-left"></i>';
          prevBtn.setAttribute('aria-label', 'Previous image');
          lightbox.querySelector('.lightbox-content').appendChild(prevBtn);
          prevBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            navigateLightbox(-1);
          });
        }
        
        let nextBtn = lightbox.querySelector('.lightbox-next');
        if (!nextBtn) {
          nextBtn = document.createElement('button');
          nextBtn.className = 'lightbox-next';
          nextBtn.innerHTML = '<i class="fas fa-chevron-right"></i>';
          nextBtn.setAttribute('aria-label', 'Next image');
          lightbox.querySelector('.lightbox-content').appendChild(nextBtn);
          nextBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            navigateLightbox(1);
          });
        }

        renderLightbox();
      };
    })();
  </script>
