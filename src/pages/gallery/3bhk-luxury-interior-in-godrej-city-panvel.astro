---
import Layout from '../../layouts/Layout.astro';

const title = "3BHK Luxury Interior in Godrej City Panvel | Siddhivinayak Designers";
const description = "Tour this premium 3BHK turnkey interior in Godrej City (Highlands / Woods), Panvel. Features walk-in wardrobe, Saint-Gobain ceilings, and Royale paint finish.";
const canonical = "https://siddhivinayakdesigners.in/gallery/3bhk-luxury-interior-in-godrej-city-panvel/";
---

<Layout title={title} description={description} canonical={canonical}>
  <div class="portfolio-detail-wrapper py-4" style="background-color: #f4f5f7 !important;">
    <div class="container">
      <!-- Breadcrumb Link -->
      <nav aria-label="breadcrumb" class="mb-4 d-none d-md-block">
        <ol class="breadcrumb mb-0 small">
          <li class="breadcrumb-item"><a href="/" class="text-danger text-decoration-none">Home</a></li>
          <li class="breadcrumb-item"><a href="/cities/interior-designers-navi-mumbai/panvel/" class="text-danger text-decoration-none">Interior Designer Panvel</a></li>
          <li class="breadcrumb-item active text-muted" aria-current="page">3BHK Godrej City Panvel</li>
        </ol>
      </nav>

      <!-- Premium Top Image Grid -->
      <div class="row g-2 mb-4 align-stretch">
        <!-- Left Large Image -->
        <div class="col-md-7">
          <div class="rounded-3 overflow-hidden position-relative h-100 project-hero-main-img" style="cursor: pointer;" onclick="openProjectLightbox()">
            <img src="/assets/images/delivered-projects/ghansoli-4bhk/1.webp" alt="Luxury Living Room with Track Spotlights" class="w-100 h-100 object-fit-cover" />
          </div>
        </div>
        <!-- Right 2x2 Small Images Grid -->
        <div class="col-md-5">
          <div class="row g-2">
            <div class="col-6">
              <div class="overflow-hidden rounded-2 project-hero-sub-img" style="cursor: pointer;" onclick="openProjectLightbox()">
                <img src="/assets/images/delivered-projects/ghansoli-4bhk/2.webp" alt="Master Bedroom Walk-in Wardrobe" class="w-100 h-100 object-fit-cover" />
              </div>
            </div>
            <div class="col-6">
              <div class="overflow-hidden rounded-2 project-hero-sub-img" style="cursor: pointer;" onclick="openProjectLightbox()">
                <img src="/assets/images/delivered-projects/ghansoli-4bhk/3.webp" alt="Parallel Kitchen with Island Breakfast Bar" class="w-100 h-100 object-fit-cover" />
              </div>
            </div>
            <div class="col-6">
              <div class="overflow-hidden rounded-2 project-hero-sub-img" style="cursor: pointer;" onclick="openProjectLightbox()">
                <img src="/assets/images/delivered-projects/ghansoli-4bhk/4.webp" alt="Guest Bedroom Mirrored Wardrobe" class="w-100 h-100 object-fit-cover" />
              </div>
            </div>
            <div class="col-6">
              <div class="overflow-hidden rounded-2 position-relative project-hero-sub-img" style="cursor: pointer;" onclick="openProjectLightbox()">
                <img src="/assets/images/delivered-projects/ghansoli-4bhk/5.webp" alt="Designer Entrance Foyer with Shoe Console" class="w-100 h-100 object-fit-cover" />
                <!-- See All Button overlay -->
                <div class="position-absolute bottom-0 end-0 m-3" style="z-index: 10;">
                  <button class="btn btn-light btn-sm px-4 rounded-pill fw-bold border-0" style="opacity: 0.9; box-shadow: 0 2px 8px rgba(0,0,0,0.15);" onclick="event.stopPropagation(); openProjectLightbox()">See All</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Columns Grid -->
      <div class="row g-4">
        <!-- Left Column: Specs, Highlights & FAQs -->
        <div class="col-lg-8">
          <!-- Main Description Card -->
          <div class="p-4 bg-white rounded-4 border border-light-subtle shadow-sm mb-4">
            <h1 class="fw-bold mb-2 text-dark" style="font-size: 2.2rem; font-family: 'Open Sans', sans-serif; letter-spacing: -0.5px;">3BHK Luxury Interior in Godrej City, Panvel</h1>
            <p class="text-secondary mb-3">Godrej City (Highlands / Woods)</p>
            
            <div class="d-flex flex-wrap gap-2 mb-4">
              <span class="badge-pill-light">Luxury Turnkey</span>
              <span class="badge-pill-light">Walk-in Wardrobe</span>
              <span class="badge-pill-light">Saint-Gobain Ceilings</span>
              <span class="badge-pill-light">Direct Factory</span>
            </div>
            
            <div class="d-flex justify-content-between align-items-center mb-4">
              <div class="d-flex align-items-center text-dark fw-semibold small">
                <i class="fas fa-map-marker-alt text-danger me-2 fs-5"></i> Thombrewadi, Shedung Panvel
              </div>
              <button class="btn btn-red-pill px-4 py-2 fw-bold text-white border-0" onclick="window.openConsultationPopup && window.openConsultationPopup(true)">
                GET STARTED
              </button>
            </div>
            
            <hr class="my-4" style="border-color: #e5e8eb;" />
            
            <div class="row g-3 text-start">
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">Pricing</span>
                <strong class="text-dark d-block">₹9.8 - 14.0 Lakhs</strong>
              </div>
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">BHK</span>
                <strong class="text-dark d-block">3-BHK</strong>
              </div>
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">Scope</span>
                <strong class="text-dark d-block" style="font-size: 0.9rem;">Full Turnkey, Saint-Gobain Ceilings, Walk-in Wardrobe</strong>
              </div>
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">Property Type</span>
                <strong class="text-dark d-block">Township Golf Residence</strong>
              </div>
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">Size</span>
                <strong class="text-dark d-block">1350 sq.ft</strong>
              </div>
            </div>
          </div>

          <!-- Project Details Accordion / Highlights -->
          <div class="p-4 bg-white rounded-4 border border-light-subtle shadow-sm mb-4">
            <h2 class="fw-bold h5 text-dark mb-4">Project Details</h2>
            
            <div class="mb-4">
              <h3 class="h6 fw-bold text-dark mb-2">Design Highlights</h3>
              <p class="text-secondary leading-relaxed small mb-0">
                Designed for a tranquil golf-course lifestyle in Godrej City, this 3BHK flat features soothing earthy tones, bronze tinted glass partitions, and a luxurious master walk-in wardrobe.
              </p>
            </div>
            
            <hr class="my-4" style="border-color: #e5e8eb;" />
            
            <div>
              <h3 class="h6 fw-bold text-dark mb-2">About the Home</h3>
              <p class="text-secondary leading-relaxed small mb-0">
                Turnkey execution included complete electrical restructuring, Dr. Fixit bathroom waterproofing, Saint-Gobain false ceiling framing with magnetic track spotlights, and Asian Paints Royale luxury emulsion on all walls.
              </p>
            </div>
          </div>

          <!-- FAQs Section -->
          <div class="p-4 bg-white rounded-4 border border-light-subtle shadow-sm mb-4">
            <h2 class="fw-bold h5 text-dark mb-4">Frequently Asked Questions</h2>
            
            <div class="accordion accordion-flush" id="projectFaqAccordion">
              <div class="accordion-item border-bottom py-2">
                <h3 class="accordion-header">
                  <button class="accordion-button collapsed px-0 bg-transparent text-dark fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                    Can I get a similar design for my Panvel flat?
                  </button>
                </h3>
                <div id="faq1" class="accordion-collapse collapse" data-bs-parent="#projectFaqAccordion">
                  <div class="accordion-body px-0 text-secondary small">
                    Yes! Our interior architects can tailor this exact design layout, material specification (100% IS:710 Marine Ply), and color palette to your flat's unique floor plan and budget.
                  </div>
                </div>
              </div>

              <div class="accordion-item border-bottom py-2">
                <h3 class="accordion-header">
                  <button class="accordion-button collapsed px-0 bg-transparent text-dark fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                    What is the typical timeline for executing this project in Panvel?
                  </button>
                </h3>
                <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#projectFaqAccordion">
                  <div class="accordion-body px-0 text-secondary small">
                    Standard execution takes 40 to 45 working days from 3D design sign-off and society permissions, backed by our on-time handover guarantee.
                  </div>
                </div>
              </div>

              <div class="accordion-item py-2">
                <h3 class="accordion-header">
                  <button class="accordion-button collapsed px-0 bg-transparent text-dark fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                    Is the BOQ price fixed or will there be mid-project cost escalations?
                  </button>
                </h3>
                <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#projectFaqAccordion">
                  <div class="accordion-body px-0 text-secondary small">
                    Our itemized Bill of Quantities (BOQ) is 100% locked. We calculate laser-accurate measurements and specify brand names upfront, ensuring zero surprise costs.
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: Sticky Form -->
        <div class="col-lg-4">
          <div class="p-4 bg-white rounded-4 border border-light-subtle shadow-sm sticky-top" style="top: 90px; z-index: 5;">
            <h3 class="fw-bold h5 text-dark mb-1">Get Similar Interiors</h3>
            <p class="text-secondary small mb-4">Book a free design consultation with 3D floor plan layout.</p>
            
            <form id="panvelLeadForm">
              <div class="mb-3">
                <label class="form-label small text-secondary">Your Name</label>
                <input type="text" class="form-control rounded-3" placeholder="Enter your full name" required />
              </div>
              <div class="mb-3">
                <label class="form-label small text-secondary">Phone Number</label>
                <div class="input-group">
                  <span class="input-group-text bg-light border-end-0 text-muted">+91</span>
                  <input type="tel" class="form-control rounded-end-3" placeholder="98765 43210" pattern="[0-9]{10}" required />
                </div>
              </div>
              <div class="mb-4">
                <label class="form-label small text-secondary">Township / Area</label>
                <input type="text" class="form-control rounded-3" value="Godrej City (Highlands / Woods)" />
              </div>
              <button type="submit" class="btn btn-red-pill w-100 py-2 fw-bold text-white border-0 mb-3" style="background-color: #189ba6 !important;">
                Book Free Consultation
              </button>
            </form>
            
            <div class="text-center pt-2">
              <a href="https://wa.me/918369297174?text=Hi%20Siddhivinayak%20Designers,%20I'm%20interested%20in%203BHK%20Luxury%20Interior%20in%20Godrej%20City%2C%20Panvel" target="_blank" class="text-decoration-none fw-bold small" style="color: #25D366;">
                <i class="fab fa-whatsapp me-1 fs-6"></i> Chat on WhatsApp Instantly
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Fullscreen Lightbox Modal -->
  <div id="projectLightbox" class="lightbox-modal">
    <span class="lightbox-close" onclick="closeProjectLightbox()">&times;</span>
    <div class="lightbox-content">
      <img id="lightboxImg" src="/assets/images/delivered-projects/ghansoli-4bhk/1.webp" alt="3BHK Luxury Interior in Godrej City, Panvel" />
      <div class="lightbox-caption" id="lightboxCaption">Luxury Living Room with Track Spotlights</div>
    </div>
    <a class="lightbox-prev" onclick="changeProjectSlide(-1)">&#10094;</a>
    <a class="lightbox-next" onclick="changeProjectSlide(1)">&#10095;</a>
  </div>
</Layout>

<style is:inline>
  .portfolio-detail-wrapper {
    min-height: 100vh;
    font-family: 'Open Sans', sans-serif;
  }
  .project-hero-main-img {
    height: 420px;
  }
  .project-hero-sub-img {
    height: 206px;
  }
  @media (max-width: 767px) {
    .project-hero-main-img {
      height: 260px;
    }
    .project-hero-sub-img {
      height: 130px;
    }
  }
  .badge-pill-light {
    background-color: #f1f3f5;
    color: #495057;
    padding: 6px 14px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 500;
  }
  .btn-red-pill {
    background-color: #e03131;
    border-radius: 50px;
    transition: all 0.2s ease;
  }
  .btn-red-pill:hover {
    background-color: #c92a2a;
    transform: translateY(-1px);
  }
  
  /* Lightbox Styles */
  .lightbox-modal {
    display: none;
    position: fixed;
    z-index: 9999;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.9);
    justify-content: center;
    align-items: center;
    flex-direction: column;
  }
  .lightbox-content {
    max-width: 90%;
    max-height: 80vh;
    text-align: center;
  }
  .lightbox-content img {
    max-width: 100%;
    max-height: 75vh;
    object-fit: contain;
    border-radius: 8px;
  }
  .lightbox-caption {
    color: #fff;
    font-size: 1rem;
    margin-top: 15px;
  }
  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 35px;
    color: #fff;
    font-size: 40px;
    font-weight: bold;
    cursor: pointer;
  }
  .lightbox-prev, .lightbox-next {
    cursor: pointer;
    position: absolute;
    top: 50%;
    padding: 16px;
    color: white;
    font-weight: bold;
    font-size: 24px;
    transition: 0.3s;
    user-select: none;
    text-decoration: none;
    background: rgba(0,0,0,0.4);
    border-radius: 50%;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox-prev { left: 20px; }
  .lightbox-next { right: 20px; }
  .lightbox-prev:hover, .lightbox-next:hover { background: rgba(0,0,0,0.8); }
</style>

<script is:inline>
  const projectGalleryImages = [{"src":"/assets/images/delivered-projects/ghansoli-4bhk/1.webp","alt":"Luxury Living Room with Track Spotlights"},{"src":"/assets/images/delivered-projects/ghansoli-4bhk/2.webp","alt":"Master Bedroom Walk-in Wardrobe"},{"src":"/assets/images/delivered-projects/ghansoli-4bhk/3.webp","alt":"Parallel Kitchen with Island Breakfast Bar"},{"src":"/assets/images/delivered-projects/ghansoli-4bhk/4.webp","alt":"Guest Bedroom Mirrored Wardrobe"},{"src":"/assets/images/delivered-projects/ghansoli-4bhk/5.webp","alt":"Designer Entrance Foyer with Shoe Console"}];
  let currentProjectSlideIndex = 0;

  function openProjectLightbox() {
    document.getElementById('projectLightbox').style.display = 'flex';
    showProjectSlide(currentProjectSlideIndex);
  }

  function closeProjectLightbox() {
    document.getElementById('projectLightbox').style.display = 'none';
  }

  function changeProjectSlide(n) {
    currentProjectSlideIndex += n;
    if (currentProjectSlideIndex >= projectGalleryImages.length) currentProjectSlideIndex = 0;
    if (currentProjectSlideIndex < 0) currentProjectSlideIndex = projectGalleryImages.length - 1;
    showProjectSlide(currentProjectSlideIndex);
  }

  function showProjectSlide(index) {
    const item = projectGalleryImages[index];
    if (item) {
      document.getElementById('lightboxImg').src = item.src;
      document.getElementById('lightboxCaption').innerText = item.alt;
    }
  }

  // Handle lead form submission
  document.getElementById('panvelLeadForm')?.addEventListener('submit', function(e) {
    e.preventDefault();
    alert('Thank you! Our Panvel interior design team will contact you shortly.');
  });
</script>
