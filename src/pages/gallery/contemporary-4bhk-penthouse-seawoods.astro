---
import Layout from '../../layouts/Layout.astro';

const title = "Contemporary 4 BHK Penthouse, Seawoods | Siddhivinayak Designers";
const description = "Explore the design portfolio of our Contemporary 4 BHK Penthouse project in Seawoods. Premium high-contrast living areas, customized carpentry, and lighting.";
const canonical = "https://siddhivinayakdesigners.in/gallery/contemporary-4bhk-penthouse-seawoods/";

const bodyContent = `
  <!-- Custom Immersive Gallery Page -->
  <div class="immersive-gallery-wrapper">
    <!-- Fixed Close Button -->
    <a href="/#glimpseSection" class="close-btn" aria-label="Close and return to homepage">
      <i class="fas fa-times"></i>
    </a>

    <div class="gallery-container">
      <!-- Title Header Block -->
      <div class="gallery-header text-center mb-5" data-aos="fade-down">
        <h1 class="font-luxury fw-bold mb-2" style="color: #111111 !important; font-size: clamp(2rem, 5vw, 3rem);">Contemporary 4 BHK Penthouse</h1>
        <p class="text-muted" style="font-size: 1.1rem;"><i class="fas fa-map-marker-alt text-gold me-2" style="color: #c5a880 !important;"></i> Seawoods Project Showcase</p>
        <div style="width: 60px; height: 3px; background-color: #c5a880; margin: 20px auto 0;"></div>
      </div>

      <!-- Rhythmic Grid Layout -->
      <div class="gallery-grid">
        <!-- Row 1: Side by side -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/contemporary-4bhk-penthouse-seawoods/img1.webp" alt="Contemporary 4 BHK Penthouse Seawoods - Elegant Living Room Entrance" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/contemporary-4bhk-penthouse-seawoods/img2.webp" alt="Contemporary 4 BHK Penthouse Seawoods - Cozy Living Lounge Seating" loading="lazy" />
        </div>

        <!-- Row 2: Full Width -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/contemporary-4bhk-penthouse-seawoods/img3.webp" alt="Contemporary 4 BHK Penthouse Seawoods - Custom TV Console Wall Design" loading="lazy" />
        </div>

        <!-- Row 3: Side by side -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/contemporary-4bhk-penthouse-seawoods/img4.webp" alt="Contemporary 4 BHK Penthouse Seawoods - False Ceiling Profile Lights" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/contemporary-4bhk-penthouse-seawoods/img5.webp" alt="Contemporary 4 BHK Penthouse Seawoods - Contemporary Dining Layout" loading="lazy" />
        </div>

        <!-- Row 4: Full Width -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/contemporary-4bhk-penthouse-seawoods/img6.webp" alt="Contemporary 4 BHK Penthouse Seawoods - Dining Area Cabinetry Setup" loading="lazy" />
        </div>

        <!-- Row 5: Side by side -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/contemporary-4bhk-penthouse-seawoods/img7.webp" alt="Contemporary 4 BHK Penthouse Seawoods - Master Bedroom Bed Backrest Wall" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/contemporary-4bhk-penthouse-seawoods/img8.webp" alt="Contemporary 4 BHK Penthouse Seawoods - Master Bedroom Wardrobe Setup" loading="lazy" />
        </div>

        <!-- Row 6: Full Width -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/contemporary-4bhk-penthouse-seawoods/img9.webp" alt="Contemporary 4 BHK Penthouse Seawoods - Kids Bedroom Vibrant Play Zone" loading="lazy" />
        </div>

        <!-- Row 7: Side by side -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/contemporary-4bhk-penthouse-seawoods/img10.webp" alt="Contemporary 4 BHK Penthouse Seawoods - Modern Kitchen Modular Cabinetry" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/contemporary-4bhk-penthouse-seawoods/img11.webp" alt="Contemporary 4 BHK Penthouse Seawoods - Kitchen Chimney Hub Layout" loading="lazy" />
        </div>

        <!-- Row 8: Full Width -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/contemporary-4bhk-penthouse-seawoods/img12.webp" alt="Contemporary 4 BHK Penthouse Seawoods - Traditional Pooja Room Wood Mandir" loading="lazy" />
        </div>

        <!-- Row 9: Side by side -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/contemporary-4bhk-penthouse-seawoods/img13.webp" alt="Contemporary 4 BHK Penthouse Seawoods - Balcony Outdoor Sitout Deck" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/contemporary-4bhk-penthouse-seawoods/img14.webp" alt="Contemporary 4 BHK Penthouse Seawoods - Bathroom Glass Partition Vanity" loading="lazy" />
        </div>
      </div>
    </div>
  </div>
`;
---

<Layout title={title} description={description} canonical={canonical}>
  <Fragment set:html={bodyContent} />
</Layout>

<style is:global>
  /* Immersive Gallery Styles */
  .immersive-gallery-wrapper {
    background-color: #ffffff !important;
    min-height: 100vh;
    width: 100%;
    position: relative;
    z-index: 10;
  }

  /* Force hide header, footer, and navigation bars on this full-screen layout */
  header, footer, nav, .header, .footer, .floating-widgets {
    display: none !important;
  }

  /* Reset layout spacing */
  body, main {
    background-color: #ffffff !important;
    padding-top: 0 !important;
    margin-top: 0 !important;
    overflow-x: hidden;
  }

  /* Circular close button */
  .close-btn {
    position: fixed;
    top: 24px;
    right: 24px;
    width: 48px;
    height: 48px;
    background-color: #111111;
    border-radius: 50%;
    color: #ffffff !important;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10050;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    border: none;
    text-decoration: none !important;
  }

  .close-btn:hover {
    background-color: #000000;
    transform: scale(1.08) rotate(90deg);
  }

  .close-btn i {
    font-size: 18px;
  }

  /* Grid Layout */
  .gallery-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 80px 24px;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .grid-item {
    position: relative;
    overflow: hidden;
    background: #fdfdfd;
    border-radius: 4px;
  }

  .grid-item img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    border-radius: 4px;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.05);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .grid-item img:hover {
    transform: scale(1.02);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
  }

  .span-2 {
    grid-column: span 2;
  }

  .span-1 {
    grid-column: span 1;
  }

  /* Mobile responsiveness */
  @media (max-width: 767px) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .grid-item img {
      aspect-ratio: 3 / 4 !important;
      object-fit: cover !important;
    }
    .span-2 {
      grid-column: span 1;
    }
    .gallery-container {
      padding: 60px 16px;
    }
    .close-btn {
      top: 16px;
      right: 16px;
      width: 40px;
      height: 40px;
    }
    .close-btn i {
      font-size: 16px;
    }
  }
</style>
