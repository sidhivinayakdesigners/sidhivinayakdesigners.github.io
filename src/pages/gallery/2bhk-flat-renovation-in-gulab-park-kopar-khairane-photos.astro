---
import Layout from '../../layouts/Layout.astro';

const title = "2BHK Flat Renovation in Gulab Park, Kopar Khairane | Photo Gallery | Siddhivinayak Designers";
const description = "Complete high-resolution photo portfolio of 2BHK flat renovation in Gulab Park, Sector 23 Kopar Khairane. Civil structural overhaul, modular woodwork, and false ceilings.";
const canonical = "https://siddhivinayakdesigners.in/gallery/2bhk-flat-renovation-in-gulab-park-kopar-khairane-photos/";

const bodyContent = `
  <!-- Custom Immersive Gallery Page -->
  <div class="immersive-gallery-wrapper">
    <!-- Fixed Close Button returning to Project Detail Page -->
    <a href="/gallery/2bhk-flat-renovation-in-gulab-park-kopar-khairane/" class="close-btn" aria-label="Close and return to project overview">
      <i class="fas fa-times"></i>
    </a>

    <div class="gallery-container">
      <!-- Title Header Block -->
      <div class="gallery-header text-center mb-5" data-aos="fade-down">
        <h1 class="font-luxury fw-bold mb-2" style="color: #111111 !important; font-size: clamp(2rem, 5vw, 3rem);">2BHK Flat Renovation in Gulab Park, Kopar Khairane</h1>
        <p class="text-muted" style="font-size: 1.1rem;"><i class="fas fa-map-marker-alt text-teal me-2" style="color: #189ba6 !important;"></i> Sector 23, Kopar Khairane Showcase</p>
        <div style="width: 60px; height: 3px; background-color: #189ba6; margin: 20px auto 0;"></div>
      </div>

      <!-- Rhythmic Grid Layout -->
      <div class="gallery-grid">
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/delivered-projects/nerul-3bhk-u-shaped/1.webp" alt="Gulab Park Kopar Khairane - Modernized Living Room Foyer" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/delivered-projects/nerul-3bhk-u-shaped/2.webp" alt="Gulab Park Kopar Khairane - Living Lounge with Profile False Ceiling" loading="lazy" />
        </div>
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/2bhk/modern-living-room-designers-for-2bhk-home-design.webp" alt="Gulab Park Kopar Khairane - TV Feature Unit & Fluted Wood Accents" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/delivered-projects/nerul-3bhk-u-shaped/3.webp" alt="Gulab Park Kopar Khairane - Waterproofed Modular Kitchen Cabinets" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/delivered-projects/nerul-3bhk-u-shaped/4.webp" alt="Gulab Park Kopar Khairane - Master Bedroom Sliding Wardrobe" loading="lazy" />
        </div>
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/2bhk/small-2bhk-kitchen-designed-with-built-in-microwave.webp" alt="Gulab Park Kopar Khairane - Built-in Microwave & Tall Appliance Unit" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/delivered-projects/nerul-3bhk-u-shaped/5.webp" alt="Gulab Park Kopar Khairane - Kids Bedroom Study Desk Setup" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/delivered-projects/nerul-3bhk-u-shaped/6.webp" alt="Gulab Park Kopar Khairane - Refurbished Bathroom Vanity & Tiling" loading="lazy" />
        </div>
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/2bhk/dining-room-interior-for-2bhk-home.webp" alt="Gulab Park Kopar Khairane - Compact Dining Corner with Wall Mirror" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/2bhk/home-design-2bhk-with-a-stunning-pooja-unit.webp" alt="Gulab Park Kopar Khairane - Wall Hanging Mandir with Jaali Doors" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/2bhk/master-bedroom-design-in-2bhk-home-apartment.webp" alt="Gulab Park Kopar Khairane - Master Bed Suite with Bedside Lighting" loading="lazy" />
        </div>
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/2bhk/balcony-design-images-in-2bhk-house.webp" alt="Gulab Park Kopar Khairane - Weatherproof Balcony Flooring & Greenery" loading="lazy" />
        </div>
      </div>

      <!-- Kopar Khairane Hub Backlink & CTA -->
      <div class="mt-5 p-4 rounded-4 text-center border" style="background: linear-gradient(135deg, #062639 0%, #0c4363 100%); color: #ffffff;">
        <h3 class="h4 font-luxury text-white mb-2" style="color: #ffffff !important; font-weight: 700; margin-bottom: 8px;">Want a Similar Interior Design in Kopar Khairane?</h3>
        <p class="small mb-3" style="color: #f8fafc !important; font-size: 0.95rem; opacity: 1 !important; line-height: 1.5;">Speak with our Kopar Khairane Sector 23 design team for custom 3D layouts, German CNC woodwork, and locked BOQ execution.</p>
        <div class="d-flex flex-wrap gap-2 justify-content-center">
          <a href="/gallery/2bhk-flat-renovation-in-gulab-park-kopar-khairane/" class="btn btn-primary btn-sm px-4 rounded-pill fw-bold" style="background-color: #189ba6; border-color: #189ba6;">View Project Specifications</a>
          <a href="/cities/interior-designers-navi-mumbai/kopar-khairane/" class="btn btn-outline-light btn-sm px-3 rounded-pill">Kopar Khairane Hub</a>
          <a href="https://wa.me/918369297174?text=Hi%20Siddhivinayak%20Designers,%20I%20saw%20your%202BHK%20Flat%20Renovation%20in%20Gulab%20Park%2C%20Kopar%20Khairane%20project%20and%20want%20a%20free%20quote" target="_blank" class="btn btn-outline-success btn-sm px-3 rounded-pill bg-success text-white border-0"><i class="fab fa-whatsapp me-1"></i> WhatsApp Instant Quote</a>
        </div>
      </div>
    </div>
  </div>
`;
---

<Layout title={title} description={description} canonical={canonical}>
  <Fragment set:html={bodyContent} />
</Layout>

<style is:global>

  /* White Card & Form Text Visibility */
  .portfolio-detail-wrapper .bg-white h1,
  .portfolio-detail-wrapper .bg-white h2,
  .portfolio-detail-wrapper .bg-white h3,
  .portfolio-detail-wrapper .bg-white h4,
  .portfolio-detail-wrapper .bg-white h5,
  .portfolio-detail-wrapper .bg-white strong {
    color: #111111 !important;
  }
  .portfolio-detail-wrapper .bg-white p,
  .portfolio-detail-wrapper .bg-white span,
  .portfolio-detail-wrapper .bg-white li,
  .portfolio-detail-wrapper .bg-white label {
    color: #475569 !important;
  }
  .portfolio-detail-wrapper .form-label {
    color: #334155 !important;
    font-weight: 600;
  }
  .portfolio-detail-wrapper .form-control,
  .portfolio-detail-wrapper .form-select {
    color: #111111 !important;
    background-color: #ffffff !important;
    border: 1px solid #cbd5e1 !important;
  }

  /* Only Dark CTA Banners get White Text */
  .portfolio-detail-wrapper [style*="linear-gradient"] h3,
  .immersive-gallery-wrapper [style*="linear-gradient"] h3 {
    color: #ffffff !important;
  }
  .portfolio-detail-wrapper [style*="linear-gradient"] p,
  .immersive-gallery-wrapper [style*="linear-gradient"] p {
    color: #f8fafc !important;
  }

  

  /* Immersive Gallery Styles */
  .immersive-gallery-wrapper {
    background-color: #ffffff !important;
    min-height: 100vh;
    width: 100%;
    position: relative;
    z-index: 10;
  }

  header, footer, nav, .header, .footer, .floating-widgets {
    display: none !important;
  }

  body, main {
    background-color: #ffffff !important;
    padding-top: 0 !important;
    margin-top: 0 !important;
    overflow-x: hidden;
  }

  .close-btn {
    position: fixed;
    top: 20px;
    right: 20px;
    width: 44px;
    height: 44px;
    background-color: #111111;
    border-radius: 50%;
    color: #ffffff !important;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10050;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    border: none;
    text-decoration: none !important;
  }

  .close-btn:hover {
    background-color: #000000;
    transform: scale(1.08) rotate(90deg);
  }

  .close-btn i {
    font-size: 16px;
  }

  .gallery-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 70px 20px 40px;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .grid-item {
    position: relative;
    overflow: hidden;
    background: #fdfdfd;
    border-radius: 6px;
  }

  .grid-item img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    border-radius: 6px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.05);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .grid-item img:hover {
    transform: scale(1.02);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
  }

  .span-2 {
    grid-column: span 2;
  }

  .span-1 {
    grid-column: span 1;
  }

  @media (max-width: 768px) {
    .gallery-container {
      padding: 50px 12px 24px !important;
    }
    .gallery-header {
      margin-bottom: 24px !important;
    }
    .gallery-header h1 {
      font-size: 1.35rem !important;
      line-height: 1.3 !important;
    }
    .gallery-header p {
      font-size: 0.85rem !important;
    }
    .gallery-grid {
      grid-template-columns: 1fr !important;
      gap: 12px !important;
    }
    .span-2, .span-1 {
      grid-column: span 1 !important;
    }
    .grid-item {
      border-radius: 8px !important;
    }
    .grid-item img {
      border-radius: 8px !important;
    }
    .close-btn {
      top: 12px !important;
      right: 12px !important;
      width: 36px !important;
      height: 36px !important;
    }
    .close-btn i {
      font-size: 13px !important;
    }
  }
</style>
