---
import Layout from '../../layouts/Layout.astro';

const title = "Premium 4 BHK at Ghansoli | Siddhivinayak Designers";
const description = "Explore the complete design portfolio of our Premium 4 BHK at Ghansoli. Intelligent space-saving solutions, custom modular kitchen, bespoke sliding wardrobes, and refined contemporary living room decor in Ghansoli.";
const canonical = "https://siddhivinayakdesigners.in/gallery/premium-4bhk-at-ghansoli/";

const bodyContent = `
  <!-- Custom Immersive Gallery Page -->
  <div class="immersive-gallery-wrapper">
    <!-- Fixed Close Button -->
    <button type="button" onclick="closeImmersiveGallery(event)" class="close-btn" aria-label="Close and return to previous page" style="color: #ffffff !important; -webkit-text-fill-color: #ffffff !important;">
      <i class="fas fa-times" style="color: #ffffff !important; -webkit-text-fill-color: #ffffff !important;"></i>
    </button>

    <div class="gallery-container">
      <!-- Title Header Block -->
      <div class="gallery-header text-center mb-5" data-aos="fade-down">
        <h1 class="font-luxury fw-bold mb-2" style="color: #111111 !important; font-size: clamp(2rem, 5vw, 3rem);">Premium 4 BHK</h1>
        <p class="text-muted" style="font-size: 1.1rem;"><i class="fas fa-map-marker-alt text-gold me-2" style="color: #c5a880 !important;"></i> Ghansoli Project Showcase</p>
        <div style="width: 60px; height: 3px; background-color: #c5a880; margin: 20px auto 0;"></div>
      </div>

      <!-- Rhythmic Grid Layout -->
      <div class="gallery-grid">
        <!-- Row 1: Side by side - Foyer -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img1.webp" alt="Premium 4 BHK Ghansoli - Grand Entrance Foyer & Backlit Screen" loading="eager" fetchpriority="high" width="1600" height="1067" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img2.webp" alt="Premium 4 BHK Ghansoli - Foyer Seating & Marble Panelling" loading="lazy" width="1600" height="1067" />
        </div>

        <!-- Row 2: Full Width - Living Room with Jhula -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img3.webp" alt="Premium 4 BHK Ghansoli - Grand Living Room with Luxury Indoor Swing" loading="lazy" width="1600" height="1067" />
        </div>

        <!-- Row 3: Side by side - Living Room Details (Portrait) -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img4.webp" alt="Premium 4 BHK Ghansoli - Living Room Sofa & Wall Art" loading="lazy" width="1600" height="2071" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img5.webp" alt="Premium 4 BHK Ghansoli - Living Room Lounge Seating" loading="lazy" width="1600" height="2071" />
        </div>

        <!-- Row 4: Side by side - Dining Area -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img7.webp" alt="Premium 4 BHK Ghansoli - Dining & Living View" loading="lazy" width="1600" height="1067" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img8.webp" alt="Premium 4 BHK Ghansoli - Italian Marble Dining Table" loading="lazy" width="1600" height="1067" />
        </div>

        <!-- Row 5: Full Width - Living Room Entertainment -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img9.webp" alt="Premium 4 BHK Ghansoli - TV Unit & Cove False Ceiling" loading="lazy" width="1600" height="1067" />
        </div>

        <!-- Row 6: Side by side - Dining Chandelier & Study Showcase (Portrait) -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img6.webp" alt="Premium 4 BHK Ghansoli - Dining Chandelier & Arched Panelling" loading="lazy" width="1600" height="2071" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img11.webp" alt="Premium 4 BHK Ghansoli - Home Office Display Cabinet" loading="lazy" width="1600" height="2071" />
        </div>

        <!-- Row 7: Side by side - Study Daybed & Master Bedroom Headboard -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img10.webp" alt="Premium 4 BHK Ghansoli - Home Office & Study Daybed" loading="lazy" width="1600" height="1067" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img12.webp" alt="Premium 4 BHK Ghansoli - Master Bedroom 3D Floral Headboard" loading="lazy" width="1600" height="1067" />
        </div>

        <!-- Row 8: Full Width - Master Bedroom Panoramic View -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img13.webp" alt="Premium 4 BHK Ghansoli - Master Bedroom Suite Panoramic View" loading="lazy" width="1600" height="1067" />
