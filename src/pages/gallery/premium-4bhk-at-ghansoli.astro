        <!-- Row 9: Side by side - Master Bed Details & Kids Bunk Bed -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img14.webp" alt="Premium 4 BHK Ghansoli - Master Bedroom King Bed & Fluted Trim" loading="lazy" width="1600" height="1067" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img15.webp" alt="Premium 4 BHK Ghansoli - Kids Bedroom Custom Bunk Bed with Storage" loading="lazy" width="1600" height="1067" />
        </div>

        <!-- Row 10: Side by side - Kids Wardrobe & Study Desk (Portrait) -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img16.webp" alt="Premium 4 BHK Ghansoli - Kids Arched Wardrobe with Pink Accents" loading="lazy" width="1600" height="2071" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img17.webp" alt="Premium 4 BHK Ghansoli - Kids Study Station & Storage Unit" loading="lazy" width="1600" height="2071" />
        </div>

        <!-- Row 11: Full Width - Kids Bedroom Overview -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img19.webp" alt="Premium 4 BHK Ghansoli - Kids Bedroom Complete Overview" loading="lazy" width="1600" height="1067" />
        </div>

        <!-- Row 12: Side by side - Kids Play & Guest Bedroom -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img18.webp" alt="Premium 4 BHK Ghansoli - Kids Bunk Bed Play Space" loading="lazy" width="1600" height="2265" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img20.webp" alt="Premium 4 BHK Ghansoli - Guest Bedroom Sage Green Moulding & Sconces" loading="lazy" width="1600" height="1067" />
        </div>

        <!-- Row 13: Side by side - Guest Bedroom Entertainment & Wardrobe -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img21.webp" alt="Premium 4 BHK Ghansoli - Guest Bedroom TV Wall & Wardrobe" loading="lazy" width="1600" height="1067" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/premium-4bhk-ghansoli/img22.webp" alt="Premium 4 BHK Ghansoli - Guest Bedroom Window View & Decor" loading="lazy" width="1600" height="1067" />
        </div>
      </div>
    </div>
  </div>
`;
---

<Layout title={title} description={description} canonical={canonical}>
  <Fragment set:html={bodyContent} />
</Layout>

<style is:global>
  /* White Card & Form Text Visibility */
  .portfolio-detail-wrapper .bg-white h1,
  .portfolio-detail-wrapper .bg-white h2,
  .portfolio-detail-wrapper .bg-white h3,
  .portfolio-detail-wrapper .bg-white h4,
  .portfolio-detail-wrapper .bg-white h5,
  .portfolio-detail-wrapper .bg-white strong {
    color: #111111 !important;
  }
  .portfolio-detail-wrapper .bg-white p,
  .portfolio-detail-wrapper .bg-white span,
  .portfolio-detail-wrapper .bg-white li,
  .portfolio-detail-wrapper .bg-white label {
    color: #475569 !important;
  }
  .portfolio-detail-wrapper .form-label {
    color: #334155 !important;
    font-weight: 600;
  }
  .portfolio-detail-wrapper .form-control,
  .portfolio-detail-wrapper .form-select {
    color: #111111 !important;
    background-color: #ffffff !important;
    border: 1px solid #cbd5e1 !important;
  }

  /* Only Dark CTA Banners get White Text */
  .portfolio-detail-wrapper [style*="linear-gradient"] h3,
  .immersive-gallery-wrapper [style*="linear-gradient"] h3 {
    color: #ffffff !important;
  }
  .portfolio-detail-wrapper [style*="linear-gradient"] p,
  .immersive-gallery-wrapper [style*="linear-gradient"] p {
    color: #f8fafc !important;
  }

  /* Immersive Gallery Styles */
  .immersive-gallery-wrapper {
    background-color: #ffffff !important;
    min-height: 100vh;
    width: 100%;
    position: relative;
    z-index: 10;
  }

  /* Force hide header, footer, and navigation bars on this full-screen layout */
  header, footer, nav, .header, .footer, .floating-widgets {
    display: none !important;
  }

  /* Reset layout spacing */
  body, main {
    background-color: #ffffff !important;
    padding-top: 0 !important;
    margin-top: 0 !important;
    overflow-x: hidden;
  }

  /* Circular close button */
  .close-btn {
    position: fixed;
    top: 24px;
    right: 24px;
    width: 48px;
    height: 48px;
    background-color: #111111;
    border-radius: 50%;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    z-index: 9999;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    border: none;
    cursor: pointer;
  }

  .close-btn:hover {
    background-color: #000000;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
    transform: scale(1.08) rotate(90deg);
  }

  .close-btn i {
    font-size: 18px;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
  }

  /* Grid Layout */
  .gallery-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 80px 24px;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  .grid-item {
    position: relative;
    overflow: hidden;
    background: #fdfdfd;
    border-radius: 4px;
  }

  .grid-item img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    border-radius: 4px;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.05);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .grid-item img:hover {
    transform: scale(1.02);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
  }

  .span-2 {
    grid-column: span 2;
  }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .grid-item img {
      aspect-ratio: 3 / 4 !important;
      object-fit: cover !important;
    }
    .span-2 {
      grid-column: span 1;
    }
    .gallery-container {
      padding: 60px 16px;
    }
    .close-btn {
      top: 16px;
      right: 16px;
      width: 40px;
      height: 40px;
      color: #ffffff !important;
      -webkit-text-fill-color: #ffffff !important;
    }
    .close-btn i {
      font-size: 16px;
      color: #ffffff !important;
      -webkit-text-fill-color: #ffffff !important;
    }
  }
</style>

<script is:inline>
  function closeImmersiveGallery(e) {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
    }
    if (document.referrer && document.referrer.indexOf(window.location.host) !== -1) {
      window.history.back();
    } else {
      window.location.href = '/completed-projects/';
    }
  }
</script>
