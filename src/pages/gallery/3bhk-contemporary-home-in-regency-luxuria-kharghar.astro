---
import Layout from '../../layouts/Layout.astro';

const title = "3BHK Contemporary Home in Regency Luxuria Kharghar | Siddhivinayak Designers";
const description = "See this 3BHK turnkey interior in Regency Luxuria, Sector 35 Kharghar. Features balcony wooden decking, 3 custom wardrobes, and smart partition screen.";
const canonical = "https://siddhivinayakdesigners.in/gallery/3bhk-contemporary-home-in-regency-luxuria-kharghar/";
---

<Layout title={title} description={description} canonical={canonical}>
  <div class="portfolio-detail-wrapper py-4" style="background-color: #f4f5f7 !important;">
    <div class="container">
      <!-- Breadcrumb Link -->
      <nav aria-label="breadcrumb" class="mb-4 d-none d-md-block">
        <ol class="breadcrumb mb-0 small">
          <li class="breadcrumb-item"><a href="/" class="text-danger text-decoration-none">Home</a></li>
          <li class="breadcrumb-item"><a href="/cities/interior-designers-navi-mumbai/kharghar/" class="text-danger text-decoration-none">Interior Designer Kharghar</a></li>
          <li class="breadcrumb-item active text-muted" aria-current="page">3BHK Regency Luxuria Kharghar</li>
        </ol>
      </nav>

      <!-- Premium Top Image Grid -->
      <div class="row g-2 mb-4 align-stretch">
        <!-- Left Large Image -->
        <div class="col-md-7">
          <div class="rounded-3 overflow-hidden position-relative h-100 project-hero-main-img" style="cursor: pointer;" onclick="openProjectLightbox()">
            <img src="/assets/images/delivered-projects/sanpada-4bhk/1.webp" alt="Spacious Contemporary Living Room in Regency Luxuria Kharghar" class="w-100 h-100 object-fit-cover" />
          </div>
        </div>
        <!-- Right 2x2 Small Images Grid -->
        <div class="col-md-5">
          <div class="row g-2">
            <div class="col-6">
              <div class="overflow-hidden rounded-2 project-hero-sub-img" style="cursor: pointer;" onclick="openProjectLightbox()">
                <img src="/assets/images/delivered-projects/sanpada-4bhk/2.webp" alt="Living-Dining Partition Screen" class="w-100 h-100 object-fit-cover" />
              </div>
            </div>
            <div class="col-6">
              <div class="overflow-hidden rounded-2 project-hero-sub-img" style="cursor: pointer;" onclick="openProjectLightbox()">
                <img src="/assets/images/delivered-projects/sanpada-4bhk/3.webp" alt="High-Rise Balcony WPC Wooden Deck" class="w-100 h-100 object-fit-cover" />
              </div>
            </div>
            <div class="col-6">
              <div class="overflow-hidden rounded-2 project-hero-sub-img" style="cursor: pointer;" onclick="openProjectLightbox()">
                <img src="/assets/images/delivered-projects/sanpada-4bhk/4.webp" alt="Master Bedroom Tinted Glass Sliding Wardrobe" class="w-100 h-100 object-fit-cover" />
              </div>
            </div>
            <div class="col-6">
              <div class="overflow-hidden rounded-2 position-relative project-hero-sub-img" style="cursor: pointer;" onclick="openProjectLightbox()">
                <img src="/assets/images/delivered-projects/sanpada-4bhk/5.webp" alt="L-Shaped Modular Kitchen with Pantry Pullout" class="w-100 h-100 object-fit-cover" />
                <!-- See All Button overlay -->
                <div class="position-absolute bottom-0 end-0 m-3" style="z-index: 10;">
                  <button class="btn btn-light btn-sm px-4 rounded-pill fw-bold border-0" style="opacity: 0.9; box-shadow: 0 2px 8px rgba(0,0,0,0.15);" onclick="event.stopPropagation(); openProjectLightbox()">See All</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Columns Grid -->
      <div class="row g-4">
        <!-- Left Column: Specs, Highlights & FAQs -->
        <div class="col-lg-8">
          <!-- Main Description Card -->
          <div class="p-4 bg-white rounded-4 border border-light-subtle shadow-sm mb-4">
            <h1 class="fw-bold mb-2 text-dark" style="font-size: 2.2rem; font-family: 'Open Sans', sans-serif; letter-spacing: -0.5px;">3BHK Contemporary Home in Regency Luxuria, Kharghar</h1>
            <p class="text-secondary mb-3">Regency Luxuria, Sector 35, Kharghar, Navi Mumbai</p>
            
            <div class="d-flex flex-wrap gap-2 mb-4">
              <span class="badge-pill-light">Contemporary Luxury</span>
              <span class="badge-pill-light">Balcony Deck</span>
              <span class="badge-pill-light">3 Wardrobes</span>
              <span class="badge-pill-light">Turnkey 45 Days</span>
            </div>
            
            <div class="d-flex justify-content-between align-items-center mb-4">
              <div class="d-flex align-items-center text-dark fw-semibold small">
                <i class="fas fa-map-marker-alt text-danger me-2 fs-5"></i> Sector 35, Kharghar (Near Golf Course)
              </div>
              <button class="btn btn-red-pill px-4 py-2 fw-bold text-white border-0" onclick="window.openConsultationPopup && window.openConsultationPopup(true)">
                GET STARTED
              </button>
            </div>
            
            <hr class="my-4" style="border-color: #e5e8eb;" />
            
            <div class="row g-3 text-start">
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">Pricing</span>
                <strong class="text-dark d-block">₹8.8 - 12.5 Lakhs</strong>
              </div>
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">BHK</span>
                <strong class="text-dark d-block">3-BHK</strong>
              </div>
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">Scope</span>
                <strong class="text-dark d-block" style="font-size: 0.9rem;">Living Partition, Balcony WPC Deck, 3 Custom Wardrobes</strong>
              </div>
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">Handover</span>
                <strong class="text-dark d-block">45 Days Locked</strong>
              </div>
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">Warranty</span>
                <strong class="text-dark d-block">10-Year Warranty</strong>
              </div>
            </div>
          </div>

          <!-- Project Story & Technical Overview -->
          <div class="p-4 bg-white rounded-4 border border-light-subtle shadow-sm mb-4">
            <h2 class="h4 fw-bold text-dark mb-3">Project Overview: Regency Luxuria, Kharghar</h2>
            <p class="text-secondary mb-3" style="line-height: 1.7;">
              In this high-rise 3BHK flat at <strong>Regency Luxuria, Sector 35 Kharghar</strong>, our design team balanced panoramic Kharghar hill views with functional luxury storage. The open living-dining layout is separated by an acoustic fluted jaali partition screen, preserving airflow while establishing dedicated zones.
            </p>
            <p class="text-secondary mb-4" style="line-height: 1.7;">
              The high-rise balcony features interlocking weather-proof WPC composite wooden tiles and vertical wall planters. All indoor modular components are constructed from <strong>CenturyPly BWP 710 Marine Plywood</strong> with German hardware.
            </p>
            
            <h3 class="h5 fw-bold text-dark mb-3">Key Features Delivered:</h3>
            <ul class="text-secondary mb-4 ps-3" style="line-height: 1.8;">
              <li><strong>Modular Kitchen:</strong> Premium acrylic two-tone finish with soft-close tandem boxes and a dedicated tall pantry unit.</li>
              <li><strong>Living &amp; Balcony:</strong> CNC fluted partition screen, floating TV wall, and rain-proof WPC balcony deck flooring.</li>
              <li><strong>3 Custom Bedrooms:</strong> Tinted glass sliding wardrobes, upholstered headboards, and full-height loft storage.</li>
              <li><strong>Concealed Lighting:</strong> Magnetic track spotlights and 3000K warm LED profile lighting in all false ceilings.</li>
            </ul>

            <!-- Client Review -->
            <div class="p-3 rounded-3" style="background-color: #f8fafc; border-left: 4px solid #189ba6;">
              <p class="fst-italic text-dark mb-2" style="font-size: 0.95rem;">
                "Our 3BHK in Regency Luxuria looks breathtaking. Siddhivinayak Designers delivered exactly what was promised in the 3D renders with zero budget surprises. Highly recommended for Kharghar flat owners!"
              </p>
              <div class="d-flex align-items-center">
                <strong class="text-dark small me-2">Vikram &amp; Deepa Mehta</strong>
                <span class="text-muted small">• Homeowners, Regency Luxuria, Sector 35 Kharghar</span>
              </div>
            </div>
          </div>

          <!-- Kharghar Link Ribbon -->
          <div class="p-3 bg-white rounded-4 border border-light-subtle shadow-sm mb-4 d-flex flex-wrap gap-2 justify-content-between align-items-center">
            <span class="text-dark fw-semibold small">Explore more Kharghar services:</span>
            <div class="d-flex gap-2">
              <a href="/cities/interior-designers-navi-mumbai/kharghar/" class="btn btn-outline-dark btn-sm rounded-pill">Kharghar Hub</a>
              <a href="/cities/interior-designers-navi-mumbai/kharghar/2bhk-3bhk-interiors/" class="btn btn-outline-dark btn-sm rounded-pill">2BHK &amp; 3BHK Packages</a>
              <a href="/cities/interior-designers-navi-mumbai/kharghar/modular-kitchen/" class="btn btn-outline-dark btn-sm rounded-pill">Modular Kitchens</a>
            </div>
          </div>
        </div>

        <!-- Right Column: Consultation Form -->
        <div class="col-lg-4">
          <div class="position-sticky" style="top: 90px;">
            <div class="p-4 bg-white rounded-4 border border-light-subtle shadow-sm mb-4">
              <h3 class="h5 fw-bold text-dark mb-2">Get a Quote for Your Kharghar Home</h3>
              <p class="small text-secondary mb-3">Book your free on-site measurement &amp; 3D layout consultation.</p>
              
              <form class="luxury-form" id="projectConsultForm" onsubmit="event.preventDefault(); window.location.href='https://wa.me/918369297174?text=Hi%20Siddhivinayak%20Designers,%20I%20saw%20your%20Regency%20Luxuria%20Kharghar%20project%20and%20want%20a%20free%20quote';">
                <div class="mb-3">
                  <label class="form-label small text-secondary">Your Name</label>
                  <input type="text" class="form-control rounded-3" placeholder="Enter your name" required />
                </div>
                <div class="mb-3">
                  <label class="form-label small text-secondary">Mobile Number</label>
                  <input type="tel" class="form-control rounded-3" placeholder="Enter 10-digit number" required />
                </div>
                <div class="mb-3">
                  <label class="form-label small text-secondary">Apartment / Society Name</label>
                  <input type="text" class="form-control rounded-3" value="Regency Luxuria, Kharghar" />
                </div>
                <div class="mb-3">
                  <label class="form-label small text-secondary">Configuration</label>
                  <select class="form-select rounded-3">
                    <option selected>3 BHK Flat</option>
                    <option>2 BHK Flat</option>
                    <option>4 BHK / Penthouse</option>
                    <option>Modular Kitchen Only</option>
                  </select>
                </div>
                <button type="submit" class="btn btn-dark w-100 py-2 rounded-3 fw-bold mb-2" style="background-color: #189ba6; border-color: #189ba6;">
                  Request Free 3D Layout &amp; Quote
                </button>
                <a href="https://wa.me/918369297174?text=Hi%20Siddhivinayak%20Designers,%20I'm%20interested%20in%20a%20similar%203BHK%20interior%20design%20for%20my%20Regency%20Luxuria%20Kharghar%20flat" target="_blank" class="btn btn-outline-success w-100 py-2 rounded-3 fw-bold">
                  <i class="fab fa-whatsapp me-1"></i> WhatsApp Instant Estimate
                </a>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Custom Fullscreen Lightbox Modal -->
  <div id="projectLightbox" class="position-fixed top-0 start-0 w-100 h-100 d-none justify-content-center align-items-center bg-dark bg-opacity-95" style="z-index: 10500; touch-action: none; overscroll-behavior: contain;">
    <button class="position-absolute top-0 end-0 m-4 btn btn-light rounded-circle border-0" onclick="closeProjectLightbox()" style="width: 45px; height: 45px; z-index: 10510;">
      <i class="fas fa-times"></i>
    </button>
    <div class="container text-center position-relative">
      <img id="projectLightboxImg" src="/assets/images/delivered-projects/sanpada-4bhk/1.webp" alt="Regency Luxuria Kharghar 3BHK Interior" class="img-fluid rounded-3" style="max-height: 85vh; object-fit: contain;" />
      <div class="d-flex justify-content-center gap-3 mt-3">
        <button class="btn btn-outline-light rounded-circle px-3 py-2" onclick="prevProjectPhoto()"><i class="fas fa-chevron-left"></i></button>
        <button class="btn btn-outline-light rounded-circle px-3 py-2" onclick="nextProjectPhoto()"><i class="fas fa-chevron-right"></i></button>
      </div>
    </div>
  </div>

  <script is:inline>
    const projectPhotos = [
      "/assets/images/delivered-projects/sanpada-4bhk/1.webp",
      "/assets/images/delivered-projects/sanpada-4bhk/2.webp",
      "/assets/images/delivered-projects/sanpada-4bhk/3.webp",
      "/assets/images/delivered-projects/sanpada-4bhk/4.webp",
      "/assets/images/delivered-projects/sanpada-4bhk/5.webp",
      "/assets/images/delivered-projects/sanpada-4bhk/6.webp",
      "/assets/images/delivered-projects/sanpada-4bhk/7.webp",
      "/assets/images/delivered-projects/sanpada-4bhk/8.webp",
      "/assets/images/delivered-projects/sanpada-4bhk/9.webp"
    ];
    let currentPhotoIdx = 0;
    const pLb = document.getElementById('projectLightbox');
    if (pLb) {
      pLb.addEventListener('wheel', (e) => { e.preventDefault(); e.stopPropagation(); }, { passive: false });
      pLb.addEventListener('touchmove', (e) => { if (e.cancelable) e.preventDefault(); }, { passive: false });
    }

    function openProjectLightbox() {
      const modal = document.getElementById('projectLightbox');
      if (modal) {
        modal.classList.remove('d-none');
        modal.classList.add('d-flex');
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
      }
    }

    function closeProjectLightbox() {
      const modal = document.getElementById('projectLightbox');
      if (modal) {
        modal.classList.add('d-none');
        modal.classList.remove('d-flex');
        document.documentElement.style.overflow = '';
        document.body.style.overflow = '';
      }
    }

    function nextProjectPhoto() {
      currentPhotoIdx = (currentPhotoIdx + 1) % projectPhotos.length;
      document.getElementById('projectLightboxImg').src = projectPhotos[currentPhotoIdx];
    }

    function prevProjectPhoto() {
      currentPhotoIdx = (currentPhotoIdx - 1 + projectPhotos.length) % projectPhotos.length;
      document.getElementById('projectLightboxImg').src = projectPhotos[currentPhotoIdx];
    }
  </script>
</Layout>
