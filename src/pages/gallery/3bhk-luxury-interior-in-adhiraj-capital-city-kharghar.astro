---
import Layout from '../../layouts/Layout.astro';

const title = "3BHK Luxury Interior in Adhiraj Capital City Kharghar | Siddhivinayak Designers";
const description = "Explore this 3BHK luxury turnkey apartment in Adhiraj Capital City, Sector 37 Kharghar. Features premium Saint-Gobain ceilings, walk-in wardrobe, and designer foyer.";
const canonical = "https://siddhivinayakdesigners.in/gallery/3bhk-luxury-interior-in-adhiraj-capital-city-kharghar/";
---

<Layout title={title} description={description} canonical={canonical}>
  <div class="portfolio-detail-wrapper py-4" style="background-color: #f4f5f7 !important;">
    <div class="container">
      <!-- Breadcrumb Link -->
      <nav aria-label="breadcrumb" class="mb-4 d-none d-md-block">
        <ol class="breadcrumb mb-0 small">
          <li class="breadcrumb-item"><a href="/" class="text-danger text-decoration-none">Home</a></li>
          <li class="breadcrumb-item"><a href="/cities/interior-designers-navi-mumbai/kharghar/" class="text-danger text-decoration-none">Interior Designer Kharghar</a></li>
          <li class="breadcrumb-item active text-muted" aria-current="page">3BHK Adhiraj Capital City Kharghar</li>
        </ol>
      </nav>

      <!-- Premium Top Image Grid -->
      <div class="row g-2 mb-4 align-stretch">
        <!-- Left Large Image -->
        <div class="col-md-7">
          <div class="rounded-3 overflow-hidden position-relative h-100 project-hero-main-img" style="cursor: pointer;" onclick="openProjectLightbox()">
            <img src="/assets/images/delivered-projects/ghansoli-4bhk-foyer/1.webp" alt="Grand Entrance Foyer & Living Area in Adhiraj Capital City Kharghar" class="w-100 h-100 object-fit-cover" />
          </div>
        </div>
        <!-- Right 2x2 Small Images Grid -->
        <div class="col-md-5">
          <div class="row g-2">
            <div class="col-6">
              <div class="overflow-hidden rounded-2 project-hero-sub-img" style="cursor: pointer;" onclick="openProjectLightbox()">
                <img src="/assets/images/delivered-projects/ghansoli-4bhk-foyer/2.webp" alt="Designer TV Unit with Marble & Gold Accents" class="w-100 h-100 object-fit-cover" />
              </div>
            </div>
            <div class="col-6">
              <div class="overflow-hidden rounded-2 project-hero-sub-img" style="cursor: pointer;" onclick="openProjectLightbox()">
                <img src="/assets/images/delivered-projects/ghansoli-4bhk-foyer/3.webp" alt="Custom Walk-in Wardrobe with LED Sensor Lighting" class="w-100 h-100 object-fit-cover" />
              </div>
            </div>
            <div class="col-6">
              <div class="overflow-hidden rounded-2 project-hero-sub-img" style="cursor: pointer;" onclick="openProjectLightbox()">
                <img src="/assets/images/delivered-projects/ghansoli-4bhk-foyer/4.webp" alt="Parallel Modular Kitchen with Island Counter" class="w-100 h-100 object-fit-cover" />
              </div>
            </div>
            <div class="col-6">
              <div class="overflow-hidden rounded-2 position-relative project-hero-sub-img" style="cursor: pointer;" onclick="openProjectLightbox()">
                <img src="/assets/images/delivered-projects/ghansoli-4bhk-foyer/5.webp" alt="Luxury Master Bedroom Suite" class="w-100 h-100 object-fit-cover" />
                <!-- See All Button overlay -->
                <div class="position-absolute bottom-0 end-0 m-3" style="z-index: 10;">
                  <button class="btn btn-light btn-sm px-4 rounded-pill fw-bold border-0" style="opacity: 0.9; box-shadow: 0 2px 8px rgba(0,0,0,0.15);" onclick="event.stopPropagation(); openProjectLightbox()">See All</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Columns Grid -->
      <div class="row g-4">
        <!-- Left Column: Specs, Highlights & FAQs -->
        <div class="col-lg-8">
          <!-- Main Description Card -->
          <div class="p-4 bg-white rounded-4 border border-light-subtle shadow-sm mb-4">
            <h1 class="fw-bold mb-2 text-dark" style="font-size: 2.2rem; font-family: 'Open Sans', sans-serif; letter-spacing: -0.5px;">3BHK Luxury Interior in Adhiraj Capital City, Kharghar</h1>
            <p class="text-secondary mb-3">Adhiraj Capital City, Sector 37, Kharghar, Navi Mumbai</p>
            
            <div class="d-flex flex-wrap gap-2 mb-4">
              <span class="badge-pill-light">Luxury High-Rise</span>
              <span class="badge-pill-light">Walk-in Wardrobe</span>
              <span class="badge-pill-light">Saint-Gobain Ceilings</span>
              <span class="badge-pill-light">Turnkey Execution</span>
            </div>
            
            <div class="d-flex justify-content-between align-items-center mb-4">
              <div class="d-flex align-items-center text-dark fw-semibold small">
                <i class="fas fa-map-marker-alt text-danger me-2 fs-5"></i> Sector 37, Kharghar (Near BKC-II Hub)
              </div>
              <button class="btn btn-red-pill px-4 py-2 fw-bold text-white border-0" onclick="window.openConsultationPopup && window.openConsultationPopup(true)">
                GET STARTED
              </button>
            </div>
            
            <hr class="my-4" style="border-color: #e5e8eb;" />
            
            <div class="row g-3 text-start">
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">Pricing</span>
                <strong class="text-dark d-block">₹9.8 - 14.0 Lakhs</strong>
              </div>
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">BHK</span>
                <strong class="text-dark d-block">3-BHK</strong>
              </div>
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">Scope</span>
                <strong class="text-dark d-block" style="font-size: 0.9rem;">Full Turnkey, Saint-Gobain Ceilings, Walk-in Wardrobe</strong>
              </div>
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">Handover</span>
                <strong class="text-dark d-block">45 Days Locked</strong>
              </div>
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">Warranty</span>
                <strong class="text-dark d-block">10-Year Warranty</strong>
              </div>
            </div>
          </div>

          <!-- Project Story & Technical Overview -->
          <div class="p-4 bg-white rounded-4 border border-light-subtle shadow-sm mb-4">
            <h2 class="h4 fw-bold text-dark mb-3">Turnkey Highlights: Adhiraj Capital City, Kharghar</h2>
            <p class="text-secondary mb-3" style="line-height: 1.7;">
              Designed for a high-profile executive family in <strong>Adhiraj Capital City, Sector 37 Kharghar</strong>, this 3BHK flat embraces contemporary European minimalism. The layout emphasizes an expansive living area with seamless marble-textured TV panelling, ambient cove lighting, and a private master bedroom suite with a glass-enclosed walk-in closet.
            </p>
            <p class="text-secondary mb-4" style="line-height: 1.7;">
              Manufactured with <strong>CenturyPly IS:710 Marine Grade Plywood</strong> and finished with anti-fingerprint acrylic laminates, the entire carpentry guarantees termite, borer, and water resistance for over a decade.
            </p>
            
            <h3 class="h5 fw-bold text-dark mb-3">Key Inclusions Delivered:</h3>
            <ul class="text-secondary mb-4 ps-3" style="line-height: 1.8;">
              <li><strong>Kitchen &amp; Island:</strong> Quartz stone counter, Blum Aventos lift-up mechanisms, and Hafele magic corner baskets.</li>
              <li><strong>Master Suite &amp; Wardrobe:</strong> Tinted fluted glass walk-in wardrobe with automatic sensor LED illumination.</li>
              <li><strong>Living &amp; Foyer:</strong> Grand entryway console, CNC brass inlay wall paneling, and Italian marble TV backdrop.</li>
              <li><strong>Ceilings:</strong> Saint-Gobain Gyproc ceilings with magnetic track lighting and ambient perimeter coving.</li>
            </ul>

            <!-- Client Review -->
            <div class="p-3 rounded-3" style="background-color: #f8fafc; border-left: 4px solid #189ba6;">
              <p class="fst-italic text-dark mb-2" style="font-size: 0.95rem;">
                "Siddhivinayak Designers gave our 3BHK flat in Adhiraj Capital City a truly luxurious hotel-suite look. Their project management, transparent BOQ, and timely delivery are second to none in Navi Mumbai!"
              </p>
              <div class="d-flex align-items-center">
                <strong class="text-dark small me-2">Manish &amp; Ritu Agarwal</strong>
                <span class="text-muted small">• Homeowners, Adhiraj Capital City, Sector 37 Kharghar</span>
              </div>
            </div>
          </div>

          <!-- Kharghar Link Ribbon -->
          <div class="p-3 bg-white rounded-4 border border-light-subtle shadow-sm mb-4 d-flex flex-wrap gap-2 justify-content-between align-items-center">
            <span class="text-dark fw-semibold small">Explore more Kharghar services:</span>
            <div class="d-flex gap-2">
              <a href="/cities/interior-designers-navi-mumbai/kharghar/" class="btn btn-outline-dark btn-sm rounded-pill">Kharghar Hub</a>
              <a href="/cities/interior-designers-navi-mumbai/kharghar/2bhk-3bhk-interiors/" class="btn btn-outline-dark btn-sm rounded-pill">2BHK &amp; 3BHK Packages</a>
              <a href="/cities/interior-designers-navi-mumbai/kharghar/modular-kitchen/" class="btn btn-outline-dark btn-sm rounded-pill">Modular Kitchens</a>
            </div>
          </div>
        </div>

        <!-- Right Column: Consultation Form -->
        <div class="col-lg-4">
          <div class="position-sticky" style="top: 90px;">
            <div class="p-4 bg-white rounded-4 border border-light-subtle shadow-sm mb-4">
              <h3 class="h5 fw-bold text-dark mb-2">Get a Quote for Your Kharghar Home</h3>
              <p class="small text-secondary mb-3">Book your free 3D design and itemized BOQ estimation.</p>
              
              <form class="luxury-form" id="projectConsultForm" onsubmit="event.preventDefault(); window.location.href='https://wa.me/918369297174?text=Hi%20Siddhivinayak%20Designers,%20I%20saw%20your%20Adhiraj%20Capital%20City%20Kharghar%20project%20and%20want%20a%20free%20quote';">
                <div class="mb-3">
                  <label class="form-label small text-secondary">Your Name</label>
                  <input type="text" class="form-control rounded-3" placeholder="Enter your name" required />
                </div>
                <div class="mb-3">
                  <label class="form-label small text-secondary">Mobile Number</label>
                  <input type="tel" class="form-control rounded-3" placeholder="Enter 10-digit number" required />
                </div>
                <div class="mb-3">
                  <label class="form-label small text-secondary">Apartment / Society Name</label>
                  <input type="text" class="form-control rounded-3" value="Adhiraj Capital City, Kharghar" />
                </div>
                <div class="mb-3">
                  <label class="form-label small text-secondary">Configuration</label>
                  <select class="form-select rounded-3">
                    <option selected>3 BHK Flat</option>
                    <option>2 BHK Flat</option>
                    <option>4 BHK / Penthouse</option>
                    <option>Modular Kitchen Only</option>
                  </select>
                </div>
                <button type="submit" class="btn btn-dark w-100 py-2 rounded-3 fw-bold mb-2" style="background-color: #189ba6; border-color: #189ba6;">
                  Request Free 3D Layout &amp; Quote
                </button>
                <a href="https://wa.me/918369297174?text=Hi%20Siddhivinayak%20Designers,%20I'm%20interested%20in%20a%20similar%203BHK%20interior%20design%20for%20my%20Adhiraj%20Capital%20City%20Kharghar%20flat" target="_blank" class="btn btn-outline-success w-100 py-2 rounded-3 fw-bold">
                  <i class="fab fa-whatsapp me-1"></i> WhatsApp Instant Estimate
                </a>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Custom Fullscreen Lightbox Modal -->
  <div id="projectLightbox" class="position-fixed top-0 start-0 w-100 h-100 d-none justify-content-center align-items-center bg-dark bg-opacity-95" style="z-index: 10500;">
    <button class="position-absolute top-0 end-0 m-4 btn btn-light rounded-circle border-0" onclick="closeProjectLightbox()" style="width: 45px; height: 45px; z-index: 10510;">
      <i class="fas fa-times"></i>
    </button>
    <div class="container text-center position-relative">
      <img id="projectLightboxImg" src="/assets/images/delivered-projects/ghansoli-4bhk-foyer/1.webp" alt="Adhiraj Capital City Kharghar 3BHK Interior" class="img-fluid rounded-3" style="max-height: 85vh; object-fit: contain;" />
      <div class="d-flex justify-content-center gap-3 mt-3">
        <button class="btn btn-outline-light rounded-circle px-3 py-2" onclick="prevProjectPhoto()"><i class="fas fa-chevron-left"></i></button>
        <button class="btn btn-outline-light rounded-circle px-3 py-2" onclick="nextProjectPhoto()"><i class="fas fa-chevron-right"></i></button>
      </div>
    </div>
  </div>

  <script is:inline>
    const projectPhotos = [
      "/assets/images/delivered-projects/ghansoli-4bhk-foyer/1.webp",
      "/assets/images/delivered-projects/ghansoli-4bhk-foyer/2.webp",
      "/assets/images/delivered-projects/ghansoli-4bhk-foyer/3.webp",
      "/assets/images/delivered-projects/ghansoli-4bhk-foyer/4.webp",
      "/assets/images/delivered-projects/ghansoli-4bhk-foyer/5.webp",
      "/assets/images/delivered-projects/ghansoli-4bhk-foyer/6.webp",
      "/assets/images/delivered-projects/ghansoli-4bhk-foyer/7.webp",
      "/assets/images/delivered-projects/ghansoli-4bhk-foyer/8.webp",
      "/assets/images/delivered-projects/ghansoli-4bhk-foyer/9.webp",
      "/assets/images/delivered-projects/ghansoli-4bhk-foyer/10.webp"
    ];
    let currentPhotoIdx = 0;

    function openProjectLightbox() {
      const modal = document.getElementById('projectLightbox');
      if (modal) modal.classList.remove('d-none'), modal.classList.add('d-flex');
    }

    function closeProjectLightbox() {
      const modal = document.getElementById('projectLightbox');
      if (modal) modal.classList.add('d-none'), modal.classList.remove('d-flex');
    }

    function nextProjectPhoto() {
      currentPhotoIdx = (currentPhotoIdx + 1) % projectPhotos.length;
      document.getElementById('projectLightboxImg').src = projectPhotos[currentPhotoIdx];
    }

    function prevProjectPhoto() {
      currentPhotoIdx = (currentPhotoIdx - 1 + projectPhotos.length) % projectPhotos.length;
      document.getElementById('projectLightboxImg').src = projectPhotos[currentPhotoIdx];
    }
  </script>
</Layout>
