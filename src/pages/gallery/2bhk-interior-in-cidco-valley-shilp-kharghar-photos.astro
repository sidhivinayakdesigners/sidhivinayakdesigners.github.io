---
import Layout from '../../layouts/Layout.astro';

const title = "2BHK Interior in CIDCO Valley Shilp, Kharghar | Photo Gallery | Siddhivinayak Designers";
const description = "Complete high-resolution photo portfolio of 2BHK flat in CIDCO Valley Shilp, Sector 36 Kharghar. L-shape acrylic kitchen, study nook, and fluted TV feature wall.";
const canonical = "https://siddhivinayakdesigners.in/gallery/2bhk-interior-in-cidco-valley-shilp-kharghar-photos/";

const bodyContent = `
  <!-- Custom Immersive Gallery Page -->
  <div class="immersive-gallery-wrapper">
    <!-- Fixed Close Button returning to Project Detail Page -->
    <button type="button" onclick="closeImmersiveGallery(event)" class="close-btn" aria-label="Close and return to project overview">
      <i class="fas fa-times"></i>
    </button>

    <div class="gallery-container">
      <!-- Title Header Block -->
      <div class="gallery-header text-center mb-5" data-aos="fade-down">
        <h1 class="font-luxury fw-bold mb-2" style="color: #111111 !important; font-size: clamp(2rem, 5vw, 3rem);">2BHK Interior in CIDCO Valley Shilp</h1>
        <p class="text-muted" style="font-size: 1.1rem;"><i class="fas fa-map-marker-alt text-teal me-2" style="color: #189ba6 !important;"></i> Sector 36, Kharghar Project Showcase</p>
        <div style="width: 60px; height: 3px; background-color: #189ba6; margin: 20px auto 0;"></div>
      </div>

      <!-- Rhythmic Grid Layout -->
      <div class="gallery-grid">
        <!-- Row 1: Side by side -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/delivered-projects/belapur-2bhk-parallel/1.webp" alt="CIDCO Valley Shilp Kharghar - Modern L-Shaped Kitchen Entrance" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/delivered-projects/belapur-2bhk-parallel/2.webp" alt="CIDCO Valley Shilp Kharghar - Fluted Accent TV Wall Paneling" loading="lazy" />
        </div>

        <!-- Row 2: Full Width -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/delivered-projects/belapur-2bhk-parallel/3.webp" alt="CIDCO Valley Shilp Kharghar - Master Bedroom Sliding Wardrobe with Mirror Panel" loading="lazy" />
        </div>

        <!-- Row 3: Side by side -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/delivered-projects/belapur-2bhk-parallel/4.webp" alt="CIDCO Valley Shilp Kharghar - Compact Work Desk and Book Showcase" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/delivered-projects/belapur-2bhk-parallel/5.webp" alt="CIDCO Valley Shilp Kharghar - Warm Cove Lighting Living Area" loading="lazy" />
        </div>

        <!-- Row 4: Full Width -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/delivered-projects/belapur-2bhk-parallel/6.webp" alt="CIDCO Valley Shilp Kharghar - High-Gloss Acrylic Cabinetry & Breakfast Counter" loading="lazy" />
        </div>

        <!-- Row 5: Side by side -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/delivered-projects/belapur-2bhk-parallel/7.webp" alt="CIDCO Valley Shilp Kharghar - Compact Dining Set with Geometric Lighting" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/delivered-projects/belapur-2bhk-parallel/8.webp" alt="CIDCO Valley Shilp Kharghar - Bedroom Dressing Unit with Concealed Drawers" loading="lazy" />
        </div>

        <!-- Row 6: Full Width -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/delivered-projects/belapur-2bhk-parallel/9.webp" alt="CIDCO Valley Shilp Kharghar - False Ceiling with Ambient Backlit LED Profile" loading="lazy" />
        </div>

        <!-- Row 7: Side by side -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/delivered-projects/belapur-2bhk-parallel/10.webp" alt="CIDCO Valley Shilp Kharghar - Bathroom Vanity with Quartz Countertop" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/3bhk/pooja-room-in-a-3bhk-interior-design-with-a-wood-accent-wall-cladding-and-two-hanging-lamps.webp" alt="CIDCO Valley Shilp Kharghar - Custom Teak Finish Mandir" loading="lazy" />
        </div>
      </div>

      <!-- Kharghar Hub Backlink & CTA -->
      <div class="mt-5 p-4 rounded-4 text-center border" style="background: linear-gradient(135deg, #062639 0%, #0c4363 100%); color: #ffffff;">
        <h3 class="h4 font-luxury text-white mb-2" style="color: #ffffff !important; font-weight: 700; margin-bottom: 8px;">Want a Similar 2BHK Interior in CIDCO Valley Shilp Kharghar?</h3>
        <p class="small mb-3" style="color: #f8fafc !important; font-size: 0.95rem; opacity: 1 !important; line-height: 1.5;">Speak with our Kharghar design team for custom 3D layouts, German CNC woodwork, and locked BOQ execution.</p>
        <div class="d-flex flex-wrap gap-2 justify-content-center">
          <a href="/gallery/2bhk-interior-in-cidco-valley-shilp-kharghar/" class="btn btn-primary btn-sm px-4 rounded-pill fw-bold" style="background-color: #189ba6; border-color: #189ba6;">View Project Specifications</a>
          <a href="/cities/interior-designers-navi-mumbai/kharghar/" class="btn btn-outline-light btn-sm px-3 rounded-pill">Kharghar Hub</a>
          <a href="https://wa.me/918369297174?text=Hi%20Siddhivinayak%20Designers,%20I%20saw%20your%20CIDCO%20Valley%20Shilp%20Kharghar%202BHK%20project%20and%20want%20a%20free%20quote" target="_blank" class="btn btn-outline-success btn-sm px-3 rounded-pill bg-success text-white border-0"><i class="fab fa-whatsapp me-1"></i> WhatsApp Instant Quote</a>
        </div>
      </div>
    </div>
  </div>
`;
---

<Layout title={title} description={description} canonical={canonical}>
  <Fragment set:html={bodyContent} />
</Layout>

<style is:global>

  /* White Card & Form Text Visibility */
  .portfolio-detail-wrapper .bg-white h1,
  .portfolio-detail-wrapper .bg-white h2,
  .portfolio-detail-wrapper .bg-white h3,
  .portfolio-detail-wrapper .bg-white h4,
  .portfolio-detail-wrapper .bg-white h5,
  .portfolio-detail-wrapper .bg-white strong {
    color: #111111 !important;
  }
  .portfolio-detail-wrapper .bg-white p,
  .portfolio-detail-wrapper .bg-white span,
  .portfolio-detail-wrapper .bg-white li,
  .portfolio-detail-wrapper .bg-white label {
    color: #475569 !important;
  }
  .portfolio-detail-wrapper .form-label {
    color: #334155 !important;
    font-weight: 600;
  }
  .portfolio-detail-wrapper .form-control,
  .portfolio-detail-wrapper .form-select {
    color: #111111 !important;
    background-color: #ffffff !important;
    border: 1px solid #cbd5e1 !important;
  }

  /* Only Dark CTA Banners get White Text */
  .portfolio-detail-wrapper [style*="linear-gradient"] h3,
  .immersive-gallery-wrapper [style*="linear-gradient"] h3 {
    color: #ffffff !important;
  }
  .portfolio-detail-wrapper [style*="linear-gradient"] p,
  .immersive-gallery-wrapper [style*="linear-gradient"] p {
    color: #f8fafc !important;
  }

  

  /* Immersive Gallery Styles */
  .immersive-gallery-wrapper {
    background-color: #ffffff !important;
    min-height: 100vh;
    width: 100%;
    position: relative;
    z-index: 10;
  }

  /* Force hide header, footer, and navigation bars on this full-screen layout */
  header, footer, nav, .header, .footer, .floating-widgets {
    display: none !important;
  }

  /* Reset layout spacing */
  body, main {
    background-color: #ffffff !important;
    padding-top: 0 !important;
    margin-top: 0 !important;
    overflow-x: hidden;
  }

  /* Circular close button */
  .close-btn {
    position: fixed;
    top: 24px;
    right: 24px;
    width: 48px;
    height: 48px;
    background-color: #111111;
    border-radius: 50%;
    color: #ffffff !important;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10050;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    border: none;
    outline: none;
    text-decoration: none !important;
  }

  .close-btn:hover {
    background-color: #000000;
    transform: scale(1.08) rotate(90deg);
  }

  .close-btn i {
    font-size: 18px;
  }

  /* Grid Layout */
  .gallery-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 80px 24px;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .grid-item {
    position: relative;
    overflow: hidden;
    background: #fdfdfd;
    border-radius: 4px;
  }

  .grid-item img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    border-radius: 4px;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.05);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .grid-item img:hover {
    transform: scale(1.02);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
  }

  .span-2 {
    grid-column: span 2;
  }

  .span-1 {
    grid-column: span 1;
  }

  /* Mobile responsiveness */
  @media (max-width: 767px) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .grid-item img {
      aspect-ratio: 3 / 4 !important;
      object-fit: cover !important;
    }
    .span-2 {
      grid-column: span 1;
    }
    .gallery-container {
      padding: 60px 16px;
    }
    .close-btn {
      top: 16px;
      right: 16px;
      width: 40px;
      height: 40px;
    }
    .close-btn i {
      font-size: 16px;
    }
  }
</style>
