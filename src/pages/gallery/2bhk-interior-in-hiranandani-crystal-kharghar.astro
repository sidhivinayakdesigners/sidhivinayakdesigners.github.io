---
import Layout from '../../layouts/Layout.astro';

const title = "2BHK Modern Interior in Hiranandani Crystal Kharghar | Siddhivinayak Designers";
const description = "Tour this elegant 2BHK flat interior in Hiranandani Crystal & Heritage, Sector 7 Kharghar. Features space-saving lofts, BWP marine ply kitchen, and gypsum cove lighting.";
const canonical = "https://siddhivinayakdesigners.in/gallery/2bhk-interior-in-hiranandani-crystal-kharghar/";
---

<Layout title={title} description={description} canonical={canonical}>
  <div class="portfolio-detail-wrapper py-4" style="background-color: #f4f5f7 !important;">
    <div class="container">
      <!-- Breadcrumb Link -->
      <nav aria-label="breadcrumb" class="mb-4 d-none d-md-block">
        <ol class="breadcrumb mb-0 small">
          <li class="breadcrumb-item"><a href="/" class="text-danger text-decoration-none">Home</a></li>
          <li class="breadcrumb-item"><a href="/cities/interior-designers-navi-mumbai/kharghar/" class="text-danger text-decoration-none">Interior Designer Kharghar</a></li>
          <li class="breadcrumb-item active text-muted" aria-current="page">2BHK Hiranandani Crystal Kharghar</li>
        </ol>
      </nav>

      <!-- Premium Top Image Grid -->
      <div class="row g-2 mb-4 align-stretch">
        <!-- Left Large Image -->
        <div class="col-md-7">
          <div class="rounded-3 overflow-hidden position-relative h-100 project-hero-main-img" style="cursor: pointer;" onclick="openProjectLightbox()">
            <img src="/assets/images/delivered-projects/seawoods-2bhk/1.webp" alt="Modern Living Room with Cove Lighting in Hiranandani Crystal Kharghar" class="w-100 h-100 object-fit-cover" />
          </div>
        </div>
        <!-- Right 2x2 Small Images Grid -->
        <div class="col-md-5">
          <div class="row g-2">
            <div class="col-6">
              <div class="overflow-hidden rounded-2 project-hero-sub-img" style="cursor: pointer;" onclick="openProjectLightbox()">
                <img src="/assets/images/delivered-projects/seawoods-2bhk/2.webp" alt="Parallel Modular Kitchen in BWP Marine Ply" class="w-100 h-100 object-fit-cover" />
              </div>
            </div>
            <div class="col-6">
              <div class="overflow-hidden rounded-2 project-hero-sub-img" style="cursor: pointer;" onclick="openProjectLightbox()">
                <img src="/assets/images/delivered-projects/seawoods-2bhk/3.webp" alt="Master Bedroom Sliding Wardrobe with Lofts" class="w-100 h-100 object-fit-cover" />
              </div>
            </div>
            <div class="col-6">
              <div class="overflow-hidden rounded-2 project-hero-sub-img" style="cursor: pointer;" onclick="openProjectLightbox()">
                <img src="/assets/images/delivered-projects/seawoods-2bhk/4.webp" alt="Compact Dining Nook with Fluted Panels" class="w-100 h-100 object-fit-cover" />
              </div>
            </div>
            <div class="col-6">
              <div class="overflow-hidden rounded-2 position-relative project-hero-sub-img" style="cursor: pointer;" onclick="openProjectLightbox()">
                <img src="/assets/images/delivered-projects/seawoods-2bhk/5.webp" alt="Sleek TV Console Unit" class="w-100 h-100 object-fit-cover" />
                <!-- See All Button overlay -->
                <div class="position-absolute bottom-0 end-0 m-3" style="z-index: 10;">
                  <button class="btn btn-light btn-sm px-4 rounded-pill fw-bold border-0" style="opacity: 0.9; box-shadow: 0 2px 8px rgba(0,0,0,0.15);" onclick="event.stopPropagation(); openProjectLightbox()">See All</button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Columns Grid -->
      <div class="row g-4">
        <!-- Left Column: Specs, Highlights & FAQs -->
        <div class="col-lg-8">
          <!-- Main Description Card -->
          <div class="p-4 bg-white rounded-4 border border-light-subtle shadow-sm mb-4">
            <h1 class="fw-bold mb-2 text-dark" style="font-size: 2.2rem; font-family: 'Open Sans', sans-serif; letter-spacing: -0.5px;">2BHK Modern Flat Interior in Hiranandani Crystal, Kharghar</h1>
            <p class="text-secondary mb-3">Hiranandani Crystal &amp; Heritage, Sector 7, Kharghar, Navi Mumbai</p>
            
            <div class="d-flex flex-wrap gap-2 mb-4">
              <span class="badge-pill-light">Modern Minimalist</span>
              <span class="badge-pill-light">100% Marine Ply</span>
              <span class="badge-pill-light">Space Maximizer</span>
              <span class="badge-pill-light">Turnkey</span>
            </div>
            
            <div class="d-flex justify-content-between align-items-center mb-4">
              <div class="d-flex align-items-center text-dark fw-semibold small">
                <i class="fas fa-map-marker-alt text-danger me-2 fs-5"></i> Sector 7, Kharghar (Near Central Park)
              </div>
              <button class="btn btn-red-pill px-4 py-2 fw-bold text-white border-0" onclick="window.openConsultationPopup && window.openConsultationPopup(true)">
                GET STARTED
              </button>
            </div>
            
            <hr class="my-4" style="border-color: #e5e8eb;" />
            
            <div class="row g-3 text-start">
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">Pricing</span>
                <strong class="text-dark d-block">₹6.5 - 8.0 Lakhs</strong>
              </div>
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">BHK</span>
                <strong class="text-dark d-block">2-BHK</strong>
              </div>
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">Scope</span>
                <strong class="text-dark d-block" style="font-size: 0.9rem;">Parallel BWP Kitchen, Gypsum Ceiling, Master Bedroom Lofts</strong>
              </div>
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">Handover</span>
                <strong class="text-dark d-block">45 Days Locked</strong>
              </div>
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">Warranty</span>
                <strong class="text-dark d-block">10-Year Warranty</strong>
              </div>
            </div>
          </div>

          <!-- Project Story & Technical Overview -->
          <div class="p-4 bg-white rounded-4 border border-light-subtle shadow-sm mb-4">
            <h2 class="h4 fw-bold text-dark mb-3">Design &amp; Execution Highlights: Hiranandani Crystal</h2>
            <p class="text-secondary mb-3" style="line-height: 1.7;">
              Customized for a young working couple in Sector 7, Kharghar, this 2BHK apartment needed high vertical storage without compromising natural light or open walking spaces. The design incorporates handleless matte laminate finishes, integrated warm LED cove lighting, and space-saving hydraulic bedroom furniture.
            </p>
            <p class="text-secondary mb-4" style="line-height: 1.7;">
              All modular woodwork was factory-fabricated using <strong>CenturyPly IS:710 Marine Grade Plywood</strong> with 1.2mm PUR zero-joint edge banding, ensuring 100% moisture and borer protection through Kharghar monsoons.
            </p>
            
            <h3 class="h5 fw-bold text-dark mb-3">Delivered Package Inclusions:</h3>
            <ul class="text-secondary mb-4 ps-3" style="line-height: 1.8;">
              <li><strong>Parallel Modular Kitchen:</strong> Anti-scratch acrylic shutters, quartz stone counter, Hettich soft-close tandem boxes, and tall pantry pull-out.</li>
              <li><strong>Living &amp; Dining Area:</strong> Floating TV console unit with integrated charcoal acoustic fluted paneling and concealed cable management.</li>
              <li><strong>Master &amp; Guest Bedrooms:</strong> 2 Full-height sliding wardrobes with upper lofts, hydraulic storage double bed, and ergonomic work-from-home desk.</li>
              <li><strong>Ceiling &amp; Electrical:</strong> Saint-Gobain Gyproc false ceiling with warm 3000K profile strip lights and Philips LED spots.</li>
            </ul>

            <!-- Client Review -->
            <div class="p-3 rounded-3" style="background-color: #f8fafc; border-left: 4px solid #189ba6;">
              <p class="fst-italic text-dark mb-2" style="font-size: 0.95rem;">
                "Siddhivinayak Designers transformed our 2BHK flat in Hiranandani Crystal into a spacious, clutter-free haven. The parallel kitchen layout has doubled our storage, and their 45-day handover promise was strictly adhered to."
              </p>
              <div class="d-flex align-items-center">
                <strong class="text-dark small me-2">Rahul &amp; Neha Deshmukh</strong>
                <span class="text-muted small">• Homeowners, Hiranandani Crystal, Sector 7 Kharghar</span>
              </div>
            </div>
          </div>

          <!-- Kharghar Hub Quick Link Ribbon -->
          <div class="p-3 bg-white rounded-4 border border-light-subtle shadow-sm mb-4 d-flex flex-wrap gap-2 justify-content-between align-items-center">
            <span class="text-dark fw-semibold small">Explore more Kharghar solutions:</span>
            <div class="d-flex gap-2">
              <a href="/cities/interior-designers-navi-mumbai/kharghar/" class="btn btn-outline-dark btn-sm rounded-pill">Kharghar Hub</a>
              <a href="/cities/interior-designers-navi-mumbai/kharghar/2bhk-3bhk-interiors/" class="btn btn-outline-dark btn-sm rounded-pill">2BHK &amp; 3BHK Cost</a>
              <a href="/cities/interior-designers-navi-mumbai/kharghar/modular-kitchen/" class="btn btn-outline-dark btn-sm rounded-pill">Modular Kitchens</a>
            </div>
          </div>
        </div>

        <!-- Right Column: Consultation Form -->
        <div class="col-lg-4">
          <div class="position-sticky" style="top: 90px;">
            <div class="p-4 bg-white rounded-4 border border-light-subtle shadow-sm mb-4">
              <h3 class="h5 fw-bold text-dark mb-2">Get a Quote for Your Kharghar Home</h3>
              <p class="small text-secondary mb-3">Get a customized 3D design concept and itemized BOQ estimate.</p>
              
              <form class="luxury-form" id="projectConsultForm" onsubmit="event.preventDefault(); window.location.href='https://wa.me/918369297174?text=Hi%20Siddhivinayak%20Designers,%20I%20saw%20your%20Hiranandani%20Crystal%20Kharghar%20project%20and%20want%20a%20free%20quote';">
                <div class="mb-3">
                  <label class="form-label small text-secondary">Your Name</label>
                  <input type="text" class="form-control rounded-3" placeholder="Enter your name" required />
                </div>
                <div class="mb-3">
                  <label class="form-label small text-secondary">Mobile Number</label>
                  <input type="tel" class="form-control rounded-3" placeholder="Enter 10-digit number" required />
                </div>
                <div class="mb-3">
                  <label class="form-label small text-secondary">Apartment / Society Name</label>
                  <input type="text" class="form-control rounded-3" value="Hiranandani Crystal, Kharghar" />
                </div>
                <div class="mb-3">
                  <label class="form-label small text-secondary">Configuration</label>
                  <select class="form-select rounded-3">
                    <option selected>2 BHK Flat</option>
                    <option>3 BHK Flat</option>
                    <option>4 BHK / Penthouse</option>
                    <option>Modular Kitchen Only</option>
                  </select>
                </div>
                <button type="submit" class="btn btn-dark w-100 py-2 rounded-3 fw-bold mb-2" style="background-color: #189ba6; border-color: #189ba6;">
                  Request Free 3D Layout &amp; Quote
                </button>
                <a href="https://wa.me/918369297174?text=Hi%20Siddhivinayak%20Designers,%20I'm%20interested%20in%20a%20similar%202BHK%20interior%20design%20for%20my%20Hiranandani%20Crystal%20Kharghar%20flat" target="_blank" class="btn btn-outline-success w-100 py-2 rounded-3 fw-bold">
                  <i class="fab fa-whatsapp me-1"></i> WhatsApp Instant Estimate
                </a>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Custom Fullscreen Lightbox Modal -->
  <div id="projectLightbox" class="position-fixed top-0 start-0 w-100 h-100 d-none justify-content-center align-items-center bg-dark bg-opacity-95" style="z-index: 10500;">
    <button class="position-absolute top-0 end-0 m-4 btn btn-light rounded-circle border-0" onclick="closeProjectLightbox()" style="width: 45px; height: 45px; z-index: 10510;">
      <i class="fas fa-times"></i>
    </button>
    <div class="container text-center position-relative">
      <img id="projectLightboxImg" src="/assets/images/delivered-projects/seawoods-2bhk/1.webp" alt="Hiranandani Crystal Kharghar 2BHK Interior" class="img-fluid rounded-3" style="max-height: 85vh; object-fit: contain;" />
      <div class="d-flex justify-content-center gap-3 mt-3">
        <button class="btn btn-outline-light rounded-circle px-3 py-2" onclick="prevProjectPhoto()"><i class="fas fa-chevron-left"></i></button>
        <button class="btn btn-outline-light rounded-circle px-3 py-2" onclick="nextProjectPhoto()"><i class="fas fa-chevron-right"></i></button>
      </div>
    </div>
  </div>

  <script is:inline>
    const projectPhotos = [
      "/assets/images/delivered-projects/seawoods-2bhk/1.webp",
      "/assets/images/delivered-projects/seawoods-2bhk/2.webp",
      "/assets/images/delivered-projects/seawoods-2bhk/3.webp",
      "/assets/images/delivered-projects/seawoods-2bhk/4.webp",
      "/assets/images/delivered-projects/seawoods-2bhk/5.webp",
      "/assets/images/delivered-projects/seawoods-2bhk/6.webp",
      "/assets/images/delivered-projects/seawoods-2bhk/7.webp",
      "/assets/images/delivered-projects/seawoods-2bhk/8.webp",
      "/assets/images/delivered-projects/seawoods-2bhk/9.webp",
      "/assets/images/delivered-projects/seawoods-2bhk/10.webp"
    ];
    let currentPhotoIdx = 0;

    function openProjectLightbox() {
      const modal = document.getElementById('projectLightbox');
      if (modal) modal.classList.remove('d-none'), modal.classList.add('d-flex');
    }

    function closeProjectLightbox() {
      const modal = document.getElementById('projectLightbox');
      if (modal) modal.classList.add('d-none'), modal.classList.remove('d-flex');
    }

    function nextProjectPhoto() {
      currentPhotoIdx = (currentPhotoIdx + 1) % projectPhotos.length;
      document.getElementById('projectLightboxImg').src = projectPhotos[currentPhotoIdx];
    }

    function prevProjectPhoto() {
      currentPhotoIdx = (currentPhotoIdx - 1 + projectPhotos.length) % projectPhotos.length;
      document.getElementById('projectLightboxImg').src = projectPhotos[currentPhotoIdx];
    }
  </script>
</Layout>
