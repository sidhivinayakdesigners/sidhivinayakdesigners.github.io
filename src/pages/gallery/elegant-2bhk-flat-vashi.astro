---
import Layout from '../../layouts/Layout.astro';

const title = "Elegant 2 BHK Flat, Vashi | Siddhivinayak Designers";
const description = "Explore the complete design portfolio of our Elegant 2 BHK Flat in Vashi. Intelligent space-saving solutions, custom wardrobes, and premium modular kitchen.";
const canonical = "https://siddhivinayakdesigners.in/gallery/elegant-2bhk-flat-vashi/";

const bodyContent = `
  <!-- Custom Immersive Gallery Page -->
  <div class="immersive-gallery-wrapper">
    <!-- Fixed Close Button -->
    <button type="button" onclick="closeImmersiveGallery(event)" class="close-btn" aria-label="Close and return to previous page">
      <i class="fas fa-times"></i>
    </button>

    <div class="gallery-container">
      <!-- Title Header Block -->
      <div class="gallery-header text-center mb-5" data-aos="fade-down">
        <h1 class="font-luxury fw-bold mb-2" style="color: #111111 !important; font-size: clamp(2rem, 5vw, 3rem);">Elegant 2 BHK Flat</h1>
        <p class="text-muted" style="font-size: 1.1rem;"><i class="fas fa-map-marker-alt text-gold me-2" style="color: #c5a880 !important;"></i> Vashi Project Showcase</p>
        <div style="width: 60px; height: 3px; background-color: #c5a880; margin: 20px auto 0;"></div>
      </div>

      <!-- Rhythmic Grid Layout -->
      <div class="gallery-grid">
        <!-- Row 1: Side by side -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/elegant-2bhk-flat-vashi/img1.webp" alt="Elegant 2 BHK Flat Vashi - Living Room Entrance" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/elegant-2bhk-flat-vashi/img2.webp" alt="Elegant 2 BHK Flat Vashi - Living Room Sofa Seating" loading="lazy" />
        </div>

        <!-- Row 2: Full Width -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/elegant-2bhk-flat-vashi/img3.webp" alt="Elegant 2 BHK Flat Vashi - TV Unit Wall Panel" loading="lazy" />
        </div>

        <!-- Row 3: Side by side -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/elegant-2bhk-flat-vashi/img4.webp" alt="Elegant 2 BHK Flat Vashi - False Ceiling & Chandelier" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/elegant-2bhk-flat-vashi/img5.webp" alt="Elegant 2 BHK Flat Vashi - Compact Dining Area" loading="lazy" />
        </div>

        <!-- Row 4: Full Width -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/elegant-2bhk-flat-vashi/img6.webp" alt="Elegant 2 BHK Flat Vashi - Master Bedroom Setup" loading="lazy" />
        </div>

        <!-- Row 5: Side by side -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/elegant-2bhk-flat-vashi/img7.webp" alt="Elegant 2 BHK Flat Vashi - Master Bedroom Sliding Wardrobe" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/elegant-2bhk-flat-vashi/img8.webp" alt="Elegant 2 BHK Flat Vashi - Kids Bedroom Study Unit" loading="lazy" />
        </div>

        <!-- Row 6: Full Width -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/elegant-2bhk-flat-vashi/img9.webp" alt="Elegant 2 BHK Flat Vashi - Modular Kitchen Layout" loading="lazy" />
        </div>

        <!-- Row 7: Side by side -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/elegant-2bhk-flat-vashi/img10.webp" alt="Elegant 2 BHK Flat Vashi - Kitchen Cabinet Storage" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/elegant-2bhk-flat-vashi/img11.webp" alt="Elegant 2 BHK Flat Vashi - Compact Pooja Mandir" loading="lazy" />
        </div>

        <!-- Row 8: Full Width -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/elegant-2bhk-flat-vashi/img12.webp" alt="Elegant 2 BHK Flat Vashi - Modern Bathroom Vanity" loading="lazy" />
        </div>
      </div>
    </div>
  </div>
`;
---

<Layout title={title} description={description} canonical={canonical}>
  <Fragment set:html={bodyContent} />
</Layout>

<style is:global>

  /* White Card & Form Text Visibility */
  .portfolio-detail-wrapper .bg-white h1,
  .portfolio-detail-wrapper .bg-white h2,
  .portfolio-detail-wrapper .bg-white h3,
  .portfolio-detail-wrapper .bg-white h4,
  .portfolio-detail-wrapper .bg-white h5,
  .portfolio-detail-wrapper .bg-white strong {
    color: #111111 !important;
  }
  .portfolio-detail-wrapper .bg-white p,
  .portfolio-detail-wrapper .bg-white span,
  .portfolio-detail-wrapper .bg-white li,
  .portfolio-detail-wrapper .bg-white label {
    color: #475569 !important;
  }
  .portfolio-detail-wrapper .form-label {
    color: #334155 !important;
    font-weight: 600;
  }
  .portfolio-detail-wrapper .form-control,
  .portfolio-detail-wrapper .form-select {
    color: #111111 !important;
    background-color: #ffffff !important;
    border: 1px solid #cbd5e1 !important;
  }

  /* Only Dark CTA Banners get White Text */
  .portfolio-detail-wrapper [style*="linear-gradient"] h3,
  .immersive-gallery-wrapper [style*="linear-gradient"] h3 {
    color: #ffffff !important;
  }
  .portfolio-detail-wrapper [style*="linear-gradient"] p,
  .immersive-gallery-wrapper [style*="linear-gradient"] p {
    color: #f8fafc !important;
  }

  

  /* Immersive Gallery Styles */
  .immersive-gallery-wrapper {
    background-color: #ffffff !important;
    min-height: 100vh;
    width: 100%;
    position: relative;
    z-index: 10;
  }

  /* Force hide header, footer, and navigation bars on this full-screen layout */
  header, footer, nav, .header, .footer, .floating-widgets {
    display: none !important;
  }

  /* Reset layout spacing */
  body, main {
    background-color: #ffffff !important;
    padding-top: 0 !important;
    margin-top: 0 !important;
    overflow-x: hidden;
  }

  /* Circular close button */
  .close-btn {
    position: fixed;
    top: 24px;
    right: 24px;
    width: 48px;
    height: 48px;
    background-color: #111111;
    border-radius: 50%;
    color: #ffffff !important;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10050;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    border: none;
    text-decoration: none !important;
  }

  .close-btn:hover {
    background-color: #000000;
    transform: scale(1.08) rotate(90deg);
  }

  .close-btn i {
    font-size: 18px;
  }

  /* Grid Layout */
  .gallery-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 80px 24px;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .grid-item {
    position: relative;
    overflow: hidden;
    background: #fdfdfd;
    border-radius: 4px;
  }

  .grid-item img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    border-radius: 4px;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.05);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .grid-item img:hover {
    transform: scale(1.02);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
  }

  .span-2 {
    grid-column: span 2;
  }

  .span-1 {
    grid-column: span 1;
  }

  /* Mobile responsiveness */
  @media (max-width: 767px) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .grid-item img {
      aspect-ratio: 3 / 4 !important;
      object-fit: cover !important;
    }
    .span-2 {
      grid-column: span 1;
    }
    .gallery-container {
      padding: 60px 16px;
    }
    .close-btn {
      top: 16px;
      right: 16px;
      width: 40px;
      height: 40px;
    }
    .close-btn i {
      font-size: 16px;
    }
  }
</style>
