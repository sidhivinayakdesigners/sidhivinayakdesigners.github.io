---
import Layout from '../../layouts/Layout.astro';

const title = "Minimal 2 BHK Flat, Seawoods | Siddhivinayak Designers";
const description = "Explore the complete design portfolio of our Minimal 2 BHK Flat in Seawoods. Intelligent space-saving solutions, custom modular kitchen, bespoke sliding wardrobes, and refined contemporary living room decor in Seawoods.";
const canonical = "https://siddhivinayakdesigners.in/gallery/minimal-2bhk-flat-seawoods/";

const bodyContent = `
  <!-- Custom Immersive Gallery Page -->
  <div class="immersive-gallery-wrapper">
    <!-- Fixed Close Button -->
    <button type="button" onclick="closeImmersiveGallery(event)" class="close-btn" aria-label="Close and return to previous page" style="color: #ffffff !important; -webkit-text-fill-color: #ffffff !important;">
      <i class="fas fa-times" style="color: #ffffff !important; -webkit-text-fill-color: #ffffff !important;"></i>
    </button>

    <div class="gallery-container">
      <!-- Title Header Block -->
      <div class="gallery-header text-center mb-5" data-aos="fade-down">
        <h1 class="font-luxury fw-bold mb-2" style="color: #111111 !important; font-size: clamp(2rem, 5vw, 3rem);">Minimal 2 BHK Flat</h1>
        <p class="text-muted" style="font-size: 1.1rem;"><i class="fas fa-map-marker-alt text-gold me-2" style="color: #c5a880 !important;"></i> Seawoods Project Showcase</p>
        <div style="width: 60px; height: 3px; background-color: #c5a880; margin: 20px auto 0;"></div>
      </div>

      <!-- Rhythmic Grid Layout -->
      <div class="gallery-grid">
        <!-- Row 1: Side by side - Living Room -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/minimal-2bhk-seawoods/img1.webp" alt="Minimal 2 BHK Flat Seawoods - Living Room Main View & Sleek TV Console" loading="eager" fetchpriority="high" width="1500" height="1000" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/minimal-2bhk-seawoods/img2.webp" alt="Minimal 2 BHK Flat Seawoods - Living Room Lounge Seating & Coffee Table" loading="lazy" width="1500" height="1000" />
        </div>

        <!-- Row 2: Full Width - Open Layout -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/minimal-2bhk-seawoods/img3.webp" alt="Minimal 2 BHK Flat Seawoods - Open Living and Dining Space Layout" loading="lazy" width="1500" height="1000" />
        </div>

        <!-- Row 3: Side by side - Dining Area -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/minimal-2bhk-seawoods/img4.webp" alt="Minimal 2 BHK Flat Seawoods - Dining Table & Brass Geometric Wall Sculpture" loading="lazy" width="1500" height="1000" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/minimal-2bhk-seawoods/img5.webp" alt="Minimal 2 BHK Flat Seawoods - Dining Area Crockery Cabinet & Storage" loading="lazy" width="1500" height="1000" />
        </div>

        <!-- Row 4: Full Width - Dining Table Setting -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/minimal-2bhk-seawoods/img6.webp" alt="Minimal 2 BHK Flat Seawoods - Contemporary 4-Seater Dining Table Setup" loading="lazy" width="1500" height="1000" />
        </div>

        <!-- Row 5: Side by side - Modular Kitchen -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/minimal-2bhk-seawoods/img7.webp" alt="Minimal 2 BHK Flat Seawoods - Parallel Modular Kitchen with High-Gloss Cabinets" loading="lazy" width="1500" height="1000" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/minimal-2bhk-seawoods/img8.webp" alt="Minimal 2 BHK Flat Seawoods - Kitchen Sink & Countertop Prep Station" loading="lazy" width="1500" height="1000" />
        </div>

        <!-- Row 6: Side by side - Master Bedroom -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/minimal-2bhk-seawoods/img9.webp" alt="Minimal 2 BHK Flat Seawoods - Master Bedroom Floating TV Unit & Mirror" loading="lazy" width="1500" height="1000" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/minimal-2bhk-seawoods/img10.webp" alt="Minimal 2 BHK Flat Seawoods - King Bed with Triptych Floral Wallpaper Panelling" loading="lazy" width="1500" height="1000" />
        </div>

        <!-- Row 7: Full Width - Master Suite Wardrobe -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/minimal-2bhk-seawoods/img11.webp" alt="Minimal 2 BHK Flat Seawoods - Master Bedroom Sliding Mirrored Wardrobe View" loading="lazy" width="1500" height="1000" />
        </div>

        <!-- Row 8: Side by side - Master Wardrobe & Vanity -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/minimal-2bhk-seawoods/img12.webp" alt="Minimal 2 BHK Flat Seawoods - Full-Height Sliding Wardrobe with Gold Trim" loading="lazy" width="1500" height="1000" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/minimal-2bhk-seawoods/img13.webp" alt="Minimal 2 BHK Flat Seawoods - Master Dressing Table & Mirrored Vanity" loading="lazy" width="1500" height="1000" />
        </div>

        <!-- Row 9: Side by side - Kids Bedroom -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/minimal-2bhk-seawoods/img14.webp" alt="Minimal 2 BHK Flat Seawoods - Kids Bedroom Sky Blue Moulding Wall & Bed" loading="lazy" width="1500" height="1000" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/minimal-2bhk-seawoods/img15.webp" alt="Minimal 2 BHK Flat Seawoods - Custom Blue Wardrobe with Frosted Glass Upper Shutters" loading="lazy" width="1500" height="1000" />
        </div>

        <!-- Row 10: Full Width - Study Station -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/minimal-2bhk-seawoods/img16.webp" alt="Minimal 2 BHK Flat Seawoods - Floating Study Workstation & Overhead Display Storage" loading="lazy" width="1500" height="1000" />
        </div>
      </div>
    </div>
  </div>
`;
---

<Layout title={title} description={description} canonical={canonical}>
  <Fragment set:html={bodyContent} />
</Layout>

<style is:global>
  /* White Card & Form Text Visibility */
  .portfolio-detail-wrapper .bg-white h1,
  .portfolio-detail-wrapper .bg-white h2,
  .portfolio-detail-wrapper .bg-white h3,
  .portfolio-detail-wrapper .bg-white h4,
  .portfolio-detail-wrapper .bg-white h5,
  .portfolio-detail-wrapper .bg-white strong {
    color: #111111 !important;
  }
  .portfolio-detail-wrapper .bg-white p,
  .portfolio-detail-wrapper .bg-white span,
  .portfolio-detail-wrapper .bg-white li,
  .portfolio-detail-wrapper .bg-white label {
    color: #475569 !important;
  }
  .portfolio-detail-wrapper .form-label {
    color: #334155 !important;
    font-weight: 600;
  }
  .portfolio-detail-wrapper .form-control,
  .portfolio-detail-wrapper .form-select {
    color: #111111 !important;
    background-color: #ffffff !important;
    border: 1px solid #cbd5e1 !important;
  }

  /* Only Dark CTA Banners get White Text */
  .portfolio-detail-wrapper [style*="linear-gradient"] h3,
  .immersive-gallery-wrapper [style*="linear-gradient"] h3 {
    color: #ffffff !important;
  }
  .portfolio-detail-wrapper [style*="linear-gradient"] p,
  .immersive-gallery-wrapper [style*="linear-gradient"] p {
    color: #f8fafc !important;
  }

  /* Immersive Gallery Styles */
  .immersive-gallery-wrapper {
    background-color: #ffffff !important;
    min-height: 100vh;
    width: 100%;
    position: relative;
    z-index: 10;
  }

  /* Force hide header, footer, and navigation bars on this full-screen layout */
  header, footer, nav, .header, .footer, .floating-widgets {
    display: none !important;
  }

  /* Reset layout spacing */
  body, main {
    background-color: #ffffff !important;
    padding-top: 0 !important;
    margin-top: 0 !important;
    overflow-x: hidden;
  }

  /* Circular close button */
  .close-btn {
    position: fixed;
    top: 24px;
    right: 24px;
    width: 48px;
    height: 48px;
    background-color: #111111;
    border-radius: 50%;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    z-index: 9999;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    border: none;
    cursor: pointer;
  }

  .close-btn:hover {
    background-color: #000000;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
    transform: scale(1.08) rotate(90deg);
  }

  .close-btn i {
    font-size: 18px;
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
  }

  /* Grid Layout */
  .gallery-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 80px 24px;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  .grid-item {
    position: relative;
    overflow: hidden;
    background: #fdfdfd;
    border-radius: 4px;
  }

  .grid-item img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    border-radius: 4px;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.05);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .grid-item img:hover {
    transform: scale(1.02);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
  }

  .span-2 {
    grid-column: span 2;
  }

  /* Responsive Adjustments */
  @media (max-width: 768px) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .grid-item img {
      aspect-ratio: 3 / 4 !important;
      object-fit: cover !important;
    }
    .span-2 {
      grid-column: span 1;
    }
    .gallery-container {
      padding: 60px 16px;
    }
    .close-btn {
      top: 16px;
      right: 16px;
      width: 40px;
      height: 40px;
      color: #ffffff !important;
      -webkit-text-fill-color: #ffffff !important;
    }
    .close-btn i {
      font-size: 16px;
      color: #ffffff !important;
      -webkit-text-fill-color: #ffffff !important;
    }
  }
</style>

<script is:inline>
  function closeImmersiveGallery(e) {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
    }
    if (document.referrer && document.referrer.indexOf(window.location.host) !== -1) {
      window.history.back();
    } else {
      window.location.href = '/completed-projects/';
    }
  }
</script>
