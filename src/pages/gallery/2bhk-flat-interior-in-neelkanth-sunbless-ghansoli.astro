---
import Layout from '../../layouts/Layout.astro';

const title = "2BHK in Neelkanth Sunbless, Sector 15 Ghansoli | Siddhivinayak Designers";
const description = "Explore this beautiful 2BHK turnkey flat interior in Neelkanth Sunbless, Sector 15, Ghansoli. Features modular kitchen, custom sliding wardrobes, gypsum false ceilings, and anti-scratch acrylic finishes.";
const canonical = "https://siddhivinayakdesigners.in/gallery/2bhk-flat-interior-in-neelkanth-sunbless-ghansoli/";

const schema = `{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://siddhivinayakdesigners.in/" },
        { "@type": "ListItem", "position": 2, "name": "Interior Designer Ghansoli", "item": "https://siddhivinayakdesigners.in/cities/interior-designers-navi-mumbai/ghansoli/" },
        { "@type": "ListItem", "position": 3, "name": "2BHK in Neelkanth Sunbless", "item": "${canonical}" }
      ]
    },
    {
      "@type": "CreativeWork",
      "name": "2BHK in Neelkanth Sunbless, Ghansoli",
      "headline": "2BHK Modern Flat Interior in Neelkanth Sunbless, Sector 15 Ghansoli",
      "description": "Completed turnkey 2BHK flat interior design in Neelkanth Sunbless, Sector 15, Ghansoli by Siddhivinayak Designers. Delivered with 100% IS:710 Marine Ply, factory PUR edge banding, and elegant false ceilings.",
      "image": "https://siddhivinayakdesigners.in/assets/images/delivered-projects/neelkanth-sunbless-ghansoli/1.webp",
      "url": "${canonical}",
      "author": {
        "@type": "HomeAndConstructionBusiness",
        "name": "Siddhivinayak Designers",
        "url": "https://siddhivinayakdesigners.in/cities/interior-designers-navi-mumbai/ghansoli/",
        "telephone": "+918369297174",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Shree Laxmi CHS, A 301, Sector 23, Kopar Khairane",
          "addressLocality": "Navi Mumbai",
          "postalCode": "400709",
          "addressCountry": "IN"
        }
      },
      "contentLocation": {
        "@type": "Place",
        "name": "Neelkanth Sunbless, Sector 15, Ghansoli, Navi Mumbai 400701"
      }
    }
  ]
}`;
---

<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <div class="portfolio-detail-wrapper py-4" style="background-color: #f4f5f7 !important;">
    <div class="container">
      <!-- Breadcrumb Link -->
      <nav aria-label="breadcrumb" class="mb-4 d-none d-md-block">
        <ol class="breadcrumb mb-0 small">
