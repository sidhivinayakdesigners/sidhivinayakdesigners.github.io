          </div>
        </div>

        <!-- Right Column: Sticky Sidebar -->
        <div class="col-lg-4">
          <div class="sticky-sidebar" style="top: 100px; position: sticky; z-index: 100;">
            <!-- Get Similar Interiors Box -->
            <div class="p-4 rounded-4 mb-3 text-center text-white" style="background-color: #062639 !important; box-shadow: 0 4px 15px rgba(6, 38, 57, 0.15); color: #ffffff !important;">
              <h3 class="fw-bold mb-2 h5 text-white" style="font-family: 'Open Sans', sans-serif; color: #ffffff !important;">Get Similar Interiors</h3>
              <p class="small text-white-50 mb-3">Free 3D Layout &amp; Itemized Locked BOQ Estimate for Your Ghansoli Flat</p>
              <a href="https://wa.me/918369297174?text=Hi%20Siddhivinayak%20Designers,%20I'm%20interested%20in%20getting%20an%20estimate%20for%20my%20Ghansoli%20home" target="_blank" class="btn w-100 py-3 rounded-pill fw-bold border-0 text-white text-decoration-none" style="background-color: #189ba6 !important; color: #ffffff !important;">
