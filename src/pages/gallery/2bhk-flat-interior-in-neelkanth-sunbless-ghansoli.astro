            <!-- Quick Project Specs Box -->
            <div class="p-4 bg-white rounded-4 border border-light-subtle shadow-sm">
              <h4 class="fw-bold text-dark mb-3 h6" style="font-family: 'Open Sans', sans-serif;">Project Summary</h4>
              <ul class="list-unstyled small text-secondary mb-0">
                <li class="py-2 border-bottom d-flex justify-content-between">
                  <span>Society:</span>
                  <strong class="text-dark">Neelkanth Sunbless</strong>
                </li>
                <li class="py-2 border-bottom d-flex justify-content-between">
                  <span>Location:</span>
                  <strong class="text-dark">Sector 15, Ghansoli</strong>
                </li>
                <li class="py-2 border-bottom d-flex justify-content-between">
