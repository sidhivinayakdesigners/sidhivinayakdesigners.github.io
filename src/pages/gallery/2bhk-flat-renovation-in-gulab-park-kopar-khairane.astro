---
import Layout from '../../layouts/Layout.astro';

const title = "2BHK Flat Renovation in Gulab Park, Sector 23 Kopar Khairane | Siddhivinayak Designers";
const description = "2BHK residential flat renovation in Gulab Park, Sector 23 Kopar Khairane. Civil waterproofing, plumbing overhaul, modular woodwork with 10-year warranty.";
const canonical = "https://siddhivinayakdesigners.in/gallery/2bhk-flat-renovation-in-gulab-park-kopar-khairane/";

const schema = `{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://siddhivinayakdesigners.in/" },
        { "@type": "ListItem", "position": 2, "name": "Interior Designer Kopar Khairane", "item": "https://siddhivinayakdesigners.in/cities/interior-designers-navi-mumbai/kopar-khairane/" },
        { "@type": "ListItem", "position": 3, "name": "2BHK Gulab Park Project", "item": "${canonical}" }
      ]
    },
    {
      "@type": "CreativeWork",
      "name": "2BHK Flat Turnkey Renovation - Gulab Park, Kopar Khairane",
      "headline": "2BHK Flat Renovation in Gulab Park, Sector 23 Kopar Khairane",
      "description": "Completed turnkey 2BHK flat renovation in Gulab Park, Sector 23, Kopar Khairane by Siddhivinayak Designers. Delivered with civil structural waterproofing and 100% IS:710 Marine Ply.",
      "image": "https://siddhivinayakdesigners.in/assets/images/delivered-projects/seawoods-2bhk/1.webp",
      "url": "${canonical}",
      "author": {
        "@type": "HomeAndConstructionBusiness",
        "name": "Siddhivinayak Designers",
        "url": "https://siddhivinayakdesigners.in/cities/interior-designers-navi-mumbai/kopar-khairane/",
        "telephone": "+918369297174",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Shree Laxmi CHS, A 301, Sector 23, Kopar Khairane",
          "addressLocality": "Navi Mumbai",
          "postalCode": "400709",
          "addressCountry": "IN"
        }
      },
      "contentLocation": {
        "@type": "Place",
        "name": "Gulab Park, Sector 23, Kopar Khairane, Navi Mumbai 400709"
      }
    }
  ]
}`;
---

<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <!-- Main Project Detail Page Content -->
  <div class="portfolio-detail-wrapper py-4" style="background-color: #f4f5f7 !important;">
    <div class="container">
      <!-- Breadcrumb Link -->
      <nav aria-label="breadcrumb" class="mb-4 d-none d-md-block">
        <ol class="breadcrumb mb-0 small">
          <li class="breadcrumb-item"><a href="/" class="text-danger text-decoration-none">Home</a></li>
          <li class="breadcrumb-item"><a href="/cities/interior-designers-navi-mumbai/kopar-khairane/" class="text-danger text-decoration-none">Interior Designer Kopar Khairane</a></li>
          <li class="breadcrumb-item active text-muted" aria-current="page">2BHK Gulab Park Kopar Khairane</li>
        </ol>
      </nav>

      <!-- Premium Top Image Grid (Click navigates to dedicated maximization page) -->
      <div class="row g-2 mb-4 align-stretch">
        <!-- Left Large Featured Image -->
        <div class="col-md-7">
          <a href="/gallery/2bhk-flat-renovation-in-gulab-park-kopar-khairane-photos/" class="d-block h-100 text-decoration-none">
            <div class="rounded-3 overflow-hidden position-relative h-100 project-hero-main-img" style="cursor: pointer;">
              <img src="/assets/images/delivered-projects/nerul-3bhk-u-shaped/1.webp" alt="2BHK Flat Renovation in Gulab Park, Kopar Khairane - Main Showcase" class="w-100 h-100 object-fit-cover" />
              <div class="position-absolute top-0 start-0 m-3 bg-dark bg-opacity-75 text-white px-3 py-1 rounded-pill small fw-semibold">
                <i class="fas fa-expand me-1"></i> View Full Photo Gallery
              </div>
            </div>
          </a>
        </div>
        <!-- Right 2x2 Small Images Grid -->
        <div class="col-md-5">
          <div class="row g-2">
            <div class="col-6">
              <a href="/gallery/2bhk-flat-renovation-in-gulab-park-kopar-khairane-photos/" class="d-block text-decoration-none">
                <div class="overflow-hidden rounded-2 project-hero-sub-img" style="cursor: pointer;">
                  <img src="/assets/images/delivered-projects/nerul-3bhk-u-shaped/3.webp" alt="2BHK Flat Renovation in Gulab Park, Kopar Khairane - Paneling & Lighting" class="w-100 h-100 object-fit-cover" />
                </div>
              </a>
            </div>
            <div class="col-6">
              <a href="/gallery/2bhk-flat-renovation-in-gulab-park-kopar-khairane-photos/" class="d-block text-decoration-none">
                <div class="overflow-hidden rounded-2 project-hero-sub-img" style="cursor: pointer;">
                  <img src="/assets/images/delivered-projects/nerul-3bhk-u-shaped/2.webp" alt="2BHK Flat Renovation in Gulab Park, Kopar Khairane - Living Lounge" class="w-100 h-100 object-fit-cover" />
                </div>
              </a>
            </div>
            <div class="col-6">
              <a href="/gallery/2bhk-flat-renovation-in-gulab-park-kopar-khairane-photos/" class="d-block text-decoration-none">
                <div class="overflow-hidden rounded-2 project-hero-sub-img" style="cursor: pointer;">
                  <img src="/assets/images/delivered-projects/nerul-3bhk-u-shaped/4.webp" alt="2BHK Flat Renovation in Gulab Park, Kopar Khairane - Bedroom Wardrobe" class="w-100 h-100 object-fit-cover" />
                </div>
              </a>
            </div>
            <div class="col-6">
              <a href="/gallery/2bhk-flat-renovation-in-gulab-park-kopar-khairane-photos/" class="d-block text-decoration-none">
                <div class="overflow-hidden rounded-2 position-relative project-hero-sub-img" style="cursor: pointer;">
                  <img src="/assets/images/delivered-projects/nerul-3bhk-u-shaped/6.webp" alt="2BHK Flat Renovation in Gulab Park, Kopar Khairane - Cabinetry & Details" class="w-100 h-100 object-fit-cover" />
                  <!-- See All Button overlay -->
                  <div class="position-absolute bottom-0 end-0 m-3" style="z-index: 10;">
                    <span class="btn btn-light btn-sm px-3 rounded-pill fw-bold border-0" style="opacity: 0.95; box-shadow: 0 2px 8px rgba(0,0,0,0.25);">
                      <i class="fas fa-images me-1"></i> 12 Photos
                    </span>
                  </div>
                </div>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Main Columns Grid -->
      <div class="row g-4">
        <!-- Left Column: Specs, Highlights & Story -->
        <div class="col-lg-8">
          <!-- Main Description Card -->
          <div class="p-4 bg-white rounded-4 border border-light-subtle shadow-sm mb-4">
            <h1 class="fw-bold mb-2 text-dark" style="font-size: 2.2rem; font-family: 'Open Sans', sans-serif; letter-spacing: -0.5px;">2BHK Flat Renovation in Gulab Park, Kopar Khairane</h1>
            <p class="text-secondary mb-3">Gulab Park, Sector 23, Kopar Khairane, Navi Mumbai</p>
            
            <div class="d-flex flex-wrap gap-2 mb-4">
              <span class="badge-pill-light">Kopar Khairane</span>
              <span class="badge-pill-light">Turnkey Execution</span>
              <span class="badge-pill-light">100% BWP Marine Ply</span>
              <span class="badge-pill-light">German CNC Precision</span>
              <span class="badge-pill-light">Hettich Hardware</span>
            </div>
            
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
              <div class="d-flex align-items-center text-dark fw-semibold small">
                <i class="fas fa-map-marker-alt text-teal me-2 fs-5" style="color: #189ba6;"></i> Sector 23, Kopar Khairane
              </div>
              <button class="btn btn-danger px-4 py-2 fw-bold text-white border-0 rounded-pill" onclick="window.openConsultationPopup && window.openConsultationPopup(true)" style="background-color: #e53935;">
                GET STARTED
              </button>
            </div>
            
            <hr class="my-4" style="border-color: #e5e8eb;" />
            
            <div class="row g-3 text-start">
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">Pricing</span>
                <strong class="text-dark d-block">₹5.6 - 7.2 Lakhs</strong>
              </div>
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">BHK</span>
                <strong class="text-dark d-block">2-BHK</strong>
              </div>
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">Scope</span>
                <strong class="text-dark d-block" style="font-size: 0.9rem;">Civil Structural Modernization, Modular Woodwork, Profile False Ceiling</strong>
              </div>
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">Handover</span>
                <strong class="text-dark d-block">45 Days Locked</strong>
              </div>
              <div class="col-6 col-md">
                <span class="text-secondary small d-block mb-1">Warranty</span>
                <strong class="text-dark d-block">10-Year Warranty</strong>
              </div>
            </div>
          </div>

          <!-- Project Story & Technical Overview -->
          <div class="p-4 bg-white rounded-4 border border-light-subtle shadow-sm mb-4">
            <h2 class="h4 fw-bold text-dark mb-3">Project Execution Story: Gulab Park, Sector 23 Kopar Khairane</h2>
            <p class="text-secondary mb-3" style="line-height: 1.7;">
              This 2BHK flat in Gulab Park required a total interior refresh including tile replacement, bathroom waterproofing, and new factory-finished modular furniture throughout.
            </p>
            <p class="text-secondary mb-4" style="line-height: 1.7;">
              We delivered a turnkey overhaul in 38 days, featuring a moisture-proof BWP Marine Ply kitchen, sliding wardrobes, and custom TV console with fluted accents.
            </p>
            
            <h3 class="h5 fw-bold text-dark mb-3">Key Design &amp; Construction Highlights:</h3>
            <ul class="text-secondary mb-4 ps-3" style="line-height: 1.8;">
              <li><strong>Modular Kitchen:</strong> 100% IS:710 BWP Marine Plywood with 1.2mm PUR automated German CNC edge-banding and anti-corrosion Hettich soft-close tandem drawers.</li>
              <li><strong>Living &amp; Dining:</strong> Fluted charcoal louvers, warm ambient profile LED coving, and bookmatched marble texture feature walls.</li>
              <li><strong>Bedrooms &amp; Wardrobes:</strong> Floor-to-ceiling anti-warp sliding wardrobes with soft-close track mechanisms and integrated dressing mirrors.</li>
              <li><strong>False Ceiling &amp; Electricals:</strong> Saint-Gobain Gyproc ceiling grid with modular magnetic track lights and fire-retardant concealed wiring.</li>
            </ul>

            <!-- Client Testimonial Card -->
            <div class="p-3 rounded-3" style="background-color: #f8fafc; border-left: 4px solid #189ba6;">
              <p class="fst-italic text-dark mb-2" style="font-size: 0.95rem;">
                "Living in the same sector as Siddhivinayak Designers made site coordination seamless. The quality of plywood, fittings, and paint finish exceeded our expectations."
              </p>
              <div class="d-flex align-items-center">
                <strong class="text-dark small me-2">Manish Joshi</strong>
                <span class="text-muted small">• Homeowner, Gulab Park, Sector 23 Kopar Khairane</span>
              </div>
            </div>
          </div>

          <!-- Kopar Khairane Link Ribbon -->
          <div class="p-3 bg-white rounded-4 border border-light-subtle shadow-sm mb-4 d-flex flex-wrap gap-2 justify-content-between align-items-center">
            <span class="text-dark fw-semibold small">Explore more solutions in Kopar Khairane:</span>
            <div class="d-flex gap-2 flex-wrap">
              <a href="/cities/interior-designers-navi-mumbai/kopar-khairane/" class="btn btn-outline-dark btn-sm rounded-pill">Kopar Khairane Hub</a>
              <a href="/cities/interior-designers-navi-mumbai/kopar-khairane/2bhk-3bhk-interiors/" class="btn btn-outline-dark btn-sm rounded-pill">2BHK &amp; 3BHK Packages</a>
              <a href="/cities/interior-designers-navi-mumbai/kopar-khairane/modular-kitchen/" class="btn btn-outline-dark btn-sm rounded-pill">Modular Kitchens</a>
            </div>
          </div>
        </div>

        <!-- Right Column: Sticky Consultation Form -->
        <div class="col-lg-4">
          <div class="position-sticky" style="top: 90px;">
            <div class="p-4 bg-white rounded-4 border border-light-subtle shadow-sm mb-4">
              <h3 class="h5 fw-bold text-dark mb-2">Get a Quote for Your Kopar Khairane Home</h3>
              <p class="small text-secondary mb-3">Book a free 3D design consultation and itemized BOQ estimate from our Sector 23 studio.</p>
              
              <form class="luxury-form" id="projectConsultForm" onsubmit="event.preventDefault(); window.location.href='https://wa.me/918369297174?text=Hi%20Siddhivinayak%20Designers,%20I%20saw%20your%202BHK%20Flat%20Renovation%20in%20Gulab%20Park%2C%20Kopar%20Khairane%20project%20and%20want%20a%20free%20consultation';">
                <div class="mb-3">
                  <label class="form-label small text-secondary">Your Name</label>
                  <input type="text" class="form-control rounded-3" placeholder="Enter your name" required />
                </div>
                <div class="mb-3">
                  <label class="form-label small text-secondary">Mobile Number</label>
                  <input type="tel" class="form-control rounded-3" placeholder="Enter 10-digit number" required />
                </div>
                <div class="mb-3">
                  <label class="form-label small text-secondary">Apartment / Society Name</label>
                  <input type="text" class="form-control rounded-3" value="Gulab Park, Sector 23, Kopar Khairane, Navi Mumbai" />
                </div>
                <div class="mb-3">
                  <label class="form-label small text-secondary">Configuration</label>
                  <select class="form-select rounded-3">
                    <option selected>2-BHK Flat</option>
                    <option>2 BHK Flat</option>
                    <option>3 BHK Flat</option>
                    <option>Modular Kitchen Only</option>
                  </select>
                </div>
                <button type="submit" class="btn btn-dark w-100 py-2 rounded-3 fw-bold mb-2" style="background-color: #189ba6; border-color: #189ba6;">
                  Request Free 3D Layout &amp; Quote
                </button>
                <a href="https://wa.me/918369297174?text=Hi%20Siddhivinayak%20Designers,%20I'm%20interested%20in%20a%20similar%20interior%20design%20for%20my%20Kopar%20Khairane%20home" target="_blank" class="btn btn-outline-success w-100 py-2 rounded-3 fw-bold">
                  <i class="fab fa-whatsapp me-1"></i> WhatsApp Instant Estimate
                </a>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style is:global>

  /* White Card & Form Text Visibility */
  .portfolio-detail-wrapper .bg-white h1,
  .portfolio-detail-wrapper .bg-white h2,
  .portfolio-detail-wrapper .bg-white h3,
  .portfolio-detail-wrapper .bg-white h4,
  .portfolio-detail-wrapper .bg-white h5,
  .portfolio-detail-wrapper .bg-white strong {
    color: #111111 !important;
  }
  .portfolio-detail-wrapper .bg-white p,
  .portfolio-detail-wrapper .bg-white span,
  .portfolio-detail-wrapper .bg-white li,
  .portfolio-detail-wrapper .bg-white label {
    color: #475569 !important;
  }
  .portfolio-detail-wrapper .form-label {
    color: #334155 !important;
    font-weight: 600;
  }
  .portfolio-detail-wrapper .form-control,
  .portfolio-detail-wrapper .form-select {
    color: #111111 !important;
    background-color: #ffffff !important;
    border: 1px solid #cbd5e1 !important;
  }

  /* Only Dark CTA Banners get White Text */
  .portfolio-detail-wrapper [style*="linear-gradient"] h3,
  .immersive-gallery-wrapper [style*="linear-gradient"] h3 {
    color: #ffffff !important;
  }
  .portfolio-detail-wrapper [style*="linear-gradient"] p,
  .immersive-gallery-wrapper [style*="linear-gradient"] p {
    color: #f8fafc !important;
  }

  

    /* Desktop Hero Image Grid */
    .project-hero-main-img {
      height: 380px;
      transition: opacity 0.2s ease;
    }
    .project-hero-sub-img {
      height: 185px;
      transition: opacity 0.2s ease;
    }
    .project-hero-main-img:hover img, .project-hero-sub-img:hover img {
      transform: scale(1.03);
      transition: transform 0.4s ease;
    }
    .badge-pill-light {
      background-color: #f1f5f9;
      color: #334155;
      font-size: 0.8rem;
      padding: 5px 12px;
      border-radius: 20px;
      font-weight: 600;
      border: 1px solid #e2e8f0;
    }

    /* Mobile Responsive Overrides - Clean & Proportionate */
    @media (max-width: 768px) {
      .portfolio-detail-wrapper {
        padding-top: 10px !important;
        padding-bottom: 20px !important;
      }
      .portfolio-detail-wrapper .container {
        padding-left: 12px !important;
        padding-right: 12px !important;
      }
      .project-hero-main-img {
        height: 200px !important;
        border-radius: 10px !important;
      }
      .project-hero-sub-img {
        height: 95px !important;
        border-radius: 8px !important;
      }
      .portfolio-detail-wrapper h1 {
        font-size: 1.35rem !important;
        line-height: 1.3 !important;
        letter-spacing: -0.3px !important;
        margin-bottom: 6px !important;
      }
      .portfolio-detail-wrapper p.text-secondary {
        font-size: 0.85rem !important;
        margin-bottom: 12px !important;
      }
      .badge-pill-light {
        font-size: 0.72rem !important;
        padding: 3px 8px !important;
      }
      .portfolio-detail-wrapper .card, .portfolio-detail-wrapper .p-4 {
        padding: 16px !important;
        border-radius: 14px !important;
      }
      .portfolio-detail-wrapper h2.h4 {
        font-size: 1.15rem !important;
        margin-bottom: 10px !important;
      }
      .portfolio-detail-wrapper h3.h5 {
        font-size: 1.02rem !important;
        margin-bottom: 8px !important;
      }
      .portfolio-detail-wrapper p, .portfolio-detail-wrapper li {
        font-size: 0.88rem !important;
        line-height: 1.55 !important;
      }
      .portfolio-detail-wrapper .row.g-3 .col-6 {
        margin-bottom: 6px;
      }
      .portfolio-detail-wrapper .row.g-3 .text-secondary.small {
        font-size: 0.72rem !important;
      }
      .portfolio-detail-wrapper .row.g-3 strong {
        font-size: 0.88rem !important;
      }
      .portfolio-detail-wrapper .btn-danger {
        padding: 6px 14px !important;
        font-size: 0.78rem !important;
      }
      .portfolio-detail-wrapper .btn-outline-dark {
        padding: 4px 10px !important;
        font-size: 0.75rem !important;
      }
      .portfolio-detail-wrapper .form-label {
        font-size: 0.78rem !important;
        margin-bottom: 3px !important;
      }
      .portfolio-detail-wrapper .form-control, .portfolio-detail-wrapper .form-select {
        padding: 6px 10px !important;
        font-size: 0.85rem !important;
      }
      .portfolio-detail-wrapper .btn-dark, .portfolio-detail-wrapper .btn-outline-success {
        padding: 8px 12px !important;
        font-size: 0.85rem !important;
      }
    }
  </style>
</Layout>
