        <div style="width: 60px; height: 3px; background-color: #c5a880; margin: 20px auto 0;"></div>
      </div>

      <!-- Rhythmic Grid Layout -->
      <div class="gallery-grid">
        <!-- Row 1: Side by side -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/modern-4bhk-penthouse/1.webp" alt="Modern 4 BHK Penthouse Kharghar - Living Room Entryway" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/modern-4bhk-penthouse/2.webp" alt="Modern 4 BHK Penthouse Kharghar - Premium Living Area Lounge" loading="lazy" />
        </div>

        <!-- Row 2: Full Width -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/modern-4bhk-penthouse/3.webp" alt="Modern 4 BHK Penthouse Kharghar - High-End Accent TV Unit Wall" loading="lazy" />
        </div>

        <!-- Row 3: Side by side -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/modern-4bhk-penthouse/4.webp" alt="Modern 4 BHK Penthouse Kharghar - Master Bedroom Suite Setup" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/modern-4bhk-penthouse/5.webp" alt="Modern 4 BHK Penthouse Kharghar - False Ceiling & Profile Lighting Detail" loading="lazy" />
        </div>

        <!-- Row 4: Full Width -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/modern-4bhk-penthouse/6.webp" alt="Modern 4 BHK Penthouse Kharghar - Luxury Dining Area Set with Wooden Details" loading="lazy" />
        </div>

        <!-- Row 5: Side by side -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/modern-4bhk-penthouse/7.webp" alt="Modern 4 BHK Penthouse Kharghar - Custom Walk-in Wardrobe Space" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/modern-4bhk-penthouse/8.webp" alt="Modern 4 BHK Penthouse Kharghar - Secondary Guest Bedroom Layout" loading="lazy" />
        </div>

        <!-- Row 6: Full Width -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/modern-4bhk-penthouse/9.webp" alt="Modern 4 BHK Penthouse Kharghar - Modular Kitchen L-Shape Cabinetry" loading="lazy" />
        </div>

        <!-- Row 7: Side by side -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/modern-4bhk-penthouse/10.webp" alt="Modern 4 BHK Penthouse Kharghar - Modular Kitchen Storage Drawers Detail" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/modern-4bhk-penthouse/11.webp" alt="Modern 4 BHK Penthouse Kharghar - Kids Bedroom Colorful Setup" loading="lazy" />
        </div>

        <!-- Row 8: Full Width -->
        <div class="grid-item span-2" data-aos="fade-up">
          <img src="/assets/images/modern-4bhk-penthouse/12.webp" alt="Modern 4 BHK Penthouse Kharghar - Premium Pooja Room Wood Finish Jaali" loading="lazy" />
        </div>

        <!-- Row 9: Side by side -->
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/modern-4bhk-penthouse/13.webp" alt="Modern 4 BHK Penthouse Kharghar - Balcony Cane Lamps Lighting Detail" loading="lazy" />
        </div>
        <div class="grid-item span-1" data-aos="fade-up">
          <img src="/assets/images/modern-4bhk-penthouse/14.webp" alt="Modern 4 BHK Penthouse Kharghar - Bathroom Hanging Lights Vanity" loading="lazy" />
        </div>
      </div>

      <!-- Kharghar Hub Backlink & CTA -->
      <div class="mt-5 p-4 rounded-4 text-center border" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff;">
        <h3 class="h4 font-luxury text-white mb-2">Want a Similar Luxury Penthouse Interior in Kharghar?</h3>
        <p class="small text-white-50 mb-3">Speak with our senior interior designers for custom 3D layouts, German CNC woodwork, and turnkey execution.</p>
        <div class="d-flex flex-wrap gap-2 justify-content-center">
          <a href="/cities/interior-designers-navi-mumbai/kharghar/" class="btn btn-primary btn-sm px-4 rounded-pill fw-bold" style="background-color: #189ba6; border-color: #189ba6;">Explore Kharghar Hub</a>
          <a href="/cities/interior-designers-navi-mumbai/kharghar/2bhk-3bhk-interiors/" class="btn btn-outline-light btn-sm px-3 rounded-pill">2BHK &amp; 3BHK Interiors</a>
          <a href="/cities/interior-designers-navi-mumbai/kharghar/interior-design-cost/" class="btn btn-outline-light btn-sm px-3 rounded-pill">2026 Cost Guide</a>
        </div>
      </div>
    </div>
  </div>
`;
---

<Layout title={title} description={description} canonical={canonical}>
  <Fragment set:html={bodyContent} />
</Layout>

<style is:global>
  /* Immersive Gallery Styles */
  .immersive-gallery-wrapper {
    background-color: #ffffff !important;
    min-height: 100vh;
    width: 100%;
    position: relative;
    z-index: 10;
  }

  /* Force hide header, footer, and navigation bars on this full-screen layout */
  header, footer, nav, .header, .footer, .floating-widgets {
    display: none !important;
  }

  /* Reset layout spacing */
  body, main {
    background-color: #ffffff !important;
    padding-top: 0 !important;
    margin-top: 0 !important;
    overflow-x: hidden;
  }

  /* Circular close button */
  .close-btn {
    position: fixed;
    top: 24px;
    right: 24px;
    width: 48px;
    height: 48px;
    background-color: #111111;
    border-radius: 50%;
    color: #ffffff !important;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 10050;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    border: none;
    text-decoration: none !important;
  }

  .close-btn:hover {
    background-color: #000000;
    transform: scale(1.08) rotate(90deg);
  }

  .close-btn i {
    font-size: 18px;
  }

  /* Grid Layout */
  .gallery-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 80px 24px;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .grid-item {
    position: relative;
    overflow: hidden;
    background: #fdfdfd;
    border-radius: 4px;
  }

  .grid-item img {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
    border-radius: 4px;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.05);
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .grid-item img:hover {
    transform: scale(1.02);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
  }

  .span-2 {
    grid-column: span 2;
  }

  .span-1 {
    grid-column: span 1;
  }

  /* Mobile responsiveness */
  @media (max-width: 767px) {
    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .grid-item img {
      aspect-ratio: 3 / 4 !important;
      object-fit: cover !important;
    }
    .span-2 {
      grid-column: span 1;
    }
    .gallery-container {
      padding: 60px 16px;
    }
    .close-btn {
      top: 16px;
      right: 16px;
      width: 40px;
      height: 40px;
    }
    .close-btn i {
      font-size: 16px;
    }
  }
</style>
