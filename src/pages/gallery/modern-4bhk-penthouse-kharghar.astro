---
import Layout from '../../layouts/Layout.astro';

const title = "Modern 4 BHK Penthouse, Kharghar | Siddhivinayak Designers";
const description = "Explore the complete design portfolio of our Modern 4 BHK Penthouse in Kharghar. Executive luxury interiors, false ceilings, and premium carpentry.";
const canonical = "https://siddhivinayakdesigners.in/gallery/modern-4bhk-penthouse-kharghar/";

const bodyContent = `
  <!-- Custom Immersive Gallery Page -->
  <div class="immersive-gallery-wrapper">
    <!-- Fixed Close Button -->
    <a href="/#glimpseSection" class="close-btn" aria-label="Close and return to homepage">
      <i class="fas fa-times"></i>
    </a>

    <div class="gallery-container">
      <!-- Title Header Block -->
      <div class="gallery-header text-center mb-5" data-aos="fade-down">
        <h1 class="font-luxury fw-bold mb-2" style="color: #111111 !important; font-size: clamp(2rem, 5vw, 3rem);">Modern 4 BHK Penthouse</h1>
