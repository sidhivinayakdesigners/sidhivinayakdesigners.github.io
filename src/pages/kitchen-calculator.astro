    function showStepBox(num) {
      document.querySelectorAll('.calc-step').forEach(box => box.classList.remove('active'));
      document.getElementById('stepBox' + num).classList.add('active');
      
      // If Step 2, update dynamic reference guide photo
      if (num === 2) {
        updateStep2ReferenceDiagram();
      }

      // Update Progress Timeline
      document.querySelectorAll('.timeline-step').forEach((step, index) => {
        step.classList.remove('active', 'completed');
        if (index + 1 < num) {
          step.classList.add('completed');
        } else if (index + 1 === num) {
          step.classList.add('active');
        }
      });

      // Update Timeline line progress
      const progressPercent = ((num - 1) / 3) * 80;
      document.getElementById('timelineProgress').style.width = progressPercent + '%';

      // Update Counter Label
      document.getElementById('stepCounterLabel').textContent = num + '/4';

      // Update footer buttons
      if (num === 1) {
        document.getElementById('btnPillBack').style.visibility = 'hidden';
      } else {
        document.getElementById('btnPillBack').style.visibility = 'visible';
      }

      if (num === 4) {
        document.getElementById('btnPillNext').textContent = 'Submit';
      } else {
        document.getElementById('btnPillNext').textContent = 'Next';
        document.getElementById('btnPillNext').style.display = 'inline-block';
      }
    }

    function goPillNext() {
      if (currentStep === 1) {
        if (!selectedLayoutName) return;
        currentStep = 2;
        showStepBox(2);
      } else if (currentStep === 2) {
        currentStep = 3;
        showStepBox(3);
      } else if (currentStep === 3) {
        currentStep = 4;
        showStepBox(4);
      } else if (currentStep === 4) {
        // Trigger Submit Form
        const name = document.getElementById('leadName').value;
        const email = document.getElementById('leadEmail').value;
        const phone = document.getElementById('leadPhone').value;
        const city = document.getElementById('leadCity').value;
        
        if (name && email && phone && city) {
          const prices = calculateInstantEstimate();
          
          const summaryData = {
            layout: selectedLayoutName,
            dimensions: `A: ${measureA} ft., B: ${measureB} ft.`,
            package: packageName
          };
          
          localStorage.setItem("kitchen_calc_summary", JSON.stringify(summaryData));
          
          window.location.href = `/kitchen-calculator-result?min=${prices.min}&max=${prices.max}`;
        } else {
          alert('Please fill out all fields.');
        }
      }
    }

    function goPillBack() {
      if (currentStep > 1) {
        currentStep--;
        showStepBox(currentStep);
      }
    }

    function calculateInstantEstimate() {
      // Base Size total linear feet is 11 (A=3, B=8)
      const totalLinearFeet = measureA + measureB;
      const sizeMultiplier = totalLinearFeet / 11;

      const calculatedMin = (minBasePrice * sizeMultiplier * packageMultiplier) / 100000;
      const calculatedMax = (maxBasePrice * sizeMultiplier * packageMultiplier) / 100000;

      return {
        min: Math.round(calculatedMin),
        max: Math.round(calculatedMax)
      };
    }
