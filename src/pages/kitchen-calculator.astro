<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <Fragment set:html={bodyContent} />
</Layout>

<style is:global>
    /* High specificity overrides to hide the dynamically injected mobile bottom bar */
    div#dcMobileBottomBar {
      display: none !important;
    }
    html body {
      padding-bottom: 0 !important;
    }

    * {
      box-sizing: border-box;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    }
    html, body {
      background-color: #f3f6f8 !important;
      color: #333333;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      margin: 0;
      overflow-x: hidden;
      width: 100%;
    }

    .calc-header-logo {
      min-width: auto;
    }
    .calc-header-counter {
      min-width: auto;
    }
    @media (min-width: 768px) {
      .calc-header-logo {
        min-width: 320px;
      }
      .calc-header-counter {
        min-width: 320px;
      }
    }

    /* Progress Header */
    .calc-top-header {
      background: #ffffff;
      border-bottom: 1px solid #e2e8f0;
      padding: 0.75rem 2rem;
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    .timeline-container {
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      width: 100%;
      padding: 0;
    }
    .timeline-line {
      position: absolute;
      top: 10px;
      left: 10%;
      right: 10%;
      height: 3px;
      background: #e2e8f0;
      z-index: 1;
    }
    .timeline-progress {
      position: absolute;
      top: 10px;
      left: 10%;
      height: 3px;
      background: #4a3748;
      width: 0%;
      transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 2;
    }
    .timeline-step {
      flex: 1;
      text-align: center;
      position: relative;
      z-index: 3;
    }
    .step-dot {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: #ffffff;
      border: 3px solid #cbd5e1;
      margin: 0 auto 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.65rem;
      color: transparent;
      transition: all 0.3s ease;
    }
    .timeline-step.active .step-dot {
      border-color: #4a3748;
      background: #ffffff;
    }
    .timeline-step.active .step-dot::after {
      content: '';
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #4a3748;
    }
    .timeline-step.completed .step-dot {
      border-color: #4a3748;
      background: #4a3748;
      color: #ffffff;
    }
    .step-text {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      color: #94a3b8;
      letter-spacing: 0.5px;
      display: block;
    }
    .timeline-step.active .step-text, .timeline-step.completed .step-text {
      color: #4a3748;
    }
    .step-counter-label {
      font-size: 0.95rem;
      font-weight: 700;
      color: #475569;
    }

    /* Main Calculator Container Card */
    .calc-card-wrapper {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2.5rem 1rem 6.5rem !important;
    }
    .calc-box {
      background: #ffffff;
      border-radius: 20px;
      width: 100%;
      max-width: 680px;
      padding: 3rem 2.5rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
      border: 1px solid rgba(226, 232, 240, 0.8);
      min-height: 480px;
      display: flex;
      flex-direction: column;
    }
    .calc-heading {
      font-size: 1.65rem;
      font-weight: 800;
      color: #2d1e2f !important;
      margin-bottom: 0.4rem;
      text-align: center;
    }
    .calc-subheading {
      font-size: 0.95rem;
      color: #64748b;
      margin-bottom: 2rem;
      text-align: center;
      font-weight: 500;
    }
    .calc-subheading a {
      color: #ec5252;
      text-decoration: none;
      font-weight: 600;
    }

    /* Step 1: Layout Selection Cards */
    .layout-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    .layout-choice-card {
      border: 1.5px solid #e2e8f0;
      border-radius: 12px;
      padding: 1.5rem;
      cursor: pointer;
      background: #ffffff;
      transition: all 0.25s ease;
      text-align: center;
      position: relative;
    }
    .layout-choice-card:hover {
      border-color: #fca5a5;
    }
    .layout-choice-card.selected {
      border-color: #ec5252 !important;
      background: #fef2f2 !important;
    }
    .layout-icon-box {
      margin-bottom: 1rem;
      display: flex;
      justify-content: center;
    }
    .layout-label {
      font-size: 1.05rem;
      font-weight: 700;
      color: #334155;
    }

    /* Step 2: Measurements Dropdowns */
    .measure-box {
      background: #fafbfc;
      border: 1px solid #e2e8f0;
      border-radius: 12px;
      padding: 2rem;
      margin-bottom: 1.5rem;
    }
    .measure-label {
      font-size: 0.88rem;
      font-weight: 800;
      color: #ec5252;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 0.5rem;
    }
    .measure-select-field {
      width: 100%;
      border: 1.5px solid #cbd5e1;
      border-radius: 10px;
      padding: 0.85rem 1.25rem;
      font-size: 0.95rem;
      font-weight: 600;
      color: #1e293b;
      background: #ffffff;
      outline: none;
      transition: all 0.25s ease;
    }
    .measure-select-field:focus {
      border-color: #ec5252;
    }

    /* Step 3: Packages styling (Compact) */
    .package-scroll-wrap {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .pkg-choice-card {
      border: 1.5px solid #e2e8f0;
      border-radius: 12px;
      padding: 0.9rem;
      cursor: pointer;
      background: #ffffff;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      gap: 12px;
    }
    .pkg-choice-card:hover {
      border-color: #fca5a5;
    }
    .pkg-choice-card.selected {
      border-color: #ec5252 !important;
      background: #fef2f2 !important;
    }
    .pkg-radio-col {
      width: 20px;
    }
    .pkg-info-col {
      flex: 1;
    }
    .pkg-title-line {
      font-size: 0.95rem;
      font-weight: 800;
      color: #1e293b !important;
      margin-bottom: 0.2rem;
    }
    .pkg-subtitle-line {
      font-size: 0.78rem;
      color: #64748b;
      line-height: 1.4;
      margin-bottom: 0.6rem;
    }
    .pkg-image {
      width: 100%;
      height: 110px;
      object-fit: cover;
      border-radius: 8px;
      margin-bottom: 0.6rem;
      border: 1px solid #f1f5f9;
    }
    .pkg-checklist {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .pkg-checklist li {
      font-size: 0.75rem;
      font-weight: 600;
      color: #475569;
      display: flex;
      align-items: center;
      gap: 5px;
      margin-bottom: 4px;
    }
    .pkg-checklist li i {
      color: #ec5252;
    }

    /* Step 4: Form */
    .lead-form-wrap {
      max-width: 480px;
      margin: 0 auto;
      width: 100%;
    }
    .calc-input-group {
      margin-bottom: 1.25rem;
    }
    .calc-input-field {
      width: 100%;
      border: 1.5px solid #cbd5e1;
      border-radius: 10px;
      padding: 0.85rem 1.25rem;
      font-size: 0.95rem;
      font-weight: 600;
      color: #1e293b;
      background: #ffffff;
      outline: none;
      transition: all 0.25s ease;
    }
    .calc-input-field:focus {
      border-color: #ec5252;
      box-shadow: 0 0 0 4px rgba(236, 82, 82, 0.1);
    }
    .whatsapp-checkbox-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 1.5rem;
      cursor: pointer;
      user-select: none;
    }
    .whatsapp-check-box {
      width: 20px;
      height: 20px;
      border-radius: 4px;
      border: 2px solid #cbd5e1;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      color: transparent;
      transition: all 0.2s ease;
    }
    .whatsapp-checkbox-row.active .whatsapp-check-box {
      border-color: #ec5252;
      background: #ec5252;
      color: #ffffff;
    }
    .whatsapp-label {
      font-size: 0.88rem;
      font-weight: 600;
      color: #475569;
    }

    /* Fixed Bottom Action Bar */
    .calc-bottom-action-bar {
      background: #ffffff !important;
      border-top: 1px solid #e2e8f0;
      padding: 1rem 0;
      position: sticky;
      bottom: 0;
      width: 100%;
      z-index: 100;
    }

    /* Hide mobile bottom bar specifically on calculator pages */
    @media (max-width: 991px) {
      .dc-mobile-bottom-bar {
        display: none !important;
      }
      body {
        padding-bottom: 0 !important;
      }
    }
    .action-bar-container {
      max-width: 680px;
      margin: 0 auto;
      padding: 0 15px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .calc-btn-pill-back {
      background: transparent;
      border: none;
      font-weight: 700;
      color: #fca5a5;
      font-size: 0.95rem;
      padding: 0.75rem 1.5rem;
      cursor: pointer;
      transition: color 0.2s ease;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .calc-btn-pill-back:hover {
      color: #ec5252;
    }
    .calc-btn-pill-next {
      background: #ec5252 !important;
      color: #ffffff !important;
      font-weight: 800;
      font-size: 0.95rem;
      letter-spacing: 0.8px;
      text-transform: uppercase;
      padding: 0.85rem 3.5rem;
      border-radius: 50px;
      border: none;
      box-shadow: 0 6px 18px rgba(236, 82, 82, 0.28);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1) !important;
    }
    .calc-btn-pill-next:disabled {
      background: #cbd5e1 !important;
      box-shadow: none !important;
      cursor: not-allowed;
    }
    .calc-btn-pill-next:not(:disabled):hover {
      background: #d93d3d !important;
      transform: translateY(-2px);
      box-shadow: 0 10px 24px rgba(236, 82, 82, 0.42);
    }

    /* Step Containers */
    .calc-step {
      display: none;
      animation: fadeInSlide 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
    .calc-step.active {
      display: block;
    }

    @keyframes fadeInSlide {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @media (max-width: 768px) {
      .calc-card-wrapper {
        padding: 1rem 0.5rem 5.5rem !important;
      }
      .calc-box {
        padding: 1.5rem 1rem !important;
        min-height: auto !important;
        border-radius: 12px !important;
      }
      .calc-heading {
        font-size: 1.35rem !important;
      }
      .calc-subheading {
        font-size: 0.85rem !important;
        margin-bottom: 1.25rem !important;
      }
      .layout-grid {
        grid-template-columns: repeat(2, 1fr) !important;
        gap: 10px !important;
      }
      .layout-choice-card {
        padding: 0.75rem 0.5rem !important;
      }
      .layout-label {
        font-size: 0.85rem !important;
      }
      .layout-icon-box svg {
        max-width: 100% !important;
        height: auto !important;
      }
      .calc-bottom-action-bar {
        padding: 0.75rem 0 !important;
      }
      .calc-btn-pill-next {
        padding: 0.75rem 2.5rem !important;
        font-size: 0.88rem !important;
      }
      .calc-btn-pill-back {
        font-size: 0.88rem !important;
      }
    }
</style>

<script is:inline>
    let currentStep = 1;
    let selectedLayoutName = '';
    let minBasePrice = 0;
    let maxBasePrice = 0;
    let measureA = 3;
    let measureB = 8;
    let packageMultiplier = 1.0;
    let packageName = 'Essentials';

    function selectKitchenLayout(name, minP, maxP, cardElement) {
      document.querySelectorAll('.layout-choice-card').forEach(c => c.classList.remove('selected'));
      cardElement.classList.add('selected');
      
      selectedLayoutName = name;
      minBasePrice = minP;
      maxBasePrice = maxP;

      document.getElementById('btnPillNext').disabled = false;
    }

    function updateDimensions() {
      measureA = parseInt(document.getElementById('measureA').value);
      measureB = parseInt(document.getElementById('measureB').value);
    }

    function selectPkgCard(element, pkgName, multiplier) {
      document.querySelectorAll('.pkg-choice-card').forEach(c => c.classList.remove('selected'));
      element.classList.add('selected');
      packageName = pkgName;
      packageMultiplier = multiplier;
    }

    function toggleWhatsAppCheckbox(element) {
      element.classList.toggle('active');
    }

    function updateStep2ReferenceDiagram() {
      const container = document.getElementById('measureRefPhotoContainer');
      if (!container) return;

      let svgHtml = '';
      if (selectedLayoutName === 'L-shaped') {
        svgHtml = `
          <svg width="220" height="150" viewBox="0 0 220 150" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- L-shape Countertop -->
            <path d="M45 125 V35 H175 V70 H85 V125 H45 Z" fill="#ebd9d0" stroke="#7e6e65" stroke-width="2.5" stroke-linejoin="round"/>
            
