        <!-- Reference Photo/Diagram Container -->
        <div id="measureRefPhotoContainer" style="display: flex; justify-content: center; margin-bottom: 2rem; background: #fafbfc; border: 1px dashed #cbd5e1; border-radius: 12px; padding: 1.5rem; min-height: 180px;">
