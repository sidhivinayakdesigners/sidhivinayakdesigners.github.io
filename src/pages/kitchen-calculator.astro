      <!-- STEP 3: PICK PACKAGE -->
      <div class="calc-step" id="stepBox3">
        <h1 class="calc-heading">Pick your package</h1>
        <p class="calc-subheading">Choose design &amp; materials suited for your cooking style</p>

        <div class="package-scroll-wrap">
          <!-- Essentials -->
          <div class="pkg-choice-card selected" onclick="selectPkgCard(this, 'Essentials', 1.0)">
            <div class="pkg-radio-col">
              <div class="custom-radio"></div>
            </div>
            <div class="pkg-info-col">
              <h3 class="pkg-title-line">Essentials (₹₹)</h3>
              <p class="pkg-subtitle-line">A range of basic units and acessories that are necessary for a comfortable modular kitchen.</p>
              <img src="/assets/images/modular-kitchen/kitchen-with-foldable-breakfast-table-and-yellow-chairs.webp" class="pkg-image" alt="Essentials Kitchen Package" />
              <ul class="pkg-checklist">
                <li><i class="fas fa-check"></i> Affordable pricing</li>
                <li><i class="fas fa-check"></i> Convenient designs</li>
                <li><i class="fas fa-check"></i> Basic accessories</li>
              </ul>
            </div>
          </div>

          <!-- Premium -->
          <div class="pkg-choice-card" onclick="selectPkgCard(this, 'Premium', 1.35)">
            <div class="pkg-radio-col">
              <div class="custom-radio"></div>
            </div>
            <div class="pkg-info-col">
              <h3 class="pkg-title-line">Premium (₹₹₹)</h3>
              <p class="pkg-subtitle-line">An exquisite offering with sleek fixtures, hardware, cabinets and fittings for an elegant kitchen design.</p>
              <img src="/assets/images/modular-kitchen/an-l-shaped-kitchen-with-green-base-cabinets-and-white-upper-cabinets-kitchen-interior-design.webp" class="pkg-image" alt="Premium Kitchen Package" />
              <ul class="pkg-checklist">
                <li><i class="fas fa-check"></i> Mid-range pricing</li>
                <li><i class="fas fa-check"></i> Premium designs</li>
                <li><i class="fas fa-check"></i> Wide range of accessories</li>
              </ul>
            </div>
          </div>

          <!-- Luxe -->
          <div class="pkg-choice-card" onclick="selectPkgCard(this, 'Luxe', 1.75)">
            <div class="pkg-radio-col">
              <div class="custom-radio"></div>
            </div>
            <div class="pkg-info-col">
              <h3 class="pkg-title-line">Luxe (₹₹₹₹)</h3>
              <p class="pkg-subtitle-line">A swanky kitchen package that's a fine blend of aesthetics and high functionality with chic-looking units and accessories.</p>
              <img src="/assets/images/modular-kitchen/a-u-shaped-kitchen-home-interior-design-with-black-matte-finish-cabinets-that-add-a-sleek-look.webp" class="pkg-image" alt="Luxe Kitchen Package" onerror="this.src='/assets/images/modular-kitchen/kitchen-with-foldable-breakfast-table-and-yellow-chairs.webp'" />
              <ul class="pkg-checklist">
                <li><i class="fas fa-check"></i> Elite pricing</li>
                <li><i class="fas fa-check"></i> Lavish designs</li>
                <li><i class="fas fa-check"></i> Extensive range of accessories</li>
              </ul>
            </div>
          </div>

          <!-- Build your own package -->
          <div class="pkg-choice-card" onclick="selectPkgCard(this, 'Build your own package', 1.20)">
            <div class="pkg-radio-col">
              <div class="custom-radio"></div>
            </div>
            <div class="pkg-info-col">
              <h3 class="pkg-title-line">Build your own package</h3>
              <p class="pkg-subtitle-line">A flexible, built-to-suit option that lets you pick and choose from a collection of well-crafted finishes and accessories.</p>
              <img src="/assets/images/modular-kitchen/bold-kitchen-design-with-drawers-and-organisers.webp" class="pkg-image" alt="Build your own package Kitchen Package" onerror="this.src='/assets/images/modular-kitchen/kitchen-with-foldable-breakfast-table-and-yellow-chairs.webp'" />
              <ul class="pkg-checklist">
                <li><i class="fas fa-check"></i> Customised pricing</li>
                <li><i class="fas fa-check"></i> Flexible designs</li>
                <li><i class="fas fa-check"></i> Range of accessories to pick from</li>
              </ul>
            </div>
          </div>
        </div>
      </div>

      <!-- STEP 4: GET QUOTE / LEAD FORM -->
      <div class="calc-step" id="stepBox4">
        <h1 class="calc-heading">Your kitchen estimate is almost ready!</h1>
        <p class="calc-subheading">Submit your contact info to view your instant cost estimate report</p>

        <div class="lead-form-wrap">
          <form onsubmit="handleFinalSubmit(event)">
            <div class="calc-input-group">
              <input type="text" class="calc-input-field" placeholder="Name" id="leadName" required />
            </div>
