<!-- Header Banner -->
<section class="py-5" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff;">
  <div class="container py-4 text-center">
    <span class="badge px-3 py-2 text-uppercase fw-bold mb-3" style="background: #189ba6; color: #ffffff; letter-spacing: 1px; font-size: 0.75rem;">Specialized Kharghar Layouts</span>
    <h1 class="font-luxury text-white mb-2" style="font-size: clamp(1.8rem, 3.5vw, 2.5rem);">2 BHK &amp; 3 BHK Interior Design in Kharghar</h1>
    <p class="text-white-50 mx-auto" style="max-width: 700px; font-size: 1rem;">Space-Optimized Furniture • 100% IS:710 Marine Plywood • 45-Day Guaranteed Handover</p>
    <div class="custom-breadcrumb text-center justify-content-center d-flex gap-2 mt-3">
      <a href="/cities/interior-designers-navi-mumbai/kharghar/" class="btn btn-sm btn-outline-light rounded-pill px-3"><i class="fas fa-arrow-left me-1"></i> Kharghar Main Hub</a>
      <a href="/cities/interior-designers-navi-mumbai/kharghar/interior-design-cost/" class="btn btn-sm btn-light rounded-pill px-3 text-teal fw-bold" style="color: #189ba6;">Cost Guide <i class="fas fa-arrow-right ms-1"></i></a>
    </div>
  </div>
</section>

<!-- Content Section -->
<section class="py-5 bg-white text-dark">
  <div class="container py-4">
    <div class="row g-5">
      <div class="col-lg-8">
        <h2 class="font-luxury h3 mb-4" style="color: #0f172a;">Tailored Living Spaces for Kharghar Modern Towers</h2>
        <p class="text-secondary leading-relaxed">
          Designing 2 BHK and 3 BHK flats in Kharghar requires an architectural balance of open spatial aesthetics and maximum concealed storage. Whether you own a 750 sq.ft 2BHK in <em>CIDCO Valley Shilp / Celebration CHS</em> or a spacious 1400 sq.ft 3BHK in <em>Hiranandani Crystal, Paradise Sai World Empire, or Juhi Niharika Mirage</em>, our interior design team maximizes every square foot of your carpet area.
        </p>

        <h3 class="font-luxury h4 mt-5 mb-3" style="color: #0f172a;">Custom 2 BHK &amp; 3 BHK Scope of Work</h3>
        
        <div class="row g-4 my-3 text-secondary">
          <div class="col-md-6">
            <div class="p-4 bg-light border rounded-4 h-100 shadow-sm">
              <h4 class="h5 fw-bold text-dark mb-2"><i class="fas fa-expand text-teal me-2" style="color: #189ba6;"></i> 2 BHK Flat Package</h4>
              <p class="small mb-3">Tailored for young professionals and families in Sectors 10, 20 &amp; 35:</p>
              <ul class="small ps-3 mb-0">
                <li class="mb-1"><strong>L-Shape/Parallel Modular Kitchen</strong> with soft-close Hettich tandem boxes.</li>
                <li class="mb-1"><strong>Master Bedroom Sliding Wardrobe</strong> with floor-to-ceiling loft storage.</li>
                <li class="mb-1"><strong>Living Room TV Wall Unit</strong> with fluted charcoal louvers and concealed wiring.</li>
                <li class="mb-1"><strong>False Ceiling (Saint-Gobain)</strong> with 3000K warm profile LED lighting.</li>
                <li class="mb-1"><strong>Asian Paints Royale Luxury Emulsion</strong> throughout the flat.</li>
              </ul>
            </div>
          </div>
          <div class="col-md-6">
            <div class="p-4 bg-light border rounded-4 h-100 shadow-sm">
              <h4 class="h5 fw-bold text-dark mb-2"><i class="fas fa-gem text-teal me-2" style="color: #189ba6;"></i> 3 BHK Luxury Package</h4>
              <p class="small mb-3">Designed for high-rise gated societies in Sectors 20, 35 &amp; 36:</p>
              <ul class="small ps-3 mb-0">
                <li class="mb-1"><strong>Island / U-Shaped Modular Kitchen</strong> with quartz counter and built-in appliances.</li>
                <li class="mb-1"><strong>3 Custom Wardrobes</strong> (Walk-in glass wardrobe in Master Suite).</li>
                <li class="mb-1"><strong>Living-Dining Spatial Divider</strong> (Cnc metal / wooden jali fluted screen).</li>
                <li class="mb-1"><strong>Kids Bedroom Theme</strong> with study desk, library bookshelf, and hydraulic storage bed.</li>
                <li class="mb-1"><strong>Balcony Wooden Decking</strong> (WPC weather-resistant anti-skid planks).</li>
              </ul>
            </div>
          </div>
        </div>

        <h3 class="font-luxury h4 mt-5 mb-3" style="color: #0f172a;">Why Kharghar Flats Require 100% BWP Marine Plywood</h3>
        <p class="text-secondary leading-relaxed">
          Because Kharghar is situated adjacent to the Western Ghats and Pandavkada waterfalls, the local monsoon air carries extreme dampness (frequently exceeding 90% RH). Using commercial particle board (PLPB) or low-grade MDF results in warped cabinet doors, bubbling laminate, and fungal infestation. At Siddhivinayak Designers, we construct all modular cabinetry strictly using <strong>IS:710 Certified Boiling Water Proof (BWP) Marine Plywood</strong> with German PUR hot-melt edge banding, guaranteed for 10 years.
        </p>

        <!-- Completed Project Reference -->
        <div class="p-4 rounded-4 my-4 border" style="background: #f8fafc;">
          <h4 class="h6 fw-bold text-dark mb-2"><i class="fas fa-camera text-teal me-2" style="color: #189ba6;"></i> Real Kharghar Handover Showcase</h4>
          <p class="small text-secondary mb-3">Check out our real 3BHK flat interior execution in Sector 20 Kharghar with sliding wardrobes and an acrylic kitchen.</p>
          <a href="/gallery/3bhk-interior-design-in-kharghar-with-swing-and-sliding-wardrobes/" class="btn btn-sm btn-primary rounded-pill px-3" style="background-color: #189ba6; border-color: #189ba6;">
            View 3BHK Kharghar Gallery <i class="fas fa-arrow-right ms-1"></i>
          </a>
        </div>

        <!-- Back Link & CTA -->
        <div class="mt-5 p-4 rounded-4 text-center border" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: #ffffff;">
          <h4 class="font-luxury h5 mb-3 text-white">Book a Free Site Measurement Visit in Kharghar</h4>
          <p class="small text-white-50 mb-4">Our senior interior architects will visit your flat in Kharghar, assess structural layout options, and provide a 3D floor plan with an itemized BOQ.</p>
          <div class="d-flex flex-wrap gap-3 justify-content-center">
            <a href="/calculator/" class="btn btn-primary px-4 py-2 rounded-pill fw-bold" style="background-color: #189ba6; border-color: #189ba6;">Calculate 2BHK/3BHK Cost</a>
            <a href="/cities/interior-designers-navi-mumbai/kharghar/" class="btn btn-outline-light px-4 py-2 rounded-pill">Back to Kharghar Hub</a>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="col-lg-4">
        <div class="p-4 rounded-4 border bg-light shadow-sm mb-4">
          <h4 class="h5 fw-bold text-dark mb-3">Kharghar Cluster Navigation</h4>
          <ul class="list-unstyled ps-0 mb-0 small">
            <li class="mb-2"><a href="/cities/interior-designers-navi-mumbai/kharghar/" class="text-decoration-none text-dark fw-bold"><i class="fas fa-chevron-right text-teal me-2" style="color: #189ba6;"></i> Kharghar Overview Hub</a></li>
            <li class="mb-2"><a href="/cities/interior-designers-navi-mumbai/kharghar/2bhk-3bhk-interiors/" class="text-decoration-none fw-bold" style="color: #189ba6;"><i class="fas fa-chevron-right me-2"></i> 2BHK &amp; 3BHK Interiors (Active)</a></li>
            <li class="mb-2"><a href="/cities/interior-designers-navi-mumbai/kharghar/interior-design-cost/" class="text-decoration-none text-dark fw-bold"><i class="fas fa-chevron-right text-teal me-2" style="color: #189ba6;"></i> 2026 Cost &amp; Pricing Guide</a></li>
            <li class="mb-2"><a href="/cities/interior-designers-navi-mumbai/kharghar/modular-kitchen/" class="text-decoration-none text-dark fw-bold"><i class="fas fa-chevron-right text-teal me-2" style="color: #189ba6;"></i> Modular Kitchens</a></li>
          </ul>
        </div>

        <div class="p-4 rounded-4 border bg-light shadow-sm mb-4">
          <h4 class="h5 fw-bold text-dark mb-3">Kharghar Flat Budget Estimate</h4>
          <div class="mb-3">
            <span class="d-block small text-muted">2 BHK Turnkey Package</span>
            <span class="h5 fw-bold text-teal" style="color: #189ba6;">₹5.5 L - ₹8.0 Lakhs</span>
          </div>
          <div class="mb-3">
            <span class="d-block small text-muted">3 BHK Turnkey Package</span>
            <span class="h5 fw-bold text-teal" style="color: #189ba6;">₹8.5 L - ₹13.5 Lakhs</span>
          </div>
          <a href="https://wa.me/918369297174?text=Hi%20Siddhivinayak%20Designers,%20I'm%20interested%20in%20a%202BHK/3BHK%20interior%20quote%20for%20my%20Kharghar%20flat." target="_blank" class="btn btn-outline-success w-100 rounded-pill fw-bold">
            <i class="fab fa-whatsapp me-1"></i> WhatsApp for Free Estimate
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Floating Buttons -->
<div class="floating-widgets">
  <a style="background-color: #25D366 !important; background: #25D366 !important; color: #ffffff !important; border-color: #25D366 !important;" class="float-btn float-whatsapp" href="https://wa.me/918369297174?text=Hi%20Siddhivinayak%20Designers,%20I'm%20interested%20in%202BHK/3BHK%20interior%20design%20in%20Kharghar." target="_blank">
