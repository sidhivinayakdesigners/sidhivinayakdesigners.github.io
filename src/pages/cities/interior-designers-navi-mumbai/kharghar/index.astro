<Layout title={title} description={description} canonical={canonical} schema={schema} showNaviMumbaiFooter={false}>
  <Fragment set:html={bodyContent} />
</Layout>

<style is:global>
html, body {
  background-color: #ffffff !important;
  color: #000000 !important;
  font-family: Arial, Helvetica, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
}
.hero-section, .catalog-directory-hero, .dc-top-section-bg, header.bg-dark, .bg-dark, .bg-dark-card, .bg-dark-contrast, .bg-dark-gradient {
  background-color: #f3f6f8 !important;
  color: #000000 !important;
}
h1, h2, h3, h4, h5, h6, .section-title, .display-4, .display-6 {
  color: #000000 !important;
}
p, span, li, label, div, small, strong, p *, li *, span *, label *, div *, small *, strong *, .text-muted, .text-white-50, .text-secondary, .text-muted * {
  color: #000000 !important;
}
:not(footer) .text-white, body:not(footer) .text-white, a.text-white:not(footer a), .section-title.text-white {
  color: #000000 !important;
}
.text-gold, .text-gold * {
  color: #189ba6 !important;
}
.btn-gold, .btn-primary {
  background-color: #189ba6 !important;
  border-color: #189ba6 !important;
  color: #ffffff !important;
}
.btn-gold:hover, .btn-primary:hover {
  background-color: #127c85 !important;
  border-color: #127c85 !important;
  color: #ffffff !important;
}
.btn-outline-gold {
  color: #189ba6 !important;
  border-color: #189ba6 !important;
}
.btn-outline-gold:hover {
  background-color: #189ba6 !important;
  color: #ffffff !important;
}
.accordion-button:not(.collapsed) {
  color: #189ba6 !important;
  background-color: #e6f4f5 !important;
}
.accordion-button {
  color: #000000 !important;
}
.border-secondary, .border-light-subtle {
  border-color: #e2e8f0 !important;
}
/* Ensure footer text remains crisp and white/light */
footer, footer *, footer p, footer span, footer li, footer div, footer small, footer .text-muted {
  color: #ffffff !important;
}
footer p, footer span, footer li, footer div, footer small, footer .text-muted, footer a {
  color: #d1cfc9 !important;
}
footer a:hover {
  color: #ffffff !important;
}

/* Fix headings appearing white on light background inside bg-dark / bg-dark-card / bg-dark-contrast elements */
.bg-dark h1, .bg-dark h2, .bg-dark h3, .bg-dark h4, .bg-dark h5, .bg-dark h6,
.bg-dark-card h1, .bg-dark-card h2, .bg-dark-card h3, .bg-dark-card h4, .bg-dark-card h5, .bg-dark-card h6,
.bg-dark-contrast h1, .bg-dark-contrast h2, .bg-dark-contrast h3, .bg-dark-contrast h4, .bg-dark-contrast h5, .bg-dark-contrast h6 {
  color: #1a1a1a !important;
}
.bg-dark p, .bg-dark li, .bg-dark span:not(.text-gold):not(.text-teal), .bg-dark label, .bg-dark .text-muted,
.bg-dark-card p, .bg-dark-card li, .bg-dark-card span:not(.text-gold):not(.text-teal), .bg-dark-card label, .bg-dark-card .text-muted,
.bg-dark-contrast p, .bg-dark-contrast li, .bg-dark-contrast span:not(.text-gold):not(.text-teal), .bg-dark-contrast label, .bg-dark-contrast .text-muted {
  color: #444444 !important;
}
.bg-dark strong, .bg-dark-card strong, .bg-dark-contrast strong {
  color: #1a1a1a !important;
}
</style>

<!-- Custom Styles for Delivered Section -->
<style is:global>
.delivered-section {
  background-color: #f8f9fa !important;
  padding: 60px 0 !important;
  position: relative;
}
.delivered-carousel-wrapper {
  position: relative;
  width: 100%;
  margin-top: 30px;
}
.delivered-carousel-container {
  display: flex !important;
  gap: 20px !important;
  overflow-x: auto !important;
  scroll-snap-type: x mandatory !important;
  scrollbar-width: none !important;
  padding: 10px 0 !important;
}
.delivered-carousel-container::-webkit-scrollbar {
  display: none !important;
}
.delivered-card {
  width: 380px !important;
  height: auto !important;
  min-height: 560px !important;
  flex-shrink: 0 !important;
  scroll-snap-align: start !important;
  background-color: #ffffff !important;
  border-radius: 16px !important;
  overflow: hidden !important;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05) !important;
  display: flex !important;
  flex-direction: column !important;
  border: 1px solid #e5e8eb !important;
  transition: transform 0.3s ease, box-shadow 0.3s ease !important;
  text-decoration: none !important;
}
.delivered-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08) !important;
}
.delivered-card-link-wrapper {
  text-decoration: none !important;
  color: inherit !important;
  display: block;
}
.delivered-card-img-wrapper {
  position: relative;
  width: 100%;
  height: 280px !important;
  overflow: hidden;
}
.delivered-card-img-wrapper img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.delivered-card-photo-count {
  position: absolute;
  bottom: 12px;
  right: 12px;
  background: rgba(0, 0, 0, 0.65);
  color: #ffffff;
  padding: 4px 10px;
  border-radius: 20px;
  font-size: 0.8rem;
  display: flex;
  align-items: center;
  gap: 5px;
}
.delivered-card-info {
  padding: 20px;
  flex-grow: 1;
}
.delivered-card-title {
  font-size: 1.15rem;
  font-weight: 700;
  color: #111111 !important;
  margin-bottom: 5px;
  line-height: 1.35;
}
.delivered-card-subtitle {
  font-size: 0.85rem;
  color: #6c757d !important;
  margin-bottom: 15px;
}
.card-divider {
  border-top: 1px solid #e9ecef;
  margin: 15px 0;
}
.delivered-card-specs {
  display: flex;
  justify-content: space-between;
}
.spec-col {
  display: flex;
  flex-direction: column;
}
.spec-label {
  font-size: 0.75rem;
  color: #8c98a4 !important;
  text-transform: uppercase;
}
.spec-val {
  font-size: 0.85rem;
  font-weight: 600;
  color: #212529 !important;
}
.border-start-custom {
  border-left: 1px solid #e9ecef;
  padding-left: 12px;
}
.delivered-card-cta {
  display: block;
  text-align: center;
  background: #f8f9fa;
  color: #189ba6 !important;
  font-weight: 700;
  font-size: 0.9rem;
  padding: 14px;
  text-decoration: none;
  border-top: 1px solid #e5e8eb;
  transition: background 0.2s ease, color 0.2s ease;
}
.delivered-card-cta:hover {
  background: #189ba6;
  color: #ffffff !important;
}
</style>
