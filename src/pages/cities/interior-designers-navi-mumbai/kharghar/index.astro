            <div class="accordion-item bg-transparent border-bottom border-secondary py-3">
              <h3 class="accordion-header">
                <button class="accordion-button collapsed bg-transparent text-white font-luxury h5" type="button" data-bs-toggle="collapse" data-bs-target="#faq5">
