<script is:inline>
    (function() {
      const words = ["Wardrobe", "Kitchen", "Home"];
      let idx = 0;
      let isAnimating = false;
      
      window.setLsActiveWord = function(w) {
        const el = document.getElementById("lsDynamicWord");
        if (!el || el.textContent === w || isAnimating) return;
        
        isAnimating = true;
        el.style.opacity = "0";
        el.style.transform = "translateY(-8px)";
        
        setTimeout(function() {
          el.textContent = w;
          el.style.transform = "translateY(8px)";
          
          setTimeout(function() {
            el.style.opacity = "1";
            el.style.transform = "translateY(0)";
            setTimeout(function() { isAnimating = false; }, 450);
          }, 40);
        }, 280);
      };

      function cycleWord() {
        idx = (idx + 1) % words.length;
        window.setLsActiveWord(words[idx]);
      }

      document.addEventListener("DOMContentLoaded", function() {
        setInterval(cycleWord, 4800);
      });
    })();
  </script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    const carousel = document.getElementById('glimpseCarousel');
    const prevBtn = document.getElementById('glimpsePrevBtn');
    const nextBtn = document.getElementById('glimpseNextBtn');
    
    if (carousel && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        const cardWidth = carousel.querySelector('.glimpse-card').offsetWidth + 20; // width + gap
        carousel.scrollBy({ left: -cardWidth * 2, behavior: 'smooth' });
      });
      
      nextBtn.addEventListener('click', () => {
        const cardWidth = carousel.querySelector('.glimpse-card').offsetWidth + 20; // width + gap
        carousel.scrollBy({ left: cardWidth * 2, behavior: 'smooth' });
      });
      
      const toggleArrows = () => {
        const maxScroll = carousel.scrollWidth - carousel.clientWidth;
        prevBtn.style.opacity = carousel.scrollLeft <= 5 ? '0.3' : '1';
        prevBtn.style.pointerEvents = carousel.scrollLeft <= 5 ? 'none' : 'auto';
        
        nextBtn.style.opacity = carousel.scrollLeft >= maxScroll - 5 ? '0.3' : '1';
        nextBtn.style.pointerEvents = carousel.scrollLeft >= maxScroll - 5 ? 'none' : 'auto';
      };
      
      carousel.addEventListener('scroll', toggleArrows);
      window.addEventListener('resize', toggleArrows);
      setTimeout(toggleArrows, 500);
    }
  });
</script>

