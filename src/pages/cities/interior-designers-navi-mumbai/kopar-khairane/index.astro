<style is:global>
html, body {
      background-color: #ffffff !important;
      color: #000000 !important;
      font-family: Arial, Helvetica, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    }
    .hero-section, .catalog-directory-hero, .dc-top-section-bg, header.bg-dark, .bg-dark, .bg-dark-card, .bg-dark-contrast, .bg-dark-gradient {
      background-color: #f3f6f8 !important;
      color: #000000 !important;
    }
    h1, h2, h3, h4, h5, h6, .section-title, .display-4, .display-6 {
      color: #000000 !important;
    }
    p, span, li, label, div, small, strong, p *, li *, span *, label *, div *, small *, strong *, .text-muted, .text-white-50, .text-secondary, .text-muted * {
      color: #000000 !important;
    }
    :not(footer) .text-white, body:not(footer) .text-white, a.text-white:not(footer a), .section-title.text-white {
      color: #000000 !important;
    }
    .text-gold, .text-gold * {
      color: #189ba6 !important;
    }
    .btn-gold, .btn-primary {
      background-color: #189ba6 !important;
      border-color: #189ba6 !important;
      color: #ffffff !important;
    }
    .btn-gold:hover, .btn-primary:hover {
      background-color: #127c85 !important;
      border-color: #127c85 !important;
      color: #ffffff !important;
    }
    .btn-outline-gold {
      color: #189ba6 !important;
      border-color: #189ba6 !important;
    }
    .btn-outline-gold:hover {
      background-color: #189ba6 !important;
      color: #ffffff !important;
    }
    .accordion-button:not(.collapsed) {
      color: #189ba6 !important;
      background-color: #e6f4f5 !important;
    }
    .accordion-button {
      color: #000000 !important;
    }
    .border-secondary, .border-light-subtle {
      border-color: #e2e8f0 !important;
    }
    /* Ensure footer text remains crisp and white/light */
    footer, footer *, footer p, footer span, footer li, footer div, footer small, footer .text-muted {
      color: #ffffff !important;
    }
    footer p, footer span, footer li, footer div, footer small, footer .text-muted, footer a {
      color: #d1cfc9 !important;
    }
    footer a:hover {
      color: #ffffff !important;
    }
  
    /* Fix headings appearing white on light background inside bg-dark / bg-dark-card / bg-dark-contrast elements */
    .bg-dark h1, .bg-dark h2, .bg-dark h3, .bg-dark h4, .bg-dark h5, .bg-dark h6,
    .bg-dark-card h1, .bg-dark-card h2, .bg-dark-card h3, .bg-dark-card h4, .bg-dark-card h5, .bg-dark-card h6,
    .bg-dark-contrast h1, .bg-dark-contrast h2, .bg-dark-contrast h3, .bg-dark-contrast h4, .bg-dark-contrast h5, .bg-dark-contrast h6 {
      color: #1a1a1a !important;
    }
    /* Fix text elements appearing light grey/white on light background inside bg-dark / bg-dark-card / bg-dark-contrast elements */
    .bg-dark p, .bg-dark li, .bg-dark span:not(.text-gold):not(.text-teal), .bg-dark label, .bg-dark .text-muted,
    .bg-dark-card p, .bg-dark-card li, .bg-dark-card span:not(.text-gold):not(.text-teal), .bg-dark-card label, .bg-dark-card .text-muted,
    .bg-dark-contrast p, .bg-dark-contrast li, .bg-dark-contrast span:not(.text-gold):not(.text-teal), .bg-dark-contrast label, .bg-dark-contrast .text-muted {
      color: #444444 !important;
    }
    .bg-dark strong, .bg-dark-card strong, .bg-dark-contrast strong {
      color: #1a1a1a !important;
    }
    @media (max-width: 767px) {
      #homeDesignGrid, #naviNodesGrid {
        display: flex !important;
        flex-wrap: nowrap !important;
        overflow-x: auto !important;
        scroll-snap-type: x mandatory !important;
        padding-bottom: 20px !important;
        padding-left: 15px !important;
        padding-right: 15px !important;
        -webkit-overflow-scrolling: touch !important;
      }
      #homeDesignGrid > div, #naviNodesGrid > div {
        flex: 0 0 85% !important;
        max-width: 85% !important;
        scroll-snap-align: center !important;
      }
      #homeDesignGrid::-webkit-scrollbar, #naviNodesGrid::-webkit-scrollbar {
        display: none !important;
      }
      #homeDesignGrid, #naviNodesGrid {
        -ms-overflow-style: none !important;
        scrollbar-width: none !important;
        cursor: grab;
      }
      #homeDesignGrid:active, #naviNodesGrid:active {
        cursor: grabbing;
      }
    }
</style>

