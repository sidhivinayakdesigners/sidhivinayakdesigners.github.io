<script is:inline>
// ===== LIGHTBOX LOGIC =====
      const lbOverlay = document.getElementById('dcLightbox');
      const lbImg = document.getElementById('dcLightboxImg');
      const lbCaption = document.getElementById('dcLightboxCaption');
      const lbClose = document.getElementById('dcLightboxClose');
      const lbPrev = document.getElementById('dcLightboxPrev');
      const lbNext = document.getElementById('dcLightboxNext');
      let lbPhotos = [];
      let lbIndex = 0;
      let lbTitle = '';

      if (lbImg) {
        lbImg.style.display = 'none';
      }

      const lbContent = lbOverlay.querySelector('.dc-lightbox-content');
      let sliderContainer = lbContent.querySelector('.dc-lightbox-slider-container');
      if (!sliderContainer) {
        sliderContainer = document.createElement('div');
        sliderContainer.className = 'dc-lightbox-slider-container';
        const sliderTrack = document.createElement('div');
        sliderTrack.className = 'dc-lightbox-slider-track';
        sliderContainer.appendChild(sliderTrack);
        lbContent.insertBefore(sliderContainer, lbCaption);
      }
      const sliderTrack = sliderContainer.querySelector('.dc-lightbox-slider-track');

                              let isLbOpening = false;
      window.openLightbox = function(imgEl, evt) {
        if (evt) {
          try { evt.stopPropagation(); evt.preventDefault(); } catch(e) {}
        }
        if (isLbOpening) return;
        isLbOpening = true;
        setTimeout(() => { isLbOpening = false; }, 300);

        const container = imgEl ? imgEl.closest('.dc-exact-card-img, .premium-card-img, .premium-card') : null;
        if (!container) return;

        lbTitle = (container.getAttribute('data-lightbox-title') || '').replace(/&amp;/g,'&');

        // Prioritize data-lightbox-photos attribute if present
        let hasRawPhotos = false;
        try {
          const raw = container.getAttribute('data-lightbox-photos');
          if (raw) {
            lbPhotos = JSON.parse(raw.replace(/&quot;/g,'"').replace(/&amp;/g,'&'));
            hasRawPhotos = lbPhotos && lbPhotos.length > 0;
          }
        } catch(e) {}

        let cardImgs = [];
        if (!hasRawPhotos) {
          // Extract images directly from DOM in exact visual sequence as fallback
          cardImgs = Array.from(container.querySelectorAll('.carousel-inner img'));
          if (cardImgs.length === 0) {
            cardImgs = Array.from(container.querySelectorAll('img'));
          }

          // Build lbPhotos from DOM img elements (100% synchronized with card order)
          if (cardImgs.length > 0) {
            lbPhotos = cardImgs.map(img => img.getAttribute('src') || img.src);
          } else {
            lbPhotos = imgEl ? [imgEl.getAttribute('src') || imgEl.src] : [];
          }
        }

        // Find exact index of clicked img in cardImgs first
        let foundIdx = -1;
        if (imgEl && cardImgs.length > 0) {
          foundIdx = cardImgs.indexOf(imgEl);
        }

        // Find index by active carousel item (most robust for dynamic carousels if imgEl not found)
        if (foundIdx < 0 && container) {
          const activeItem = container.querySelector('.carousel-item.active');
          if (activeItem) {
            const carouselItems = Array.from(container.querySelectorAll('.carousel-item'));
            foundIdx = carouselItems.indexOf(activeItem);
          }
        }

        // Fallback matching by src / filename
        if (foundIdx < 0 && imgEl) {
          const clickedSrc = (imgEl.getAttribute('src') || imgEl.src || '').split('?')[0].split('#')[0].toLowerCase();
          const clickedFname = clickedSrc.split('/').pop();

          for (let i = 0; i < lbPhotos.length; i++) {
            const pSrc = (lbPhotos[i] || '').split('?')[0].split('#')[0].toLowerCase();
            if (pSrc === clickedSrc || (clickedFname && pSrc.endsWith('/' + clickedFname))) {
              foundIdx = i;
              break;
            }
          }
        }

        // Fallback matching by active carousel item image
        if (foundIdx < 0 && container) {
          const activeImg = container.querySelector('.carousel-item.active img');
          if (activeImg) {
            foundIdx = cardImgs.indexOf(activeImg);
          }
        }

        lbIndex = (foundIdx >= 0 && foundIdx < lbPhotos.length) ? foundIdx : 0;

        lbOverlay.classList.add('active');
        document.body.style.overflow = 'hidden';
        showLbSlide();
      };

      function showLbSlide() {
        lbCaption.textContent = lbTitle + ' (' + (lbIndex + 1) + ' / ' + lbPhotos.length + ')';
        
        const total = lbPhotos.length;
        const prevIndex = (lbIndex - 1 + total) % total;
        const nextIndex = (lbIndex + 1) % total;
        
        const prevSrc = total > 1 ? lbPhotos[prevIndex] : '';
        const currentSrc = lbPhotos[lbIndex];
        const nextSrc = total > 1 ? lbPhotos[nextIndex] : '';

        sliderTrack.innerHTML = '';
        sliderTrack.style.transition = 'none';

        if (total <= 1) {
          sliderTrack.style.width = '100%';
          sliderTrack.style.transform = 'translate3d(0px, 0, 0)';
          
          const activeSlide = document.createElement('div');
          activeSlide.className = 'dc-lightbox-slide active-slide';
          activeSlide.style.width = '100%';
          activeSlide.style.height = '100%';
          activeSlide.style.display = 'flex';
          activeSlide.style.alignItems = 'center';
          activeSlide.style.justifyContent = 'center';
          activeSlide.innerHTML = `<img src="${currentSrc}" alt="${lbTitle}" />`;
          sliderTrack.appendChild(activeSlide);
          
          if (lbPrev) lbPrev.style.display = 'none';
          if (lbNext) lbNext.style.display = 'none';
        } else {
          sliderTrack.style.width = '300%';
          
          // 1. Prev slide
          const prevSlide = document.createElement('div');
          prevSlide.className = 'dc-lightbox-slide prev-slide';
          if (prevSrc) {
            prevSlide.innerHTML = `<img src="${prevSrc}" alt="Previous Image" />`;
          }
          sliderTrack.appendChild(prevSlide);

          // 2. Active slide
          const activeSlide = document.createElement('div');
          activeSlide.className = 'dc-lightbox-slide active-slide';
          activeSlide.innerHTML = `<img src="${currentSrc}" alt="${lbTitle}" />`;
          sliderTrack.appendChild(activeSlide);

          // 3. Next slide
          const nextSlide = document.createElement('div');
          nextSlide.className = 'dc-lightbox-slide next-slide';
          if (nextSrc) {
            nextSlide.innerHTML = `<img src="${nextSrc}" alt="Next Image" />`;
          }
          sliderTrack.appendChild(nextSlide);

          // Center active slide
          const width = sliderContainer.offsetWidth || (window.innerWidth * 0.9);
          sliderTrack.style.transform = `translate3d(-${width}px, 0, 0)`;

          if (lbPrev) lbPrev.style.display = 'flex';
          if (lbNext) lbNext.style.display = 'flex';
        }
      }

      function closeLightbox() {
        lbOverlay.classList.remove('active');
        sliderTrack.innerHTML = '';
        document.body.style.overflow = '';
      }

      lbClose.addEventListener('click', closeLightbox);
      lbOverlay.addEventListener('click', function(e) {
        if (e.target === lbOverlay || e.target === lbCaption) closeLightbox();
      });

      lbPrev.addEventListener('click', function(e) {
        e.stopPropagation();
        if (lbPhotos.length <= 1) return;
        sliderTrack.style.transition = 'transform 0.25s cubic-bezier(0.16, 1, 0.3, 1)';
        sliderTrack.style.transform = `translate3d(0px, 0, 0)`;
        setTimeout(() => {
          lbIndex = (lbIndex - 1 + lbPhotos.length) % lbPhotos.length;
          showLbSlide();
        }, 250);
      });

      lbNext.addEventListener('click', function(e) {
        e.stopPropagation();
        if (lbPhotos.length <= 1) return;
        const width = sliderContainer.offsetWidth || window.innerWidth;
        sliderTrack.style.transition = 'transform 0.25s cubic-bezier(0.16, 1, 0.3, 1)';
        sliderTrack.style.transform = `translate3d(-${2 * width}px, 0, 0)`;
        setTimeout(() => {
          lbIndex = (lbIndex + 1) % lbPhotos.length;
          showLbSlide();
        }, 250);
      });

      document.addEventListener('keydown', function(e) {
        if (!lbOverlay.classList.contains('active')) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft' && lbPhotos.length > 1) {
          sliderTrack.style.transition = 'transform 0.25s cubic-bezier(0.16, 1, 0.3, 1)';
          sliderTrack.style.transform = `translate3d(0px, 0, 0)`;
          setTimeout(() => {
            lbIndex = (lbIndex - 1 + lbPhotos.length) % lbPhotos.length;
            showLbSlide();
          }, 250);
        }
        if (e.key === 'ArrowRight' && lbPhotos.length > 1) {
          const width = sliderContainer.offsetWidth || window.innerWidth;
          sliderTrack.style.transition = 'transform 0.25s cubic-bezier(0.16, 1, 0.3, 1)';
          sliderTrack.style.transform = `translate3d(-${2 * width}px, 0, 0)`;
          setTimeout(() => {
            lbIndex = (lbIndex + 1) % lbPhotos.length;
            showLbSlide();
          }, 250);
        }
      });

      // Swipe/Drag scrolling implementation (Instagram style)
      let startX = 0;
      let currentX = 0;
      let isDragging = false;
      let containerWidth = 0;

      const getTouchX = (e) => {
        return e.touches ? e.touches[0].clientX : e.clientX;
      };

      const handleDragStart = (e) => {
        if (lbPhotos.length <= 1) return;
        if (e.target.closest('#dcLightboxClose') || e.target.closest('#dcLightboxCaption')) return;
        
        isDragging = true;
        startX = getTouchX(e);
        currentX = startX;
        containerWidth = sliderContainer.offsetWidth || window.innerWidth;
        sliderTrack.style.transition = 'none';
      };

      const handleDragMove = (e) => {
        if (!isDragging) return;
        currentX = getTouchX(e);
        const deltaX = currentX - startX;
        const translation = -containerWidth + deltaX;
        sliderTrack.style.transform = `translate3d(${translation}px, 0, 0)`;
      };

      const handleDragEnd = () => {
        if (!isDragging) return;
        isDragging = false;
        const deltaX = currentX - startX;
        const threshold = containerWidth * 0.15; // 15% swipe threshold

        sliderTrack.style.transition = 'transform 0.25s cubic-bezier(0.16, 1, 0.3, 1)';

        if (deltaX > threshold) {
          // Swiped right -> show previous slide
          sliderTrack.style.transform = `translate3d(0px, 0, 0)`;
          setTimeout(() => {
            lbIndex = (lbIndex - 1 + lbPhotos.length) % lbPhotos.length;
            showLbSlide();
          }, 250);
        } else if (deltaX < -threshold) {
          // Swiped left -> show next slide
          sliderTrack.style.transform = `translate3d(-${2 * containerWidth}px, 0, 0)`;
          setTimeout(() => {
            lbIndex = (lbIndex + 1) % lbPhotos.length;
            showLbSlide();
          }, 250);
        } else {
          // Snap back to center active slide
          sliderTrack.style.transform = `translate3d(-${containerWidth}px, 0, 0)`;
        }
      };

      // Left/Right side click tap navigation + background click close
      sliderContainer.addEventListener('click', (e) => {
        if (isDragging || Math.abs(currentX - startX) > 8) return;
        
        // Close if clicking outside the image boundaries (on the slide background itself)
        if (e.target.classList.contains('dc-lightbox-slide')) {
          closeLightbox();
          return;
        }

        if (e.target.closest('#dcLightboxClose')) return;

        // Ignore left/right click navigation if only 1 image
        if (lbPhotos.length <= 1) return;

        const rect = sliderContainer.getBoundingClientRect();
        const clickX = e.clientX - rect.left;
        const width = rect.width;

        sliderTrack.style.transition = 'transform 0.25s cubic-bezier(0.16, 1, 0.3, 1)';

        if (clickX < width * 0.4) {
          sliderTrack.style.transform = `translate3d(0px, 0, 0)`;
          setTimeout(() => {
            lbIndex = (lbIndex - 1 + lbPhotos.length) % lbPhotos.length;
            showLbSlide();
          }, 250);
        } else {
          sliderTrack.style.transform = `translate3d(-${2 * width}px, 0, 0)`;
          setTimeout(() => {
            lbIndex = (lbIndex + 1) % lbPhotos.length;
            showLbSlide();
          }, 250);
        }
      });

      // Provide visual navigation cursor arrows on hover
      sliderContainer.addEventListener('mousemove', (e) => {
        if (lbPhotos.length <= 1) {
          sliderContainer.style.cursor = 'default';
          return;
        }
        const rect = sliderContainer.getBoundingClientRect();
        const hoverX = e.clientX - rect.left;
        const width = rect.width;
        
        if (hoverX < width * 0.4) {
          sliderContainer.style.cursor = 'w-resize';
        } else {
          sliderContainer.style.cursor = 'e-resize';
        }
      });

      // Register touch events
      sliderContainer.addEventListener('touchstart', handleDragStart, { passive: true });
      sliderContainer.addEventListener('touchmove', handleDragMove, { passive: true });
      sliderContainer.addEventListener('touchend', handleDragEnd);

      // Register mouse events for drag/swipe support on desktop
      sliderContainer.addEventListener('mousedown', (e) => {
        if (e.button !== 0) return;
        handleDragStart(e);
      });
      sliderContainer.addEventListener('mousemove', handleDragMove);
      sliderContainer.addEventListener('mouseup', handleDragEnd);
      sliderContainer.addEventListener('mouseleave', () => {
        if (isDragging) handleDragEnd();
      });
</script>
