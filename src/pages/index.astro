  <script>
    (function() {
      const words = ["Wardrobe", "Kitchen", "Home"];
      let idx = 0;
      let isAnimating = false;
      
      window.setLsActiveWord = function(w) {
        const el = document.getElementById("lsDynamicWord");
        if (!el || el.textContent === w || isAnimating) return;
        
        isAnimating = true;
        el.style.opacity = "0";
        el.style.transform = "translateY(-8px)";
        
        setTimeout(function() {
          el.textContent = w;
          el.style.transform = "translateY(8px)";
          
          setTimeout(function() {
            el.style.opacity = "1";
            el.style.transform = "translateY(0)";
            setTimeout(function() { isAnimating = false; }, 450);
          }, 40);
        }, 280);
      };

      function cycleWord() {
        idx = (idx + 1) % words.length;
        window.setLsActiveWord(words[idx]);
      }

      document.addEventListener("DOMContentLoaded", function() {
        setInterval(cycleWord, 4800);
      });
    })();
  </script>

