<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <Fragment set:html={bodyContent} />
</Layout>

<style is:global>

/* ===== LIGHTBOX STYLE ===== */
    .dc-lightbox-overlay {
      display: none;
      position: fixed;
      z-index: 10000;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.95);
      align-items: center;
      justify-content: center;
      user-select: none;
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    
    .dc-lightbox-overlay.active {
      display: flex;
      opacity: 1;
    }
    
    .dc-lightbox-content {
      position: relative;
      max-width: 90%;
      max-height: 85%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    
    .dc-lightbox-img {
      max-width: 100%;
      max-height: 80vh;
      object-fit: contain;
      border-radius: 4px;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }
    
    .dc-lightbox-caption {
      color: #ffffff;
      font-size: 16px;
      margin-top: 15px;
      text-align: center;
      font-weight: 500;
      text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    }
    
    .dc-lightbox-close {
      position: absolute;
      top: -50px;
      right: 0;
      color: #ffffff;
      font-size: 35px;
      font-weight: 300;
      cursor: pointer;
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(255,255,255,0.1);
      border-radius: 50%;
      transition: background 0.2s;
    }
    
    .dc-lightbox-close:hover {
      background: rgba(255,255,255,0.25);
    }
    
    .dc-lightbox-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background-color: rgba(255, 255, 255, 0.15);
      color: #ffffff;
      border: none;
      font-size: 28px;
      font-weight: bold;
      padding: 10px 18px;
      cursor: pointer;
      border-radius: 50%;
      transition: background-color 0.2s, transform 0.2s;
      width: 54px;
      height: 54px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .dc-lightbox-nav:hover {
      background-color: rgba(255, 255, 255, 0.35);
    }
    
    .dc-lightbox-prev {
      left: -80px;
    }
    
    .dc-lightbox-next {
      right: -80px;
    }
    
    @media (max-width: 768px) {
      .dc-lightbox-prev {
        left: 10px;
      }
      .dc-lightbox-next {
        right: 10px;
      }
      .dc-lightbox-nav {
        width: 38px;
        height: 38px;
        font-size: 18px;
      }
      .dc-lightbox-close {
        top: 10px;
        right: 10px;
      }
    }

    /* Slider container and track layout matching Instagram carousel */
    .dc-lightbox-slider-container {
      width: 90vw;
      height: 80vh;
      overflow: hidden;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      touch-action: pan-y;
    }
    .dc-lightbox-slider-track {
      display: flex;
      width: 300%;
      height: 100%;
      transform: translate3d(-90vw, 0, 0);
      will-change: transform;
    }
    .dc-lightbox-slide {
      width: 90vw;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      user-select: none;
    }
    .dc-lightbox-slide img {
      max-width: 90%;
      max-height: 75vh;
      object-fit: contain;
      border: 1px solid #189ba6;
      pointer-events: none;
      user-select: none;
      -webkit-user-drag: none;
    }
    /* Hide navigation arrows on all touch-supported screens and mobile viewports (e.g. mobile, iPads, tablets) */
    @media (max-width: 1024px) {
      .dc-lightbox-nav {
        display: none !important;
      }
    }

/* Hero Banner Slider Responsive CSS */
    .hero-banner-slider-section {
      width: 100%;
      overflow: hidden;
      padding-top: 0 !important;
      margin-top: 0 !important;
    }

    @media (max-width: 767px) {
      .hero-banner-img {
        width: 100% !important;
        height: auto !important;
        display: block !important;
      }
      .carousel-indicators {
        bottom: 8px !important;
        margin-bottom: 0 !important;
      }
      .carousel-indicators [data-bs-target] {
        width: 8px !important;
        height: 8px !important;
        border-radius: 50% !important;
        background-color: #189ba6 !important;
      }
    }

    @media (min-width: 768px) {
      .hero-banner-img {
        width: 100% !important;
        max-height: 620px !important;
        object-fit: cover !important;
      }
    }

    /* Premium 10k$ Hero Styling Overhaul */
    .hero-section {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding-top: 120px;
      padding-bottom: 100px;
      overflow: hidden;
    }

    .hero-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, rgba(21, 20, 19, 0.98) 0%, rgba(21, 20, 19, 0.92) 40%, rgba(21, 20, 19, 0.6) 100%);
      z-index: 1;
    }

    /* Glow backdrop element */
    .hero-glow-orb {
      position: absolute;
      top: 20%;
      right: 10%;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(184, 144, 71, 0.15) 0%, rgba(184, 144, 71, 0) 70%);
      filter: blur(50px);
      z-index: 2;
      pointer-events: none;
      animation: pulse-glow 8s infinite alternate;
    }

    @keyframes pulse-glow {
      0% { transform: scale(1); opacity: 0.7; }
      100% { transform: scale(1.2); opacity: 1; }
    }

    .hero-container {
      position: relative;
      z-index: 3;
    }

    .hero-subtitle-premium {
      font-size: 0.9rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 3px;
      color: var(--color-gold);
      display: inline-block;
      margin-bottom: 1.5rem;
      position: relative;
      padding-left: 45px;
    }

    .hero-subtitle-premium::before {
      content: '';
      position: absolute;
      left: 0;
      top: 50%;
      width: 30px;
      height: 1px;
      background-color: var(--color-gold);
    }

    .hero-title-premium {
      font-size: clamp(2.5rem, 5vw, 4.5rem);
      line-height: 1.15;
      font-weight: 800;
      color: #fff !important;
      letter-spacing: -1px;
    }

    .hero-title-premium .text-gradient-gold {
      background: linear-gradient(135deg, #FFF 30%, #D4AF37 70%, #B89047 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      display: inline-block;
    }

    .hero-text-premium {
      font-size: 1.15rem;
      line-height: 1.8;
      font-weight: 300;
      color: #D1CFC9 !important;
      max-width: 650px;
      margin-top: 1.5rem;
      margin-bottom: 2.5rem;
    }

    /* Floating Showcase Card UI */
    .hero-showcase-glass-card {
      background: rgba(30, 28, 26, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.08);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      padding: 3rem 2.5rem;
      border-radius: 1px;
      position: relative;
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
      z-index: 10;
      animation: float-slow 6s ease-in-out infinite;
