</style>

<script is:inline>
  (function() {
    // Isolate app-like bottom thumb bar & suppress popup specifically on /design-brief/
    if (window.location.pathname.includes('design-brief')) {
      const appStyle = document.createElement('style');
      appStyle.textContent = '#consultationPopup { display: none !important; } body.consultation-popup-open { overflow: auto !important; } @media (max-width: 991px) { .dc-mobile-bottom-bar, #dcMobileBottomBar { display: none !important; } body { padding-bottom: 0 !important; } }';
      document.head.appendChild(appStyle);
    }

    const totalInteractiveSteps = 8; // 0..6 + 7 (Reveal)
    let currentStep = 0;
    let allStepsMode = false;

    const state = {
      propertyType: [],
      propertyNode: [],
      timeline: [],
      homeStyle: [],
      ceilingStyle: [],
      lightTone: ['Warm White (3000K — Hotel Cozy)'],
      lightExtras: [],
      wardrobeStyle: [],
      wardrobeFinish: [],
      loftPref: [],
      wardrobeExtras: [],
      kitchenStyle: [],
      countertop: [],
      kitchenLayout: [],
      kitchenExtras: [],
      livingElements: [],
      wallDecor: [],
      colorPalette: [],
      lifestyle: [],
      vastu: [],
      storageStyle: [],
      budget: []
    };

    const selectedImages = new Map();
    const selectedColorDots = new Map();

    const appShell = document.getElementById('studioAppShell');
    const stepEls = document.querySelectorAll('.studio-step');
    const dotEls = document.querySelectorAll('.step-dot');
    const stepCounterEl = document.getElementById('studioStepCounter');
    const dockStepTextEl = document.getElementById('dockStepText');
    const progressFillEl = document.getElementById('studioProgressFill');
    const dockBackBtn = document.getElementById('dockBackBtn');
    const dockNextBtn = document.getElementById('dockNextBtn');
    const toastEl = document.getElementById('studioToast');
    const thumbStackEl = document.getElementById('moodboardThumbStack');
    const moodboardCountEl = document.getElementById('moodboardCount');

    const nameEl = document.getElementById('clientName');
    const phoneEl = document.getElementById('clientPhone');
    const finalNameEl = document.getElementById('finalName');
    const finalPhoneEl = document.getElementById('finalPhone');
    const locEl = document.getElementById('clientLocation');
    const dislikesEl = document.getElementById('clientDislikes');
    const notesEl = document.getElementById('clientNotes');
    const previewEl = document.getElementById('liveBriefPreview');
    const feedbackEl = document.getElementById('briefFormFeedback');

    function triggerHaptic() {
      if (navigator.vibrate) {
        try { navigator.vibrate(12); } catch(e) {}
      }
    }

    let toastTimer = null;
    function showToast(msg) {
      if (!msg) return;
      toastEl.textContent = msg;
      toastEl.classList.add('show');
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toastEl.classList.remove('show'), 1900);
    }

    function syncContactFields(source, target) {
      if (source && target && target.value !== source.value) {
        target.value = source.value;
      }
    }
    nameEl?.addEventListener('input', () => { syncContactFields(nameEl, finalNameEl); updateLiveUI(); });
    finalNameEl?.addEventListener('input', () => { syncContactFields(finalNameEl, nameEl); updateLiveUI(); });
    phoneEl?.addEventListener('input', () => { syncContactFields(phoneEl, finalPhoneEl); updateLiveUI(); });
    finalPhoneEl?.addEventListener('input', () => { syncContactFields(finalPhoneEl, phoneEl); updateLiveUI(); });

    function goToStep(idx) {
      if (idx < 0 || idx >= totalInteractiveSteps) return;
      triggerHaptic();

      currentStep = idx;
      stepEls.forEach((el, i) => {
        el.classList.toggle('active', i === idx);
      });
      dotEls.forEach((dot, i) => {
        dot.classList.toggle('active', i === idx);
        dot.classList.toggle('completed', i < idx);
      });

      const pct = Math.round(((idx + 1) / totalInteractiveSteps) * 100);
      progressFillEl.style.width = `${pct}%`;

      if (idx < 7) {
        stepCounterEl.textContent = `Step ${idx + 1} of 7`;
        dockStepTextEl.textContent = `${idx + 1} / 7`;
      } else {
        stepCounterEl.textContent = `Design DNA Ready ✨`;
        dockStepTextEl.textContent = `Final DNA`;
      }

      dockBackBtn.disabled = idx === 0;
      if (idx === 0) {
        dockNextBtn.innerHTML = `<span>Start Styling</span> <i class="fas fa-arrow-right ms-1"></i>`;
        dockNextBtn.style.background = '';
        dockNextBtn.style.display = 'inline-flex';
      } else if (idx === 6) {
        dockNextBtn.innerHTML = `<span>Reveal Design DNA ✨</span>`;
        dockNextBtn.style.background = '';
        dockNextBtn.style.display = 'inline-flex';
      } else if (idx === 7) {
        dockNextBtn.innerHTML = `<i class="fab fa-whatsapp me-1"></i> <span>Send WhatsApp</span>`;
        dockNextBtn.style.background = '#25D366';
        dockNextBtn.style.display = 'inline-flex';
        renderDnaReveal();
        fireConfetti();
      } else {
        dockNextBtn.innerHTML = `<span>Next</span> <i class="fas fa-arrow-right ms-1"></i>`;
        dockNextBtn.style.background = '';
        dockNextBtn.style.display = 'inline-flex';
      }

      window.scrollTo({ top: 0, behavior: 'auto' });
      updateLiveUI();
    }

    dockBackBtn.addEventListener('click', () => goToStep(currentStep - 1));
    dockNextBtn.addEventListener('click', () => {
      if (currentStep === 7) {
        document.getElementById('designBriefForm').requestSubmit();
      } else {
        goToStep(currentStep + 1);
      }
    });
    dotEls.forEach(dot => {
      dot.addEventListener('click', () => {
        const target = parseInt(dot.getAttribute('data-goto'), 10);
        if (allStepsMode) {
          document.getElementById('step-' + target)?.scrollIntoView({ behavior: 'auto' });
        } else {
          goToStep(target);
        }
      });
    });

    const toggleViewBtn = document.getElementById('toggleViewModeBtn');
    if (toggleViewBtn) {
      toggleViewBtn.addEventListener('click', () => {
        allStepsMode = !allStepsMode;
        appShell.classList.toggle('all-steps-mode', allStepsMode);
        toggleViewBtn.querySelector('span').textContent = allStepsMode ? 'Step Mode' : 'All Steps';
        if (allStepsMode) renderDnaReveal();
      });
    }

    function toggleGroupSelection(container, itemEl) {
      const groupName = container.getAttribute('data-group');
      const mode = container.getAttribute('data-mode') || 'multi';
      const val = itemEl.getAttribute('data-value');
      if (!groupName || !val) return;
      triggerHaptic();

      if (mode === 'single') {
        const wasSel = itemEl.classList.contains('selected');
        container.querySelectorAll('.selected').forEach(el => el.classList.remove('selected'));
        if (wasSel) {
          state[groupName] = [];
        } else {
          itemEl.classList.add('selected');
          state[groupName] = [val];
        }
      } else {
        itemEl.classList.toggle('selected');
        if (itemEl.classList.contains('selected')) {
          if (!state[groupName].includes(val)) state[groupName].push(val);
        } else {
          state[groupName] = state[groupName].filter(v => v !== val);
        }
      }

      const imgSrc = itemEl.getAttribute('data-img');
      if (imgSrc) {
        if (itemEl.classList.contains('selected')) {
          selectedImages.set(val, { img: imgSrc, label: val });
          const simImg = document.getElementById('lightSimImg');
          if (groupName === 'ceilingStyle' && simImg) simImg.src = imgSrc;
          showToast(itemEl.getAttribute('data-toast') || `✨ Added ${val}`);
        } else {
          selectedImages.delete(val);
        }
      }

      const colorsAttr = itemEl.getAttribute('data-colors');
      if (colorsAttr) {
        if (itemEl.classList.contains('selected')) {
          selectedColorDots.set(val, colorsAttr.split(','));
          showToast(`🎨 ${val} palette added`);
        } else {
          selectedColorDots.delete(val);
        }
      }

      if (container.id === 'lightToneGroup' && itemEl.classList.contains('selected')) {
        const tint = itemEl.getAttribute('data-tint');
        const badge = itemEl.getAttribute('data-badge');
        const filterClass = itemEl.getAttribute('data-filter');
        const tintEl = document.getElementById('lightSimTint');
        const labelEl = document.getElementById('lightSimLabel');
        const simImg = document.getElementById('lightSimImg');
        if (tintEl && tint) tintEl.style.background = tint;
        if (labelEl && badge) labelEl.textContent = badge;
        if (simImg && filterClass) {
          simImg.className = filterClass;
        }
      }

      updateLiveUI();
    }

    document.querySelectorAll('.v-card').forEach(card => {
      card.addEventListener('click', (e) => {
        if (e.target.closest('.v-zoom')) return;
        const container = card.closest('[data-group]');
        if (container) toggleGroupSelection(container, card);
      });
    });

    document.querySelectorAll('.studio-tile, .studio-pill, .p-swatch-card, .budget-tier-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const container = btn.closest('[data-group]');
        if (container) toggleGroupSelection(container, btn);
      });
    });

    [locEl, dislikesEl, notesEl].forEach(el => {
      if (el) el.addEventListener('input', updateLiveUI);
    });

    function buildSummaryText() {
      const lines = [];
      const activeName = (nameEl?.value || finalNameEl?.value || '').trim();
      const activePhone = (phoneEl?.value || finalPhoneEl?.value || '').trim();
      lines.push('CLIENT DESIGN DNA BRIEF — SIDDHIVINAYAK DESIGNERS');
      lines.push('----------------------------------------');
      if (activeName) lines.push('Client Name: ' + activeName);
      if (activePhone) lines.push('Phone: +91 ' + activePhone);
      if (state.propertyNode.length || locEl.value.trim()) {
        lines.push('Location: ' + [state.propertyNode.join(', '), locEl.value.trim()].filter(Boolean).join(' - '));
      }
      if (state.propertyType.length) lines.push('Property Type: ' + state.propertyType.join(', '));
      if (state.timeline.length) lines.push('Timeline: ' + state.timeline.join(', '));
      lines.push('');

      if (state.homeStyle.length) lines.push('Home Vibe: ' + state.homeStyle.join(' | '));
      if (state.ceilingStyle.length) lines.push('False Ceiling: ' + state.ceilingStyle.join(' | '));
      if (state.lightTone.length) lines.push('Light Tone: ' + state.lightTone.join(', '));
      if (state.lightExtras.length) lines.push('Light Extras: ' + state.lightExtras.join(', '));

      if (state.wardrobeStyle.length) lines.push('Wardrobe Style: ' + state.wardrobeStyle.join(' | '));
      if (state.wardrobeFinish.length) lines.push('Wardrobe Finish: ' + state.wardrobeFinish.join(', '));
      if (state.loftPref.length) lines.push('Loft Design: ' + state.loftPref.join(', '));
      if (state.wardrobeExtras.length) lines.push('Wardrobe Accessories: ' + state.wardrobeExtras.join(', '));

      if (state.kitchenStyle.length) lines.push('Kitchen Style: ' + state.kitchenStyle.join(' | '));
      if (state.kitchenLayout.length) lines.push('Kitchen Layout: ' + state.kitchenLayout.join(', '));
      if (state.countertop.length) lines.push('Countertop: ' + state.countertop.join(', '));
      if (state.kitchenExtras.length) lines.push('Kitchen Appliances: ' + state.kitchenExtras.join(', '));

      if (state.livingElements.length) lines.push('Living & Pooja: ' + state.livingElements.join(' | '));
      if (state.wallDecor.length) lines.push('Wall Decor: ' + state.wallDecor.join(', '));

      if (state.colorPalette.length) lines.push('Color Palettes: ' + state.colorPalette.join(' | '));
      if (state.lifestyle.length) lines.push('Family Needs: ' + state.lifestyle.join(', '));
      if (state.vastu.length) lines.push('Vastu: ' + state.vastu.join(', '));
      if (state.storageStyle.length) lines.push('Storage Approach: ' + state.storageStyle.join(', '));
      if (state.budget.length) lines.push('Budget Comfort: ' + state.budget.join(', '));

      if (dislikesEl.value.trim()) lines.push('Strict Dislikes: ' + dislikesEl.value.trim());
      if (notesEl.value.trim()) lines.push('Notes / Links: ' + notesEl.value.trim());

      return lines.join('\n');
    }

    function updateLiveUI() {
      moodboardCountEl.textContent = String(selectedImages.size);
      if (selectedImages.size === 0) {
        thumbStackEl.innerHTML = '<span class="stack-empty-dot"></span>';
      } else {
        const imgs = Array.from(selectedImages.values()).slice(-3);
        thumbStackEl.innerHTML = imgs.map(item => `<img src="${item.img}" width="22" height="22" alt="" />`).join('');
      }
      previewEl.textContent = buildSummaryText();
    }

    function computePersona() {
      const styles = state.homeStyle.join(' ');
      if (styles.includes('Opulent')) return 'The Modern Luxury Curator';
      if (styles.includes('Neo-Classical')) return 'The Timeless Heritage Connoisseur';
      if (styles.includes('Contemporary Minimal')) return 'The Warm Contemporary Minimalist';
      if (styles.includes('Wooden')) return 'The Warm Earthy Sanctuary';
      if (styles.includes('Minimalist')) return 'The Serene Minimalist';
      return 'Custom Signature Home DNA';
    }

    function renderDnaReveal() {
      document.getElementById('dnaPersonaTitle').textContent = computePersona();
      const cName = (nameEl?.value || finalNameEl?.value || '').trim();
      document.getElementById('dnaClientLabel').textContent = cName ? `${cName}'s Home` : 'Your Dream Home';

      const mosaicEl = document.getElementById('dnaMosaic');
      if (selectedImages.size === 0) {
        mosaicEl.innerHTML = '<div class="dna-mosaic-empty">No reference photos tapped yet — tap any step dot at the top to pick your favorite looks!</div>';
      } else {
        mosaicEl.innerHTML = Array.from(selectedImages.values()).map(item => `
          <div class="dna-mosaic-item">
            <img src="${item.img}" alt="${item.label}" />
            <span>${item.label}</span>
          </div>
        `).join('');
      }

      const paletteDotsEl = document.getElementById('dnaPaletteDots');
      const allColors = [];
      selectedColorDots.forEach(arr => arr.forEach(c => allColors.push(c)));
      paletteDotsEl.innerHTML = allColors.slice(0, 9).map(c => `<span style="background:${c}"></span>`).join('');

      previewEl.textContent = buildSummaryText();
    }

    function fireConfetti() {
      const burst = document.getElementById('confettiBurst');
      if (!burst) return;
      burst.innerHTML = '';
      const colors = ['#189ba6', '#b89047', '#25D366', '#f59e0b', '#ec4899'];
      for (let i = 0; i < 24; i++) {
        const dot = document.createElement('span');
        dot.className = 'confetti-piece';
        dot.style.left = Math.random() * 100 + '%';
        dot.style.top = '-10px';
        dot.style.background = colors[i % colors.length];
        dot.style.animationDelay = (Math.random() * 0.4) + 's';
        burst.appendChild(dot);
      }
      setTimeout(() => burst.innerHTML = '', 2000);
    }

    // Moodboard Drawer Sheet
    const drawerBackdrop = document.getElementById('moodboardDrawerBackdrop');
    const drawerGrid = document.getElementById('drawerGrid');
    document.getElementById('openMoodboardBtn').addEventListener('click', () => {
      triggerHaptic();
      if (selectedImages.size === 0) {
        drawerGrid.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:1.5rem;color:#6b7280;">Tap photos in Steps 2–6 to collect them into your personal moodboard!</div>';
      } else {
        drawerGrid.innerHTML = Array.from(selectedImages.values()).map(item => `
          <div class="dna-mosaic-item">
            <img src="${item.img}" alt="${item.label}" />
            <span>${item.label}</span>
          </div>
        `).join('');
      }
      drawerBackdrop.classList.remove('d-none');
    });
    const closeDrawer = () => drawerBackdrop.classList.add('d-none');
    document.getElementById('closeMoodboardBtn').addEventListener('click', closeDrawer);
    drawerBackdrop.addEventListener('click', (e) => {
      if (e.target === drawerBackdrop) closeDrawer();
    });

    // Submit -> WhatsApp
    document.getElementById('designBriefForm').addEventListener('submit', function(e) {
      e.preventDefault();
      feedbackEl.classList.add('d-none');

      const clientName = (finalNameEl.value || nameEl.value).trim();
      const rawPhone = (finalPhoneEl.value || phoneEl.value).replace(/\D/g, '');
      const clientPhone = rawPhone.slice(-10);

      if (!clientName) {
        showToast('👋 Enter your Name below to send');
        feedbackEl.textContent = 'Please enter your Name above before sending on WhatsApp.';
        feedbackEl.className = 'studio-feedback error mt-3';
        finalNameEl.focus();
        return;
      }
      if (!clientPhone || clientPhone.length < 10) {
        showToast('📱 Enter a 10-digit WhatsApp Number');
        feedbackEl.textContent = 'Please enter a valid 10-digit WhatsApp number above.';
        feedbackEl.className = 'studio-feedback error mt-3';
        finalPhoneEl.focus();
        return;
      }

      const fullBrief = buildSummaryText();
      const waUrl = `https://wa.me/918369297174?text=${encodeURIComponent(fullBrief)}`;
      window.open(waUrl, '_blank');
      feedbackEl.textContent = 'Opening WhatsApp with your Design DNA ready to send!';
      feedbackEl.className = 'studio-feedback success mt-3';
    });

    document.getElementById('copyBriefBtn').addEventListener('click', function() {
      const btn = this;
      navigator.clipboard.writeText(buildSummaryText()).then(() => {
        const orig = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-check me-1"></i> Copied!';
        setTimeout(() => btn.innerHTML = orig, 2200);
      });
    });

    document.getElementById('copyPageLinkBtn').addEventListener('click', function() {
      const btn = this;
      navigator.clipboard.writeText(window.location.href).then(() => {
        const orig = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-check me-1"></i> Link Copied!';
        setTimeout(() => btn.innerHTML = orig, 2400);
      });
    });

    document.getElementById('printBriefBtn').addEventListener('click', () => window.print());

    // Zoom modal
    const zoomModal = document.getElementById('briefZoomModal');
    const zoomImg = document.getElementById('briefZoomImg');
    const zoomCap = document.getElementById('briefZoomCaption');
    document.querySelectorAll('.v-zoom').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        zoomImg.src = btn.getAttribute('data-zoom');
        zoomCap.textContent = btn.getAttribute('data-caption') || '';
        zoomModal.classList.remove('d-none');
        zoomModal.setAttribute('aria-hidden', 'false');
      });
    });
    const closeZoom = () => {
      zoomModal.classList.add('d-none');
      zoomModal.setAttribute('aria-hidden', 'true');
      zoomImg.src = '';
    };
    document.getElementById('briefZoomClose').addEventListener('click', closeZoom);
    zoomModal.addEventListener('click', (e) => {
      if (e.target === zoomModal) closeZoom();
    });

    updateLiveUI();
  })();
</script>
