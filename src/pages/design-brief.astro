---
import Layout from '../layouts/Layout.astro';

const title = "Client Design Taste & Style Brief | Siddhivinayak Designers";
const description = "Share your home interior taste and style preferences—false ceiling, wardrobes, modular kitchen, living room, lighting, colors, and budget—with Siddhivinayak Designers.";
const canonical = "https://siddhivinayakdesigners.in/design-brief/";
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://siddhivinayakdesigners.in/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Client Design Brief",
          "item": "https://siddhivinayakdesigners.in/design-brief/"
        }
      ]
    },
    {
      "@type": "WebPage",
      "@id": "https://siddhivinayakdesigners.in/design-brief/#webpage",
      "name": "Client Design Taste & Style Brief",
      "url": "https://siddhivinayakdesigners.in/design-brief/",
      "description": "Interactive visual interior design taste questionnaire for Navi Mumbai homeowners."
    }
  ]
});
---

<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <!-- Hero Header -->
  <section class="brief-hero">
    <div class="container">
      <div class="brief-hero-inner text-center mx-auto">
        <span class="brief-badge">
          <i class="fas fa-swatchbook me-1"></i> Client Onboarding &amp; Taste Form
        </span>
        <h1 class="brief-title">Tell Us How You Envision Your Dream Home</h1>
        <p class="brief-subtitle">
          Tap the designs, finishes, lighting, and color palettes you naturally love. Takes just 2 minutes—no design jargon needed. Your choices help our team craft 3D concepts made specifically for your family.
        </p>
        <div class="brief-hero-actions">
          <button type="button" class="brief-share-btn" id="copyPageLinkBtn">
            <i class="fas fa-share-nodes me-1"></i> Share Form with Spouse / Partner
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Sticky Progress & Quick Navigation -->
  <div class="brief-progress-bar-wrap" id="briefProgressWrap">
    <div class="container">
      <div class="brief-progress-top">
        <span class="brief-progress-label" id="briefProgressText">0 of 7 Sections Filled</span>
        <span class="brief-progress-pct" id="briefProgressPct">0%</span>
      </div>
      <div class="brief-progress-track">
        <div class="brief-progress-fill" id="briefProgressFill"></div>
      </div>
      <div class="brief-nav-pills">
        <a href="#sec-basics" class="brief-nav-pill">1. Basics</a>
        <a href="#sec-vibe" class="brief-nav-pill">2. Home Vibe</a>
        <a href="#sec-ceiling" class="brief-nav-pill">3. Ceiling &amp; Lights</a>
        <a href="#sec-wardrobe" class="brief-nav-pill">4. Wardrobes</a>
        <a href="#sec-kitchen" class="brief-nav-pill">5. Kitchen</a>
        <a href="#sec-living" class="brief-nav-pill">6. Living &amp; Pooja</a>
        <a href="#sec-lifestyle" class="brief-nav-pill">7. Colors &amp; Budget</a>
      </div>
    </div>
  </div>

  <!-- Main Questionnaire Form -->
  <section class="brief-main-section">
    <div class="container">
      <form id="designBriefForm" class="brief-form" novalidate>

        <!-- SECTION 1: BASICS -->
        <div class="brief-card" id="sec-basics">
          <div class="brief-card-head">
            <span class="brief-step-num">01</span>
            <div>
              <h2 class="brief-section-title">Client &amp; Property Details</h2>
              <p class="brief-section-desc">Basic details about your home so we can tag this brief to your project file.</p>
            </div>
          </div>

          <div class="row g-3 mt-1">
            <div class="col-md-4">
              <label for="clientName" class="brief-field-label">Your Full Name <span class="text-danger">*</span></label>
              <input type="text" id="clientName" class="form-control brief-input" placeholder="e.g., Rahul Sharma" required />
            </div>
            <div class="col-md-4">
              <label for="clientPhone" class="brief-field-label">WhatsApp / Mobile Number <span class="text-danger">*</span></label>
              <div class="input-group">
                <span class="input-group-text brief-addon">+91</span>
                <input type="tel" id="clientPhone" class="form-control brief-input" placeholder="10-digit mobile number" pattern="[6-9][0-9]{9}" required />
              </div>
            </div>
            <div class="col-md-4">
              <label for="clientLocation" class="brief-field-label">Node / Area &amp; Society Name</label>
              <input type="text" id="clientLocation" class="form-control brief-input" placeholder="e.g., Kharghar - Sai World Empire" />
            </div>
          </div>

          <div class="mt-4">
            <label class="brief-field-label">Property Configuration</label>
            <div class="brief-chip-group" data-group="propertyType" data-mode="single">
              <button type="button" class="brief-chip" data-value="1 BHK">1 BHK</button>
              <button type="button" class="brief-chip" data-value="2 BHK">2 BHK</button>
              <button type="button" class="brief-chip" data-value="3 BHK">3 BHK</button>
              <button type="button" class="brief-chip" data-value="4+ BHK / Duplex">4+ BHK / Duplex</button>
              <button type="button" class="brief-chip" data-value="Villa / Bungalow">Villa / Bungalow</button>
              <button type="button" class="brief-chip" data-value="Commercial / Office">Commercial / Office</button>
            </div>
          </div>

          <div class="mt-4">
            <label class="brief-field-label">Expected Move-In / Handover Timeline</label>
            <div class="brief-chip-group" data-group="timeline" data-mode="single">
              <button type="button" class="brief-chip" data-value="Urgent (Within 45-60 Days)">Urgent (45–60 Days)</button>
              <button type="button" class="brief-chip" data-value="2-4 Months">2–4 Months</button>
              <button type="button" class="brief-chip" data-value="4-6 Months (Under Possession)">4–6 Months</button>
              <button type="button" class="brief-chip" data-value="Flexible / Planning Ahead">Flexible / Planning</button>
            </div>
          </div>
        </div>

        <!-- SECTION 2: OVERALL HOME VIBE -->
        <div class="brief-card" id="sec-vibe">
          <div class="brief-card-head">
            <span class="brief-step-num">02</span>
            <div>
              <h2 class="brief-section-title">Overall Home Vibe &amp; Aesthetic</h2>
              <p class="brief-section-desc">Tap 1 or 2 styles that feel closest to what you want to come home to every day.</p>
            </div>
          </div>

          <div class="brief-visual-grid" data-group="homeStyle" data-mode="multi">
            <div class="brief-visual-card" data-value="Bright & Minimalist">
              <div class="brief-img-box">
                <img src="/assets/images/minimal-2bhk-seawoods/img1.webp" alt="Bright and Minimalist interior style" loading="lazy" decoding="async" />
                <span class="brief-check-badge"><i class="fas fa-check"></i></span>
                <button type="button" class="brief-zoom-btn" data-zoom="/assets/images/minimal-2bhk-seawoods/img1.webp" data-caption="Bright & Minimalist — Clean surfaces, airy light tones & clutter-free calm" aria-label="Zoom preview"><i class="fas fa-expand-alt"></i></button>
              </div>
              <div class="brief-visual-body">
                <h3>Bright &amp; Minimalist</h3>
                <p>Crisp whites, warm greige, clean flat surfaces, clutter-free calm.</p>
              </div>
            </div>

            <div class="brief-visual-card" data-value="Luxury Neo-Classical">
              <div class="brief-img-box">
                <img src="/assets/images/contemporary-2bhk-kharghar/img1.webp" alt="Luxury Neo-Classical wall mouldings interior" loading="lazy" decoding="async" />
                <span class="brief-check-badge"><i class="fas fa-check"></i></span>
                <button type="button" class="brief-zoom-btn" data-zoom="/assets/images/contemporary-2bhk-kharghar/img1.webp" data-caption="Luxury Neo-Classical — Wall mouldings, soft creams & chandelier elegance" aria-label="Zoom preview"><i class="fas fa-expand-alt"></i></button>
              </div>
              <div class="brief-visual-body">
                <h3>Luxury Neo-Classical</h3>
                <p>European wall mouldings, soft neutrals, chandeliers &amp; refined grace.</p>
              </div>
            </div>

            <div class="brief-visual-card" data-value="Warm Wooden & Cozy">
              <div class="brief-img-box">
                <img src="/assets/images/rustic-3bhk-home-nerul/img4.webp" alt="Warm wooden and earthy cozy interior" loading="lazy" decoding="async" />
                <span class="brief-check-badge"><i class="fas fa-check"></i></span>
                <button type="button" class="brief-zoom-btn" data-zoom="/assets/images/rustic-3bhk-home-nerul/img4.webp" data-caption="Warm Wooden & Cozy — Natural wood textures, earthy warmth & ambient lighting" aria-label="Zoom preview"><i class="fas fa-expand-alt"></i></button>
              </div>
              <div class="brief-visual-body">
                <h3>Warm Wooden &amp; Cozy</h3>
                <p>Rich walnut/teak grain, earthy tones, warm inviting homeliness.</p>
              </div>
            </div>

            <div class="brief-visual-card" data-value="Opulent Modern & Marble">
              <div class="brief-img-box">
                <img src="/assets/images/premium-4bhk-ghansoli/img3.webp" alt="Opulent Modern Marble and Gold interior" loading="lazy" decoding="async" />
                <span class="brief-check-badge"><i class="fas fa-check"></i></span>
                <button type="button" class="brief-zoom-btn" data-zoom="/assets/images/premium-4bhk-ghansoli/img3.webp" data-caption="Opulent Modern & Marble — Fluted textures, gold trims & grand statement accents" aria-label="Zoom preview"><i class="fas fa-expand-alt"></i></button>
              </div>
              <div class="brief-visual-body">
                <h3>Opulent Modern &amp; Marble</h3>
                <p>Italian marble look, fluted panels, brass/gold trims &amp; statement luxury.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- SECTION 3: FALSE CEILING & LIGHTING -->
        <div class="brief-card" id="sec-ceiling">
          <div class="brief-card-head">
            <span class="brief-step-num">03</span>
            <div>
              <h2 class="brief-section-title">False Ceiling &amp; Lighting Taste</h2>
              <p class="brief-section-desc">Choose your favorite ceiling patterns and preferred light warmth.</p>
            </div>
          </div>

          <div class="brief-visual-grid" data-group="ceilingStyle" data-mode="multi">
            <div class="brief-visual-card" data-value="Peripheral Border + Warm Cove Glow">
              <div class="brief-img-box">
                <img src="/assets/images/premium-4bhk-ghansoli/img9.webp" alt="Peripheral border ceiling with cove lighting" loading="lazy" decoding="async" />
                <span class="brief-check-badge"><i class="fas fa-check"></i></span>
                <button type="button" class="brief-zoom-btn" data-zoom="/assets/images/premium-4bhk-ghansoli/img9.webp" data-caption="Peripheral Border + Warm Cove — Keeps center height open with soft perimeter glow" aria-label="Zoom preview"><i class="fas fa-expand-alt"></i></button>
              </div>
              <div class="brief-visual-body">
                <h3>Peripheral Border + Cove Glow</h3>
                <p>Maximizes full center ceiling height with soft indirect perimeter lighting.</p>
              </div>
            </div>

            <div class="brief-visual-card" data-value="Dual-Layer Gypsum + COB Spotlights">
              <div class="brief-img-box">
                <img src="/assets/images/2026-04-11 (11).webp" alt="Dual-layer gypsum ceiling with spotlights" loading="lazy" decoding="async" />
                <span class="brief-check-badge"><i class="fas fa-check"></i></span>
                <button type="button" class="brief-zoom-btn" data-zoom="/assets/images/2026-04-11 (11).webp" data-caption="Dual-Layer Gypsum + COB Spotlights — Architectural stepped ceiling with focused spots" aria-label="Zoom preview"><i class="fas fa-expand-alt"></i></button>
              </div>
              <div class="brief-visual-body">
                <h3>Dual-Layer Gypsum + Spotlights</h3>
                <p>Multi-level POP drop ceiling with directional COB spots for rich depth.</p>
              </div>
            </div>

            <div class="brief-visual-card" data-value="Linear Recessed Profile LEDs">
              <div class="brief-img-box">
                <img src="/assets/images/contemporary-3bhk-house-belapur/img6.webp" alt="Linear recessed profile LED ceiling" loading="lazy" decoding="async" />
                <span class="brief-check-badge"><i class="fas fa-check"></i></span>
                <button type="button" class="brief-zoom-btn" data-zoom="/assets/images/contemporary-3bhk-house-belapur/img6.webp" data-caption="Linear Profile LEDs — Sleek modern geometric light strips recessed flush" aria-label="Zoom preview"><i class="fas fa-expand-alt"></i></button>
              </div>
              <div class="brief-visual-body">
                <h3>Linear Recessed Profile LEDs</h3>
                <p>Sleek architectural light lines seamlessly flush inside gypsum ceiling.</p>
              </div>
            </div>

            <div class="brief-visual-card" data-value="Wooden Rafters / Slatted Ceiling Accent">
              <div class="brief-img-box">
                <img src="/assets/images/rustic-3bhk-home-nerul/img4.webp" alt="Wooden ceiling panel and rafters" loading="lazy" decoding="async" />
                <span class="brief-check-badge"><i class="fas fa-check"></i></span>
                <button type="button" class="brief-zoom-btn" data-zoom="/assets/images/rustic-3bhk-home-nerul/img4.webp" data-caption="Wooden Rafters / Ceiling Accents — Warm veneer/laminate paneling detail" aria-label="Zoom preview"><i class="fas fa-expand-alt"></i></button>
              </div>
              <div class="brief-visual-body">
                <h3>Wooden Rafters / Panel Accent</h3>
                <p>Warm wooden ceiling beams or veneer inlays in living &amp; dining zones.</p>
              </div>
            </div>
          </div>

          <div class="row g-4 mt-2">
            <div class="col-md-6">
              <label class="brief-field-label">Preferred Lighting Tone</label>
              <div class="brief-chip-group" data-group="lightTone" data-mode="single">
                <button type="button" class="brief-chip" data-value="Warm White (3000K — Hotel Cozy)"><span class="tone-dot" style="background:#ffe0a3;"></span> Warm White (3000K)</button>
                <button type="button" class="brief-chip" data-value="Natural Daylight (4000K — Balanced)"><span class="tone-dot" style="background:#fff4dc;"></span> Natural White (4000K)</button>
                <button type="button" class="brief-chip" data-value="Cool White (6000K — Crisp Bright)"><span class="tone-dot" style="background:#eef7ff;"></span> Cool White (6000K)</button>
                <button type="button" class="brief-chip" data-value="Smart 3-in-1 / Dimmable">3-in-1 Smart Lights</button>
              </div>
            </div>
            <div class="col-md-6">
              <label class="brief-field-label">Decorative Fixtures &amp; Extras</label>
              <div class="brief-chip-group" data-group="lightExtras" data-mode="multi">
                <button type="button" class="brief-chip" data-value="Statement Chandelier">Living / Dining Chandelier</button>
                <button type="button" class="brief-chip" data-value="Bedside Hanging Pendants">Bedside Hanging Pendants</button>
                <button type="button" class="brief-chip" data-value="No Heavy POP in Bedrooms (Plain Ceiling)">Simple Ceiling in Bedrooms</button>
                <button type="button" class="brief-chip" data-value="Concealed Curtain Pelmets">Concealed Curtain Pelmets</button>
              </div>
            </div>
          </div>
        </div>

        <!-- SECTION 4: WARDROBES & BEDROOM STORAGE -->
        <div class="brief-card" id="sec-wardrobe">
          <div class="brief-card-head">
            <span class="brief-step-num">04</span>
            <div>
              <h2 class="brief-section-title">Wardrobes &amp; Bedroom Finishes</h2>
              <p class="brief-section-desc">Select door styles, laminate finishes, loft design, and internal organizers you want.</p>
            </div>
          </div>

          <div class="brief-visual-grid" data-group="wardrobeStyle" data-mode="multi">
            <div class="brief-visual-card" data-value="Full-Height Sliding Wardrobe with Metallic Trim">
              <div class="brief-img-box">
                <img src="/assets/images/minimal-2bhk-seawoods/img12.webp" alt="Full height sliding wardrobe with gold trim" loading="lazy" decoding="async" />
                <span class="brief-check-badge"><i class="fas fa-check"></i></span>
                <button type="button" class="brief-zoom-btn" data-zoom="/assets/images/minimal-2bhk-seawoods/img12.webp" data-caption="Full-Height Sliding Wardrobe — Space-saving doors with sleek metallic profiles" aria-label="Zoom preview"><i class="fas fa-expand-alt"></i></button>
              </div>
              <div class="brief-visual-body">
                <h3>Full-Height Sliding + Gold Trim</h3>
                <p>Zero door-swing clearance needed; sleek floor-to-ceiling tracks.</p>
              </div>
            </div>

            <div class="brief-visual-card" data-value="Sliding Mirrored Wardrobe with Dresser">
              <div class="brief-img-box">
                <img src="/assets/images/minimal-2bhk-seawoods/img11.webp" alt="Sliding mirrored wardrobe" loading="lazy" decoding="async" />
                <span class="brief-check-badge"><i class="fas fa-check"></i></span>
                <button type="button" class="brief-zoom-btn" data-zoom="/assets/images/minimal-2bhk-seawoods/img11.webp" data-caption="Sliding Mirrored Wardrobe — Full-length mirror panels make bedrooms look 2x larger" aria-label="Zoom preview"><i class="fas fa-expand-alt"></i></button>
              </div>
              <div class="brief-visual-body">
                <h3>Mirrored Sliding + Dresser</h3>
                <p>Reflects light and saves separate dressing table wall space.</p>
              </div>
            </div>

            <div class="brief-visual-card" data-value="Tinted / Fluted Glass Profile Shutters">
              <div class="brief-img-box">
                <img src="/assets/images/wardrobe/four-door-modern-wardrobe-with-tinted-glass-shutters.webp" alt="Tinted glass shutter wardrobe" loading="lazy" decoding="async" />
                <span class="brief-check-badge"><i class="fas fa-check"></i></span>
                <button type="button" class="brief-zoom-btn" data-zoom="/assets/images/wardrobe/four-door-modern-wardrobe-with-tinted-glass-shutters.webp" data-caption="Tinted / Fluted Glass Wardrobe — Boutique luxury aesthetic with sensor LED strips" aria-label="Zoom preview"><i class="fas fa-expand-alt"></i></button>
              </div>
              <div class="brief-visual-body">
                <h3>Tinted / Fluted Glass Shutters</h3>
                <p>Luxury boutique walk-in closet look with internal sensor lights.</p>
              </div>
            </div>

            <div class="brief-visual-card" data-value="Classic Hinged Doors + Overhead Loft">
              <div class="brief-img-box">
                <img src="/assets/images/wardrobe/4-door-wardrobe-design-with-cabinets-and-drawers-for-storage.webp" alt="4 door hinged wardrobe with drawers and loft" loading="lazy" decoding="async" />
                <span class="brief-check-badge"><i class="fas fa-check"></i></span>
                <button type="button" class="brief-zoom-btn" data-zoom="/assets/images/wardrobe/4-door-wardrobe-design-with-cabinets-and-drawers-for-storage.webp" data-caption="Classic Hinged Wardrobe + Loft — 100% full interior visibility and durable hardware" aria-label="Zoom preview"><i class="fas fa-expand-alt"></i></button>
              </div>
              <div class="brief-visual-body">
                <h3>Classic Hinged + Loft Storage</h3>
                <p>Opens all doors together for easy access; zero dust-track maintenance.</p>
              </div>
            </div>
          </div>

          <div class="row g-4 mt-2">
            <div class="col-md-6">
              <label class="brief-field-label">Wardrobe Shutter Finish</label>
              <div class="brief-chip-group" data-group="wardrobeFinish" data-mode="single">
                <button type="button" class="brief-chip" data-value="Matte / Suede Laminate">Matte / Suede Laminate</button>
                <button type="button" class="brief-chip" data-value="High-Gloss Acrylic / Laminate">High-Gloss Acrylic</button>
                <button type="button" class="brief-chip" data-value="Textured Wood-Grain">Wooden Texture</button>
                <button type="button" class="brief-chip" data-value="PU Lacquered / Fluted">PU Painted / Fluted</button>
              </div>
            </div>
            <div class="col-md-6">
              <label class="brief-field-label">Loft Preference</label>
              <div class="brief-chip-group" data-group="loftPref" data-mode="single">
                <button type="button" class="brief-chip" data-value="Flush Full-Height Doors (Single seamless shutter)">Seamless Full-Height</button>
                <button type="button" class="brief-chip" data-value="Separate Overhead Loft Doors">Separate Overhead Lofts</button>
                <button type="button" class="brief-chip" data-value="No Loft (Clean Minimal)">No Loft Needed</button>
              </div>
            </div>
          </div>

          <div class="mt-4">
            <label class="brief-field-label">Must-Have Wardrobe &amp; Bedroom Features</label>
            <div class="brief-chip-group" data-group="wardrobeExtras" data-mode="multi">
              <button type="button" class="brief-chip" data-value="Saree / Trouser Pull-Out">Saree / Trouser Pull-Out</button>
              <button type="button" class="brief-chip" data-value="Velvet Jewelry Drawer">Jewelry Organizer Drawer</button>
              <button type="button" class="brief-chip" data-value="Hidden / Pull-Out Dressing Mirror">Pull-Out Mirror</button>
              <button type="button" class="brief-chip" data-value="Digital Safe / Secret Locker">Secret Locker Drawer</button>
              <button type="button" class="brief-chip" data-value="Wardrobe-cum-Study / Vanity">Attached Study / Vanity</button>
              <button type="button" class="brief-chip" data-value="Hydraulic Storage Bed">Hydraulic Storage Bed</button>
            </div>
          </div>
        </div>

        <!-- SECTION 5: MODULAR KITCHEN -->
        <div class="brief-card" id="sec-kitchen">
          <div class="brief-card-head">
            <span class="brief-step-num">05</span>
            <div>
              <h2 class="brief-section-title">Modular Kitchen Taste</h2>
              <p class="brief-section-desc">Pick the kitchen aesthetic, finish, countertop, and smart accessories you prefer.</p>
            </div>
          </div>

          <div class="brief-visual-grid" data-group="kitchenStyle" data-mode="multi">
            <div class="brief-visual-card" data-value="High-Gloss Handleless Acrylic Kitchen">
              <div class="brief-img-box">
                <img src="/assets/images/minimal-2bhk-seawoods/img7.webp" alt="High gloss handleless acrylic kitchen" loading="lazy" decoding="async" />
                <span class="brief-check-badge"><i class="fas fa-check"></i></span>
                <button type="button" class="brief-zoom-btn" data-zoom="/assets/images/minimal-2bhk-seawoods/img7.webp" data-caption="High-Gloss Handleless Acrylic — Bright mirror sheen, sleek G-profile & easy stain wipe" aria-label="Zoom preview"><i class="fas fa-expand-alt"></i></button>
              </div>
              <div class="brief-visual-body">
                <h3>High-Gloss Handleless Acrylic</h3>
                <p>Bright reflective sheen, Gola handleless profiles, easy wipe-down.</p>
              </div>
            </div>

            <div class="brief-visual-card" data-value="Fluted Glass Overhead Display Cabinets">
              <div class="brief-img-box">
                <img src="/assets/images/contemporary-2bhk-kharghar/img3.webp" alt="Modular kitchen with fluted glass cabinets" loading="lazy" decoding="async" />
                <span class="brief-check-badge"><i class="fas fa-check"></i></span>
                <button type="button" class="brief-zoom-btn" data-zoom="/assets/images/contemporary-2bhk-kharghar/img3.webp" data-caption="Fluted Glass Upper Cabinets — Designer ribbed glass shutters with warm backlit glow" aria-label="Zoom preview"><i class="fas fa-expand-alt"></i></button>
              </div>
              <div class="brief-visual-body">
                <h3>Fluted Glass Overhead Cabinets</h3>
                <p>Translucent ribbed glass upper shutters paired with profile lights.</p>
              </div>
            </div>

            <div class="brief-visual-card" data-value="Silky Matte Anti-Fingerprint Finish">
              <div class="brief-img-box">
                <img src="/assets/images/modular-kitchen/a-u-shaped-kitchen-home-interior-design-with-black-matte-finish-cabinets-that-add-a-sleek-look.webp" alt="Matte finish modern kitchen" loading="lazy" decoding="async" />
                <span class="brief-check-badge"><i class="fas fa-check"></i></span>
