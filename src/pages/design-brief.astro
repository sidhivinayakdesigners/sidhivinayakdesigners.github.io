</style>

<script is:inline>
  (function() {
    // Prevent auto consultation popup from interrupting clients while filling out the Design Brief
    if (window.location.pathname.includes('design-brief')) {
      const hidePopupStyle = document.createElement('style');
      hidePopupStyle.textContent = '#consultationPopup { display: none !important; } body.consultation-popup-open { overflow: auto !important; }';
      document.head.appendChild(hidePopupStyle);
    }

    const state = {
      propertyType: [],
      timeline: [],
      homeStyle: [],
      ceilingStyle: [],
      lightTone: [],
      lightExtras: [],
      wardrobeStyle: [],
      wardrobeFinish: [],
      loftPref: [],
      wardrobeExtras: [],
      kitchenStyle: [],
      countertop: [],
      kitchenLayout: [],
      kitchenExtras: [],
      livingElements: [],
      wallDecor: [],
      colorPalette: [],
      lifestyle: [],
      vastu: [],
      storageStyle: [],
      budget: []
    };

    const nameEl = document.getElementById('clientName');
    const phoneEl = document.getElementById('clientPhone');
    const locEl = document.getElementById('clientLocation');
    const dislikesEl = document.getElementById('clientDislikes');
    const notesEl = document.getElementById('clientNotes');
    const previewEl = document.getElementById('liveBriefPreview');
    const progressTextEl = document.getElementById('briefProgressText');
    const progressPctEl = document.getElementById('briefProgressPct');
    const progressFillEl = document.getElementById('briefProgressFill');
    const feedbackEl = document.getElementById('briefFormFeedback');

    function toggleGroupSelection(groupContainer, itemEl) {
      const groupName = groupContainer.getAttribute('data-group');
      const mode = groupContainer.getAttribute('data-mode') || 'multi';
      const val = itemEl.getAttribute('data-value');
      if (!groupName || !val) return;

      if (mode === 'single') {
        const wasSelected = itemEl.classList.contains('selected');
        groupContainer.querySelectorAll('.selected').forEach(el => el.classList.remove('selected'));
        if (wasSelected) {
          state[groupName] = [];
        } else {
          itemEl.classList.add('selected');
          state[groupName] = [val];
        }
      } else {
        itemEl.classList.toggle('selected');
        if (itemEl.classList.contains('selected')) {
          if (!state[groupName].includes(val)) state[groupName].push(val);
        } else {
          state[groupName] = state[groupName].filter(v => v !== val);
        }
      }
      updateBrief();
    }

    // Bind visual cards, chips, and palette cards
    document.querySelectorAll('.brief-visual-card').forEach(card => {
      card.addEventListener('click', (e) => {
        if (e.target.closest('.brief-zoom-btn')) return;
        const container = card.closest('[data-group]');
        if (container) toggleGroupSelection(container, card);
      });
    });

    document.querySelectorAll('.brief-chip, .brief-palette-card').forEach(btn => {
      btn.addEventListener('click', () => {
        const container = btn.closest('[data-group]');
        if (container) toggleGroupSelection(container, btn);
      });
    });

    [nameEl, phoneEl, locEl, dislikesEl, notesEl].forEach(el => {
      if (el) el.addEventListener('input', updateBrief);
    });

    function buildSummaryText() {
      const lines = [];
      lines.push('CLIENT DESIGN TASTE BRIEF — SIDDHIVINAYAK DESIGNERS');
      lines.push('----------------------------------------');
      if (nameEl.value.trim()) lines.push('Client Name: ' + nameEl.value.trim());
      if (phoneEl.value.trim()) lines.push('Phone: +91 ' + phoneEl.value.trim());
      if (locEl.value.trim()) lines.push('Location/Society: ' + locEl.value.trim());
      if (state.propertyType.length) lines.push('Property Type: ' + state.propertyType.join(', '));
      if (state.timeline.length) lines.push('Timeline: ' + state.timeline.join(', '));
      lines.push('');

      if (state.homeStyle.length) lines.push('Overall Home Vibe: ' + state.homeStyle.join(' | '));
      if (state.ceilingStyle.length) lines.push('False Ceiling: ' + state.ceilingStyle.join(' | '));
      if (state.lightTone.length) lines.push('Lighting Tone: ' + state.lightTone.join(', '));
      if (state.lightExtras.length) lines.push('Lighting Extras: ' + state.lightExtras.join(', '));

      if (state.wardrobeStyle.length) lines.push('Wardrobe Style: ' + state.wardrobeStyle.join(' | '));
      if (state.wardrobeFinish.length) lines.push('Wardrobe Finish: ' + state.wardrobeFinish.join(', '));
      if (state.loftPref.length) lines.push('Loft Design: ' + state.loftPref.join(', '));
      if (state.wardrobeExtras.length) lines.push('Wardrobe Accessories: ' + state.wardrobeExtras.join(', '));

      if (state.kitchenStyle.length) lines.push('Modular Kitchen Style: ' + state.kitchenStyle.join(' | '));
      if (state.kitchenLayout.length) lines.push('Kitchen Layout: ' + state.kitchenLayout.join(', '));
      if (state.countertop.length) lines.push('Countertop: ' + state.countertop.join(', '));
      if (state.kitchenExtras.length) lines.push('Kitchen Appliances & Units: ' + state.kitchenExtras.join(', '));

      if (state.livingElements.length) lines.push('Living & Pooja: ' + state.livingElements.join(' | '));
      if (state.wallDecor.length) lines.push('Wall Decor: ' + state.wallDecor.join(', '));

      if (state.colorPalette.length) lines.push('Color Palettes: ' + state.colorPalette.join(' | '));
      if (state.lifestyle.length) lines.push('Family Needs: ' + state.lifestyle.join(', '));
      if (state.vastu.length) lines.push('Vastu: ' + state.vastu.join(', '));
      if (state.storageStyle.length) lines.push('Storage Approach: ' + state.storageStyle.join(', '));
      if (state.budget.length) lines.push('Budget Range: ' + state.budget.join(', '));

      if (dislikesEl.value.trim()) lines.push('Strict Dislikes: ' + dislikesEl.value.trim());
      if (notesEl.value.trim()) lines.push('Notes / Links: ' + notesEl.value.trim());

      return lines.join('\n');
    }

    function updateBrief() {
      const sec1 = Boolean(nameEl.value.trim() || phoneEl.value.trim() || state.propertyType.length || state.timeline.length);
      const sec2 = state.homeStyle.length > 0;
      const sec3 = (state.ceilingStyle.length + state.lightTone.length + state.lightExtras.length) > 0;
      const sec4 = (state.wardrobeStyle.length + state.wardrobeFinish.length + state.loftPref.length + state.wardrobeExtras.length) > 0;
      const sec5 = (state.kitchenStyle.length + state.countertop.length + state.kitchenLayout.length + state.kitchenExtras.length) > 0;
      const sec6 = (state.livingElements.length + state.wallDecor.length) > 0;
      const sec7 = (state.colorPalette.length + state.lifestyle.length + state.vastu.length + state.storageStyle.length + state.budget.length) > 0 || Boolean(dislikesEl.value.trim() || notesEl.value.trim());

      const completed = [sec1, sec2, sec3, sec4, sec5, sec6, sec7].filter(Boolean).length;
      const pct = Math.round((completed / 7) * 100);

      progressTextEl.textContent = `${completed} of 7 Sections Filled`;
      progressPctEl.textContent = `${pct}%`;
      progressFillEl.style.width = `${pct}%`;

      const summary = buildSummaryText();
      previewEl.textContent = completed === 0 ? 'Select your preferences above to build your live design brief...' : summary;
    }

    // Submit -> WhatsApp
    document.getElementById('designBriefForm').addEventListener('submit', function(e) {
      e.preventDefault();
      feedbackEl.classList.add('d-none');

      const clientName = nameEl.value.trim();
      const clientPhone = phoneEl.value.replace(/\D/g, '').slice(-10);

      if (!clientName) {
        showFeedback('Please enter your Name in Section 1 before sending.', 'error');
        nameEl.focus();
        return;
      }
      if (!clientPhone || clientPhone.length < 10) {
        showFeedback('Please enter a valid 10-digit Mobile Number in Section 1.', 'error');
        phoneEl.focus();
        return;
      }

      const fullBrief = buildSummaryText();
      const waUrl = `https://wa.me/918369297174?text=${encodeURIComponent(fullBrief)}`;
      window.open(waUrl, '_blank');
      showFeedback('Opening WhatsApp with your Design Brief ready to send!', 'success');
    });

    function showFeedback(msg, type) {
      feedbackEl.textContent = msg;
      feedbackEl.className = 'brief-feedback ' + type;
    }

    // Copy summary button
    document.getElementById('copyBriefBtn').addEventListener('click', function() {
      const btn = this;
      const text = buildSummaryText();
      navigator.clipboard.writeText(text).then(() => {
        const orig = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-check me-1"></i> Copied!';
        setTimeout(() => btn.innerHTML = orig, 2200);
      });
    });

    // Share Form Link button
    document.getElementById('copyPageLinkBtn').addEventListener('click', function() {
      const btn = this;
      const url = window.location.href;
      navigator.clipboard.writeText(url).then(() => {
        const orig = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-check me-1"></i> Link Copied! Send to Partner';
        setTimeout(() => btn.innerHTML = orig, 2500);
      });
    });

    // Print / PDF
    document.getElementById('printBriefBtn').addEventListener('click', () => window.print());

    // Zoom modal logic
    const zoomModal = document.getElementById('briefZoomModal');
    const zoomImg = document.getElementById('briefZoomImg');
    const zoomCap = document.getElementById('briefZoomCaption');
    const zoomClose = document.getElementById('briefZoomClose');

    document.querySelectorAll('.brief-zoom-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        zoomImg.src = btn.getAttribute('data-zoom');
        zoomCap.textContent = btn.getAttribute('data-caption') || '';
        zoomModal.classList.remove('d-none');
        zoomModal.setAttribute('aria-hidden', 'false');
      });
    });

    const closeZoom = () => {
      zoomModal.classList.add('d-none');
      zoomModal.setAttribute('aria-hidden', 'true');
      zoomImg.src = '';
    };
    zoomClose.addEventListener('click', closeZoom);
    zoomModal.addEventListener('click', (e) => {
      if (e.target === zoomModal) closeZoom();
    });
  })();
</script>
