    z-index: 2147482000;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  #studioAppShell .moodboard-drawer-sheet {
    background: #ffffff;
    width: 100%;
    max-width: 640px;
    max-height: 75vh;
    border-radius: 20px 20px 0 0;
    padding: 0.75rem 1.15rem 1.5rem 1.15rem;
    overflow-y: auto;
    animation: studioDrawerUp 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes studioDrawerUp {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }
  #studioAppShell .drawer-handle {
    width: 40px;
