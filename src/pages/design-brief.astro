---
import Layout from '../layouts/Layout.astro';

const title = "Client Design Taste & Style Brief | Siddhivinayak Designers";
const description = "Discover your home interior taste in 90 seconds—tap your favorite false ceilings, wardrobes, modular kitchens, lighting tones, and color palettes with Siddhivinayak Designers.";
const canonical = "https://siddhivinayakdesigners.in/design-brief/";
const HINGED_WARDROBES = [
  { img: "/assets/images/design-brief/wardrobe-hinged-01.webp", cat: "classic", title: "6-Door Geometric Contemporary", desc: "Six crisp matte shutters with sleek geometric pattern lines.", val: "6-Door Geometric Swing Wardrobe", toast: "✨ 6-Door Geometric Swing added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-02.webp", cat: "classic", title: "4-Door Matte Membrane", desc: "Clean bevelled membrane shutters with matching overhead lofts.", val: "4-Door Matte Membrane Swing", toast: "✨ 4-Door Matte Membrane added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-03.webp", cat: "glass", title: "Gold Topographical Line Mural", desc: "Statement sculptural gold line art across hinged shutters.", val: "Gold Line Pattern Mural Swing", toast: "✨ Gold Line Mural Swing added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-04.webp", cat: "vanity", title: "4-Door + Backlit Vanity Counter", desc: "Attached illuminated dresser counter & backlit vanity mirror.", val: "4-Door + Backlit Vanity Swing", toast: "🪞 4-Door + Backlit Vanity added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-05.webp", cat: "classic", title: "Matte Irish Cream Setup", desc: "Soft pastel cream hinged doors with flush vertical handles.", val: "Matte Irish Cream Swing Wardrobe", toast: "🤍 Irish Cream Swing added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-06.webp", cat: "color", title: "5-Door Mint Green Vertical", desc: "Fresh sage-mint finish paired with tall slim side storage.", val: "5-Door Mint Green Swing", toast: "🌿 5-Door Mint Green added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-07.webp", cat: "glass", title: "6-Door L-Shape + Glass Shutters", desc: "Corner L-shaped wardrobe combining opaque & illuminated glass doors.", val: "6-Door L-Shape Glass Swing", toast: "💎 6-Door L-Shape Glass added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-08.webp", cat: "vanity", title: "Integrated TV Unit Wardrobe", desc: "Seamless TV bay framed inside a full-wall hinged closet.", val: "Integrated TV Unit Wardrobe", toast: "📺 Integrated TV Wardrobe added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-09.webp", cat: "color", title: "Plum & Marble Panel Wardrobe", desc: "Deep plum hinged doors accented by open marble-back shelving.", val: "Plum & Marble Panel Swing", toast: "🟣 Plum & Marble Swing added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-10.webp", cat: "vanity", title: "Terracotta Swing + Study Corner", desc: "Warm earthy terracotta shutters paired with compact study nook.", val: "Terracotta Swing + Study Corner", toast: "💻 Terracotta + Study added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-11.webp", cat: "vanity", title: "Violet Swing + Integrated Study", desc: "Muted violet laminated shutters leading into a work desk.", val: "Violet Swing + Study Desk", toast: "💻 Violet + Study Desk added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-12.webp", cat: "vanity", title: "Color-Blocked Swing + Study", desc: "Two-tone hinged storage smoothly extended into a wall desk.", val: "Color-Blocked Swing + Study", toast: "💻 Color-Blocked Study added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-13.webp", cat: "color", title: "Olive Green Full-Height", desc: "Ceiling-touch olive green shutters with attached dresser bay.", val: "Green Full-Height Swing Wardrobe", toast: "🌿 Green Full-Height added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-14.webp", cat: "vanity", title: "Green Swing + Arched Mirror Dresser", desc: "Boutique dressing alcove with arch mirror carved into greenery.", val: "Green Swing + Arched Dresser", toast: "🪞 Green + Arched Mirror added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-15.webp", cat: "vanity", title: "Grey Swing + Oval Mirror Niche", desc: "Matte grey doors wrapping around a cozy oval mirror dresser.", val: "Grey Swing + Oval Mirror Niche", toast: "🪞 Grey + Oval Mirror added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-16.webp", cat: "glass", title: "Cajun Brown + Cane Infill", desc: "Open wood shelving paired with trendy woven rattan cane shutters.", val: "Cajun Swing + Cane Infill", toast: "🪵 Cane Infill Swing added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-17.webp", cat: "vanity", title: "Tan & Acacia + TV Console", desc: "Warm woodgrain shutters wrapping a bedroom media unit.", val: "Tan & Acacia + TV Console", toast: "📺 Tan & Acacia TV Unit added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-18.webp", cat: "glass", title: "Mustard Yellow & Grey Fluted", desc: "Playful ribbed fluted panels balanced by soft grey doors.", val: "Yellow & Grey Fluted Swing", toast: "💛 Yellow & Grey Fluted added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-19.webp", cat: "vanity", title: "Powder Blue + Vanity Mirror", desc: "Pastel blue hinged wardrobe paired with illuminated dressing corner.", val: "Powder Blue + Vanity Swing", toast: "🪞 Powder Blue + Vanity added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-20.webp", cat: "color", title: "Sage Green Recessed Panel", desc: "Neo-classical shaker recessed panels in calming muted green.", val: "Green Recessed Panel Swing", toast: "🏛️ Sage Shaker Swing added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-21.webp", cat: "color", title: "Cobalt Blue & Oak High-Gloss", desc: "Two-tone glossy ocean blue & natural oak finish combination.", val: "Blue & Oak High-Gloss Swing", toast: "🌊 Blue & Oak Gloss added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-22.webp", cat: "glass", title: "Ceramic Red + Glass LED Display", desc: "Bold red shutters contrasted by sunlit glass accessory cabinet.", val: "Ceramic Red + Glass LED Swing", toast: "💎 Ceramic Red + Glass added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-23.webp", cat: "glass", title: "Forest Green & Walnut + Cane", desc: "Organic dark walnut paired with woven cane framed doors.", val: "Green & Walnut + Cane Swing", toast: "🌿 Walnut + Cane Swing added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-24.webp", cat: "classic", title: "Cream 4-Door Patterned Panels", desc: "Warm off-white four-door closet with subtle tonal grooves.", val: "Cream 4-Door Patterned Swing", toast: "🤍 Cream 4-Door Swing added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-25.webp", cat: "glass", title: "Blue & Taupe + Illuminated Shelves", desc: "Muted blue shutters paired with backlit corner display niches.", val: "Blue & Taupe + LED Shelves", toast: "💡 Illuminated Shelves Swing added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-26.webp", cat: "glass", title: "Red & Cane 4-Door + Tower", desc: "Rattan cane texture blended with rich terracotta-red shutters.", val: "Red & Cane 4-Door + Tower", toast: "🪵 Red & Cane Tower added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-27.webp", cat: "color", title: "Red & Oak 4-Door + Bookcase", desc: "Side open bookcase built neatly alongside crimson-oak doors.", val: "Red & Oak + Bookcase Swing", toast: "📚 Oak + Bookcase Swing added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-28.webp", cat: "color", title: "Yellow & Grey 3-Door + Lofts", desc: "Bright cheerful accent door framed with overhead ceiling storage.", val: "Yellow & Grey 3-Door + Lofts", toast: "💛 Yellow & Grey 3-Door added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-29.webp", cat: "glass", title: "Blue & White 3-Door Fluted", desc: "Vertical textured fluted stripes across soft blue-white doors.", val: "Blue & White 3-Door Fluted", toast: "🏛️ Blue & White Fluted added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-30.webp", cat: "glass", title: "Fluted Glass + Warm LED Lighting", desc: "Boutique aluminum fluted glass doors glowing with interior strips.", val: "Fluted Glass + LED Swing Wardrobe", toast: "✨ Fluted Glass LED added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-31.webp", cat: "glass", title: "Off-White Arched Fluted Paneling", desc: "Sculpted soft-arch grooving in creamy ivory matte finish.", val: "Off-White Arched Fluted Swing", toast: "🏛️ Arched Fluted Swing added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-32.webp", cat: "classic", title: "Frosty White + Black Handles", desc: "Clean crisp white shutters contrasted by tall matte black pulls.", val: "Frosty White + Black Handles", toast: "🤍 White + Black Pulls added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-33.webp", cat: "classic", title: "Warm Beige + Top Lofts", desc: "Zero-clutter beige hinged storage with black bar handles & lofts.", val: "Beige Swing + Top Lofts", toast: "🤎 Warm Beige + Lofts added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-34.webp", cat: "vanity", title: "White & Lavender + Study Table", desc: "Airy white & soft lilac bedroom unit with matching desk.", val: "White & Lavender + Study", toast: "💻 Lavender + Study added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-35.webp", cat: "vanity", title: "White Swing + Mirror & Drawers", desc: "Built-in mirror niche above compact dresser drawers in pure white.", val: "White Swing + Mirror Niche", toast: "🪞 White Mirror Niche added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-36.webp", cat: "vanity", title: "Irish Cream + Vanity & Window Seat", desc: "Dream bay-window bench linked seamlessly to a 4-door closet.", val: "Irish Cream + Window Seating", toast: "🛋️ Vanity & Window Seat added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-37.webp", cat: "vanity", title: "2-Door Gloss + Compact Study", desc: "High-sheen two-door hinged wardrobe ideal for guest & kid rooms.", val: "2-Door High-Gloss + Study", toast: "✨ 2-Door Gloss + Study added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-38.webp", cat: "glass", title: "5-Door Matte Grey + Glass", desc: "Spacious dark-grey matte unit with lit glass corner display.", val: "5-Door Matte Grey + Glass", toast: "💎 5-Door Grey + Glass added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-39.webp", cat: "classic", title: "White 4-Door + Brass Handles", desc: "Timeless pure white hinged shutters finished in brushed gold brass.", val: "White 4-Door + Brass Handles", toast: "✨ White + Brass Pulls added" },
  { img: "/assets/images/design-brief/wardrobe-hinged-40.webp", cat: "vanity", title: "Minimal Study Desk & Overheads", desc: "Seamless light-neutral wardrobe wrapped over a study workstation.", val: "Minimal Desk & Lofts Swing", toast: "💻 Minimal Study & Lofts added" }
];

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://siddhivinayakdesigners.in/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Client Design Brief",
          "item": "https://siddhivinayakdesigners.in/design-brief/"
        }
      ]
    },
    {
      "@type": "WebPage",
      "@id": "https://siddhivinayakdesigners.in/design-brief/#webpage",
      "name": "Interactive Home Interior Taste Quiz & Design Brief",
      "url": "https://siddhivinayakdesigners.in/design-brief/",
      "description": "Mobile-first visual interior design taste configurator for Navi Mumbai homeowners."
    }
  ]
});
---

<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <div class="studio-app-shell" id="studioAppShell">
    <!-- Top App Progress & Live Moodboard Header -->
    <div class="studio-topbar" id="studioTopbar">
      <div class="container studio-topbar-inner">
        <div class="studio-step-meta">
          <div class="studio-step-pills" id="studioStepDots">
            <button type="button" class="step-dot active" data-goto="0" aria-label="Step 1"></button>
            <button type="button" class="step-dot" data-goto="1" aria-label="Step 2"></button>
            <button type="button" class="step-dot" data-goto="2" aria-label="Step 3"></button>
            <button type="button" class="step-dot" data-goto="3" aria-label="Step 4"></button>
            <button type="button" class="step-dot" data-goto="4" aria-label="Step 5"></button>
            <button type="button" class="step-dot" data-goto="5" aria-label="Step 6"></button>
            <button type="button" class="step-dot" data-goto="6" aria-label="Step 7"></button>
            <button type="button" class="step-dot" data-goto="7" aria-label="Your Design DNA"></button>
          </div>
          <span class="studio-step-counter" id="studioStepCounter">Step 1 of 7</span>
        </div>

        <div class="studio-topbar-actions">
          <button type="button" class="moodboard-pill-btn" id="openMoodboardBtn" title="View your live moodboard picks">
            <span class="moodboard-thumb-stack" id="moodboardThumbStack">
              <span class="stack-empty-dot"></span>
            </span>
            <span class="moodboard-pill-text">Picks <strong id="moodboardCount">0</strong></span>
          </button>
          <button type="button" class="view-mode-btn d-none d-sm-inline-flex" id="toggleViewModeBtn" title="Switch between Guided Step Mode and Full List">
            <i class="fas fa-layer-group me-1"></i> <span>All Steps</span>
          </button>
        </div>
      </div>
      <div class="studio-progress-line">
        <div class="studio-progress-fill" id="studioProgressFill" style="width: 12.5%;"></div>
      </div>
    </div>

    <!-- Live Selection Feedback Toast -->
    <div class="studio-toast" id="studioToast" aria-live="polite"></div>

    <!-- Interactive Wizard Container -->
    <div class="studio-stage">
      <div class="container studio-stage-container">
        <form id="designBriefForm" novalidate>

          <!-- STEP 0: HOME BASICS & WELCOME HOOK -->
          <section class="studio-step active" data-step="0" id="step-0">
            <div class="step-header-block">
              <span class="step-eyebrow"><i class="fas fa-wand-magic-sparkles me-1"></i> 90-Second Interior Taste Studio</span>
              <h1 class="step-headline">Discover Your Dream Home DNA</h1>
              <p class="step-subtext">Tap the spaces, ceilings, wardrobes &amp; colors you love. Zero design jargon—we turn your picks into bespoke 3D concepts.</p>
            </div>

            <div class="studio-panel-card">
              <div>
                <label class="studio-label">1. Tap Your Home Type</label>
                <div class="studio-tile-grid cols-3" data-group="propertyType" data-mode="single">
                  <button type="button" class="studio-tile" data-value="1 BHK">
                    <i class="fas fa-home tile-ico"></i>
                    <span>1 BHK</span>
                  </button>
                  <button type="button" class="studio-tile" data-value="2 BHK">
                    <i class="fas fa-building tile-ico"></i>
                    <span>2 BHK</span>
                  </button>
                  <button type="button" class="studio-tile" data-value="3 BHK">
                    <i class="fas fa-city tile-ico"></i>
                    <span>3 BHK</span>
                  </button>
                  <button type="button" class="studio-tile" data-value="4+ BHK / Duplex">
                    <i class="fas fa-crown tile-ico"></i>
                    <span>4+ BHK</span>
                  </button>
                  <button type="button" class="studio-tile" data-value="Villa / Bungalow">
                    <i class="fas fa-archway tile-ico"></i>
                    <span>Villa</span>
                  </button>
                  <button type="button" class="studio-tile" data-value="Office / Studio">
                    <i class="fas fa-briefcase tile-ico"></i>
                    <span>Office</span>
                  </button>
                </div>
              </div>

              <div class="mt-4">
                <label class="studio-label">2. Location in Navi Mumbai</label>
                <div class="studio-pill-wrap" data-group="propertyNode" data-mode="single">
                  <button type="button" class="studio-pill" data-value="Kharghar">Kharghar</button>
                  <button type="button" class="studio-pill" data-value="Seawoods">Seawoods</button>
                  <button type="button" class="studio-pill" data-value="Vashi">Vashi</button>
                  <button type="button" class="studio-pill" data-value="Nerul">Nerul</button>
                  <button type="button" class="studio-pill" data-value="Kopar Khairane">Kopar Khairane</button>
                  <button type="button" class="studio-pill" data-value="Ghansoli">Ghansoli</button>
                  <button type="button" class="studio-pill" data-value="Belapur">Belapur</button>
                  <button type="button" class="studio-pill" data-value="Panvel">Panvel</button>
                  <button type="button" class="studio-pill" data-value="Ulwe">Ulwe</button>
                  <button type="button" class="studio-pill" data-value="Other Area">Other</button>
                </div>
              </div>

              <div class="mt-4">
                <label class="studio-label">3. Handover Timeline</label>
                <div class="studio-pill-wrap" data-group="timeline" data-mode="single">
                  <button type="button" class="studio-pill" data-value="Urgent (45-60 Days)">⚡ 45–60 Days</button>
                  <button type="button" class="studio-pill" data-value="2-4 Months">📅 2–4 Months</button>
                  <button type="button" class="studio-pill" data-value="4-6 Months">🏗️ 4–6 Months</button>
                  <button type="button" class="studio-pill" data-value="Just Exploring">💭 Exploring</button>
                </div>
              </div>

              <div class="row g-3 mt-2 pt-3 border-top">
                <div class="col-md-4">
                  <label for="clientName" class="studio-label">Your Name</label>
                  <input type="text" id="clientName" class="form-control studio-input" placeholder="e.g., Rahul &amp; Priya" />
                </div>
                <div class="col-md-4">
                  <label for="clientPhone" class="studio-label">WhatsApp Number</label>
                  <div class="input-group">
                    <span class="input-group-text studio-addon">+91</span>
                    <input type="tel" id="clientPhone" class="form-control studio-input" placeholder="10-digit number" pattern="[6-9][0-9]{9}" />
                  </div>
                </div>
                <div class="col-md-4">
                  <label for="clientLocation" class="studio-label">Society / Tower (Optional)</label>
                  <input type="text" id="clientLocation" class="form-control studio-input" placeholder="e.g., Sai World Empire" />
                </div>
              </div>
            </div>
          </section>

          <!-- STEP 1: HOME VIBE VISUAL SWIPE CARDS -->
          <section class="studio-step" data-step="1" id="step-1">
            <div class="step-header-block">
              <span class="step-eyebrow">Step 2 of 7 • Aesthetic DNA</span>
              <h2 class="step-headline">Which Room Vibe Feels Most Like "Home"?</h2>
              <p class="step-subtext">Tap 1 or 2 photos you love. Tap <i class="fas fa-expand-alt"></i> to inspect full-screen.</p>
            </div>

            <div class="visual-choice-grid" data-group="homeStyle" data-mode="multi">
              <div class="v-card" data-value="Bright & Minimalist" data-img="/assets/images/design-brief/vibe-bright-minimalist.webp" data-toast="✨ Bright & Minimalist added to Picks">
                <div class="v-img-wrap">
                  <img src="/assets/images/design-brief/vibe-bright-minimalist.webp" alt="Bright and Minimalist living room" loading="eager" decoding="async" />
                  <span class="v-badge"><i class="fas fa-heart"></i></span>
                  <button type="button" class="v-zoom" data-zoom="/assets/images/design-brief/vibe-bright-minimalist.webp" data-caption="Bright & Minimalist — Clean surfaces, airy light tones & clutter-free calm" aria-label="Zoom"><i class="fas fa-expand-alt"></i></button>
                </div>
                <div class="v-body">
                  <h3>Bright &amp; Minimalist</h3>
                  <p>Airy whites, sleek lines, calm &amp; clutter-free.</p>
                </div>
              </div>

              <div class="v-card" data-value="Luxury Neo-Classical" data-img="/assets/images/design-brief/vibe-neo-classical.webp" data-toast="🏛️ Neo-Classical Luxury added">
                <div class="v-img-wrap">
                  <img src="/assets/images/design-brief/vibe-neo-classical.webp" alt="Luxury Neo-Classical wall mouldings" loading="eager" decoding="async" />
                  <span class="v-badge"><i class="fas fa-heart"></i></span>
                  <button type="button" class="v-zoom" data-zoom="/assets/images/design-brief/vibe-neo-classical.webp" data-caption="Luxury Neo-Classical — Wall mouldings, soft creams & chandelier elegance" aria-label="Zoom"><i class="fas fa-expand-alt"></i></button>
                </div>
                <div class="v-body">
                  <h3>Luxury Neo-Classical</h3>
                  <p>Wall mouldings, chandeliers &amp; understated luxury.</p>
                </div>
              </div>

              <div class="v-card" data-value="Warm Contemporary Minimal" data-img="/assets/images/design-brief/vibe-warm-contemporary.webp" data-toast="🌿 Warm Contemporary Minimal added">
                <div class="v-img-wrap">
                  <img src="/assets/images/design-brief/vibe-warm-contemporary.webp" alt="Warm Contemporary Minimal interior" loading="eager" decoding="async" />
                  <span class="v-badge"><i class="fas fa-heart"></i></span>
                  <button type="button" class="v-zoom" data-zoom="/assets/images/design-brief/vibe-warm-contemporary.webp" data-caption="Warm Contemporary Minimal — Soft ivory, teak wood pillar & brass pendant charm" aria-label="Zoom"><i class="fas fa-expand-alt"></i></button>
                </div>
                <div class="v-body">
                  <h3>Warm Contemporary Minimal</h3>
                  <p>Soft neutrals, Indian wood warmth &amp; clean comfort.</p>
                </div>
              </div>

              <div class="v-card" data-value="Warm Wooden & Cozy" data-img="/assets/images/design-brief/vibe-warm-wooden.webp" data-toast="🪵 Warm Wooden Sanctuary added">
                <div class="v-img-wrap">
                  <img src="/assets/images/design-brief/vibe-warm-wooden.webp" alt="Warm wooden and earthy cozy interior" loading="eager" decoding="async" />
                  <span class="v-badge"><i class="fas fa-heart"></i></span>
                  <button type="button" class="v-zoom" data-zoom="/assets/images/design-brief/vibe-warm-wooden.webp" data-caption="Warm Wooden & Cozy — Rich natural wood panelling & warm ambient lights" aria-label="Zoom"><i class="fas fa-expand-alt"></i></button>
                </div>
                <div class="v-body">
                  <h3>Warm Wooden &amp; Cozy</h3>
                  <p>Rich timber wall panels, greenery &amp; cozy warmth.</p>
                </div>
              </div>

              <div class="v-card v-card-wide" data-value="Opulent Modern & Marble" data-img="/assets/images/design-brief/vibe-opulent-marble.webp" data-toast="💎 Opulent Marble & Gold added">
                <div class="v-img-wrap">
                  <img src="/assets/images/design-brief/vibe-opulent-marble.webp" alt="Opulent Modern Marble and Gold interior" loading="eager" decoding="async" />
                  <span class="v-badge"><i class="fas fa-heart"></i></span>
                  <button type="button" class="v-zoom" data-zoom="/assets/images/design-brief/vibe-opulent-marble.webp" data-caption="Opulent Modern & Marble — Bookmatched marble, gold trims & statement luxury" aria-label="Zoom"><i class="fas fa-expand-alt"></i></button>
                </div>
                <div class="v-body">
                  <h3>Opulent Modern &amp; Marble</h3>
                  <p>Italian marble walls, brushed gold trims &amp; grand statement lighting.</p>
                </div>
              </div>
            </div>
          </section>

          <!-- STEP 2: FALSE CEILING & LIVE LIGHTING SIMULATOR -->
          <section class="studio-step" data-step="2" id="step-2">
            <div class="step-header-block">
              <span class="step-eyebrow">Step 3 of 7 • Ceiling &amp; Lighting</span>
              <h2 class="step-headline">Pick False Ceiling &amp; Test Light Glow</h2>
              <p class="step-subtext">Tap lighting tones below to see the room glow shift live.</p>
            </div>

            <!-- Interactive Live Lighting Simulator -->
            <div class="light-sim-card mb-3">
