---
import Layout from '../layouts/Layout.astro';

const title = "Contact Us | Siddhivinayak Designers";
const description = "Get in touch with Siddhivinayak Designers. Book a free design consultation, visit our Ghansoli Experience Centre or Koparkhairane design studio, or request a quote online.";
const canonical = "https://siddhivinayakdesigners.in/contact/";
const schema = `{
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [{
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://siddhivinayakdesigners.in/"
      },{
        "@type": "ListItem",
        "position": 2,
        "name": "Contact Us",
        "item": "https://siddhivinayakdesigners.in/contact/"
      }]
    }`;
const bodyContent = `<!-- Header Banner -->
<section class="py-5 bg-dark" style="margin-top: 70px;">
<div class="container py-4 text-center">
<h1 class="font-luxury text-white mb-2" data-aos="fade-down">Connect With Us</h1>
<div class="custom-breadcrumb text-center justify-content-center d-flex gap-2">
<a href="/">Home</a>
<span class="text-muted">/</span>
<span>Contact Us</span>
</div>
</div>
</section>
<!-- Contact & Map -->
<section class="py-5 bg-dark text-white">
<div class="container py-5">
<div class="row g-5">
<!-- Contact Info -->
<div class="col-lg-5" data-aos="fade-right">
