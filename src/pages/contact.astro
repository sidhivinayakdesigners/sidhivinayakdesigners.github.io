</div>
<div class="row">
<div class="col-md-6 mb-3">
<label for="contactProperty">Property Type</label>
<select class="form-select" id="contactProperty" name="property" required="">
<option value="1bhk">1 BHK Flat</option>
<option selected="" value="2bhk">2 BHK Flat</option>
<option value="3bhk">3 BHK Flat</option>
<option value="villa">Bungalow / Villa</option>
<option value="commercial">Office / Showroom</option>
</select>
</div>
<div class="col-md-6 mb-3">
<label for="contactBudget">Estimated Budget</label>
<select class="form-select" id="contactBudget" name="budget" required="">
<option value="Under 3L">Under ₹3 Lakhs</option>
<option value="3L-5L">₹3 Lakhs - ₹5 Lakhs</option>
<option selected="" value="5L-10L">₹5 Lakhs - ₹10 Lakhs</option>
<option value="10L+">₹10 Lakhs - ₹20 Lakhs</option>
<option value="20L+">₹20 Lakhs +</option>
</select>
</div>
</div>
<div class="mb-4">
<label for="contactMessage">Describe Your Requirements</label>
<textarea class="form-control" id="contactMessage" name="message" placeholder="Detail any structural alterations, false ceiling plans, modular kitchen layouts..." required="" rows="4"></textarea>
</div>
<div class="d-grid gap-2">
<button class="btn btn-gold py-3" type="submit">Book Site Visit</button>
</div>
</form>
</div>
</div>
</div>
<!-- Map Section (Dual Verified Locations) -->
<div class="row mt-5" data-aos="fade-up">
<div class="col-12 text-center mb-4">
  <span class="section-subtitle">Dual Physical Presence</span>
  <h3 class="text-white h4 font-luxury mb-2">Visit Our Navi Mumbai Locations</h3>
