---
import Layout from '../layouts/Layout.astro';

const title = "Terms & Conditions | Siddhivinayak Designers - Navi Mumbai";
const description = "Review the terms and conditions for interior contracting, custom woodwork manufacturing, and project execution at Siddhivinayak Designers.";
const canonical = "https://siddhivinayakdesigners.in/terms-conditions";
const schema = ``;
const bodyContent = `<!-- Content -->
    <section class="py-5 bg-dark text-white" style="margin-top: 70px;">
        <div class="container py-5">
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <h1 class="font-luxury text-white mb-4">Terms & Conditions</h1>
                    <p class="text-muted small">Last updated: July 2026</p>
                    


                    <h3 class="font-luxury text-gold h5 mt-4">1. Scope of Work</h3>
                    <p class="text-muted small">All design layouts, civil modifications, false ceilings, electrical work, and modular cabinet fabrications shall be completed strictly as outlined in the signed Bill of Quantities (BOQ). Any alterations during execution will carry separate charges.</p>

                    <h3 class="font-luxury text-gold h5 mt-4">2. Payment Schedule</h3>
                    <p class="text-muted small">Clients must clear payment stages (10% booking, 40% dispatch, 40% site installation, 10% handover) on schedule. Delays in payments may result in suspension of carpentry and site execution works.</p>

                    <h3 class="font-luxury text-gold h5 mt-4">3. Execution Timelines</h3>
                    <p class="text-muted small">We commit to a 45-day execution window from the final approval of designs and receipt of the booking payment stage. Delays resulting from building association permission holds or weather restrictions are excluded.</p>

                    <h3 class="font-luxury text-gold h5 mt-4">4. Material Warranty</h3>
                    <p class="text-muted small">Plywood structural units carry warranties up to 10 years against manufacturing defects. Hardware accessories (drawer runner slides, cabinet hinges) carry direct warranties provided by manufacturers like Blum, Hettich, and Ebco.</p>

                    <h3 class="font-luxury text-gold h5 mt-4">5. Dispute Resolution</h3>
                    <p class="text-muted small">Any disputes, claims, or queries arising out of our interior contracting terms are subject to the exclusive jurisdiction of the courts in Thane/Navi Mumbai, Maharashtra.</p>
                </div>
            </div>
        </div>
    </section>`;
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <Fragment set:html={bodyContent} />
</Layout>

<style is:global>
html, body {
      background-color: #ffffff !important;
      color: #212529 !important;
      font-family: Arial, Helvetica, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    }
    .hero-section, .catalog-directory-hero, .dc-top-section-bg, header.bg-dark, .bg-dark, .bg-dark-card, .bg-dark-contrast {
      background-color: #f3f6f8 !important;
      color: #1a1a1a !important;
    }
    h1, h2, h3, h4, h5, h6, .section-title {
      color: #1a1a1a !important;
    }
    p, span, li, label, div {
      color: #444444 !important;
    }
    :not(footer) .text-white, body:not(footer) .text-white, a.text-white:not(footer a), .section-title.text-white {
      color: #1a1a1a !important;
    }
    .text-gold {
      color: #189ba6 !important;
    }
    .btn-gold, .btn-primary {
      background-color: #189ba6 !important;
      border-color: #189ba6 !important;
      color: #ffffff !important;
    }
    .btn-gold:hover, .btn-primary:hover {
      background-color: #127c85 !important;
      border-color: #127c85 !important;
    }
    footer, footer * {
      color: #ffffff !important;
    }
    footer p, footer span, footer li, footer div, footer small, footer .text-muted {
      color: #d1cfc9 !important;
    }
  
    /* Fix headings appearing white on light background inside bg-dark / bg-dark-card / bg-dark-contrast elements */
    .bg-dark h1, .bg-dark h2, .bg-dark h3, .bg-dark h4, .bg-dark h5, .bg-dark h6,
    .bg-dark-card h1, .bg-dark-card h2, .bg-dark-card h3, .bg-dark-card h4, .bg-dark-card h5, .bg-dark-card h6,
    .bg-dark-contrast h1, .bg-dark-contrast h2, .bg-dark-contrast h3, .bg-dark-contrast h4, .bg-dark-contrast h5, .bg-dark-contrast h6 {
      color: #1a1a1a !important;
    }
    /* Fix text elements appearing light grey/white on light background inside bg-dark / bg-dark-card / bg-dark-contrast elements */
    .bg-dark p, .bg-dark li, .bg-dark span:not(.text-gold):not(.text-teal), .bg-dark label, .bg-dark .text-muted,
    .bg-dark-card p, .bg-dark-card li, .bg-dark-card span:not(.text-gold):not(.text-teal), .bg-dark-card label, .bg-dark-card .text-muted,
    .bg-dark-contrast p, .bg-dark-contrast li, .bg-dark-contrast span:not(.text-gold):not(.text-teal), .bg-dark-contrast label, .bg-dark-contrast .text-muted {
      color: #444444 !important;
    }
    .bg-dark strong, .bg-dark-card strong, .bg-dark-contrast strong {
      color: #1a1a1a !important;
    }
</style>

<script is:inline></script>

<script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-PLACEHOLDER');
    </script>

