<style is:global>
/* DESIGN CAFE EXACT REPLICA COMPLETE ISOLATED STYLES */
    html, body {
      background-color: #ffffff !important;
      color: #000000 !important;
      font-family: Arial, Helvetica, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
      scroll-behavior: smooth;
    }
    p, span, li, label, div, small, strong, p *, li *, span *, label *, div *, small *, strong *, .text-muted, .text-white-50, .text-secondary, .text-muted * {
      color: #000000 !important;
    }
    :not(footer) .text-white, body:not(footer) .text-white, a.text-white:not(footer a), .section-title.text-white {
      color: #000000 !important;
    }

    .consultation-popup-overlay {
      display: none !important;
    }

    /* TOP CONTAINER (#f3f6f8) */
    .dc-top-section-bg {
      background-color: #f3f6f8 !important;
      padding-top: 95px;
      padding-bottom: 20px;
      border-bottom: 1px solid #e0e6ed;
    }

    .dc-page-main-title {
      font-size: 24px !important;
      font-weight: 700 !important;
      color: #000000 !important;
      margin-bottom: 8px !important;
      font-family: Arial, sans-serif !important;
    }

    .dc-page-main-desc {
      font-size: 14px !important;
      color: #000000 !important;
      line-height: 1.5 !important;
      margin-bottom: 4px !important;
      max-width: 950px;
      transition: max-height 0.3s ease, opacity 0.3s ease;
      overflow: hidden;
    }

    .dc-page-main-desc.collapsed {
      max-height: 22px;
      opacity: 0.7;
    }

    .dc-show-less-link {
      color: #189ba6 !important;
      font-size: 13px !important;
      font-weight: 600 !important;
      text-decoration: none !important;
      display: inline-block;
      margin-bottom: 16px !important;
      cursor: pointer;
    }

    .dc-show-less-link:hover {
      text-decoration: underline !important;
    }

    /* PILLS ROW */
    .dc-pills-container {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      white-space: nowrap;
      padding-bottom: 8px;
      margin-top: 6px;
      -webkit-overflow-scrolling: touch;
      border-bottom: none !important;
    }

    .dc-pills-container::-webkit-scrollbar {
      height: 4px;
    }

    .dc-pills-container::-webkit-scrollbar-thumb {
      background: #189ba6;
      border-radius: 4px;
    }

    .dc-pill-box {
      background-color: #ffffff !important;
      border: 1px solid #dcdcdc !important;
      border-radius: 4px !important;
      padding: 6px 18px !important;
      font-size: 13px !important;
      font-weight: 500 !important;
      color: #333333 !important;
      text-decoration: none !important;
      display: inline-block !important;
      white-space: nowrap !important;
      flex-shrink: 0 !important;
      transition: all 0.2s ease;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
      cursor: pointer;
    }

    .dc-pill-box:hover,
    .dc-pill-box.active {
      border-color: #189ba6 !important;
      color: #189ba6 !important;
      background-color: #ffffff !important;
      font-weight: 700 !important;
    }

    /* BREADCRUMB BAR */
    .dc-breadcrumb-wrapper {
      background-color: #ffffff;
      padding: 12px 0;
      border-bottom: 1px solid #e8e8e8;
      font-size: 13px;
      color: #666666;
    }

    .dc-breadcrumb-wrapper a {
      color: #189ba6;
      text-decoration: none;
      font-weight: 500;
    }

    /* TOP CATEGORIES COLLAGE GRID */
    .dc-section-head-title {
      font-size: 22px !important;
      font-weight: 700 !important;
      color: #1a1a1a !important;
      margin-top: 25px !important;
      margin-bottom: 16px !important;
      font-family: Arial, sans-serif !important;
    }

    .dc-top-collage-card {
      position: relative;
      border-radius: 4px;
      overflow: hidden;
      display: block;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      text-decoration: none;
      width: 100%;
    }

    .dc-top-collage-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }

    .dc-top-collage-card:hover img {
      transform: scale(1.05);
    }

    .dc-top-collage-gradient {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: linear-gradient(180deg, rgba(0, 0, 0, 0) 45%, rgba(0, 0, 0, 0.8) 100%);
    }

    .dc-top-collage-label,
    div.dc-top-collage-label,
    a.dc-top-collage-card div.dc-top-collage-label,
    .dc-top-collage-card .dc-top-collage-label {
      position: absolute;
      bottom: 12px;
      left: 14px;
      color: #ffffff !important;
      font-size: 15px !important;
      font-weight: 700 !important;
      margin: 0 !important;
    }

    /* CATEGORY BLOCK & CARDS */
    .dc-category-group {
      margin-top: 35px;
      margin-bottom: 25px;
      scroll-margin-top: 100px;
    }

    .dc-exact-card {
      background: #ffffff !important;
      border-radius: 4px !important;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08) !important;
      border: 1px solid #eaeaea !important;
      overflow: hidden !important;
      display: flex;
      flex-direction: column;
      height: 100%;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .dc-exact-card:hover {
      transform: translateY(-3px) !important;
      box-shadow: 0 6px 18px rgba(0, 0, 0, 0.12) !important;
    }

    .dc-exact-card-img {
      height: 220px;
      width: 100%;
      overflow: hidden;
      position: relative;
    }

    .dc-exact-card-img .carousel,
    .dc-exact-card-img .carousel-inner,
    .dc-exact-card-img .carousel-item {
      height: 100%;
    }

    .dc-exact-card-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.4s ease;
    }

    /* PERMANENTLY VISIBLE CAROUSEL ARROWS (< and >) */
    .dc-exact-card-img .carousel-control-prev,
    .dc-exact-card-img .carousel-control-next {
      width: 34px !important;
      height: 34px !important;
      background-color: #189ba6 !important;
      border-radius: 50% !important;
      top: 50% !important;
      transform: translateY(-50%) !important;
      opacity: 0.95 !important;
      z-index: 10 !important;
      border: 2px solid #ffffff !important;
      box-shadow: 0 2px 8px rgba(0,0,0,0.25) !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      margin: 0 !important;
      transition: all 0.2s ease !important;
    }

    .dc-exact-card-img .carousel-control-prev {
      left: 8px !important;
    }

    .dc-exact-card-img .carousel-control-next {
      right: 8px !important;
    }

    .dc-exact-card-img .carousel-control-prev:hover,
    .dc-exact-card-img .carousel-control-next:hover {
      opacity: 1 !important;
      background-color: #127c85 !important;
      transform: translateY(-50%) scale(1.1) !important;
    }

    .dc-exact-card-img .carousel-control-prev-icon,
    .dc-exact-card-img .carousel-control-next-icon {
      width: 14px !important;
      height: 14px !important;
      filter: brightness(0) invert(1) !important;
    }

    .dc-exact-card-img .carousel-indicators {
      margin-bottom: 6px;
    }

    .dc-exact-card-img .carousel-indicators [data-bs-target] {
      width: 6px;
      height: 6px;
