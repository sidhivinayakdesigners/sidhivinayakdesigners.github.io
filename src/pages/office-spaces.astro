<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <Fragment set:html={bodyContent} />
</Layout>

<style is:global>
/* DESIGN CAFE EXACT REPLICA COMPLETE ISOLATED STYLES */
    html, body {
      background-color: #ffffff !important;
      color: #000000 !important;
      font-family: Arial, Helvetica, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
      scroll-behavior: smooth;
    }
    p, span, li, label, div, small, strong, p *, li *, span *, label *, div *, small *, strong *, .text-muted, .text-white-50, .text-secondary, .text-muted * {
      color: #000000 !important;
    }
    :not(footer) .text-white, body:not(footer) .text-white, a.text-white:not(footer a), .section-title.text-white {
      color: #000000 !important;
    }

    .consultation-popup-overlay {
      display: none !important;
    }

    /* TOP CONTAINER (#f3f6f8) */
    .dc-top-section-bg {
      background-color: #f3f6f8 !important;
      padding-top: 95px;
      padding-bottom: 20px;
      border-bottom: 1px solid #e0e6ed;
    }

    .dc-page-main-title {
      font-size: 24px !important;
      font-weight: 700 !important;
      color: #000000 !important;
      margin-bottom: 8px !important;
      font-family: Arial, sans-serif !important;
    }

    .dc-page-main-desc {
      font-size: 14px !important;
      color: #000000 !important;
      line-height: 1.5 !important;
      margin-bottom: 4px !important;
      max-width: 950px;
      transition: max-height 0.3s ease, opacity 0.3s ease;
      overflow: hidden;
    }

    .dc-page-main-desc.collapsed {
      max-height: 22px;
      opacity: 0.7;
    }

    .dc-show-less-link {
      color: #189ba6 !important;
      font-size: 13px !important;
      font-weight: 600 !important;
      text-decoration: none !important;
      display: inline-block;
      margin-bottom: 16px !important;
      cursor: pointer;
    }

    .dc-show-less-link:hover {
      text-decoration: underline !important;
    }

    /* PILLS ROW */
    .dc-pills-container {
      display: flex;
      gap: 10px;
      overflow-x: auto;
      white-space: nowrap;
      padding-bottom: 8px;
      margin-top: 6px;
      -webkit-overflow-scrolling: touch;
      border-bottom: none !important;
    }

    .dc-pills-container::-webkit-scrollbar {
      height: 4px;
    }

    .dc-pills-container::-webkit-scrollbar-thumb {
      background: #189ba6;
      border-radius: 4px;
    }

    .dc-pill-box {
      background-color: #ffffff !important;
      border: 1px solid #dcdcdc !important;
      border-radius: 4px !important;
      padding: 6px 18px !important;
      font-size: 13px !important;
      font-weight: 500 !important;
      color: #333333 !important;
      text-decoration: none !important;
      display: inline-block !important;
      white-space: nowrap !important;
      flex-shrink: 0 !important;
      transition: all 0.2s ease;
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
      cursor: pointer;
    }

    .dc-pill-box:hover,
    .dc-pill-box.active {
      border-color: #189ba6 !important;
      color: #189ba6 !important;
      background-color: #ffffff !important;
      font-weight: 700 !important;
    }

    /* BREADCRUMB BAR */
    .dc-breadcrumb-wrapper {
      background-color: #ffffff;
      padding: 12px 0;
      border-bottom: 1px solid #e8e8e8;
      font-size: 13px;
      color: #666666;
    }

    .dc-breadcrumb-wrapper a {
      color: #189ba6;
      text-decoration: none;
      font-weight: 500;
    }

    /* TOP CATEGORIES COLLAGE GRID */
    .dc-section-head-title {
      font-size: 22px !important;
      font-weight: 700 !important;
      color: #1a1a1a !important;
      margin-top: 25px !important;
      margin-bottom: 16px !important;
      font-family: Arial, sans-serif !important;
    }

    .dc-top-collage-card {
      position: relative;
      border-radius: 4px;
