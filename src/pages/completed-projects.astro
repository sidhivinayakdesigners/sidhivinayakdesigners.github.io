---
import Layout from '../layouts/Layout.astro';

const title = "Completed Projects | Siddhivinayak Designers";
const description = "Explore our completed residential interior design projects across Navi Mumbai, including luxury penthouses and apartments in Kharghar, Seawoods, Nerul, and Vashi.";
const canonical = "https://siddhivinayakdesigners.in/completed-projects/";
const schema = `{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [{
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": "https://siddhivinayakdesigners.in/"
  },{
    "@type": "ListItem",
    "position": 2,
    "name": "Completed Projects",
    "item": "https://siddhivinayakdesigners.in/completed-projects/"
  }]
}`;

const bodyContent = `
  <!-- Header Banner -->
  <section class="py-4 bg-dark border-bottom border-secondary">
    <div class="container py-3 text-center">
      <h1 class="font-luxury text-white display-5 fw-bold mb-0" data-aos="fade-down" style="font-family: 'Playfair Display', Georgia, serif !important;">
        Completed Projects
      </h1>
    </div>
  </section>

  <!-- Projects Showcase Section -->
  <section class="py-5 bg-dark-card" id="completedProjectsListing">
    <div class="container py-4">
      <div class="row g-5 justify-content-center">

        <!-- Project 1: Modern 4 BHK at Kharghar -->
        <div class="col-12" data-aos="fade-up">
          <div class="completed-project-card bg-white rounded-4 overflow-hidden shadow-sm mx-auto" style="max-width: 960px; border: 1px solid rgba(184, 144, 71, 0.28);">
            <div class="position-relative overflow-hidden group">
              <a href="/gallery/modern-4bhk-penthouse-kharghar/" class="d-block text-decoration-none overflow-hidden">
                <img 
                  src="/assets/images/modern-4bhk-penthouse/1.webp" 
                  alt="Modern 4 BHK at Kharghar" 
                  width="1920" 
                  height="1280" 
                  loading="lazy" 
                  decoding="async" 
                  class="img-fluid w-100 object-fit-cover completed-project-img" 
                  style="max-height: 520px; width: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);"
                />
              </a>
            </div>
            <div class="p-4">
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                  <h2 class="font-luxury fw-bold mb-1" style="font-family: 'Playfair Display', Georgia, serif !important; color: #151413 !important; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.3;">
                    Modern <span class="spotlight-bhk-num" style="display: inline-block; transform: translateY(-0.14em);">4</span> BHK at Kharghar
                  </h2>
                  <p class="text-secondary small mb-0" style="max-width: 650px;">
                    Signature high-rise penthouse handover featuring quiet-luxury styling, layered cove ceiling illumination, bespoke woodwork, and premium designer finishes.
                  </p>
                </div>
                <a href="/gallery/modern-4bhk-penthouse-kharghar/" class="btn px-4 py-2 rounded-pill fw-bold text-decoration-none d-inline-flex align-items-center gap-2 shadow-sm spotlight-btn ms-auto text-nowrap" style="background: linear-gradient(135deg, #CDB698 0%, #B69C7C 100%); color: #1f1810; border: none; font-size: 0.92rem; transition: transform 0.2s ease, box-shadow 0.2s ease;">
                  <span>View Project</span>
                  <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Project 2: Luxury 4 BHK At Seawoods -->
        <div class="col-12" data-aos="fade-up">
          <div class="completed-project-card bg-white rounded-4 overflow-hidden shadow-sm mx-auto" style="max-width: 960px; border: 1px solid rgba(184, 144, 71, 0.28);">
