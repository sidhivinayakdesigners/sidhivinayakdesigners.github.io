---

<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <Fragment set:html={bodyContent} />
</Layout>

<style is:global>

  .completed-project-card:hover .completed-project-img {
    transform: scale(1.03);
  }
  .spotlight-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(182, 156, 124, 0.45) !important;
  }
  .spotlight-bhk-num {
    display: inline-block;
    transform: translateY(-0.14em);
  }
</style>

