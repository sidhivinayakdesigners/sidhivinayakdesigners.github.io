      </div>

      <!-- Bottom Consultation CTA -->
      <div class="text-center mt-5 pt-3" data-aos="fade-up">
        <div class="p-4 p-md-5 rounded-4 shadow-sm mx-auto" style="max-width: 960px; background: linear-gradient(135deg, rgba(205, 182, 152, 0.15) 0%, rgba(182, 156, 124, 0.22) 100%); border: 1px solid rgba(184, 144, 71, 0.35);">
          <span class="section-subtitle" style="color: #b89047 !important; letter-spacing: 2px; text-transform: uppercase; font-weight: 600; font-size: 0.85rem;">Ready to Begin?</span>
          <h2 class="font-luxury fw-bold my-2" style="font-family: 'Playfair Display', Georgia, serif !important; color: #151413 !important; font-size: clamp(1.5rem, 2.5vw, 2.2rem);">
            Bring Your Dream Home to Life
          </h2>
          <p class="text-secondary mx-auto mb-4" style="max-width: 600px; font-size: 0.98rem;">
            Book a complimentary design consultation with our senior interior architects in Navi Mumbai.
          </p>
          <div class="d-flex flex-wrap justify-content-center gap-3">
            <button onclick="window.openConsultationPopup && window.openConsultationPopup(true)" class="btn px-4 py-2 rounded-pill fw-bold text-decoration-none d-inline-flex align-items-center gap-2 shadow-sm" style="background: linear-gradient(135deg, #CDB698 0%, #B69C7C 100%); color: #1f1810; border: none; font-size: 0.95rem;">
              <i class="fa-solid fa-calendar-check"></i>
              <span>Book Free Consultation</span>
            </button>
            <a href="https://wa.me/918369297174?text=Hi%20Siddhivinayak%20Designers%2C%20I%20saw%20your%20completed%20projects%20and%20want%20to%20discuss%20my%20home%20interiors." target="_blank" rel="noopener noreferrer" class="btn px-4 py-2 rounded-pill fw-bold text-decoration-none d-inline-flex align-items-center gap-2 shadow-sm" style="background: #25D366; color: #ffffff; border: none; font-size: 0.95rem;">
              <i class="fa-brands fa-whatsapp"></i>
              <span>Chat on WhatsApp</span>
            </a>
          </div>
        </div>
      </div>

    </div>
