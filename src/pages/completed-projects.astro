                  style="max-height: 520px; width: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);"
                />
              </a>
            </div>
            <div class="p-4">
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                  <h2 class="font-luxury fw-bold mb-1" style="font-family: 'Playfair Display', Georgia, serif !important; color: #151413 !important; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.3;">
                    Luxury <span class="spotlight-bhk-num" style="display: inline-block; transform: translateY(-0.14em);">4</span> BHK At Seawoods
                  </h2>
                  <p class="text-secondary small mb-0" style="max-width: 650px;">
                    Sophisticated 4 BHK penthouse interior designed with bespoke fluted textures, custom ceiling coves, Italian marble accents, and modern ambient lighting.
                  </p>
                </div>
                <a href="/gallery/contemporary-4bhk-penthouse-seawoods/" class="btn px-4 py-2 rounded-pill fw-bold text-decoration-none d-inline-flex align-items-center gap-2 shadow-sm spotlight-btn ms-auto text-nowrap" style="background: linear-gradient(135deg, #CDB698 0%, #B69C7C 100%); color: #1f1810; border: none; font-size: 0.92rem; transition: transform 0.2s ease, box-shadow 0.2s ease;">
                  <span>View Project</span>
                  <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Project 3: Rustic 3 BHK Home, Nerul -->
        <div class="col-12" data-aos="fade-up">
          <div class="completed-project-card bg-white rounded-4 overflow-hidden shadow-sm mx-auto" style="max-width: 960px; border: 1px solid rgba(184, 144, 71, 0.28);">
            <div class="position-relative overflow-hidden group">
              <a href="/gallery/rustic-3bhk-home-nerul/" class="d-block text-decoration-none overflow-hidden">
                <img 
                  src="/assets/images/rustic-3bhk-home-nerul/img1.webp" 
                  alt="Rustic 3 BHK Home, Nerul" 
                  width="1920" 
                  height="1280" 
                  loading="lazy" 
                  decoding="async" 
                  class="img-fluid w-100 object-fit-cover completed-project-img" 
                  style="max-height: 520px; width: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);"
                />
              </a>
            </div>
            <div class="p-4">
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                  <h2 class="font-luxury fw-bold mb-1" style="font-family: 'Playfair Display', Georgia, serif !important; color: #151413 !important; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.3;">
                    Rustic <span class="spotlight-bhk-num" style="display: inline-block; transform: translateY(-0.14em);">3</span> BHK Home, Nerul
