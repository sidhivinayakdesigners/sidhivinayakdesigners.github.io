                  <p class="text-secondary small mb-0" style="max-width: 650px;">
                    Organic warmth meets contemporary elegance featuring hand-crafted timber accents, customized sliding wardrobes, and ergonomic open-concept living.
                  </p>
                </div>
                <a href="/gallery/rustic-3bhk-home-nerul/" class="btn px-4 py-2 rounded-pill fw-bold text-decoration-none d-inline-flex align-items-center gap-2 shadow-sm spotlight-btn ms-auto text-nowrap" style="background: linear-gradient(135deg, #CDB698 0%, #B69C7C 100%); color: #1f1810; border: none; font-size: 0.92rem; transition: transform 0.2s ease, box-shadow 0.2s ease;">
                  <span>View Project</span>
                  <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Project 4: Elegant 2 BHK Flat, Vashi -->
        <div class="col-12" data-aos="fade-up">
          <div class="completed-project-card bg-white rounded-4 overflow-hidden shadow-sm mx-auto" style="max-width: 960px; border: 1px solid rgba(184, 144, 71, 0.28);">
            <div class="position-relative overflow-hidden group">
              <a href="/gallery/elegant-2bhk-flat-vashi/" class="d-block text-decoration-none overflow-hidden">
                <img 
                  src="/assets/images/elegant-2bhk-flat-vashi/img1.webp" 
                  alt="Elegant 2 BHK Flat, Vashi" 
                  width="1920" 
                  height="1280" 
                  loading="lazy" 
                  decoding="async" 
                  class="img-fluid w-100 object-fit-cover completed-project-img" 
                  style="max-height: 520px; width: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);"
                />
              </a>
            </div>
            <div class="p-4">
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                  <h2 class="font-luxury fw-bold mb-1" style="font-family: 'Playfair Display', Georgia, serif !important; color: #151413 !important; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.3;">
                    Elegant <span class="spotlight-bhk-num" style="display: inline-block; transform: translateY(-0.14em);">2</span> BHK Flat, Vashi
                  </h2>
                  <p class="text-secondary small mb-0" style="max-width: 650px;">
                    Intelligent space-saving solutions, custom modular kitchen, bespoke sliding wardrobes, and refined contemporary living room decor in Vashi.
                  </p>
                </div>
                <a href="/gallery/elegant-2bhk-flat-vashi/" class="btn px-4 py-2 rounded-pill fw-bold text-decoration-none d-inline-flex align-items-center gap-2 shadow-sm spotlight-btn ms-auto text-nowrap" style="background: linear-gradient(135deg, #CDB698 0%, #B69C7C 100%); color: #1f1810; border: none; font-size: 0.92rem; transition: transform 0.2s ease, box-shadow 0.2s ease;">
                  <span>View Project</span>
                  <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Project 5: Premium 3 BHK Flat, Belapur -->
        <div class="col-12" data-aos="fade-up">
          <div class="completed-project-card bg-white rounded-4 overflow-hidden shadow-sm mx-auto" style="max-width: 960px; border: 1px solid rgba(184, 144, 71, 0.28);">
            <div class="position-relative overflow-hidden group">
              <a href="/gallery/premium-3bhk-flat-belapur/" class="d-block text-decoration-none overflow-hidden">
                <img 
                  src="/assets/images/devesh-arya/1.webp" 
                  alt="Premium 3 BHK Flat, Belapur" 
                  width="1500" 
                  height="1000" 
                  loading="lazy" 
                  decoding="async" 
                  class="img-fluid w-100 object-fit-cover completed-project-img" 
                  style="max-height: 520px; width: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);"
                />
              </a>
            </div>
            <div class="p-4">
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                  <h2 class="font-luxury fw-bold mb-1" style="font-family: 'Playfair Display', Georgia, serif !important; color: #151413 !important; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.3;">
                    Premium <span class="spotlight-bhk-num" style="display: inline-block; transform: translateY(-0.14em);">3</span> BHK Flat, Belapur
                  </h2>
                  <p class="text-secondary small mb-0" style="max-width: 650px;">
                    Intelligent space-saving solutions, custom modular kitchen, bespoke sliding wardrobes, and refined contemporary living room decor in Belapur.
                  </p>
                </div>
                <a href="/gallery/premium-3bhk-flat-belapur/" class="btn px-4 py-2 rounded-pill fw-bold text-decoration-none d-inline-flex align-items-center gap-2 shadow-sm spotlight-btn ms-auto text-nowrap" style="background: linear-gradient(135deg, #CDB698 0%, #B69C7C 100%); color: #1f1810; border: none; font-size: 0.92rem; transition: transform 0.2s ease, box-shadow 0.2s ease;">
                  <span>View Project</span>
                  <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Project 6: Premium 4 BHK Flat at Ghansoli -->
        <div class="col-12" data-aos="fade-up">
          <div class="completed-project-card bg-white rounded-4 overflow-hidden shadow-sm mx-auto" style="max-width: 960px; border: 1px solid rgba(184, 144, 71, 0.28);">
            <div class="position-relative overflow-hidden group">
              <a href="/gallery/premium-4bhk-at-ghansoli/" class="d-block text-decoration-none overflow-hidden">
                <img 
                  src="/assets/images/premium-4bhk-ghansoli/3.webp" 
                  alt="Premium 4 BHK Flat at Ghansoli" 
                  width="1600" 
                  height="1067" 
                  loading="lazy" 
                  decoding="async" 
                  class="img-fluid w-100 object-fit-cover completed-project-img" 
                  style="max-height: 520px; width: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);"
                />
              </a>
            </div>
            <div class="p-4">
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                  <h2 class="font-luxury fw-bold mb-1" style="font-family: 'Playfair Display', Georgia, serif !important; color: #151413 !important; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.3;">
                    Premium <span class="spotlight-bhk-num" style="display: inline-block; transform: translateY(-0.14em);">4</span> BHK Flat at Ghansoli
                  </h2>
                  <p class="text-secondary small mb-0" style="max-width: 650px;">
                    Intelligent space-saving solutions, custom modular kitchen, bespoke sliding wardrobes, and refined contemporary living room decor in Ghansoli.
                  </p>
                </div>
                <a href="/gallery/premium-4bhk-at-ghansoli/" class="btn px-4 py-2 rounded-pill fw-bold text-decoration-none d-inline-flex align-items-center gap-2 shadow-sm spotlight-btn ms-auto text-nowrap" style="background: linear-gradient(135deg, #CDB698 0%, #B69C7C 100%); color: #1f1810; border: none; font-size: 0.92rem; transition: transform 0.2s ease, box-shadow 0.2s ease;">
                  <span>View Project</span>
                  <i class="fa-solid fa-arrow-right"></i>
                </a>
              </div>
            </div>
          </div>
        </div>

        <!-- Project 7: Minimal 2 BHK Flat, Seawoods -->
        <div class="col-12" data-aos="fade-up">
          <div class="completed-project-card bg-white rounded-4 overflow-hidden shadow-sm mx-auto" style="max-width: 960px; border: 1px solid rgba(184, 144, 71, 0.28);">
            <div class="position-relative overflow-hidden group">
              <a href="/gallery/minimal-2bhk-flat-seawoods/" class="d-block text-decoration-none overflow-hidden">
                <img 
                  src="/assets/images/minimal-2bhk-seawoods/1.webp" 
                  alt="Minimal 2 BHK Flat, Seawoods" 
                  width="1500" 
                  height="1000" 
                  loading="lazy" 
                  decoding="async" 
                  class="img-fluid w-100 object-fit-cover completed-project-img" 
                  style="max-height: 520px; width: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);"
                />
              </a>
            </div>
            <div class="p-4">
              <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                  <h2 class="font-luxury fw-bold mb-1" style="font-family: 'Playfair Display', Georgia, serif !important; color: #151413 !important; font-size: clamp(1.25rem, 2vw, 1.6rem); line-height: 1.3;">
                    Minimal <span class="spotlight-bhk-num" style="display: inline-block; transform: translateY(-0.14em);">2</span> BHK Flat, Seawoods
                  </h2>
                  <p class="text-secondary small mb-0" style="max-width: 650px;">
                    Intelligent space-saving solutions, custom modular kitchen, bespoke sliding wardrobes, and refined contemporary living room decor in Seawoods.
                  </p>
                </div>
                <a href="/gallery/minimal-2bhk-flat-seawoods/" class="btn px-4 py-2 rounded-pill fw-bold text-decoration-none d-inline-flex align-items-center gap-2 shadow-sm spotlight-btn ms-auto text-nowrap" style="background: linear-gradient(135deg, #CDB698 0%, #B69C7C 100%); color: #1f1810; border: none; font-size: 0.92rem; transition: transform 0.2s ease, box-shadow 0.2s ease;">
