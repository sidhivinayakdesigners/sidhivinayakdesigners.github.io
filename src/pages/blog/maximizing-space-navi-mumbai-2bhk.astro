---
import Layout from '../../layouts/Layout.astro';

const title = "Space-Saving 2BHK Interior Design Ideas in Navi Mumbai | Siddhivinayak Designers";
const description = "Discover expert space-saving solutions, custom modular layouts, and space-saving furniture options for standard 2BHK flats in Vashi, Kharghar, Panvel & Nerul.";
const canonical = "https://siddhivinayakdesigners.in/blog/maximizing-space-navi-mumbai-2bhk/";
const schema = `{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [{
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
    "item": "https://siddhivinayakdesigners.in/"
  },{
    "@type": "ListItem",
    "position": 2,
    "name": "Blog",
    "item": "https://siddhivinayakdesigners.in/blog/"
  },{
    "@type": "ListItem",
    "position": 3,
    "name": "Space-Saving 2BHK Guide",
    "item": "https://siddhivinayakdesigners.in/blog/maximizing-space-navi-mumbai-2bhk"
  }]
}
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://siddhivinayakdesigners.in/blog/maximizing-space-navi-mumbai-2bhk"
  },
  "headline": "Maximizing Space in Navi Mumbai 2BHK Apartments: A Designer's Guide",
  "description": "Discover expert space-saving solutions, custom modular layouts, and space-saving furniture options for standard 2BHK flats in Vashi, Kharghar, Panvel & Nerul.",
  "image": "https://siddhivinayakdesigners.in/assets/images/img/villa-kids-room-storage-study-navi-mumbai.webp",
  "author": {
    "@type": "Organization",
    "name": "Siddhivinayak Designers"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Siddhivinayak Designers",
    "logo": {
      "@type": "ImageObject",
      "url": "https://siddhivinayakdesigners.in/assets/images/logo_icon.webp"
    }
  },
  "datePublished": "2026-08-21",
  "dateModified": "2026-08-21"
}`;

const bodyContent = `<!-- Full Width Cover Hero -->
<div class="position-relative w-100" style="height: 500px; margin-top: 65px; background: url('/assets/images/img/villa-kids-room-storage-study-navi-mumbai.webp') no-repeat center center; background-size: cover;">
  <div class="position-absolute top-0 start-0 w-100 h-100" style="background: rgba(0,0,0,0.4);"></div>
  <div class="position-absolute top-50 start-50 translate-middle text-center w-100 px-3">
    <div class="d-inline-block p-4 p-md-5 rounded-4 shadow-lg text-dark" style="background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(12px); max-width: 800px; border: 1px solid rgba(255,255,255,0.4);">
      <span class="badge mb-2 text-uppercase fw-bold text-white px-3 py-2" style="background-color: #189ba6; font-size: 0.75rem;">Space-Saving Guide</span>
      <h1 class="font-luxury mb-3 h2 text-dark fw-bold" style="color: #062639 !important; font-size: 1.85rem; line-height: 1.4;">Maximizing Space in Navi Mumbai 2BHK Apartments: A Designer's Guide</h1>
      <div class="meta-info small text-muted d-flex justify-content-center gap-3 align-items-center flex-wrap">
        <span><i class="far fa-calendar-alt text-teal me-1"></i> August 21, 2026</span>
        <span>•</span>
        <span><i class="far fa-clock text-teal me-1"></i> 12 Min Read</span>
        <span>•</span>
        <span>By Siddhivinayak Designers</span>
      </div>
    </div>
  </div>
</div>

<!-- Distraction-free Single Column Layout -->
<section class="py-5 bg-white text-dark">
  <div class="container py-2">
    <!-- Breadcrumbs -->
    <div class="row justify-content-center mb-4">
      <div class="col-lg-9">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb small mb-0 bg-transparent p-0">
            <li class="breadcrumb-item"><a href="/" style="color: #189ba6; text-decoration: none;">Home</a></li>
            <li class="breadcrumb-item"><a href="/blog/" style="color: #189ba6; text-decoration: none;">Blog</a></li>
            <li class="breadcrumb-item active text-secondary" aria-current="page">Space-Saving Guide</li>
          </ol>
        </nav>
      </div>
    </div>

    <div class="row justify-content-center">
      <div class="col-lg-9">
        
        <p class="lead text-secondary mb-5" style="font-size: 1.2rem; color: #444444 !important; line-height: 1.8; font-weight: 400;">
          With real estate prices climbing in major Navi Mumbai nodes like Vashi, Kharghar, Seawoods, and Panvel, the standard 2BHK apartment carpet sizes generally range between 650 sq. ft. and 850 sq. ft. For modern families, living in these compact flats requires planning layouts efficiently. This comprehensive guide outlines smart, space-saving design solutions that maximize your home's functionality without sacrificing premium aesthetics.
        </p>

        <h3 class="font-luxury text-dark h5 mt-4 mb-3" style="color: #062639 !important; font-weight: bold; border-left: 4px solid #189ba6; padding-left: 12px;">1. Understanding standard 2BHK Flat Layout Sizing in Navi Mumbai</h3>
        <p class="text-secondary" style="color: #444444 !important; line-height: 1.7;">
          Navi Mumbai high-rises commonly feature structural pillars, compact foyer openings, and rectangular halls. A standard 2BHK apartment is typically divided into:
        </p>
        <ul style="color: #444444 !important; line-height: 1.7;" class="mb-5">
          <li class="mb-2"><strong>Living-Cum-Dining Area (150 - 220 sqft):</strong> Needs to serve as both the family hangout lounge and the dining zone.</li>
          <li class="mb-2"><strong>Master Bedroom (110 - 130 sqft):</strong> Requires a king-size bed, a spacious wardrobe, and potentially a compact dresser or workspace.</li>
          <li class="mb-2"><strong>Kid's / Guest Bedroom (95 - 110 sqft):</strong> Needs flexible sleeping setups, play room space, and study desks.</li>
          <li class="mb-2"><strong>Kitchen (50 - 70 sqft):</strong> Parallel or L-shaped, requiring space-saving storage to hide cooking appliances.</li>
        </ul>

        <h3 class="font-luxury text-dark h5 mt-5 mb-3" style="color: #062639 !important; font-weight: bold; border-left: 4px solid #189ba6; padding-left: 12px;">2. Smart Layout Planning for Compact Living-Dining Halls</h3>
        <p class="text-secondary mb-4" style="color: #444444 !important; line-height: 1.7;">
          In a rectangular 2BHK hall, standard swing furniture quickly blocks walking lanes. Our interior designers recommend:
        </p>
        <ul style="color: #444444 !important; line-height: 1.7;" class="mb-5">
          <li class="mb-2"><strong>Visual Tricks with Mirrors:</strong> Installing a floor-to-ceiling mirror panel on the dining wall bounces light around the room, instantly making the room feel twice as wide.</li>
          <li class="mb-2"><strong>Floating TV Console Units:</strong> Choose floating wall units instead of heavy, floor-bound consoles. By keeping the floor clear, the room feels open and is easier to clean. Combine your TV console paneling with vertical display shelves to utilize overhead space.</li>
          <li class="mb-2"><strong>Folding & Wall-Mounted Dining Tables:</strong> If your dining area is narrow, use a wall-mounted drop-leaf table that folds down flat when not in use. Combine this with sleek nesting chairs that tuck underneath or double as extra balcony seats.</li>
        </ul>

        <!-- Showcase Section 1: Zebra Style (Image Left / Text Right) -->
        <div class="row align-items-center my-5 py-4 border-top border-bottom" style="border-color: #f1f3f5 !important;">
          <div class="col-md-6 mb-3 mb-md-0">
            <img src="/assets/images/space-saving/space-saving-living-room-with-multi-purpose-tv-unit.webp" alt="Sliding TV Unit Cum study desk Layout" class="img-fluid rounded shadow-sm" loading="lazy" style="width: 100%; object-fit: cover;" />
          </div>
          <div class="col-md-6 ps-md-4">
            <h4 class="h6 fw-bold mb-2 text-teal" style="color: #189ba6 !important; text-transform: uppercase; letter-spacing: 1px;"><i class="fas fa-couch me-2"></i>Multi-Functional TV Console</h4>
            <p class="small text-secondary mb-0" style="line-height: 1.7; color: #555555 !important; font-size: 0.92rem;">
              This custom piece features a horizontal sliding shutter that can cover the television screen to reveal a neat study console desk with bookshelves underneath, creating a dedicated home office corner without wasting separate room space.
            </p>
          </div>
        </div>

        <!-- Showcase Section 2: Zebra Style (Text Left / Image Right) -->
        <div class="row align-items-center my-5 py-4 border-bottom" style="border-color: #f1f3f5 !important;">
          <div class="col-md-6 order-2 order-md-1 pe-md-4">
            <h4 class="h6 fw-bold mb-2 text-teal" style="color: #189ba6 !important; text-transform: uppercase; letter-spacing: 1px;"><i class="fas fa-utensils me-2"></i>Crockery Fold-Down Dining</h4>
            <p class="small text-secondary mb-0" style="line-height: 1.7; color: #555555 !important; font-size: 0.92rem;">
              A custom crockery hutch unit with a central cabinet drop-down door that pulls down flat, instantly forming a sturdy 4-seater dining platform. When meals are over, the table folds back upright, leaving the living room walkway completely clear.
            </p>
          </div>
          <div class="col-md-6 order-1 order-md-2 mb-3 mb-md-0">
            <img src="/assets/images/space-saving/multifunctional-furniture-with-crockery-unit-and-foldable-dining-table-design.webp" alt="Crockery Cabinet with Foldable Dining Table" class="img-fluid rounded shadow-sm" loading="lazy" style="width: 100%; object-fit: cover;" />
          </div>
        </div>

        <h3 class="font-luxury text-dark h5 mt-5 mb-3" style="color: #062639 !important; font-weight: bold; border-left: 4px solid #189ba6; padding-left: 12px;">3. Space-Saving Bedroom Wardrobes & Hydraulic Bed Layouts</h3>
        <p class="text-secondary mb-4" style="color: #444444 !important; line-height: 1.7;">
          In standard master bedrooms, opening swing wardrobe doors consumes up to 2 feet of space, blocking walking pathways around the bed. Here is how we design around this restriction:
        </p>
        <ul style="color: #444444 !important; line-height: 1.7;" class="mb-5">
          <li class="mb-2"><strong>Sliding Wardrobes:</strong> Replaces swing doors with horizontal sliding tracks. High-gloss acrylic or lacquer-painted glass sliders reflect light, giving the room a premium feel.</li>
          <li class="mb-2"><strong>Floor-to-Ceiling Loft Storage:</strong> Never leave gaps above your wardrobes. Extending your wardrobe cabinetry to the ceiling (loft cabinets) creates extra space for seasonal bedding, suitcases, and winter wear.</li>
          <li class="mb-2"><strong>Hydraulic Storage Beds:</strong> Lifting up a heavy mattress to access storage is exhausting. An automated hydraulic bed frame lifts up smoothly, giving you under-bed storage space for suitcases, extra linens, and storage boxes.</li>
        </ul>

        <!-- Showcase Section 3: Zebra Style (Image Left / Text Right) -->
        <div class="row align-items-center my-5 py-4 border-bottom" style="border-color: #f1f3f5 !important;">
          <div class="col-md-6 mb-3 mb-md-0">
            <img src="/assets/images/space-saving/modern-bedroom-with-wardrobe-cum-dresser.webp" alt="Wardrobe with Integrated Slide-Out Vanity Layout" class="img-fluid rounded shadow-sm" loading="lazy" style="width: 100%; object-fit: cover;" />
          </div>
          <div class="col-md-6 ps-md-4">
            <h4 class="h6 fw-bold mb-2 text-teal" style="color: #189ba6 !important; text-transform: uppercase; letter-spacing: 1px;"><i class="fas fa-bed me-2"></i>Wardrobe Cum Slide-Out Vanity</h4>
            <p class="small text-secondary mb-0" style="line-height: 1.7; color: #555555 !important; font-size: 0.92rem;">
              To maximize walking space, this wardrobe combines a 3-door slider configuration with an adjacent dresser panel. The mirror slides open horizontally to access cosmetic organization drawers behind it, eliminating the need for a separate bulky dressing table.
            </p>
          </div>
        </div>

        <h3 class="font-luxury text-dark h5 mt-5 mb-3" style="color: #062639 !important; font-weight: bold; border-left: 4px solid #189ba6; padding-left: 12px;">4. Optimizing Compact Parallel & L-Shaped Modular Kitchens</h3>
        <p class="text-secondary mb-4" style="color: #444444 !important; line-height: 1.7;">
          Navi Mumbai modular kitchens require layout planning to maximize the counter workspace area:
        </p>
        <ul style="color: #444444 !important; line-height: 1.7;" class="mb-5">
          <li class="mb-2"><strong>Tall Appliance Units:</strong> Stack your microwave and oven vertically inside a tall modular pantry column instead of cluttering your kitchen platform.</li>
          <li class="mb-2"><strong>Tandem Drawers over Cabinets:</strong> Use pull-out tandem drawers (such as Hettich or Ebco systems) rather than traditional bottom shelves. They pull out completely, making heavy utensils at the back easily accessible.</li>
          <li class="mb-2"><strong>Corner Utilities:</strong> Corners are often wasted. Install pull-out carousel accessories or magic corner trays to utilize corner cabinet spaces.</li>
        </ul>

        <!-- Showcase Section 4: Zebra Style (Text Left / Image Right) -->
        <div class="row align-items-center my-5 py-4 border-bottom" style="border-color: #f1f3f5 !important;">
          <div class="col-md-6 order-2 order-md-1 pe-md-4">
            <h4 class="h6 fw-bold mb-2 text-teal" style="color: #189ba6 !important; text-transform: uppercase; letter-spacing: 1px;"><i class="fas fa-blender me-2"></i>Fold-out Breakfast Bar</h4>
            <p class="small text-secondary mb-0" style="line-height: 1.7; color: #555555 !important; font-size: 0.92rem;">
              Designed with a wall-mounted foldable slab matching the sage green modular cabinets. It acts as an auxiliary prep counter during food prep and folds up as a two-seater breakfast bar, maximizing utility in narrow kitchen galleries.
            </p>
          </div>
          <div class="col-md-6 order-1 order-md-2 mb-3 mb-md-0">
            <img src="/assets/images/space-saving/wall-mounted-foldable-dining-table-for-two-in-green-kitchen.webp" alt="L-shaped Green Kitchen with Fold-out Counter" class="img-fluid rounded shadow-sm" loading="lazy" style="width: 100%; object-fit: cover;" />
          </div>
        </div>

        <h3 class="font-luxury text-dark h5 mt-5 mb-3" style="color: #062639 !important; font-weight: bold; border-left: 4px solid #189ba6; padding-left: 12px;">5. Flexible Kids' Bedrooms & Multi-functional Workspaces</h3>
        <p class="text-secondary mb-4" style="color: #444444 !important; line-height: 1.7;">
          In the second bedroom of a 2BHK flat, we design double-duty setups:
        </p>
        <ul style="color: #444444 !important; line-height: 1.7;" class="mb-5">
          <li class="mb-2"><strong>Trundle Beds:</strong> An excellent option for two children, containing an extra roll-out mattress base underneath the main bed frame. This pulls out easily at night and tucks away during the day.</li>
          <li class="mb-2"><strong>Integrated Study Desks:</strong> Create floating desk units directly attached to your sliding wardrobe panel. This saves floor space and provides a clean office workspace.</li>
        </ul>

        <!-- Showcase Section 5: Zebra Style (Image Left / Text Right) -->
        <div class="row align-items-center my-5 py-4 border-bottom" style="border-color: #f1f3f5 !important;">
          <div class="col-md-6 mb-3 mb-md-0">
            <img src="/assets/images/space-saving/kids-bedroom-with-space-saving-trundle-bed.webp" alt="Kids Bedroom with Space Saving Trundle Bed Layout" class="img-fluid rounded shadow-sm" loading="lazy" style="width: 100%; object-fit: cover;" />
          </div>
          <div class="col-md-6 ps-md-4">
            <h4 class="h6 fw-bold mb-2 text-teal" style="color: #189ba6 !important; text-transform: uppercase; letter-spacing: 1px;"><i class="fas fa-child me-2"></i>Kids Room Trundle Bed</h4>
            <p class="small text-secondary mb-0" style="line-height: 1.7; color: #555555 !important; font-size: 0.92rem;">
              Features a pull-out bed base frame in blue and white laminates. During daytime activities, the bottom mattress rolls fully underneath the upper bed structure, opening up the room floor for play area activities.
            </p>
          </div>
        </div>

        <!-- Showcase Section 6: Zebra Style (Text Left / Image Right) -->
        <div class="row align-items-center my-5 py-4 border-bottom" style="border-color: #f1f3f5 !important;">
          <div class="col-md-6 order-2 order-md-1 pe-md-4">
            <h4 class="h6 fw-bold mb-2 text-teal" style="color: #189ba6 !important; text-transform: uppercase; letter-spacing: 1px;"><i class="fas fa-laptop-house me-2"></i>Murphy Bed Workstation</h4>
            <p class="small text-secondary mb-0" style="line-height: 1.7; color: #555555 !important; font-size: 0.92rem;">
              A custom vertical Murphy bed. When closed, it matches the wood panel styling of the study desk shelf. Pulling down the unit transforms the home study workstation into a cozy guest bedroom sleep station in under 10 seconds.
            </p>
          </div>
          <div class="col-md-6 order-1 order-md-2 mb-3 mb-md-0">
            <img src="/assets/images/space-saving/space-saving-bedroom-murphy-bed-with-open-shelves.webp" alt="Space saving Murphy bed and home office desk" class="img-fluid rounded shadow-sm" loading="lazy" style="width: 100%; object-fit: cover;" />
          </div>
        </div>

        <h3 class="font-luxury text-dark h5 mt-5 mb-3" style="color: #062639 !important; font-weight: bold; border-left: 4px solid #189ba6; padding-left: 12px;">6. Space-Saving Furniture Budgets in Navi Mumbai</h3>
        <p class="text-secondary mb-4" style="color: #444444 !important; line-height: 1.7;">
          Here is a realistic cost breakdown for custom space-saving interior woodwork for a 2BHK apartment in Navi Mumbai:
        </p>
        <table class="table table-bordered mb-5" style="color: #444444 !important; border-color: #dee2e6 !important;">
          <thead>
            <tr style="background-color: #f3f6f8 !important;">
              <th style="color: #111111 !important;">Modular Element</th>
              <th style="color: #111111 !important;">Standard Solution</th>
              <th style="color: #111111 !important;">Custom Space-Saving Solution</th>
              <th style="color: #111111 !important;">Est. Price Range (Navi Mumbai)</th>
            </tr>
          </thead>
          <tbody style="color: #444444 !important;">
            <tr>
              <td style="color: #333333 !important;"><strong>Living TV Unit</strong></td>
              <td style="color: #555555 !important;">Floor-bound cabinet</td>
              <td style="color: #555555 !important;">Floating console with hidden display paneling</td>
              <td style="color: #189ba6 !important; font-weight: bold;">₹45,000 - ₹75,000</td>
            </tr>
            <tr>
              <td style="color: #333333 !important;"><strong>Dining Unit</strong></td>
              <td style="color: #555555 !important;">4-Seater Table Set</td>
              <td style="color: #555555 !important;">Wall-mounted folding table with nesting stools</td>
              <td style="color: #189ba6 !important; font-weight: bold;">₹20,000 - ₹35,000</td>
            </tr>
            <tr>
              <td style="color: #333333 !important;"><strong>Master Bed</strong></td>
              <td style="color: #555555 !important;">Manual plywood box bed</td>
              <td style="color: #555555 !important;">Bed frame with easy-lift hydraulic gas lifters</td>
              <td style="color: #189ba6 !important; font-weight: bold;">₹55,000 - ₹85,000</td>
            </tr>
            <tr>
              <td style="color: #333333 !important;"><strong>Bedroom Wardrobe</strong></td>
              <td style="color: #555555 !important;">Swing door wardrobe</td>
              <td style="color: #555555 !important;">Sliding wardrobe with ceiling loft storage</td>
              <td style="color: #189ba6 !important; font-weight: bold;">₹1.2 - ₹1.8 Lakhs</td>
            </tr>
            <tr>
              <td style="color: #333333 !important;"><strong>Kids Study</strong></td>
              <td style="color: #555555 !important;">Standalone table</td>
              <td style="color: #555555 !important;">Wardrobe-integrated floating desk & trundle bed</td>
              <td style="color: #189ba6 !important; font-weight: bold;">₹75,000 - ₹1.2 Lakhs</td>
            </tr>
          </tbody>
        </table>

        <!-- Unique Space Saving FAQs Accordion -->
        <h3 class="font-luxury text-dark h5 mt-5 mb-3" style="color: #062639 !important; font-weight: bold; border-left: 4px solid #189ba6; padding-left: 12px;">Frequently Asked Questions (FAQ) on Space-Saving Design</h3>
        <div class="accordion mb-5" id="spaceFaq">
          <div class="accordion-item border" style="border-radius: 6px; overflow: hidden; margin-bottom: 10px;">
            <h4 class="accordion-header" id="headingOne">
              <button class="accordion-button collapsed fw-bold text-dark bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="false" aria-controls="collapseOne" style="color: #062639 !important; font-size: 0.95rem;">
                Are space-saving beds durable?
              </button>
            </h4>
            <div id="collapseOne" class="accordion-collapse collapse" aria-labelledby="headingOne" data-bs-parent="#spaceFaq">
              <div class="accordion-body text-secondary small" style="line-height: 1.6; color: #555555 !important;">
                Yes, our customized space-saving beds use carbon-steel gas struts and heavy-duty frame fixtures that are tested for over 10,000 cycles. We build them using BWR marine-grade plywood structures to ensure they easily withstand daily usage without sagging.
              </div>
            </div>
          </div>
          <div class="accordion-item border" style="border-radius: 6px; overflow: hidden; margin-bottom: 10px;">
            <h4 class="accordion-header" id="headingTwo">
              <button class="accordion-button collapsed fw-bold text-dark bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo" aria-expanded="false" aria-controls="collapseTwo" style="color: #062639 !important; font-size: 0.95rem;">
                How much space can I save with sliding wardrobes?
              </button>
            </h4>
            <div id="collapseTwo" class="accordion-collapse collapse" aria-labelledby="headingTwo" data-bs-parent="#spaceFaq">
              <div class="accordion-body text-secondary small" style="line-height: 1.6; color: #555555 !important;">
                A standard swing door consumes about 2 to 2.5 feet of clearance space directly in front of the wardrobe to open. Sliding wardrobes eliminate this clearance requirement entirely, allowing you to place bedside tables or move comfortably around the bed.
              </div>
            </div>
          </div>
          <div class="accordion-item border" style="border-radius: 6px; overflow: hidden; margin-bottom: 10px;">
            <h4 class="accordion-header" id="headingThree">
              <button class="accordion-button collapsed fw-bold text-dark bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree" aria-expanded="false" aria-controls="collapseThree" style="color: #062639 !important; font-size: 0.95rem;">
                Can custom space-saving furniture be dismantled?
              </button>
            </h4>
            <div id="collapseThree" class="accordion-collapse collapse" aria-labelledby="headingThree" data-bs-parent="#spaceFaq">
              <div class="accordion-body text-secondary small" style="line-height: 1.6; color: #555555 !important;">
                Yes, our modular storage units and wall beds utilize KD (Knock-Down) fittings and hardware sockets. This allows them to be dismantled and reassembled smoothly if you relocate within Navi Mumbai or Mumbai nodes.
              </div>
            </div>
          </div>
        </div>

        <!-- Centered Premium CTA Callout -->
        <div class="text-center py-5 px-4 rounded-4 my-5" style="background: linear-gradient(135deg, #e6f4f5 0%, #ffffff 100%); border: 1px solid rgba(24, 155, 166, 0.2);">
          <h4 class="font-luxury mb-2 text-dark fw-bold" style="color: #062639 !important;">Maximize Space in Your 2BHK Apartment</h4>
          <p class="small text-secondary mb-4 mx-auto max-w-600" style="color: #555555 !important;">
            Our Lead space designer in Koparkhairane can help draft custom 3D layouts matching these spatial configurations for your flat. Get complete 3D layout options.
          </p>
          <a class="btn px-4 py-2 text-white fw-bold shadow-sm" href="/contact/" style="background-color: #189ba6; border-color: #189ba6; border-radius: 30px; font-size: 0.9rem;">Book Free Layout Consultation</a>
        </div>

      </div>
    </div>
  </div>
</section>

<!-- Floating Actions -->
<div class="floating-widgets">
  <a style="background-color: #25D366 !important; background: #25D366 !important; color: #ffffff !important; border-color: #25D366 !important;" class="float-btn float-whatsapp" href="https://wa.me/918369297174?text=Hi%20Siddhivinayak%20Designers,%20I'm%20interested%20in%20a%20free%202BHK%20design%20consultation." target="_blank">
    <i class="fab fa-whatsapp"></i>
  </a>
  <a class="float-btn float-call" href="tel:+918369297174">
    <i class="fas fa-phone-alt"></i>
  </a>
</div>`;
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <Fragment set:html={bodyContent} />
</Layout>

<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-PLACEHOLDER');
</script>

<script is:inline>
  AOS.init({
    duration: 800,
    once: true
  });
</script>
