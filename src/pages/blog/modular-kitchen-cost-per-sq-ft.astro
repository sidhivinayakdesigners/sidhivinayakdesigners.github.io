---
import Layout from '../../layouts/Layout.astro';

const title = "Modular Kitchen Cost Per Sq. Ft. in 2026: Everything You Need to Know | Siddhivinayak Designers";
const description = "Everything you need to know about modular kitchen cost per square foot in 2026. Explore pricing factors, layouts, countertops, materials, and accessories in Navi Mumbai.";
const canonical = "https://siddhivinayakdesigners.in/blog/modular-kitchen-cost-per-sq-ft";
const schema = `{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [{
    "@type": "ListItem",
    "position": 1,
    "name": "Home",
