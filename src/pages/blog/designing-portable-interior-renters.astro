  }]
},
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://siddhivinayakdesigners.in/blog/designing-portable-interior-renters"
  },
  "headline": "How to Design a Portable Interior That Moves When You Do",
  "description": "Discover how to design a portable interior that moves with you. Reusable modular wardrobes, portable home office desks, and modular furniture tips.",
  "image": "https://siddhivinayakdesigners.in/assets/images/home-office/home-office-interior-design-for-small-apartment-with-floating-shelf.webp",
