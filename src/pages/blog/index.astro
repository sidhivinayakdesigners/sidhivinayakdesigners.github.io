<script is:inline>
  AOS.init({
    duration: 800,
    once: true
  });

  // Client-Side Search and Category Filtering Logic
  document.addEventListener('DOMContentLoaded', function() {
    const filterBtns = document.querySelectorAll('.cat-filter-btn');
    const blogCards = document.querySelectorAll('.blog-card-item');
    const searchInput = document.getElementById('blogSearchInput');
    const sidebarSearchInput = document.getElementById('sidebarSearchInput');
    const searchBtn = document.getElementById('blogSearchBtn');

    let currentCategory = 'all';

    function applyFilters() {
      const query = ((searchInput ? searchInput.value : '') || (sidebarSearchInput ? sidebarSearchInput.value : '')).toLowerCase().trim();

      blogCards.forEach(card => {
        const cardCategories = (card.getAttribute('data-category') || '').toLowerCase();
        const cardText = card.textContent.toLowerCase();

        const matchesCat = (currentCategory === 'all') || cardCategories.includes(currentCategory);
        const matchesQuery = (query === '') || cardText.includes(query);

        if (matchesCat && matchesQuery) {
          card.style.display = 'block';
        } else {
          card.style.display = 'none';
        }
      });
    }

    filterBtns.forEach(btn => {
      btn.addEventListener('click', function(e) {
        currentCategory = this.getAttribute('data-filter') || 'all';

        // Update Active Button Classes across all filter triggers
        filterBtns.forEach(b => {
          if (b.getAttribute('data-filter') === currentCategory) {
            b.classList.add('active', 'btn-teal');
            b.classList.remove('btn-light', 'text-dark', 'border');
          } else {
            b.classList.remove('active', 'btn-teal');
            b.classList.add('btn-light', 'text-dark', 'border');
          }
        });

        applyFilters();
      });
    });

    if (searchInput) searchInput.addEventListener('input', applyFilters);
    if (sidebarSearchInput) {
      sidebarSearchInput.addEventListener('input', function() {
        if (searchInput) searchInput.value = this.value;
        applyFilters();
      });
    }
    if (searchBtn) searchBtn.addEventListener('click', applyFilters);
  });
</script>

<style is:global>
  /* Force text in hero blog card overlays to be white */
  .hero-blog-card,
  .hero-blog-card *,
  .hero-blog-overlay,
  .hero-blog-overlay *,
  .hero-blog-card h3,
  .hero-blog-card p,
  .hero-blog-card span {
    color: #FFFFFF !important;
  }
  .hero-blog-overlay .cat-badge {
    background-color: #189ba6 !important;
    color: #FFFFFF !important;
  }
</style>


