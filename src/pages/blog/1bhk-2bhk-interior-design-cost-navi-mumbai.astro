---
import Layout from '../../layouts/Layout.astro';

const title = "1 BHK & 2 BHK Interior Design Cost in Navi Mumbai (2026 Guide) | Siddhivinayak Designers";
const description = "Discover realistic 1 BHK and 2 BHK interior design costs in Navi Mumbai. Compare package pricing, modular kitchens, wardrobes, and false ceiling costs.";
const canonical = "https://siddhivinayakdesigners.in/blog/1bhk-2bhk-interior-design-cost-navi-mumbai/";
const schema = `{
  "@context": "https://schema.org",
  "@graph": [
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [{
