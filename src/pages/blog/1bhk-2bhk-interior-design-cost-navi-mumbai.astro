    "item": "https://siddhivinayakdesigners.in/blog/"
  },{
    "@type": "ListItem",
    "position": 3,
    "name": "BHK Interior Cost Guide",
    "item": "https://siddhivinayakdesigners.in/blog/1bhk-2bhk-interior-design-cost-navi-mumbai"
  }]
},
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "https://siddhivinayakdesigners.in/blog/1bhk-2bhk-interior-design-cost-navi-mumbai"
  },
  "headline": "1 BHK & 2 BHK Interior Design Cost in Navi Mumbai (2026 Guide)",
  "description": "Discover realistic 1 BHK and 2 BHK interior design costs in Navi Mumbai. Compare package pricing, modular kitchens, wardrobes, and false ceiling costs.",
