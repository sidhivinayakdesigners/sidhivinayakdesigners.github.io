    justify-content: center;
    min-height: 0;
    pointer-events: auto;
  }

  .gallery-modal-main-img {
    max-height: calc(84vh - 90px);
    max-width: 86vw;
    object-fit: contain;
    border-radius: 4px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.75);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .gallery-modal-caption {
    color: #f0f0f0;
    font-size: 0.95rem;
    font-weight: 500;
    margin-top: 10px;
    text-align: center;
    max-width: 80%;
    text-shadow: 0 2px 6px rgba(0,0,0,0.8);
  }

  .gallery-modal-filmstrip-wrapper {
    width: 100%;
    max-width: 92vw;
    height: 75px;
    margin-top: 8px;
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .gallery-modal-filmstrip {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    max-width: 100%;
    padding: 6px 12px;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.4) transparent;
  }
  .gallery-modal-filmstrip::-webkit-scrollbar {
    height: 4px;
  }
  .gallery-modal-filmstrip::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.4);
    border-radius: 4px;
  }

  .gallery-modal-thumb {
    width: 84px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 4px;
    overflow: hidden;
    cursor: pointer;
    opacity: 0.55;
    border: 2px solid transparent;
    transition: all 0.2s ease;
    box-sizing: border-box;
    background-color: #1a1a1a;
  }
  .gallery-modal-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .gallery-modal-thumb:hover {
    opacity: 0.95;
    transform: scale(1.04);
  }
  .gallery-modal-thumb.active {
    opacity: 1;
    border-color: #ffffff;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.6);
    transform: scale(1.06);
  }

  @media (max-width: 768px) {
