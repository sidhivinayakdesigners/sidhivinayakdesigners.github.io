<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. FILTER FUNCTIONALITY
    const filterBtns = document.querySelectorAll('.gallery-filter-btn');
    const galleryItems = document.querySelectorAll('.gallery-item');
    let currentFilter = 'all';

    filterBtns.forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        filterBtns.forEach(b => b.classList.remove('active'));
        this.classList.add('active');

        currentFilter = this.getAttribute('data-filter') || 'all';

        galleryItems.forEach(item => {
          if (currentFilter === 'all' || item.classList.contains(currentFilter)) {
            item.style.display = 'block';
          } else {
            item.style.display = 'none';
          }
        });
      });
    });

    // 2. LIGHTBOX DATA & LOGIC
    let activePhotoList = [];
    let currentPhotoIdx = 0;

    function getVisibleItems() {
      const visible = [];
      galleryItems.forEach(item => {
        if (item.style.display !== 'none') {
          const img = item.querySelector('img');
          const trigger = item.querySelector('.lightbox-trigger');
          if (img) {
            const src = (trigger && trigger.getAttribute('data-src')) || img.getAttribute('src');
            const caption = (trigger && trigger.getAttribute('data-caption')) || img.getAttribute('alt') || '';
            const alt = img.getAttribute('alt') || 'Interior Design';
            visible.push({ src, caption, alt, el: item });
          }
        }
      });
      return visible;
    }

    // Attach click listeners to cards and triggers
    galleryItems.forEach(item => {
      const card = item.querySelector('.premium-card, .premium-card-img');
      const trigger = item.querySelector('.lightbox-trigger');
      
      const openThis = (e) => {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        activePhotoList = getVisibleItems();
        if (activePhotoList.length === 0) return;

        const img = item.querySelector('img');
        const clickedSrc = (trigger && trigger.getAttribute('data-src')) || (img && img.getAttribute('src'));
        
        let foundIdx = activePhotoList.findIndex(p => p.src === clickedSrc || (clickedSrc && p.src.endsWith(clickedSrc.split('/').pop())));
        if (foundIdx === -1) foundIdx = 0;

        openGalleryModal(foundIdx);
      };

      if (card) {
        card.style.cursor = 'pointer';
        card.addEventListener('click', openThis);
      }
      if (trigger) {
        trigger.addEventListener('click', openThis);
      }
    });

    // Modal Elements
    const modal = document.getElementById('galleryPhotoModal');
    const stage = document.querySelector('.gallery-modal-main-stage');
    const mainImg = document.getElementById('galleryModalMainImg');
    const captionEl = document.getElementById('galleryModalCaption');
    const filmstrip = document.getElementById('galleryModalFilmstrip');

    function renderModalSlide(index) {
      if (!activePhotoList[index]) return;
      currentPhotoIdx = index;
      const item = activePhotoList[currentPhotoIdx];

      mainImg.style.opacity = '0.35';
      mainImg.src = item.src;
      mainImg.alt = item.alt;
      mainImg.onload = () => { mainImg.style.opacity = '1'; };

      captionEl.textContent = item.caption || item.alt;

      // Update active state in thumbnail filmstrip
      const thumbs = filmstrip.querySelectorAll('.gallery-modal-thumb');
      thumbs.forEach((th, idx) => {
        if (idx === currentPhotoIdx) {
          th.classList.add('active');
          th.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          th.classList.remove('active');
        }
      });
    }

    window.openGalleryModal = function(index) {
      if (!modal) return;
      activePhotoList = getVisibleItems();
      if (activePhotoList.length === 0) return;

      // Build filmstrip
      filmstrip.innerHTML = '';
      activePhotoList.forEach((photo, idx) => {
        const thumb = document.createElement('div');
        thumb.className = 'gallery-modal-thumb' + (idx === index ? ' active' : '');
        thumb.innerHTML = `<img src="${photo.src}" alt="Thumb ${idx + 1}" loading="lazy" />`;
        thumb.addEventListener('click', (e) => {
          e.stopPropagation();
          renderModalSlide(idx);
        });
        filmstrip.appendChild(thumb);
      });

      renderModalSlide(index);
      modal.style.display = 'flex';
      document.documentElement.style.overflow = 'hidden';
      document.body.style.overflow = 'hidden';
    };

    window.closeGalleryModal = function() {
      if (!modal) return;
      modal.style.display = 'none';
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
    };

    window.nextGalleryPhoto = function() {
      if (activePhotoList.length <= 1) return;
      const nextIdx = (currentPhotoIdx + 1) % activePhotoList.length;
      renderModalSlide(nextIdx);
    };

    window.prevGalleryPhoto = function() {
      if (activePhotoList.length <= 1) return;
      const prevIdx = (currentPhotoIdx - 1 + activePhotoList.length) % activePhotoList.length;
      renderModalSlide(prevIdx);
    };

    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (modal && modal.style.display === 'flex') {
        if (e.key === 'Escape') closeGalleryModal();
        if (e.key === 'ArrowRight') nextGalleryPhoto();
        if (e.key === 'ArrowLeft') prevGalleryPhoto();
      }
    });

    // Prevent background wheel and touch scroll on modal backdrop
    if (modal) {
      modal.addEventListener('wheel', (e) => {
        if (e.target.closest('#galleryModalFilmstrip')) return; // allow wheel on thumbnail bar
        e.preventDefault();
        e.stopPropagation();
      }, { passive: false });

      // Touch drag and swipe on main image stage
      if (stage && mainImg) {
        let startX = 0;
        let startY = 0;
        let currentX = 0;
        let currentY = 0;
        let isDragging = false;
        let isSwiping = false;

        const getEventX = (e) => (e.touches ? e.touches[0].clientX : e.clientX);
        const getEventY = (e) => (e.touches ? e.touches[0].clientY : e.clientY);

        const onDragStart = (e) => {
          if (e.target.closest('.gallery-modal-close') || e.target.closest('.gallery-modal-nav') || e.target.closest('.gallery-modal-filmstrip-wrapper')) return;
          isDragging = true;
          isSwiping = false;
          startX = getEventX(e);
          startY = getEventY(e);
          currentX = startX;
          currentY = startY;
          mainImg.style.transition = 'none';
        };

        const onDragMove = (e) => {
          if (!isDragging) return;
          currentX = getEventX(e);
          currentY = getEventY(e);
          const deltaX = currentX - startX;
          const deltaY = currentY - startY;

          if (!isSwiping && (Math.abs(deltaX) > 6 || Math.abs(deltaY) > 6)) {
            isSwiping = true;
          }

          if (isSwiping) {
            const scale = Math.max(0.88, 1 - Math.abs(deltaX) / 1600);
            mainImg.style.transform = `translate3d(${deltaX}px, 0, 0) scale(${scale})`;
            mainImg.style.opacity = `${Math.max(0.4, 1 - Math.abs(deltaX) / 500)}`;
          }
        };

        const onDragEnd = () => {
          if (!isDragging) return;
          isDragging = false;
          const deltaX = currentX - startX;
          const threshold = window.innerWidth * 0.12;

          mainImg.style.transition = 'transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease';

          if (deltaX < -threshold) {
            // Swipe Left -> Next Photo
            mainImg.style.transform = `translate3d(-120px, 0, 0)`;
            mainImg.style.opacity = '0';
            setTimeout(() => {
              nextGalleryPhoto();
              mainImg.style.transition = 'none';
              mainImg.style.transform = `translate3d(80px, 0, 0)`;
              setTimeout(() => {
                mainImg.style.transition = 'transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease';
                mainImg.style.transform = 'translate3d(0, 0, 0)';
                mainImg.style.opacity = '1';
              }, 20);
            }, 140);
          } else if (deltaX > threshold) {
            // Swipe Right -> Prev Photo
            mainImg.style.transform = `translate3d(120px, 0, 0)`;
            mainImg.style.opacity = '0';
            setTimeout(() => {
              prevGalleryPhoto();
              mainImg.style.transition = 'none';
              mainImg.style.transform = `translate3d(-80px, 0, 0)`;
              setTimeout(() => {
                mainImg.style.transition = 'transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease';
                mainImg.style.transform = 'translate3d(0, 0, 0)';
                mainImg.style.opacity = '1';
              }, 20);
            }, 140);
          } else {
            // Snap back
            mainImg.style.transform = 'translate3d(0, 0, 0) scale(1)';
            mainImg.style.opacity = '1';
          }
        };

        // Stage Touch Listeners
        stage.addEventListener('touchstart', onDragStart, { passive: true });
        stage.addEventListener('touchmove', onDragMove, { passive: true });
        stage.addEventListener('touchend', onDragEnd, { passive: true });

        // Stage Mouse Drag Listeners
        stage.addEventListener('mousedown', (e) => {
          if (e.button !== 0) return;
          onDragStart(e);
        });
        window.addEventListener('mousemove', onDragMove);
        window.addEventListener('mouseup', onDragEnd);
      }

      // Horizontal wheel scroll on thumbnail filmstrip
      if (filmstrip) {
        filmstrip.addEventListener('wheel', (e) => {
          if (e.deltaY !== 0) {
            e.preventDefault();
            filmstrip.scrollLeft += e.deltaY;
          }
        }, { passive: false });
      }
    }
  });
</script>

