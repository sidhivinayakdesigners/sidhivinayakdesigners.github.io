<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <Fragment set:html={bodyContent} />

  <!-- Gallery Lightbox Modal with Bottom Thumbnail Filmstrip -->
  <div id="galleryPhotoModal" class="gallery-photo-modal" style="display: none;">
    <!-- Backdrop click catcher -->
    <div class="gallery-modal-backdrop" onclick="closeGalleryModal()"></div>

    <!-- Top Right Close Button -->
    <button class="gallery-modal-close" onclick="closeGalleryModal()" aria-label="Close">
      <i class="fas fa-times"></i>
    </button>

    <!-- Left / Prev Button -->
    <button class="gallery-modal-nav gallery-modal-prev" onclick="prevGalleryPhoto()" aria-label="Previous photo">
      <i class="fas fa-chevron-left"></i>
    </button>

    <!-- Right / Next Button -->
    <button class="gallery-modal-nav gallery-modal-next" onclick="nextGalleryPhoto()" aria-label="Next photo">
      <i class="fas fa-chevron-right"></i>
    </button>

    <!-- Main Modal Stage & Filmstrip Wrapper -->
    <div class="gallery-modal-wrapper">
      <!-- Main Photo Stage -->
      <div class="gallery-modal-main-stage">
        <img id="galleryModalMainImg" src="" alt="Interior Design Preview" class="gallery-modal-main-img" />
        <div id="galleryModalCaption" class="gallery-modal-caption"></div>
      </div>

      <!-- Bottom Thumbnail Filmstrip -->
      <div class="gallery-modal-filmstrip-wrapper">
        <div id="galleryModalFilmstrip" class="gallery-modal-filmstrip">
          <!-- Thumbnails populated dynamically by JS -->
        </div>
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  /* PREMIUM FULLSCREEN GALLERY LIGHTBOX & THUMBNAIL FILMSTRIP */
  .gallery-photo-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 100000;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.94);
    touch-action: none;
    overscroll-behavior: contain;
    user-select: none;
