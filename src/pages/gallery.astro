const canonical = "https://siddhivinayakdesigners.in/gallery/";
const schema = `{
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [{
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://siddhivinayakdesigners.in/"
      },{
        "@type": "ListItem",
        "position": 2,
        "name": "Gallery",
        "item": "https://siddhivinayakdesigners.in/gallery"
      }]
    }`;
