    transition: all 0.2s ease;
  }
  .gallery-modal-close:hover {
    background: rgba(255, 255, 255, 0.35);
    color: #ffffff;
    transform: scale(1.08);
  }

  .gallery-modal-nav {
    position: absolute;
    top: 48%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.22);
    border: none;
    color: #ffffff;
