---
import Layout from '../layouts/Layout.astro';

const title = "Interior Design Pricing | Siddhivinayak Designers";
const description = "Transparent interior design cost &amp; packages in Navi Mumbai. Budget pricing for Standard, Premium &amp; Luxury 2BHK/3BHK home interiors.";
const canonical = "https://siddhivinayakdesigners.in/pricing/";
const schema = `{
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [{
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://siddhivinayakdesigners.in/"
      },{
        "@type": "ListItem",
        "position": 2,
        "name": "Pricing",
        "item": "https://siddhivinayakdesigners.in/pricing"
      }]
    }`;
const bodyContent = `<!-- Header Banner -->
<section class="py-5 bg-dark" style="margin-top: 70px;">
<div class="container py-4 text-center">
<h1 class="font-luxury text-white mb-2" data-aos="fade-down">Transparent Pricing</h1>
<div class="custom-breadcrumb text-center justify-content-center d-flex gap-2">
<a href="/">Home</a>
<span class="text-muted">/</span>
<span>Pricing</span>
</div>
</div>
</section>
<!-- Detailed Packages Section -->
<section class="py-5 bg-dark">
<div class="container py-5">
<div class="text-center mb-5" data-aos="fade-up">
<span class="section-subtitle">Packages Overview</span>
<h2 class="section-title text-white font-luxury">Explore Our Interior Packages</h2>
</div>
<div class="row g-4 align-items-stretch">
<!-- Package 1: Standard -->
<div class="col-lg-4" data-aos="fade-up" data-aos-delay="100">
<div class="premium-card p-4 h-100 d-flex flex-column">
<div class="mb-4">
<span class="section-subtitle mb-1">Standard</span>
<h3 class="text-white font-luxury h3">?950 / sqft</h3>
<p class="small text-muted">A budget-friendly package for practical designs using quality laminates.</p>
</div>
<hr class="border-secondary"/>
<ul class="list-unstyled text-muted small flex-grow-1 mb-4">
<li class="mb-2"><i class="fas fa-check text-gold me-2"></i> <strong>Wood:</strong> Commercial MR-grade plywood</li>
<li class="mb-2"><i class="fas fa-check text-gold me-2"></i> <strong>Finish:</strong> 0.8mm glossy/matte laminates</li>
<li class="mb-2"><i class="fas fa-check text-gold me-2"></i> <strong>Kitchen:</strong> Modular baskets, standard hinges</li>
<li class="mb-2"><i class="fas fa-check text-gold me-2"></i> <strong>Hardware:</strong> Godrej/Ebco standard channels</li>
<li class="mb-2"><i class="fas fa-check text-gold me-2"></i> <strong>Paints:</strong> Asian Paints Tractor Emulsion</li>
<li class="mb-2"><i class="fas fa-check text-gold me-2"></i> <strong>Ceiling:</strong> Standard single level gypsum</li>
</ul>
<div class="d-grid mt-auto">
<a class="btn btn-outline-gold" href="/contact/">Choose Standard</a>
</div>
</div>
</div>
<!-- Package 2: Premium (Recommended) -->
<div class="col-lg-4" data-aos="fade-up" data-aos-delay="200">
<div class="premium-card p-4 h-100 d-flex flex-column border-warning" style="border: 2px solid var(--color-gold) !important;">
<div class="mb-4">
<div class="d-flex justify-content-between align-items-center">
<span class="section-subtitle mb-1">Premium</span>
<span class="badge bg-warning text-dark font-monospace text-uppercase" style="font-size: 0.65rem;">Most Popular</span>
</div>
<h3 class="text-gold font-luxury h3">?1,600 / sqft</h3>
<p class="small text-muted">A balanced tier featuring textured veneers, acrylics, and premium accessories.</p>
</div>
<hr class="border-secondary"/>
<ul class="list-unstyled text-light small flex-grow-1 mb-4">
<li class="mb-2"><i class="fas fa-check text-gold me-2"></i> <strong>Wood:</strong> BWR waterproof marine plywood</li>
<li class="mb-2"><i class="fas fa-check text-gold me-2"></i> <strong>Finish:</strong> 1mm anti-scratch acrylics &amp; natural veneers</li>
<li class="mb-2"><i class="fas fa-check text-gold me-2"></i> <strong>Kitchen:</strong> Acrylic modules with soft-close tandem boxes</li>
<li class="mb-2"><i class="fas fa-check text-gold me-2"></i> <strong>Hardware:</strong> Hettich or Ebco premium drawers</li>
<li class="mb-2"><i class="fas fa-check text-gold me-2"></i> <strong>Paints:</strong> Asian Paints Royale Luxury Emulsion</li>
<li class="mb-2"><i class="fas fa-check text-gold me-2"></i> <strong>Ceiling:</strong> Dual cove design with integrated profile lighting</li>
</ul>
<div class="d-grid mt-auto">
<a class="btn btn-gold text-dark" href="/contact/">Choose Premium</a>
</div>
</div>
</div>
<!-- Package 3: Luxury -->
<div class="col-lg-4" data-aos="fade-up" data-aos-delay="300">
<div class="premium-card p-4 h-100 d-flex flex-column">
<div class="mb-4">
<span class="section-subtitle mb-1">Luxury</span>
<h3 class="text-white font-luxury h3">?2,800 / sqft</h3>
<p class="small text-muted">Premium luxury finishing featuring Italian marble paneling and automated hardware.</p>
</div>
<hr class="border-secondary"/>
<ul class="list-unstyled text-muted small flex-grow-1 mb-4">
<li class="mb-2"><i class="fas fa-check text-gold me-2"></i> <strong>Wood:</strong> BWP Grade Marine Plywood</li>
<li class="mb-2"><i class="fas fa-check text-gold me-2"></i> <strong>Finish:</strong> Polyurethane (PU) paint coatings &amp; marble veneers</li>
<li class="mb-2"><i class="fas fa-check text-gold me-2"></i> <strong>Kitchen:</strong> Ceramic countertops, motorized Blum drawers</li>
<li class="mb-2"><i class="fas fa-check text-gold me-2"></i> <strong>Hardware:</strong> Hafele / Blum premium automation systems</li>
<li class="mb-2"><i class="fas fa-check text-gold me-2"></i> <strong>Paints:</strong> Premium PU Metallic / Velvet coatings</li>
<li class="mb-2"><i class="fas fa-check text-gold me-2"></i> <strong>Ceiling:</strong> Luxury magnetic track light profiles</li>
</ul>
<div class="d-grid mt-auto">
<a class="btn btn-outline-gold" href="/contact/">Choose Luxury</a>
</div>
</div>
</div>
</div>
</div>
</section>
<!-- Estimate Calculator Widget -->
<section class="py-5 bg-dark">
<div class="container py-5">
<div class="row align-items-center">
<div class="col-lg-6 mb-5 mb-lg-0" data-aos="fade-right">
<span class="section-subtitle">Cost Estimator</span>
<h2 class="section-title text-white font-luxury mb-4">Generate Your Instant Quote</h2>
<p class="text-muted">Use our interactive calculator built according to current labor indexes in Navi Mumbai. Our estimates include all fabrication, material dispatch, tax, and site contractor costs.</p>
<div class="p-3 bg-dark border border-warning-subtle mb-4">
<h5 class="text-gold font-luxury mb-2">Note on Quotations:</h5>
<p class="small text-muted mb-0">Estimates are tentative. A final Bill of Quantities (BOQ) with specific material counts will be drawn up after physical measurements are taken at your flat or office.</p>
</div>
</div>
<div class="col-lg-6" data-aos="fade-left">
<div class="calc-card glass-panel text-white">
<form id="calculatorForm">
<div class="mb-3">
<label for="propType">Property Space</label>
<select class="form-select" id="propType" required="">
<option value="1bhk">1 BHK Flat</option>
<option selected="" value="2bhk">2 BHK Flat</option>
<option value="3bhk">3 BHK Flat</option>
<option value="villa">Bungalow / Villa</option>
<option value="modular-kitchen">Modular Kitchen Only</option>
<option value="office">Office Space</option>
</select>
</div>
<div class="mb-3">
<label for="size">Carpet Size (Sq. Ft.)</label>
<input class="form-control" id="size" placeholder="e.g. 750" required="" type="number" value="750"/>
</div>
<div class="mb-4">
<label for="quality">Material &amp; Trim Finish</label>
<select class="form-select" id="quality" required="">
<option value="standard">Standard (Commercial MR Ply, Laminates)</option>
<option selected="" value="premium">Premium (BWR Marine Ply, Acrylic/Veneers)</option>
<option value="luxury">Luxury (BWP Marine Ply, PU Paint &amp; Italian Veneers)</option>
</select>
</div>
<div class="d-grid">
<button class="btn btn-gold" type="submit">Generate Cost Details</button>
</div>
</form>
<div class="calc-result-box mt-4" id="calcResult">
<p class="text-muted mb-0">Modify values and click the button to generate estimation.</p>
</div>
</div>
</div>
</div>
</div>
</section>
<!-- Floating Actions -->
<div class="floating-widgets">
<a style="background-color: #25D366 !important; background: #25D366 !important; color: #ffffff !important; border-color: #25D366 !important;" class="float-btn float-whatsapp" href="https://wa.me/918369297174?text=Hi%20Siddhivinayak%20Designers,%20I'm%20interested%20in%20a%20free%20design%20consultation." target="_blank">
<i class="fab fa-whatsapp"></i>
</a>
<a class="float-btn float-call" href="tel:+918369297174">
<i class="fas fa-phone-alt"></i>
</a>
</div>
<!`;
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <Fragment set:html={bodyContent} />
</Layout>

<style is:global>
html, body {
      background-color: #ffffff !important;
      color: #000000 !important;
      font-family: Arial, Helvetica, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    }
    .hero-section, .catalog-directory-hero, .dc-top-section-bg, header.bg-dark, .bg-dark, .bg-dark-card, .bg-dark-contrast {
      background-color: #f3f6f8 !important;
      color: #000000 !important;
    }
    h1, h2, h3, h4, h5, h6, .section-title {
      color: #000000 !important;
    }
    p, span, li, label, div, small, strong, p *, li *, span *, label *, div *, small *, strong *, .text-muted, .text-white-50, .text-secondary, .text-muted * {
      color: #000000 !important;
    }
    :not(footer) .text-white, body:not(footer) .text-white, a.text-white:not(footer a), .section-title.text-white {
      color: #000000 !important;
    }
    .text-gold, .text-gold * {
      color: #189ba6 !important;
    }
    .btn-gold, .btn-primary {
      background-color: #189ba6 !important;
      border-color: #189ba6 !important;
      color: #ffffff !important;
    }
    .btn-gold:hover, .btn-primary:hover {
      background-color: #127c85 !important;
      border-color: #127c85 !important;
    }
    footer, footer *, footer p, footer span, footer li, footer div, footer small, footer .text-muted {
      color: #ffffff !important;
    }
    footer p, footer span, footer li, footer div, footer small, footer .text-muted, footer a {
      color: #d1cfc9 !important;
    }
  
    /* Fix headings appearing white on light background inside bg-dark / bg-dark-card / bg-dark-contrast elements */
    .bg-dark h1, .bg-dark h2, .bg-dark h3, .bg-dark h4, .bg-dark h5, .bg-dark h6,
    .bg-dark-card h1, .bg-dark-card h2, .bg-dark-card h3, .bg-dark-card h4, .bg-dark-card h5, .bg-dark-card h6,
    .bg-dark-contrast h1, .bg-dark-contrast h2, .bg-dark-contrast h3, .bg-dark-contrast h4, .bg-dark-contrast h5, .bg-dark-contrast h6 {
      color: #1a1a1a !important;
    }
    /* Fix text elements appearing light grey/white on light background inside bg-dark / bg-dark-card / bg-dark-contrast elements */
    .bg-dark p, .bg-dark li, .bg-dark span:not(.text-gold):not(.text-teal), .bg-dark label, .bg-dark .text-muted,
    .bg-dark-card p, .bg-dark-card li, .bg-dark-card span:not(.text-gold):not(.text-teal), .bg-dark-card label, .bg-dark-card .text-muted,
    .bg-dark-contrast p, .bg-dark-contrast li, .bg-dark-contrast span:not(.text-gold):not(.text-teal), .bg-dark-contrast label, .bg-dark-contrast .text-muted {
      color: #444444 !important;
    }
    .bg-dark strong, .bg-dark-card strong, .bg-dark-contrast strong {
      color: #1a1a1a !important;
    }
</style>

<script is:inline></script>

<script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-PLACEHOLDER');
    </script>

<script is:inline>
        AOS.init({
            duration: 800,
            easing: 'ease-in-out',
            once: true
        });
    </script>

