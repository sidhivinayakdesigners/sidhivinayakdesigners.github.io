---
import Layout from '../layouts/Layout.astro';

const title = "About Us | Siddhivinayak Designers";
const description = "Learn about Siddhivinayak Designers, a leading turnkey interior design and civil contracting firm in Navi Mumbai. Discover our values, experience, and commitment to high-end execution.";
const canonical = "https://siddhivinayakdesigners.in/about";
const schema = `{
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [{
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://siddhivinayakdesigners.in/"
      },{
        "@type": "ListItem",
        "position": 2,
        "name": "About Us",
        "item": "https://siddhivinayakdesigners.in/about"
      }]
    }`;
const bodyContent = `<!-- Header Banner -->
<section class="py-5 bg-dark" style="margin-top: 70px;">
<div class="container py-4 text-center">
<h1 class="font-luxury text-white mb-2" data-aos="fade-down">About Siddhivinayak Designers</h1>
<div class="custom-breadcrumb text-center justify-content-center d-flex gap-2">
<a href="/">Home</a>
<span class="text-muted">/</span>
<span>About Us</span>
</div>
</div>
</section>
<!-- Narrative Section -->
<section class="py-5 bg-dark">
<div class="container py-5">
<div class="row align-items-center g-5">
<div class="col-lg-6" data-aos="fade-right">
<div class="img-zoom-hover border border-light-subtle">
<img alt="Siddhivinayak Designers Portfolio Navi Mumbai" class="img-fluid w-100" loading="lazy" src="/assets/images/2026-04-11 (19).webp"/>
</div>
</div>
<div class="col-lg-6" data-aos="fade-left">
<span class="section-subtitle">Since 2014</span>
<h2 class="section-title text-white font-luxury mb-4">Creating the Best Residential and Commercial Spaces in Navi Mumbai</h2>
<p class="text-muted">Siddhivinayak Designers is Navi Mumbai's leading premium interior contracting agency. Based in Koparkhairane, we deliver complete turnkey contracting solutions for luxury homes and commercial spaces.</p>
<p class="text-muted">Our strength lies in our **in-house manufacturing units** and dedicated team of over 30 master craftsmen, carpenters, and civil engineers. We manage everything directly, ensuring strict quality control, transparent material specs, and precise timelines.</p>
<p class="text-gold fw-bold">"We don't just design layouts on a screen; we execute them with precision in wood, metal, glass, and marble."</p>
</div>
</div>
</div>
</section>
<!-- Trust Pillars -->
<section class="py-5 bg-dark">
<div class="container py-5">
<div class="text-center mb-5" data-aos="fade-up">
<span class="section-subtitle">Pillars of Excellence</span>
<h2 class="section-title text-white font-luxury">Our Commitments to Clients</h2>
</div>
<div class="row g-4 text-center">
<div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="100">
<div class="premium-card p-4 h-100">
<div class="text-gold mb-3 fs-3"><i class="fas fa-history"></i></div>
<h4 class="text-white h5 font-luxury mb-2">12+ Years Experience</h4>
<p class="small text-muted">Over a decade of tackling complex civil and contracting challenges in Navi Mumbai flats, villas, and showrooms.</p>
</div>
</div>
<div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="200">
<div class="premium-card p-4 h-100">
<div class="text-gold mb-3 fs-3"><i class="fas fa-truck-loading"></i></div>
<h4 class="text-white h5 font-luxury mb-2">On-Time Delivery</h4>
<p class="small text-muted">A strict 45-day handover agreement with financial penalty clauses in case of unapproved layout delays.</p>
</div>
</div>
<div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="300">
<div class="premium-card p-4 h-100">
<div class="text-gold mb-3 fs-3"><i class="fas fa-search-dollar"></i></div>
<h4 class="text-white h5 font-luxury mb-2">Transparent BOQs</h4>
<p class="small text-muted">Every quotation lists raw material brands, plywood grades (BWP/BWR), veneer thicknesses, and hardware specs.</p>
</div>
</div>
<div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="400">
<div class="premium-card p-4 h-100">
<div class="text-gold mb-3 fs-3"><i class="fas fa-shield-alt"></i></div>
<h4 class="text-white h5 font-luxury mb-2">10-Year Warranty</h4>
<p class="small text-muted">All customized wardrobes, modular kitchen cabinets, and structural woodwork carry certified warranty certificates.</p>
</div>
</div>
</div>
</div>
</section>
<!-- Design Process CTA -->
<section class="py-5 bg-dark">
<div class="container py-5 text-center">
<div class="row justify-content-center">
<div class="col-lg-8" data-aos="zoom-in">
<h2 class="section-title text-white font-luxury mb-4">Ready to Create Your Luxury Home?</h2>
<p class="text-muted mb-5">Our specialist design consultants are ready to assist you. Get a complete layout mapping and a transparent budget breakdown during our free site consultation.</p>
<div class="d-flex justify-content-center gap-3">
<a class="btn btn-gold px-4 py-3" href="/contact">Book Site Visit</a>
<a style="background-color: #25D366 !important; background: #25D366 !important; color: #ffffff !important; border-color: #25D366 !important;" class="btn btn-outline-gold px-4 py-3" href="https://wa.me/918369297174" target="_blank">
<i class="fab fa-whatsapp me-2"></i>Connect on WhatsApp
                        </a>
</div>
</div>
</div>
</div>
</section>
<!-- Floating Actions -->
<div class="floating-widgets">
<a style="background-color: #25D366 !important; background: #25D366 !important; color: #ffffff !important; border-color: #25D366 !important;" class="float-btn float-whatsapp" href="https://wa.me/918369297174?text=Hi%20Siddhivinayak%20Designers,%20I'm%20interested%20in%20a%20free%20design%20consultation." target="_blank">
<i class="fab fa-whatsapp"></i>
</a>
<a class="float-btn float-call" href="tel:+918369297174">
<i class="fas fa-phone-alt"></i>
</a>
</div>`;
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <Fragment set:html={bodyContent} />
</Layout>

<style is:global>
html, body {
      background-color: #ffffff !important;
      color: #000000 !important;
      font-family: Arial, Helvetica, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    }
    .hero-section, .catalog-directory-hero, .dc-top-section-bg, header.bg-dark, .bg-dark, .bg-dark-card, .bg-dark-contrast {
      background-color: #f3f6f8 !important;
      color: #000000 !important;
    }
    h1, h2, h3, h4, h5, h6, .section-title {
      color: #000000 !important;
    }
    p, span, li, label, div, small, strong, p *, li *, span *, label *, div *, small *, strong *, .text-muted, .text-white-50, .text-secondary, .text-muted * {
      color: #000000 !important;
    }
    :not(footer) .text-white, body:not(footer) .text-white, a.text-white:not(footer a), .section-title.text-white {
      color: #000000 !important;
    }
    .text-gold, .text-gold * {
      color: #189ba6 !important;
    }
    .btn-gold, .btn-primary {
      background-color: #189ba6 !important;
      border-color: #189ba6 !important;
      color: #ffffff !important;
    }
    .btn-gold:hover, .btn-primary:hover {
      background-color: #127c85 !important;
      border-color: #127c85 !important;
    }
    footer, footer *, footer p, footer span, footer li, footer div, footer small, footer .text-muted {
      color: #ffffff !important;
    }
    footer p, footer span, footer li, footer div, footer small, footer .text-muted, footer a {
      color: #d1cfc9 !important;
    }
  
    /* Fix headings appearing white on light background inside bg-dark / bg-dark-card / bg-dark-contrast elements */
    .bg-dark h1, .bg-dark h2, .bg-dark h3, .bg-dark h4, .bg-dark h5, .bg-dark h6,
    .bg-dark-card h1, .bg-dark-card h2, .bg-dark-card h3, .bg-dark-card h4, .bg-dark-card h5, .bg-dark-card h6,
    .bg-dark-contrast h1, .bg-dark-contrast h2, .bg-dark-contrast h3, .bg-dark-contrast h4, .bg-dark-contrast h5, .bg-dark-contrast h6 {
      color: #1a1a1a !important;
    }
    /* Fix text elements appearing light grey/white on light background inside bg-dark / bg-dark-card / bg-dark-contrast elements */
    .bg-dark p, .bg-dark li, .bg-dark span:not(.text-gold):not(.text-teal), .bg-dark label, .bg-dark .text-muted,
    .bg-dark-card p, .bg-dark-card li, .bg-dark-card span:not(.text-gold):not(.text-teal), .bg-dark-card label, .bg-dark-card .text-muted,
    .bg-dark-contrast p, .bg-dark-contrast li, .bg-dark-contrast span:not(.text-gold):not(.text-teal), .bg-dark-contrast label, .bg-dark-contrast .text-muted {
      color: #444444 !important;
    }
    .bg-dark strong, .bg-dark-card strong, .bg-dark-contrast strong {
      color: #1a1a1a !important;
    }
</style>

<script is:inline></script>

<script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-PLACEHOLDER');
    </script>

<script is:inline>
        AOS.init({
            duration: 800,
            easing: 'ease-in-out',
            once: true
        });
    </script>

