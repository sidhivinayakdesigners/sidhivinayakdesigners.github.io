</style>

<script is:inline>
    try {
      AOS.init({ duration: 800, once: true });
    } catch(e) {}

    // $10k Interactive Scroll Progress Fill & Tooltip Pin Animation
    document.addEventListener('DOMContentLoaded', function() {
      const cards = document.querySelectorAll('.dc-how-card');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const fill = entry.target.querySelector('.dc-slider-fill');
            const pin = entry.target.querySelector('.dc-slider-pin');
            if (fill) {
              const targetWidth = fill.getAttribute('data-fill-width') || '100%';
              fill.style.width = targetWidth;
            }
            if (pin) {
              setTimeout(() => {
                pin.classList.add('animated-active');
              }, 400);
            }
          }
        });
      }, { threshold: 0.2 });

      cards.forEach(card => observer.observe(card));

      // Mouse Cursor Drag & Touch Swipe Support for Team Carousel
      const carouselEl = document.getElementById('projectTeamCarousel');
      if (carouselEl && window.bootstrap) {
        const carousel = new bootstrap.Carousel(carouselEl, {
          touch: true,
          interval: 4000
        });

        let startX = 0;
        let isDragging = false;

        // Mouse Click & Drag Handlers
        carouselEl.addEventListener('mousedown', function(e) {
          isDragging = true;
          startX = e.clientX;
          carouselEl.style.cursor = 'grabbing';
        });

        carouselEl.addEventListener('mouseup', function(e) {
          if (!isDragging) return;
          isDragging = false;
          carouselEl.style.cursor = 'grab';
          const diffX = startX - e.clientX;
          if (diffX > 40) {
            carousel.next();
          } else if (diffX < -40) {
            carousel.prev();
          }
        });

        carouselEl.addEventListener('mouseleave', function() {
          if (isDragging) {
            isDragging = false;
            carouselEl.style.cursor = 'grab';
          }
        });

        // Touch Swipe Handlers
        let touchStartX = 0;
        carouselEl.addEventListener('touchstart', function(e) {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true });

        carouselEl.addEventListener('touchend', function(e) {
          const touchEndX = e.changedTouches[0].screenX;
          const diffX = touchStartX - touchEndX;
          if (diffX > 35) {
            carousel.next();
          } else if (diffX < -35) {
            carousel.prev();
          }
        }, { passive: true });

        carouselEl.style.cursor = 'grab';
      }
    });

    // FAQ Category Tab Switcher
    function switchFaqTab(tabId, ev) {
      document.querySelectorAll('.dc-faq-pill').forEach(btn => btn.classList.remove('active'));
      document.querySelectorAll('.dc-faq-pane').forEach(pane => pane.classList.add('d-none'));
      
      if (ev && ev.currentTarget) {
        ev.currentTarget.classList.add('active');
      }
      
      const targetPane = document.getElementById('faq-' + tabId);
      if (targetPane) {
        targetPane.classList.remove('d-none');
      }
    }
  </script>

