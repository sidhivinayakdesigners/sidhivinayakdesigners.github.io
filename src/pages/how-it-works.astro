---
import Layout from '../layouts/Layout.astro';

const title = "How It Works - 5 Easy Steps to Dream Home Interiors | Siddhivinayak Designers";
const description = "Discover how Siddhivinayak Designers transforms your home in 5 easy steps - from meeting our top designers to 3D VR design sign-off, factory production, and 15-day installation.";
const canonical = "https://siddhivinayakdesigners.in/how-it-works/";
const schema = ``;
const bodyContent = `<!-- Page Header -->
  <section class="pt-5 pb-3 bg-white border-bottom">
    <div class="container px-4 px-md-5" style="max-width: 1280px;">
      <h1 class="mb-2" style="font-size: 2.2rem; font-weight: 700; color: #111111 !important; font-family: 'Open Sans', sans-serif;" data-aos="fade-right">How It Works</h1>
      <p class="mb-0" style="font-size: 1.05rem; color: #333333 !important; font-weight: 400;" data-aos="fade-right" data-aos-delay="100">How to get your dream home interiors, in 5 easy steps</p>
    </div>
  </section>

  <!-- 5 Cards Section (Exact Siddhivinayak Designers Replica) -->
  <section class="py-4 bg-white">
    <div class="container px-4 px-md-5" style="max-width: 1280px;">
      
      <!-- Card 1 -->
      <div class="dc-how-card" data-aos="fade-up">
        <div class="row g-0 align-items-stretch">
          <div class="col-lg-6 order-1 order-lg-2">
            <div class="dc-card-img-container">
              <img src="/assets/images/how-it-works/step1-meet-designer.webp" alt="Meet a designer" class="dc-card-img" />
            </div>
          </div>
          <div class="col-lg-6 order-2 order-lg-1">
            <!-- Overlapping Badge -->
            <div class="dc-floating-badge">
              <div class="title">01 Meet a designer</div>
              <div class="subtitle">Time: 7 days*</div>
            </div>
            <div class="dc-card-content">
              <p class="mb-3" style="font-size: 1.05rem; color: #222222 !important; line-height: 1.6;">Talk to a designer about your needs, dreams and budget</p>
              <p class="mb-3" style="font-size: 1.05rem; color: #222222 !important; line-height: 1.6;">Get an instant estimate</p>
              <p class="mb-4" style="font-size: 1.05rem; color: #111111 !important; font-weight: 700; font-style: italic;">Book with Siddhivinayak Designers by paying 10%</p>
              
              <!-- Progress Slider -->
              <div class="dc-slider-wrapper">
                <span class="dc-slider-label">Total Paid</span>
                <div class="dc-slider-track">
                  <div class="dc-slider-fill" data-fill-width="10%"></div>
                  <div class="dc-slider-pin" style="left: 10%;">10%</div>
                  <div class="dc-slider-pin-end">100%</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="dc-how-card" data-aos="fade-up">
        <div class="row g-0 align-items-stretch">
          <div class="col-lg-6 order-1 order-lg-2">
            <div class="dc-card-img-container">
              <img src="/assets/images/how-it-works/step2-start-designing.webp" alt="Let's start designing" class="dc-card-img" />
            </div>
          </div>
          <div class="col-lg-6 order-2 order-lg-1">
            <!-- Overlapping Badge -->
            <div class="dc-floating-badge">
              <div class="title">02 Let's start designing</div>
              <div class="subtitle">Time: 21-28 days*</div>
            </div>
            <div class="dc-card-content">
              <p class="mb-3" style="font-size: 1.05rem; color: #222222 !important; line-height: 1.6;">Our team measures and assesses your home</p>
              <p class="mb-3" style="font-size: 1.05rem; color: #222222 !important; line-height: 1.6;">Work with your designers to create something amazing and personal</p>
              <p class="mb-4" style="font-size: 1.05rem; color: #111111 !important; font-weight: 700; font-style: italic;">Pay: 15%</p>
              
              <!-- Progress Slider -->
              <div class="dc-slider-wrapper">
                <span class="dc-slider-label">Total Paid</span>
                <div class="dc-slider-track">
                  <div class="dc-slider-fill" data-fill-width="25%"></div>
                  <div class="dc-slider-pin" style="left: 25%;">25%</div>
                  <div class="dc-slider-pin-end">100%</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="dc-how-card" data-aos="fade-up">
        <div class="row g-0 align-items-stretch">
          <div class="col-lg-6 order-1 order-lg-2">
            <div class="dc-card-img-container">
              <img src="/assets/images/how-it-works/step3-3d-designs.webp" alt="View Designs in 3D" class="dc-card-img" />
            </div>
          </div>
          <div class="col-lg-6 order-2 order-lg-1">
            <!-- Overlapping Badge -->
            <div class="dc-floating-badge">
              <div class="title">03 View Designs in 3D</div>
              <div class="subtitle">Time: 7-14 days*</div>
            </div>
            <div class="dc-card-content">
              <p class="mb-3" style="font-size: 1.05rem; color: #222222 !important; line-height: 1.6;">Watch your new home come alive in 3D or VR</p>
              <p class="mb-3" style="font-size: 1.05rem; color: #222222 !important; line-height: 1.6;">Sign off on the designs when satisfied, and pay 35%</p>
              
              <!-- Circle Feature Row -->
              <div class="dc-feature-row">
                <div class="dc-circle-icon">
                  <i class="far fa-calendar-alt"></i>
                </div>
                <div class="dc-feature-text">60 days to move in*</div>
              </div>
              
              <!-- Progress Slider -->
              <div class="dc-slider-wrapper">
                <span class="dc-slider-label">Total Paid</span>
                <div class="dc-slider-track">
                  <div class="dc-slider-fill" data-fill-width="60%"></div>
                  <div class="dc-slider-pin" style="left: 60%;">60%</div>
                  <div class="dc-slider-pin-end">100%</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="dc-how-card" data-aos="fade-up">
        <div class="row g-0 align-items-stretch">
          <div class="col-lg-6 order-1 order-lg-2">
            <div class="dc-card-img-container">
              <img src="/assets/images/how-it-works/step4-factory-production.webp" alt="Production begins at our factory" class="dc-card-img" />
            </div>
          </div>
          <div class="col-lg-6 order-2 order-lg-1">
            <!-- Overlapping Badge -->
            <div class="dc-floating-badge">
              <div class="title">04 Production begins at our factory</div>
              <div class="subtitle">Time: 45 days*</div>
            </div>
            <div class="dc-card-content">
              <p class="mb-3" style="font-size: 1.05rem; color: #222222 !important; line-height: 1.6;">While your home is getting built, shop for decor with your designer</p>
              <p class="mb-3" style="font-size: 1.05rem; color: #222222 !important; line-height: 1.6;">Your designs are ready to be shipped in 45 days, after 51 quality checks and steps to ensure hygiene</p>
              <p class="mb-3" style="font-size: 1.05rem; color: #111111 !important; font-weight: 700; font-style: italic;">Pay balance 40% prior to shipping</p>
              
              <!-- Circle Feature Row -->
              <div class="dc-feature-row">
                <div class="dc-circle-icon">
                  <i class="far fa-calendar-alt"></i>
                </div>
                <div class="dc-feature-text">15 days to move in*</div>
              </div>
              
              <!-- Progress Slider -->
              <div class="dc-slider-wrapper">
                <span class="dc-slider-label">Total Paid</span>
                <div class="dc-slider-track">
                  <div class="dc-slider-fill" data-fill-width="100%"></div>
                  <div class="dc-slider-pin-end dc-pin-teal">100%</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 5 -->
      <div class="dc-how-card" data-aos="fade-up">
        <div class="row g-0 align-items-stretch">
          <div class="col-lg-6 order-1 order-lg-2">
            <div class="dc-card-img-container">
              <img src="/assets/images/how-it-works/step5-move-in.webp" alt="Move-In" class="dc-card-img" />
            </div>
          </div>
          <div class="col-lg-6 order-2 order-lg-1">
            <!-- Overlapping Badge -->
            <div class="dc-floating-badge">
              <div class="title">05 Move-In</div>
              <div class="subtitle">Time: 15 days*</div>
            </div>
            <div class="dc-card-content">
              <p class="mb-3" style="font-size: 1.05rem; color: #222222 !important; line-height: 1.6;">Our team will bring your home to life in 15 days</p>
              <p class="mb-3" style="font-size: 1.05rem; color: #222222 !important; line-height: 1.6;">Move in and start living your dream</p>

              <!-- Circle Feature Row -->
              <div class="dc-feature-row mb-0">
                <div class="dc-circle-icon">
                  <i class="fas fa-shield-alt"></i>
                </div>
                <div class="dc-feature-text">Peace of mind kicks in with our 10-year warranty and maintenance</div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Project Team Section -->
  <section class="py-5 bg-white border-top border-bottom" id="projectTeam">
    <div class="container py-4" style="max-width: 1200px;">
      <div class="text-center mb-5" data-aos="fade-up">
        <h2 class="display-6 font-luxury fw-bold mb-2" style="color: #111111 !important;">The Project Team</h2>
        <p class="lead text-dark mx-auto mb-0" style="max-width: 650px; color: #333333 !important; font-size: 1.05rem;">
          Get to know the team that'll be with you every step of the way
        </p>
      </div>

      <!-- Desktop Grid View (All 3 Side-by-Side, No Scroll) -->
      <div class="row g-4 d-none d-lg-flex justify-content-center" data-aos="fade-up">
        <!-- Team 1 -->
        <div class="col-lg-4">
          <div class="text-center px-2 h-100">
            <div class="overflow-hidden rounded-4 shadow-sm mb-3 mx-auto" style="height: 320px;">
              <img src="/assets/images/how-it-works/team-designer.webp" alt="Personal Designer" class="w-100 h-100 object-fit-cover rounded-4" />
            </div>
            <h3 class="h4 font-luxury fw-bold mb-1" style="color: #111111 !important;">Personal Designer</h3>
            <p class="mb-0" style="color: #444444 !important; font-size: 0.98rem;">Understands you. Designs for you, and with you</p>
          </div>
        </div>

        <!-- Team 2 -->
        <div class="col-lg-4">
          <div class="text-center px-2 h-100">
            <div class="overflow-hidden rounded-4 shadow-sm mb-3 mx-auto" style="height: 320px;">
              <img src="/assets/images/how-it-works/team-happiness-manager.webp" alt="Customer Happiness Manager" class="w-100 h-100 object-fit-cover rounded-4" />
            </div>
            <h3 class="h4 font-luxury fw-bold mb-1" style="color: #111111 !important;">Customer Happiness Manager</h3>
            <p class="mb-0" style="color: #444444 !important; font-size: 0.98rem;">Your single point of contact for complete peace of mind</p>
          </div>
        </div>

        <!-- Team 3 -->
        <div class="col-lg-4">
          <div class="text-center px-2 h-100">
            <div class="overflow-hidden rounded-4 shadow-sm mb-3 mx-auto" style="height: 320px;">
              <img src="/assets/images/how-it-works/team-project-manager.webp" alt="Project Manager & Site Master" class="w-100 h-100 object-fit-cover rounded-4" />
            </div>
            <h3 class="h4 font-luxury fw-bold mb-1" style="color: #111111 !important;">Project Manager &amp; Site Master</h3>
            <p class="mb-0" style="color: #444444 !important; font-size: 0.98rem;">Supervises execution and 51-point quality checks on site</p>
          </div>
        </div>
      </div>

      <!-- Mobile Carousel View (1 Scrollable Card) -->
      <div id="projectTeamCarousel" class="carousel slide d-block d-lg-none mx-auto" data-bs-ride="carousel" data-bs-touch="true" data-bs-interval="4000" style="max-width: 480px;" data-aos="fade-up">
        <div class="carousel-inner rounded-4">
          
          <!-- Slide 1 -->
          <div class="carousel-item active">
            <div class="text-center px-2">
              <div class="overflow-hidden rounded-4 shadow-sm mb-3 mx-auto" style="height: 320px; max-width: 480px;">
                <img src="/assets/images/how-it-works/team-designer.webp" alt="Personal Designer" class="w-100 h-100 object-fit-cover rounded-4" />
              </div>
              <h3 class="h4 font-luxury fw-bold mb-1" style="color: #111111 !important;">Personal Designer</h3>
              <p class="mb-0" style="color: #444444 !important; font-size: 0.98rem;">Understands you. Designs for you, and with you</p>
            </div>
          </div>

          <!-- Slide 2 -->
          <div class="carousel-item">
            <div class="text-center px-2">
              <div class="overflow-hidden rounded-4 shadow-sm mb-3 mx-auto" style="height: 320px; max-width: 480px;">
                <img src="/assets/images/how-it-works/team-happiness-manager.webp" alt="Customer Happiness Manager" class="w-100 h-100 object-fit-cover rounded-4" />
              </div>
              <h3 class="h4 font-luxury fw-bold mb-1" style="color: #111111 !important;">Customer Happiness Manager</h3>
              <p class="mb-0" style="color: #444444 !important; font-size: 0.98rem;">Your single point of contact for complete peace of mind</p>
            </div>
          </div>

          <!-- Slide 3 -->
          <div class="carousel-item">
            <div class="text-center px-2">
              <div class="overflow-hidden rounded-4 shadow-sm mb-3 mx-auto" style="height: 320px; max-width: 480px;">
                <img src="/assets/images/how-it-works/team-project-manager.webp" alt="Project Manager & Site Master" class="w-100 h-100 object-fit-cover rounded-4" />
              </div>
              <h3 class="h4 font-luxury fw-bold mb-1" style="color: #111111 !important;">Project Manager &amp; Site Master</h3>
              <p class="mb-0" style="color: #444444 !important; font-size: 0.98rem;">Supervises execution and 51-point quality checks on site</p>
            </div>
          </div>

        </div>

        <!-- Carousel Indicators / Dots -->
        <div class="carousel-indicators position-relative mt-3 mb-0">
          <button type="button" data-bs-target="#projectTeamCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
          <button type="button" data-bs-target="#projectTeamCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
          <button type="button" data-bs-target="#projectTeamCarousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>
      </div>

    </div>
  </section>

  <!-- Frequently Asked Questions Section (Siddhivinayak Designers Tabbed Replica) -->
  <section class="py-5 bg-light border-top border-bottom" id="dcFaqSection">
    <div class="container py-4">
      
      <div class="text-center mb-5" data-aos="fade-up">
        <h2 class="display-6 font-luxury fw-bold mb-3" style="color: #111111 !important;">Frequently Asked Questions</h2>
        <p class="lead text-dark mx-auto" style="max-width: 650px; color: #444444 !important; font-size: 1.05rem;">
          Everything you need to know about our home interior process, pricing, materials, and 10-year warranty.
        </p>
      </div>

      <!-- FAQ Category Tabs -->
      <div class="d-flex flex-wrap justify-content-center gap-2 mb-5" data-aos="fade-up">
        <button class="btn dc-faq-pill active" onclick="switchFaqTab('ordering', event)">Ordering &amp; How it works</button>
        <button class="btn dc-faq-pill" onclick="switchFaqTab('services', event)">Siddhivinayak Designers Services for your home</button>
        <button class="btn dc-faq-pill" onclick="switchFaqTab('consultation', event)">Book a Consultation</button>
        <button class="btn dc-faq-pill" onclick="switchFaqTab('materials', event)">Materials &amp; Quality</button>
        <button class="btn dc-faq-pill" onclick="switchFaqTab('production', event)">Production &amp; Installation</button>
        <button class="btn dc-faq-pill" onclick="switchFaqTab('warranty', event)">Warranty</button>
        <button class="btn dc-faq-pill" onclick="switchFaqTab('pricing', event)">Pricing</button>
        <button class="btn dc-faq-pill" onclick="switchFaqTab('payments', event)">Payments</button>
      </div>

      <!-- FAQ Accordions Container -->
      <div class="mx-auto" style="max-width: 900px;" data-aos="fade-up">
        
        <!-- Tab 1: Ordering -->
        <div id="faq-ordering" class="dc-faq-pane">
          <div class="accordion accordion-flush" id="accOrdering">
            <div class="accordion-item mb-3 border rounded-3 overflow-hidden shadow-sm">
              <h3 class="accordion-header">
                <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#ord1">
                  How do I get started with Siddhivinayak Designers?
                </button>
              </h3>
              <div id="ord1" class="accordion-collapse collapse show" data-bs-parent="#accOrdering">
                <div class="accordion-body text-dark" style="color: #333333 !important; line-height: 1.6;">
                  Simply book a free consultation online or visit our Kopar Khairane experience studio. You will be paired with a senior interior designer who will discuss your requirements, lifestyle preferences, floor plan, and budget roadmap.
                </div>
              </div>
            </div>
            <div class="accordion-item mb-3 border rounded-3 overflow-hidden shadow-sm">
              <h3 class="accordion-header">
                <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#ord2">
                  What is the 5-step process for my home interior design?
                </button>
              </h3>
              <div id="ord2" class="accordion-collapse collapse" data-bs-parent="#accOrdering">
                <div class="accordion-body text-dark" style="color: #333333 !important; line-height: 1.6;">
                  Our 5-step process includes: 1) Meet a designer &amp; get instant estimate. 2) Site measurement &amp; 2D layout planning. 3) 3D &amp; VR design sign-off. 4) Factory manufacturing with 51 quality checks. 5) 15-day site installation &amp; move-in handover.
                </div>
              </div>
            </div>
            <div class="accordion-item border rounded-3 overflow-hidden shadow-sm">
              <h3 class="accordion-header">
                <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#ord3">
                  How long does the entire home interior process take?
                </button>
              </h3>
              <div id="ord3" class="accordion-collapse collapse" data-bs-parent="#accOrdering">
                <div class="accordion-body text-dark" style="color: #333333 !important; line-height: 1.6;">
                  All modular woodwork is precision-manufactured in our factory within 45 days and installed on site in just 15 days following site readiness handover.
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Tab 2: Services -->
        <div id="faq-services" class="dc-faq-pane d-none">
          <div class="accordion accordion-flush" id="accServices">
            <div class="accordion-item mb-3 border rounded-3 overflow-hidden shadow-sm">
              <h3 class="accordion-header">
                <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#srv1">
                  What interior design services do you offer?
                </button>
              </h3>
              <div id="srv1" class="accordion-collapse collapse show" data-bs-parent="#accServices">
                <div class="accordion-body text-dark" style="color: #333333 !important; line-height: 1.6;">
                  We provide end-to-end turnkey interior design including modular kitchens, master bedroom wardrobes, living room entertainment centers, pooja rooms, false ceiling lighting, wallpaper, and loose furniture curation.
                </div>
              </div>
            </div>
            <div class="accordion-item border rounded-3 overflow-hidden shadow-sm">
              <h3 class="accordion-header">
                <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#srv2">
                  Do you handle civil renovations and structural modifications?
                </button>
              </h3>
              <div id="srv2" class="accordion-collapse collapse" data-bs-parent="#accServices">
                <div class="accordion-body text-dark" style="color: #333333 !important; line-height: 1.6;">
                  Yes! Backed by 25+ years of master contracting, we handle full civil alterations, tiling, bathroom remodeling, plumbing, and electrical rewiring managed by experienced Site Masters.
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Tab 3: Consultation -->
        <div id="faq-consultation" class="dc-faq-pane d-none">
          <div class="accordion accordion-flush" id="accConsultation">
            <div class="accordion-item mb-3 border rounded-3 overflow-hidden shadow-sm">
              <h3 class="accordion-header">
                <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#cns1">
                  Is the initial design consultation free?
                </button>
              </h3>
              <div id="cns1" class="accordion-collapse collapse show" data-bs-parent="#accConsultation">
                <div class="accordion-body text-dark" style="color: #333333 !important; line-height: 1.6;">
                  Yes, your first 3D layout consultation and cost estimation with our senior interior designer are 100% free with zero obligation.
                </div>
              </div>
            </div>
            <div class="accordion-item border rounded-3 overflow-hidden shadow-sm">
              <h3 class="accordion-header">
                <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#cns2">
                  Can I consult online or do I need to visit in person?
                </button>
              </h3>
              <div id="cns2" class="accordion-collapse collapse" data-bs-parent="#accConsultation">
                <div class="accordion-body text-dark" style="color: #333333 !important; line-height: 1.6;">
                  We offer both virtual 3D video consultations from the comfort of your home and in-person consultations at our Kopar Khairane studio or directly at your apartment site.
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Tab 4: Materials -->
        <div id="faq-materials" class="dc-faq-pane d-none">
          <div class="accordion accordion-flush" id="accMaterials">
            <div class="accordion-item mb-3 border rounded-3 overflow-hidden shadow-sm">
              <h3 class="accordion-header">
                <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#mat1">
                  What materials and hardware brands do you use?
                </button>
              </h3>
              <div id="mat1" class="accordion-collapse collapse show" data-bs-parent="#accMaterials">
                <div class="accordion-body text-dark" style="color: #333333 !important; line-height: 1.6;">
                  We use boiling waterproof marine plywood (BWP IS:710), high-density moisture-resistant boards (HDMR), and world-class soft-close hardware fittings from Hafele, Hettich, and Ebco.
                </div>
              </div>
            </div>
            <div class="accordion-item border rounded-3 overflow-hidden shadow-sm">
              <h3 class="accordion-header">
                <button class="accordion-button collapsed fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#mat2">
                  How do you ensure quality during production?
                </button>
              </h3>
              <div id="mat2" class="accordion-collapse collapse" data-bs-parent="#accMaterials">
                <div class="accordion-body text-dark" style="color: #333333 !important; line-height: 1.6;">
                  Every modular panel undergoes 51 rigorous quality checks for edge banding precision, moisture resistance, structural load capacity, and anti-scratch finish before dispatch.
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Tab 5: Production -->
        <div id="faq-production" class="dc-faq-pane d-none">
          <div class="accordion accordion-flush" id="accProduction">
            <div class="accordion-item mb-3 border rounded-3 overflow-hidden shadow-sm">
              <h3 class="accordion-header">
                <button class="accordion-button fw-bold" type="button" data-bs-toggle="collapse" data-bs-target="#prd1">
                  Where are your modular products manufactured?
                </button>
              </h3>
              <div id="prd1" class="accordion-collapse collapse show" data-bs-parent="#accProduction">
