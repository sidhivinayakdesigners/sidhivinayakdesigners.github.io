<style is:global>
body {
      background-color: #ffffff !important;
      color: #000000 !important;
      font-family: 'Open Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    p, span:not(.dc-slider-pin):not(.dc-slider-pin-end):not(.badge):not(.btn):not(.dc-circle-icon *), li, label, div:not(.dc-slider-pin):not(.dc-slider-pin-end):not(.badge):not(.btn):not(.dc-circle-icon), h1, h2, h3, h4, h5, h6 {
      color: #000000 !important;
    }
    .text-white-override, div.dc-slider-pin, div.dc-slider-pin-end {
      color: #ffffff !important;
      -webkit-text-fill-color: #ffffff !important;
    }

    /* Premium $10k Card Animation & Styling Overhaul */
    .dc-how-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      box-shadow: 0 4px 25px rgba(0, 0, 0, 0.05);
      position: relative;
      margin-top: 55px;
      margin-bottom: 65px;
      overflow: visible;
      transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), box-shadow 0.4s cubic-bezier(0.165, 0.84, 0.44, 1), border-color 0.4s ease;
    }

    .dc-how-card:hover {
      transform: translateY(-8px);
      box-shadow: 0 20px 40px rgba(24, 155, 166, 0.12), 0 8px 20px rgba(0, 0, 0, 0.06);
      border-color: rgba(24, 155, 166, 0.35);
    }

    .dc-floating-badge {
      position: absolute;
      top: -30px;
      left: -20px;
      background: linear-gradient(135deg, #ffffff 0%, #fcfefe 100%);
      border: 1.5px solid #d4d4d4;
      border-radius: 12px;
      padding: 22px 34px;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
      z-index: 15;
      min-width: 360px;
      transition: all 0.35s ease;
    }

    .dc-how-card:hover .dc-floating-badge {
      border-color: #189ba6;
      box-shadow: 0 8px 25px rgba(24, 155, 166, 0.18);
      transform: translateY(-2px);
    }

    .dc-floating-badge .title {
      font-size: 1.35rem;
      font-weight: 700;
      color: #000000 !important;
      margin-bottom: 4px;
      font-family: 'Open Sans', sans-serif;
      line-height: 1.25;
    }

    .dc-floating-badge .subtitle {
      font-size: 1.05rem;
      font-weight: 500;
      color: #333333 !important;
      font-family: 'Open Sans', sans-serif;
    }

    .dc-card-content {
      padding: 75px 40px 40px 45px;
    }

    .dc-card-img-container {
      height: 100%;
      min-height: 420px;
      overflow: hidden;
