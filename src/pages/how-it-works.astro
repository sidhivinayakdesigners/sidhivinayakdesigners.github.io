      }
      .dc-card-content {
        padding: 22px 18px 25px 18px;
      }
      .dc-card-content p {
        font-size: 0.95rem !important;
        line-height: 1.5 !important;
        margin-bottom: 10px !important;
      }
      .dc-feature-text {
        font-size: 0.92rem !important;
