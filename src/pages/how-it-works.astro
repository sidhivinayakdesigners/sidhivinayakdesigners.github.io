    div.dc-slider-pin-end.dc-pin-teal {
      background-color: #189ba6 !important;
      box-shadow: 0 4px 12px rgba(24, 155, 166, 0.3);
    }

    div.dc-slider-pin-end::after {
      content: '';
      position: absolute;
      bottom: -5px;
      right: 10px;
      border-width: 5px 5px 0 5px;
      border-style: solid;
      border-color: #000000 transparent transparent transparent;
    }

    div.dc-slider-pin-end.dc-pin-teal::after {
      border-color: #189ba6 transparent transparent transparent !important;
