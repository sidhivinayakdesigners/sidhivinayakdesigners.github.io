<script is:inline>
    if (typeof AOS !== 'undefined') {
      AOS.init({ duration: 800, once: true });
    }

    document.addEventListener('DOMContentLoaded', function () {
      const desc = document.getElementById('dcMainDesc');
      const showBtn = document.getElementById('dcShowLessBtn');

      if (showBtn && desc) {
        showBtn.addEventListener('click', function (e) {
          e.preventDefault();
          if (desc.classList.contains('collapsed')) {
            desc.classList.remove('collapsed');
            showBtn.textContent = 'Show Less';
          } else {
            desc.classList.add('collapsed');
            showBtn.textContent = 'Show More';
          }
        });
      }

      const pills = document.querySelectorAll('.dc-pill-box');
      const sections = document.querySelectorAll('.dc-filter-item');
      const topCollage = document.getElementById('topCategoriesGridBlock');

      function activateFilter(filterKey) {
        pills.forEach(p => p.classList.remove('active'));
        const activePill = document.querySelector(`.dc-pill-box[data-filter="${filterKey}"]`);
        if (activePill) activePill.classList.add('active');

        if (filterKey === 'all') {
          if (topCollage) topCollage.style.display = 'block';
          sections.forEach(sec => {
            sec.style.display = 'block';
            const extraCards = sec.querySelectorAll('.dc-extra-card');
            extraCards.forEach(c => c.style.display = 'none');
            const moreWrap = sec.querySelector('.dc-more-link-wrapper');
            if (moreWrap) moreWrap.style.display = 'block';
          });
          window.scrollTo({ top: 0, behavior: 'smooth' });
        } else {
          if (topCollage) topCollage.style.display = 'none';

          let targetSection = null;
          sections.forEach(sec => {
            const secId = sec.id.toLowerCase().replace(/-/g, '');
            const normFilter = filterKey.toLowerCase().replace(/-/g, '');
            if (secId.includes(normFilter) || normFilter.includes(secId.replace('section', ''))) {
              sec.style.display = 'block';
              targetSection = sec;

              const extraCards = sec.querySelectorAll('.dc-extra-card');
              extraCards.forEach(c => c.style.display = 'block');

              const moreWrap = sec.querySelector('.dc-more-link-wrapper');
              if (moreWrap) moreWrap.style.display = 'none';
            } else {
              sec.style.display = 'none';
            }
          });

          if (targetSection) {
            targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      }

            pills.forEach(pill => {
        pill.addEventListener('click', function (e) {
          // Allow navigation to the href link
          const filter = this.getAttribute('data-filter');
          activateFilter(filter);
        });
      });;

      document.querySelectorAll('.dc-inpage-trigger').forEach(trigger => {
        trigger.addEventListener('click', function (e) {
          e.preventDefault();
          const targetFilter = this.getAttribute('data-pill-target');
          if (targetFilter) {
            activateFilter(targetFilter);
          }
        });
      });

      const urlParams = new URLSearchParams(window.location.search);
      const catParam = urlParams.get('category') || window.location.hash.replace('#', '');
      if (catParam) {
        setTimeout(() => activateFilter(catParam), 150);
      }
    });

      // Lightbox logic is centrally handled by Layout.astro with bottom filmstrip
  </script>

