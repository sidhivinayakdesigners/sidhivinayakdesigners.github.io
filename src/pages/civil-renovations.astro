---
import Layout from '../layouts/Layout.astro';

const title = "Civil &amp; Renovation Work Navi Mumbai | Siddhivinayak Designers";
const description = "Professional civil renovations, partition masonry, bathroom waterproofing, kitchen platform shifting, and custom tiling works in Koparkhairne, Vashi, and Navi Mumbai.";
const canonical = "https://siddhivinayakdesigners.in/civil-renovations/";
const schema = ``;
const bodyContent = `<!-- Header Banner -->
  <section class="py-5 bg-dark" style="margin-top: 70px;">
    <div class="container py-4 text-center">
      <h1 class="font-luxury text-white mb-2" data-aos="fade-down">Civil &amp; Renovation Work</h1>
      <div class="custom-breadcrumb text-center justify-content-center d-flex gap-2">
        <a href="/">Home</a>
        <span class="text-muted">/</span>
        <a href="/services/">Designs</a>
        <span class="text-muted">/</span>
        <span class="text-gold">Civil &amp; Renovations</span>
      </div>
    </div>
  </section>

  <!-- Service Details Section -->
  <section class="py-5 bg-dark border-top border-secondary">
    <div class="container py-4">
      <div class="row g-5">
        <!-- Left Side: Detail content -->
        <div class="col-lg-7" data-aos="fade-right">
          <h2 class="font-luxury text-gold mb-3">Structural Modifications &amp; Waterproofing</h2>
          <p class="text-muted lead mb-4">We deliver heavy-duty civil masonry, structural alterations, premium tiling,
            and specialized bathroom waterproofing. Our contractors have over 25 years of experience in structural modifications,
            ensuring your project is safe, clean, and compliant.</p>

          <h3 class="text-white h5 mb-3 font-luxury"><i class="fas fa-list-check text-gold me-2"></i>What's Included in
            the Scope</h3>
          <ul class="list-unstyled text-muted mb-4 ps-3">
            <li class="mb-2"><i class="fas fa-check text-gold me-2"></i><strong>Wall Alterations:</strong> Precision wall demolitions,
              partition brickwork masonry, and structural column column wraps.</li>
            <li class="mb-2"><i class="fas fa-check text-gold me-2"></i><strong>Tile &amp; Marble Laying:</strong> Ceramic, vitrified,
              or large-format Italian marble slab flooring and wall cladding installations.</li>
            <li class="mb-2"><i class="fas fa-check text-gold me-2"></i><strong>Kitchen Platform Work:</strong> Granite shifting, L-shaped platform
              re-alignment, quartz molding, and sink drainage plumbing adjustments.</li>
            <li class="mb-2"><i class="fas fa-check text-gold me-2"></i><strong>Bathroom Waterproofing:</strong> Comprehensive hacking,
              double-coat liquid waterproofing membrane application, leakage tests, and re-tiling.</li>
            <li class="mb-2"><i class="fas fa-check text-gold me-2"></i><strong>Plastering &amp; Levelling:</strong> High-density river sand plastering
              and self-levelling concrete layouts for flooring bases.</li>
          </ul>

          <h3 class="text-white h5 mb-3 font-luxury"><i class="fas fa-gears text-gold me-2"></i>Material Specifications
          </h3>
          <div class="table-responsive">
            <table class="table table-dark table-striped border border-secondary text-muted">
              <thead>
                <tr>
                  <th>Component</th>
                  <th>Civil Specific Materials Specs</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>Cement Base</td>
                  <td>53-Grade OPC (Ordinary Portland Cement) (Ultratech / Ambuja)</td>
                </tr>
                <tr>
                  <td>Waterproofing Agent</td>
                  <td>Dr. Fixit Fastflex or Asian Paints SmartCare elastomeric coatings</td>
                </tr>
                <tr>
                  <td>Tile Adhesives</td>
                  <td>Polymer-modified tile adhesives (Laticrete / Roff) for joint strength</td>
                </tr>
                <tr>
                  <td>Concealed Plumb</td>
                  <td>Astral CPVC pipes with brass threaded elbow brackets for durability</td>
                </tr>
                <tr>
                  <td>Bricks</td>
                  <td>High-quality red clay bricks or lightweight autoclaved aerated concrete (AAC) blocks</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Right Side: Sticky side card & image -->
        <div class="col-lg-5" data-aos="fade-left">
          <div class="position-sticky" style="top: 100px;">
            <div class="premium-card p-2 mb-4">
              <img alt="Civil & Renovation Works" class="img-fluid w-100"
                src="/assets/images/modular-kitchen-koparkhairne-siddhivinayak-interior.webp"
                style="border-radius: 4px; object-fit: cover; max-height: 320px;" />
            </div>
            <div class="glass-panel p-4 text-center">
              <h4 class="font-luxury text-gold mb-3">Structural &amp; Masonry Safety</h4>
              <p class="small text-muted mb-4">Prevent structural cracks. All wall demolitions are carefully calculated and
                executed with sound safety practices. Completed in 20 days.</p>
              <div class="d-grid gap-2">
                <a class="btn btn-gold py-3 text-dark fw-bold" href="/contact/">Request Free Site Inspection</a>
                <a style="background-color: #25D366 !important; background: #25D366 !important; color: #ffffff !important; border-color: #25D366 !important;" class="btn btn-outline-gold py-3"
                  href="https://wa.me/918369297174?text=Hi,%20I'm%20interested%20in%20Civil%20and%20Renovation%20work."
                  target="_blank"><i class="fab fa-whatsapp me-2"></i>WhatsApp Details</a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Floating Actions -->
  <div class="floating-widgets">
    <a style="background-color: #25D366 !important; background: #25D366 !important; color: #ffffff !important; border-color: #25D366 !important;" class="float-btn float-whatsapp"
      href="https://wa.me/918369297174?text=Hi%20Siddhivinayak%20Designers,%20I'm%20interested%20in%20a%20free%20design%20consultation."
      target="_blank">
      <i class="fab fa-whatsapp"></i>
    </a>
    <a class="float-btn float-call" href="tel:+918369297174">
      <i class="fas fa-phone-alt"></i>
    </a>
  </div>`;
---
<Layout title={title} description={description} canonical={canonical} schema={schema}>
  <Fragment set:html={bodyContent} />
</Layout>

<style is:global>
html, body {
      background-color: #ffffff !important;
      color: #212529 !important;
      font-family: Arial, Helvetica, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif !important;
    }
    .hero-section, .catalog-directory-hero, .dc-top-section-bg, header.bg-dark, .bg-dark, .bg-dark-card, .bg-dark-contrast {
      background-color: #f3f6f8 !important;
      color: #1a1a1a !important;
    }
    h1, h2, h3, h4, h5, h6, .section-title {
      color: #1a1a1a !important;
    }
    p, span, li, label, div {
      color: #444444 !important;
    }
    :not(footer) .text-white, body:not(footer) .text-white, a.text-white:not(footer a), .section-title.text-white {
      color: #1a1a1a !important;
    }
    .text-gold {
      color: #189ba6 !important;
    }
    .btn-gold, .btn-primary {
      background-color: #189ba6 !important;
      border-color: #189ba6 !important;
      color: #ffffff !important;
    }
    .btn-gold:hover, .btn-primary:hover {
      background-color: #127c85 !important;
      border-color: #127c85 !important;
    }
    footer, footer * {
      color: #ffffff !important;
    }
    footer p, footer span, footer li, footer div, footer small, footer .text-muted {
      color: #d1cfc9 !important;
    }
  
    /* Fix headings appearing white on light background inside bg-dark / bg-dark-card / bg-dark-contrast elements */
    .bg-dark h1, .bg-dark h2, .bg-dark h3, .bg-dark h4, .bg-dark h5, .bg-dark h6,
    .bg-dark-card h1, .bg-dark-card h2, .bg-dark-card h3, .bg-dark-card h4, .bg-dark-card h5, .bg-dark-card h6,
    .bg-dark-contrast h1, .bg-dark-contrast h2, .bg-dark-contrast h3, .bg-dark-contrast h4, .bg-dark-contrast h5, .bg-dark-contrast h6 {
      color: #1a1a1a !important;
    }
    /* Fix text elements appearing light grey/white on light background inside bg-dark / bg-dark-card / bg-dark-contrast elements */
    .bg-dark p, .bg-dark li, .bg-dark span:not(.text-gold):not(.text-teal), .bg-dark label, .bg-dark .text-muted,
    .bg-dark-card p, .bg-dark-card li, .bg-dark-card span:not(.text-gold):not(.text-teal), .bg-dark-card label, .bg-dark-card .text-muted,
    .bg-dark-contrast p, .bg-dark-contrast li, .bg-dark-contrast span:not(.text-gold):not(.text-teal), .bg-dark-contrast label, .bg-dark-contrast .text-muted {
      color: #444444 !important;
    }
    .bg-dark strong, .bg-dark-card strong, .bg-dark-contrast strong {
      color: #1a1a1a !important;
    }
</style>

<script is:inline>
    try {
      AOS.init({
        duration: 800,
        easing: 'ease-in-out',
        once: true
      });
    } catch (e) {
      console.warn("AOS init error:", e);
    }
  </script>

